---
// The Yemeni beans' black box (100 g), drawn until there is artwork: matte black, a thin gold rule,
// the logo and حكاية in gold, and the region on a small gold label. [TBD: the box design.]
import type { Coffee, Lang } from '../data/products';
interface Props { coffee: Coffee; lang: Lang }
const { coffee, lang } = Astro.props;
const ar = lang === 'ar';
---
<svg class="black-box" viewBox="0 0 600 750" role="img" aria-label={ar ? `علبة سوداء: ${coffee.name.ar}` : `Black box: ${coffee.name.en}`}>
  <rect width="600" height="750" fill="#EFE7DA" />
  <ellipse cx="300" cy="652" rx="175" ry="24" fill="#33211A" opacity=".22" />
  <ellipse cx="300" cy="650" rx="120" ry="12" fill="#33211A" opacity=".18" />
  <g transform="translate(150 110)">
    <rect x="16" y="-14" width="268" height="20" rx="3" fill="#2A2420" />
    <rect width="300" height="540" rx="10" fill="#1C1714" />
    <rect x="16" y="16" width="268" height="508" rx="6" fill="none" stroke="#CF9C0C" stroke-opacity=".75" stroke-width="2" />
    <image href="/brand/logo.svg" x="104" y="88" width="92" height="77" opacity=".95" />
    <text x="150" y="232" text-anchor="middle" font-family="El Messiri, serif" font-weight="700" font-size="40" fill="#CF9C0C">حكاية</text>
    <text x="150" y="262" text-anchor="middle" font-family="IBM Plex Sans, Arial, sans-serif" font-weight="600" font-size="13" letter-spacing="6" fill="#CF9C0C" opacity=".8">HIKAYA</text>
    <rect x="70" y="330" width="160" height="96" rx="8" fill="#CF9C0C" />
    <text x="150" y="372" text-anchor="middle" font-family="El Messiri, serif" font-weight="700" font-size="30" fill="#1C1714">{coffee.name.ar}</text>
    <text x="150" y="404" text-anchor="middle" font-family="IBM Plex Sans, Arial, sans-serif" font-weight="600" font-size="15" fill="#1C1714">{coffee.name.en} · {ar ? 'اليمن' : 'Yemen'}</text>
    <text x="150" y="486" text-anchor="middle" font-family="IBM Plex Sans, Arial, sans-serif" font-weight="600" font-size="14" fill="#CF9C0C" opacity=".75">{coffee.size[lang]}</text>
  </g>
</svg>
<style>.black-box { width: 100%; height: 100%; display: block; }</style>
