---
// A drawing of a date box as it really is, until there are photos: the B1 gift box (cream lid with
// the pattern, the gold khalal sleeve and the seal; Ramadan or Eid adds our Ø50 sticker) open beside
// its lid, with what goes inside, or the clear tray of the Everyday dates. 4:5, like the photos.
import type { Box, Lang } from '../data/products';
import { DATES, EVERYDAY, RESERVE, PRODUCTS, defaultBoxOpt } from '../data/products';
import { dateSvg } from '../data/date-art';
interface Props { p: Box; lang: Lang; sleeve?: 'ramadan' | 'eid' }
const { p, lang, sleeve } = Astro.props;
const uid = `${p.id}-${Math.random().toString(36).slice(2, 7)}`;
const tray = p.tier === 'everyday';
const sealed = p.tier === 'stuffed';
// Colours of the dates that go in.
const palette = tray ? [DATES[EVERYDAY[0]].c, DATES[EVERYDAY[1]].c]
  : p.packs?.dates && !p.picks ? Object.keys(p.packs.dates).map(k => DATES[k as keyof typeof DATES].c)
  : sealed ? ['#B57A34', '#8E4A22', '#C99A5B', '#6E3420'] : RESERVE.map(k => DATES[k].c);
// What lies in the base: coffee pouches (the default choices) and dates in cups.
const coffees = p.picks ? defaultBoxOpt(p).split('|').filter((_, i) => p.picks![i] === 'coffee').map(id => PRODUCTS.find(x => x.id === id)!.name.ar) : [];
const count = tray ? 15 : p.count ?? (p.insert === 'D24' ? 24 : p.insert === 'C12' ? 12 : 0);
// Base inner area 360 × 270 (at 1.125 px/mm of the 320 × 240 box).
const area = { x: 20, y: 20, w: 360, h: 270 };
const pouchW = coffees.length ? (coffees.length === 2 ? area.w / 2 : area.w * 0.42) : 0;
const dArea = { x: area.x + pouchW, y: area.y, w: area.w - pouchW, h: area.h };
const cols = count >= 24 ? 6 : count === 15 ? 5 : count >= 12 ? (coffees.length ? 3 : 4) : 3;
const rows = Math.max(1, Math.ceil(count / cols));
const cw = dArea.w / cols, ch = dArea.h / rows;
// Stuffed boxes: each date opened with its filling (the fillings in turn, as in Mixed).
const fills = sealed ? p.fillings ?? [] : [];
const cells = coffees.length === 2 ? [] : Array.from({ length: count }, (_, i) => ({ x: dArea.x + (i % cols) * cw, y: dArea.y + Math.floor(i / cols) * ch, c: sealed ? '#8E4A22' : palette[i % palette.length], f: fills.length ? fills[i % fills.length] : null }));
const s = Math.min(cw / 52, ch / 92) * 0.78;
const ar = lang === 'ar';
---
<svg class="box-art" viewBox="0 0 600 750" role="img" aria-label={ar ? `رسم ${p.name.ar}` : `Drawing of ${p.name.en}`}>
  <defs>
    <pattern id={`pat-${uid}`} width="160" height="160" patternUnits="userSpaceOnUse"><image href="/brand/pattern.svg" width="160" height="160" /></pattern>
  </defs>
  <rect width="600" height="750" fill="#F1E8D8" />
  <ellipse cx="300" cy="640" rx="250" ry="34" fill="#33211A" opacity=".08" />
  {!tray && (
    <g transform="translate(70 70) rotate(-7)">
      <rect width="400" height="300" rx="10" fill="#F7F1E4" stroke="#33211A" stroke-opacity=".12" />
      <rect width="400" height="300" rx="10" fill={`url(#pat-${uid})`} />
      <rect x="28" y="96" width="140" height="108" rx="8" fill="#F7F1E4" />
      <image href="/brand/logo.svg" x="44" y="106" width="108" height="90" />
      <rect x="238" y="0" width="100" height="300" fill="#CF9C0C" />
      <circle cx="288" cy="150" r="44" fill="#F5EFE3" />
      <image href="/brand/logo.svg" x="256" y="124" width="64" height="54" />
      {sleeve === 'ramadan' && <g><circle cx="300" cy="236" r="30" fill="#A93B28" /><path d="M310 222a16 16 0 1 0 0 28a13 13 0 1 1 0-28z" fill="#F5EFE3" /></g>}
      {sleeve === 'eid' && <g><circle cx="300" cy="236" r="30" fill="#33211A" /><text x="300" y="246" text-anchor="middle" font-family="El Messiri, serif" font-weight="700" font-size="24" fill="#CF9C0C">عيد</text></g>}
    </g>
  )}
  <g transform={tray ? 'translate(100 200) rotate(-3)' : 'translate(150 330) rotate(5)'}>
    {tray
      ? <rect width="400" height="310" rx="18" fill="#FFFFFF" fill-opacity=".55" stroke="#9FB3B8" stroke-opacity=".7" stroke-width="3" />
      : <><rect width="400" height="310" rx="12" fill="#E9DFCB" stroke="#33211A" stroke-opacity=".12" /><rect x="20" y="20" width="360" height="270" rx="6" fill="#F3EBDA" /></>}
    {coffees.map((n, i) => (
      <g transform={`translate(${area.x + i * pouchW + 10} ${area.y + 10})`}>
        <rect width={pouchW - 20} height={area.h - 20} rx="10" fill="#FBF7EE" stroke="#33211A" stroke-opacity=".1" />
        <image href="/brand/logo.svg" x={(pouchW - 20) / 2 - 34} y="22" width="68" height="57" />
        <rect x="16" y="110" width={pouchW - 52} height="92" rx="8" fill="#FFFDF8" />
        <rect x="16" y="110" width={pouchW - 52} height="26" rx="8" fill="#E6D2A6" />
        <text x={(pouchW - 20) / 2} y="178" text-anchor="middle" font-family="El Messiri, serif" font-weight="700" font-size="24" fill="#33211A">{n}</text>
      </g>
    ))}
    {cells.map(c => (
      <g>
        {!tray && <rect x={c.x + 3} y={c.y + 3} width={cw - 6} height={ch - 6} rx="10" fill="#5A3A28" />}
        <g transform={`translate(${c.x + cw / 2} ${c.y + ch / 2}) scale(${s})`} set:html={dateSvg(c.c, c.f)} />
        {sealed && <rect x={c.x + 7} y={c.y + 7} width={cw - 14} height={ch - 14} rx="9" fill="#FFFFFF" fill-opacity=".22" stroke="#FFFFFF" stroke-opacity=".7" stroke-width="2" />}
      </g>
    ))}
    {tray && <g transform="translate(250 230)"><rect width="130" height="54" rx="10" fill="#F7F1E4" stroke="#CF9C0C" stroke-width="3" /><text x="65" y="36" text-anchor="middle" font-family="El Messiri, serif" font-weight="700" font-size="22" fill="#33211A">{p.size.ar}</text></g>}
  </g>
</svg>

<style>
  .box-art { width: 100%; height: 100%; display: block; }
</style>
