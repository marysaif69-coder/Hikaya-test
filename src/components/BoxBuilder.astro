---
// One gift box (320 × 240 × 40) for dates only: a card grid gives each date its own cell (D24 or D12), the Tamr red band
// goes across the short side, and the occasion is only our Ø50 sticker. Coffee goes beside the box, in our paper bag
// (packaging brief v12). Drawn to the packaging brief at 2 px per mm.
import type { Lang } from '../data/products';
import { BOXES, DATES, EVERYDAY, RESERVE, priceText } from '../data/products';
import { path } from '../data/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === 'ar';

const INSERTS = [
  { id: 'D24', name: { en: 'D24 · 24 dates', ar: 'D24 · ٢٤ تمرة' }, line: { en: 'Each date in its own cell: Reserve, stuffed or Four Palms.', ar: 'لكل تمرة خانتها: النخبة أو المحشي أو أربع نخلات.' } },
  { id: 'D12', name: { en: 'D12 · 12 large dates', ar: 'D12 · ١٢ تمرة كبيرة' }, line: { en: 'Twelve wider cells, for Medjool and the Reserve box of 12.', ar: 'اثنتا عشرة خانة أوسع، للمجدول ولعلبة النخبة ذات الاثنتي عشرة تمرة.' } },
] as const;
const OCC = [
  { id: 'regular', name: { en: 'Any day', ar: 'كل يوم' } },
  { id: 'ramadan', name: { en: 'Ramadan', ar: 'رمضان' } },
  { id: 'eid', name: { en: 'Eid', ar: 'العيد' } },
] as const;
// Which real product each combination is. Missing combinations fall back to the any-day box.
// A season changes the sleeve, not the product: the link opens the box with that sleeve picked.
const MATCH: Record<string, string> = { D24: 'four-palms', D12: 'reserve-12' };
const products = Object.fromEntries(BOXES.map(b => [b.id, { id: b.id, name: b.name[lang], price: priceText(b.price, lang), href: path(lang, `shop/${b.id}`), contents: b.contents[lang] }]));
// Colours of the varieties we sell (no pairing is shown: that waits for the tasting).
const dc = [...EVERYDAY, ...RESERVE].map(d => DATES[d].c);

// geometry (2 px / mm): inner tray 312 × 232 → 624 × 464
const cups = (cols: number, rows: number, x0: number, y0: number, w: number, h: number) =>
  Array.from({ length: cols * rows }, (_, i) => ({ x: x0 + (i % cols) * w, y: y0 + Math.floor(i / cols) * h, c: dc[Math.floor(i / rows) % 4] }));
// the grid fills the tray (624 × 464): D24 6 × 4 cells, D12 4 × 3; the strips between the cells are drawn as cream walls
const D24 = cups(6, 4, 16, 16, 104, 116);
const D12 = cups(4, 3, 16, 16, 156, 464 / 3);
const walls = (cols: number, rows: number, w: number, h: number) => [
  ...Array.from({ length: cols - 1 }, (_, i) => ({ x: 16 + (i + 1) * w - 2, y: 16, w: 4, h: 464 })),
  ...Array.from({ length: rows - 1 }, (_, i) => ({ x: 16, y: 16 + (i + 1) * h - 2, w: 624, h: 4 })),
];
const sets = { cd: products['guest-box'], two: products['coffee-duo'] };
---
<section class="sec boxsec" aria-labelledby="box-h">
  <div class="wrap box-grid">
    <div class="box-copy">
      <h2 id="box-h" class="h-l">{ar ? 'صندوق واحد، ولكل تمرة مكانها.' : 'One box, a place for every date.'}</h2>
      <p class="lead">{ar ? 'نصنع صندوقاً واحداً لهدايا التمر. في داخله لكل تمرة خانتها، والحزام الأحمر يبقى، والمناسبة ملصق صغير نضعه بأيدينا في كالغاري.' : 'We make one box for every gift of dates. Inside, each date sits in its own cell; the red band stays, and the occasion is a small sticker we put on by hand in Calgary.'}</p>

      <fieldset class="opt">
        <legend>{ar ? 'في الداخل' : 'Inside'}</legend>
        {INSERTS.map((it, i) => (
          <label><input type="radio" name="insert" value={it.id} checked={i === 0} /><span><b>{it.name[lang]}</b><small>{it.line[lang]}</small></span></label>
        ))}
      </fieldset>
      <fieldset class="opt opt-row">
        <legend>{ar ? 'المناسبة' : 'Occasion'}</legend>
        {OCC.map((o, i) => (
          <label data-season={o.id === 'regular' ? undefined : o.id}><input type="radio" name="occ" value={o.id} checked={i === 0} /><span><b>{o.name[lang]}</b></span></label>
        ))}
      </fieldset>

      <p class="sets muted">{ar
        ? <>القهوة تأتي بجانب الصندوق في كيسنا الورقي: <a href={sets.cd.href}>{sets.cd.name}</a> و<a href={sets.two.href}>{sets.two.name}</a>.</>
        : <>Coffee goes beside the box, in our paper bag: <a href={sets.cd.href}>{sets.cd.name}</a> and <a href={sets.two.href}>{sets.two.name}</a>.</>}</p>

      <div class="match" aria-live="polite">
                <a class="match-name" id="matchLink" href={products['four-palms'].href}>{products['four-palms'].name}</a>
        <p class="muted" id="matchLine">{products['four-palms'].contents}</p>
        <p class="price" id="matchPrice">{products['four-palms'].price}</p>
      </div>
    </div>

    <div class="box-art patterned" aria-hidden="true">
      <!-- lid, with sleeve, seal and the occasion sticker -->
      <svg class="lid" viewBox="0 0 640 480">
        <defs>
          <pattern id="lidpat" width="240" height="240" patternUnits="userSpaceOnUse">
            <image href="/brand/pattern.svg" width="240" height="240" />
          </pattern>
        </defs>
        <rect x="0" y="0" width="640" height="480" rx="10" fill="#F7F1E4" />
        <rect x="0" y="0" width="640" height="480" rx="10" fill="url(#lidpat)" />
        <rect x="40" y="150" width="210" height="180" rx="8" fill="#F7F1E4" />
        <image href="/brand/logo.svg" x="70" y="170" width="150" height="126" />
        <rect x="492" y="0" width="100" height="480" fill="#A93B28" />
        <circle cx="542" cy="200" r="76" fill="#F5EFE3" />
        <image href="/brand/logo.svg" x="486" y="156" width="112" height="94" />
        <g class="occ occ-ramadan">
          <circle cx="542" cy="360" r="50" fill="#33211A" stroke="#F5EFE3" stroke-width="4" />
          <path d="M558 337a26 26 0 1 0 0 46a21 21 0 1 1 0-46z" fill="#CF9C0C" />
        </g>
        <g class="occ occ-eid">
          <circle cx="542" cy="360" r="50" fill="#CF9C0C" stroke="#F5EFE3" stroke-width="4" />
          <text x="542" y="375" text-anchor="middle" font-family="El Messiri, serif" font-weight="700" font-size="38" fill="#33211A">عيد</text>
        </g>
      </svg>

      <!-- base, opened: the two grids drawn to the brief -->
      <svg class="base" viewBox="0 0 656 496">
        <rect x="0" y="0" width="656" height="496" rx="12" fill="#E9DFCB" />
        <rect x="16" y="16" width="624" height="464" rx="6" fill="#F3EBDA" />
        <g class="ins ins-D24">
          {D24.map(c => (<g><rect x={c.x + 4} y={c.y + 4} width="96" height="108" rx="14" fill="#5A3A28" /><g transform={`translate(${c.x + 52.0} ${c.y + 58.0}) scale(1.05)`}><path fill={c.c} d="M-2 -42c13 0 22 12 22 40c0 27-9 44-22 44c-12 0-21-15-21-43c0-29 8-41 21-41z" /><path d="M-12 -18q6 3 11 0M-14 4q7 4 14 0M-11 24q6 3 12-1M4 -30q5 2 9-1" stroke="#33211A" stroke-opacity=".28" stroke-width="2" fill="none" stroke-linecap="round" /></g></g>))}
          {walls(6, 4, 104, 116).map(r => <rect x={r.x} y={r.y} width={r.w} height={r.h} fill="#F7F1E4" />)}
        </g>
        <g class="ins ins-D12">
          {D12.map(c => (<g><rect x={c.x + 4} y={c.y + 4} width="148" height="147" rx="14" fill="#5A3A28" /><g transform={`translate(${c.x + 78.0} ${c.y + 77.3}) scale(1.45)`}><path fill={c.c} d="M-2 -42c13 0 22 12 22 40c0 27-9 44-22 44c-12 0-21-15-21-43c0-29 8-41 21-41z" /><path d="M-12 -18q6 3 11 0M-14 4q7 4 14 0M-11 24q6 3 12-1M4 -30q5 2 9-1" stroke="#33211A" stroke-opacity=".28" stroke-width="2" fill="none" stroke-linecap="round" /></g></g>))}
          {walls(4, 3, 156, 464 / 3).map(r => <rect x={r.x} y={r.y} width={r.w} height={r.h} fill="#F7F1E4" />)}
        </g>
      </svg>
    </div>
  </div>
  <script type="application/json" id="boxdata" set:html={JSON.stringify({ MATCH, products })} />
</section>

<style>
  .box-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(32px, 5vw, 80px); align-items: center; }
  @media (max-width: 900px) { .box-grid { grid-template-columns: 1fr; } }
  .box-copy { display: grid; gap: 22px; }
  .opt { border: 0; margin: 0; padding: 0; display: grid; gap: 8px; }
  .opt legend { font-weight: 600; font-size: 15px; margin-bottom: 8px; color: var(--ink-2); }
  .opt label { cursor: pointer; }
  .opt input { position: absolute; opacity: 0; }
  .opt span { display: grid; gap: 2px; padding: 12px 16px; border-radius: 18px; box-shadow: inset 0 0 0 1.5px var(--line); transition: box-shadow .15s, background .15s; }
  .opt small { font-size: 14.5px; color: var(--ink-2); }
  .opt label:hover span { box-shadow: inset 0 0 0 1.5px var(--bunn); }
  .opt input:checked + span { background: var(--sheet); box-shadow: inset 0 0 0 2px var(--bunn); border-bottom-right-radius: 5px; }
  .opt input:focus-visible + span { outline: 2.5px solid var(--tamr); outline-offset: 3px; }
  .opt-row { grid-template-columns: repeat(3, auto); justify-content: start; }
  .opt-row legend { grid-column: 1 / -1; }
  .sets { font-size: 15px; }
  .sets a { color: var(--tamr); }
  .match { border-top: 1px solid var(--line); padding-top: 18px; display: grid; gap: 4px; }
  .match-name { font-family: var(--display); font-size: 32px; font-weight: 700; color: var(--tamr); text-decoration: none; }
  .match-name:hover { text-decoration: underline; }
  .match .price { font-size: 20px; }
  .box-art { position: relative; padding: 26% 6% 8%; border-radius: 44px; border-bottom-left-radius: 8px; }
  .lid { position: absolute; top: 5%; inset-inline-end: 3%; width: 50%; border-radius: 10px; filter: drop-shadow(0 22px 26px rgba(51, 33, 26, .28)); transform: rotate(5deg); z-index: 1; }
  html[dir='rtl'] .lid { transform: rotate(-5deg); }
  .base { width: 88%; border-radius: 12px; filter: drop-shadow(0 18px 24px rgba(51, 33, 26, .18)); }
  .ins, .occ { opacity: 0; transition: opacity .35s var(--ease); }
  .boxsec:not(:has(input[value='D12']:checked)) .ins-D24,
  .boxsec:has(input[value='D12']:checked) .ins-D12,
  .boxsec:has(input[value='ramadan']:checked) .occ-ramadan,
  .boxsec:has(input[value='eid']:checked) .occ-eid { opacity: 1; }
</style>

<script>
  const data = JSON.parse(document.getElementById('boxdata')!.textContent!);
  const sec = document.querySelector('.boxsec')!;
  const link = document.getElementById('matchLink') as HTMLAnchorElement;
  const update = () => {
    const ins = (sec.querySelector('input[name=insert]:checked') as HTMLInputElement).value;
    const occ = (sec.querySelector('input[name=occ]:checked') as HTMLInputElement).value;
    const p = data.products[data.MATCH[ins]];
    link.textContent = p.name; link.href = occ === 'regular' ? p.href : `${p.href}?sleeve=${occ}`;
    document.getElementById('matchLine')!.textContent = p.contents;
    const mp = document.getElementById('matchPrice')!;
    mp.dataset.priceFor = p.id;
    mp.textContent = (window as any).hikayaPrice?.(p.id) ?? p.price;
  };
  sec.addEventListener('change', update);
</script>
