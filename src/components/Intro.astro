---
// Opening: the logo tells its own story, one beat at a time so the eye has one thing to follow:
// بُن, then تمر, then each bubble opens under its word, the names step aside, the seed and dots
// join them, the name, the line. The words بُن (coffee) and تمر (date) appear where their
// bubbles sit in the logo, then each turns into its bubble: Bunn high right, Tamr low left. The
// khalal seed appears where they meet, the dots type, the name and one line follow, then the
// logo settles into the header. Every time the homepage opens: the full story the first time on a
// device, then a short one (no words, quicker); both end with the names beside the bubbles.
// Every time the homepage opens (full the first time, short after), skippable, never under reduced motion. Built from the official logo paths.
import fs from 'node:fs';
const svg = fs.readFileSync('public/brand/logo.svg', 'utf8');
const [tamr, seed, bunn, groove, dots] = [...svg.matchAll(/<path fill="(#[0-9A-F]+)" d="([^"]+)"\/>/g)].map(m => m[2]);
const vb = svg.match(/viewBox="([^"]+)"/)![1];
const g = svg.match(/<g transform="([^"]+)">/)![1];
---
<div class="intro" id="intro" aria-hidden="true">
  <div class="intro-mark">
    <div class="intro-art">
    <p class="iw iw-bunn" lang="ar">بُن<small lang="en" dir="ltr">Bunn</small></p>
    <p class="iw iw-tamr" lang="ar">تمر<small lang="en" dir="ltr">Tamr</small></p>
    <svg class="intro-logo" viewBox={vb}>
      <g transform={g}>
        <path class="i-tamr" fill="#A93B28" d={tamr} />
        <path class="i-bunn" fill="#33211A" d={bunn} />
        <path class="i-seed" fill="#CF9C0C" d={seed} />
        <path class="i-groove" fill="#33211A" d={groove} />
        <path class="i-dots" fill="#F5EFE3" d={dots} />
      </g>
    </svg>
    <p class="nm nm-bunn"><b lang="ar">بُن</b><small lang="en" dir="ltr">Bunn</small></p>
    <p class="nm nm-tamr"><b lang="ar">تمر</b><small lang="en" dir="ltr">Tamr</small></p>
    </div>
    <p class="intro-wm"><b>حكاية</b><small>HIKAYA</small></p>
    <p class="intro-line"><span lang="ar" dir="rtl">حين يلتقي البن بالتمر، تبدأ الحكاية.</span><small lang="en" dir="ltr">When coffee meets the date, the story begins.</small></p>
  </div>
</div>


<style>
  .intro { display: none; }
  :global(html.intro-on) .intro { display: grid; position: fixed; inset: 0; z-index: 200; place-items: center; background: var(--paper); }
  :global(html.intro-on) body { overflow: hidden; }
  .intro-mark { display: grid; justify-items: center; gap: 18px; transform-origin: center; }
  .intro-logo { width: clamp(150px, 22vw, 230px); height: auto; overflow: visible; }
  .intro-wm { display: grid; justify-items: center; line-height: 1; opacity: 0; transform: translateY(8px); }
  .intro-wm b { font-family: var(--display); font-weight: 700; font-size: clamp(40px, 5vw, 56px); }
  .intro-wm small { font: 600 12px/1 var(--body); letter-spacing: .5em; padding-inline-start: .5em; margin-top: 10px; color: var(--ink-2); }

  /* the conversation, frame by frame: the words come first, then each becomes its bubble */
  .intro-art { position: relative; }
  /* The names, held beside each bubble until the logo leaves: Bunn on the right of the dark bubble,
     Tamr on the left of the red one. Big enough to belong to the bubble, smaller than حكاية. */
  .nm { position: absolute; margin: 0; display: grid; gap: 4px; line-height: 1; opacity: 0; white-space: nowrap; }
  .nm b { font-family: var(--display); font-weight: 700; font-size: clamp(32px, 3.2vw, 40px); }
  .nm small { font: 600 11px/1 var(--body); letter-spacing: .16em; text-transform: uppercase; color: var(--ink-2); }
  .nm-bunn { left: calc(100% + 14px); top: 22%; justify-items: start; color: #33211A; }
  .nm-tamr { right: calc(100% + 14px); top: 52%; justify-items: end; color: #A93B28; }
  :global(html.intro-on) .nm-bunn { animation: i-wm .45s cubic-bezier(.23, 1, .32, 1) 1.75s forwards; }
  :global(html.intro-on) .nm-tamr { animation: i-wm .45s cubic-bezier(.23, 1, .32, 1) 1.85s forwards; }
  /* Each word sits where its bubble will be. The bubble blooms under it and the word turns light, so it
     reads inside its own bubble; then it crossfades with the same name beside the bubble, in its own
     colour, which stays. The words stay on top the whole time: nothing hides, nothing is half shown. */
  .iw { position: absolute; margin: 0; display: grid; gap: 4px; line-height: 1; opacity: 0; white-space: nowrap; font-family: var(--display); font-weight: 700; font-size: clamp(38px, 4.2vw, 50px); z-index: 2; }
  .iw small { font: 600 11px/1 var(--body); letter-spacing: .16em; text-transform: uppercase; color: inherit; opacity: .75; }
  .iw-bunn { left: 70%; top: 36%; transform: translate(-50%, -50%); justify-items: center; color: #33211A; }
  .iw-tamr { left: 30%; top: 62%; transform: translate(-50%, -50%); justify-items: center; color: #A93B28; }
  :global(html.intro-on) .iw-bunn { animation: w-in .6s cubic-bezier(.23, 1, .32, 1) .2s forwards, tint .4s ease 1.85s forwards, fade .5s ease 3s forwards; }
  :global(html.intro-on) .iw-tamr { animation: w-in .6s cubic-bezier(.23, 1, .32, 1) 1s forwards, tint .4s ease 2.35s forwards, fade .5s ease 3.1s forwards; }
  @keyframes w-in { from { opacity: 0; filter: blur(4px); } to { opacity: 1; filter: none; } }
  @keyframes tint { from { opacity: 1; } to { opacity: 1; color: #F5EFE3; } }
  @keyframes fade { from { opacity: 1; color: #F5EFE3; transform: translate(-50%, -50%); } to { opacity: 0; color: #F5EFE3; transform: translate(-50%, -50%) scale(.92); } }
  .intro-logo { position: relative; z-index: 1; }
  /* Full version: the side names arrive as the words inside fade, gliding out from the bubble. */
  :global(html.intro-on:not(.intro-short)) .nm-bunn { animation: glide-r .55s cubic-bezier(.23, 1, .32, 1) 3.05s forwards; }
  :global(html.intro-on:not(.intro-short)) .nm-tamr { animation: glide-l .55s cubic-bezier(.23, 1, .32, 1) 3.15s forwards; }
  @keyframes glide-r { from { opacity: 0; transform: translateX(-14px); } to { opacity: 1; transform: none; } }
  @keyframes glide-l { from { opacity: 0; transform: translateX(14px); } to { opacity: 1; transform: none; } }
  .i-bunn, .i-tamr, .i-seed, .i-groove, .i-dots { transform-box: fill-box; transform-origin: center; opacity: 0; }
  :global(html.intro-on) .i-bunn { animation: i-grow .6s cubic-bezier(.23, 1, .32, 1) 1.8s forwards; }
  :global(html.intro-on) .i-tamr { animation: i-grow .6s cubic-bezier(.23, 1, .32, 1) 2.3s forwards; }
  :global(html.intro-on) .i-seed { animation: i-seed .45s cubic-bezier(.23, 1, .32, 1) 3.65s forwards; }
  :global(html.intro-on) .i-groove { animation: i-groove .4s ease-out 3.8s forwards; }
  :global(html.intro-on) .i-dots { animation: i-dots .5s steps(1, end) 3.9s forwards; }
  :global(html.intro-on) .intro-wm { animation: i-wm .5s cubic-bezier(.23, 1, .32, 1) 4.4s forwards; }
  :global(html.intro-on) .intro-line { animation: i-wm .5s cubic-bezier(.23, 1, .32, 1) 4.85s forwards; }
  @keyframes i-grow { from { opacity: 0; transform: scale(.25); } 35% { opacity: 1; } to { opacity: 1; transform: none; } }
  @keyframes i-seed { from { opacity: 0; transform: scale(.7); } to { opacity: 1; transform: none; } }
  @keyframes i-groove { from { opacity: 1; clip-path: inset(0 0 100% 0); } to { opacity: 1; clip-path: inset(0 0 0 0); } }
  @keyframes i-dots { 0% { opacity: 1; clip-path: inset(0 100% 0 0); } 33% { opacity: 1; clip-path: inset(0 66% 0 0); } 66% { opacity: 1; clip-path: inset(0 33% 0 0); } 100% { opacity: 1; clip-path: inset(0 0 0 0); } }
  @keyframes i-wm { to { opacity: 1; transform: none; } }
  /* The short version for return visits: no words, everything sooner. */
  :global(html.intro-on.intro-short) .iw { display: none; }
  :global(html.intro-on.intro-short) .i-bunn { animation-delay: .05s; }
  :global(html.intro-on.intro-short) .i-tamr { animation-delay: .15s; }
  :global(html.intro-on.intro-short) .nm-bunn { animation-delay: .4s; }
  :global(html.intro-on.intro-short) .nm-tamr { animation-delay: .5s; }
  :global(html.intro-on.intro-short) .i-seed { animation-delay: .55s; }
  :global(html.intro-on.intro-short) .i-groove { animation-delay: .7s; }
  :global(html.intro-on.intro-short) .i-dots { animation-delay: .78s; }
  :global(html.intro-on.intro-short) .intro-wm { animation-delay: .9s; }
  :global(html.intro-on.intro-short) .intro-line { animation-delay: 1.05s; }
  .intro-line { display: grid; justify-items: center; gap: 4px; margin: 0; text-align: center; opacity: 0; transform: translateY(8px); padding-inline: 16px; }
  .intro-line span { font-family: var(--display); font-size: clamp(18px, 2vw, 22px); color: var(--bunn); }
  .intro-line small { font-size: 13.5px; color: var(--ink-2); }
  .intro.leaving { background: transparent; transition: background .5s ease .15s; }
  .intro.leaving .intro-wm, .intro.leaving .intro-line, .intro.leaving .iw, .intro.leaving .nm, .intro.leaving .iw { opacity: 0 !important; transition: opacity .2s ease; animation: none; }
</style>

<script>
  const root = document.documentElement;
  const intro = document.getElementById('intro');
  if (intro && root.classList.contains('intro-on')) {
    const mark = intro.querySelector<HTMLElement>('.intro-logo')!;
    let done = false;
    const finish = (instant = false) => {
      if (done) return; done = true;
      try { localStorage.setItem('hikaya-seen', '1'); } catch {}
      const target = document.querySelector<HTMLElement>('.top .lockup img');
      const end = () => { root.classList.remove('intro-on'); intro.remove(); if (target) target.style.opacity = ''; };
      // If anything below fails (no Web Animations, a runtime error), take the intro away at once.
      try {
      if (instant || !target) { intro.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 200, easing: 'ease-out' }).onfinish = end; return; }
      // Fly the logo into the header (FLIP), while the paper lifts to reveal the page.
      const a = mark.getBoundingClientRect(), b = target.getBoundingClientRect();
      const dx = b.left + b.width / 2 - (a.left + a.width / 2), dy = b.top + b.height / 2 - (a.top + a.height / 2);
      const s = b.width / a.width;
      intro.classList.add('leaving');
      target.style.opacity = '0';
      mark.animate([{ transform: 'none' }, { transform: `translate(${dx}px, ${dy}px) scale(${s})` }], { duration: 720, easing: 'cubic-bezier(.77, 0, .175, 1)', fill: 'forwards' })
        .onfinish = () => { target.style.opacity = ''; end(); };
      } catch { end(); }
    };
    const t = setTimeout(() => finish(), root.classList.contains('intro-short') ? 2500 : 6100);
    const skip = () => { clearTimeout(t); finish(true); };
    intro.addEventListener('click', skip);
    addEventListener('keydown', skip, { once: true });
    addEventListener('wheel', skip, { once: true, passive: true });
    addEventListener('touchmove', skip, { once: true, passive: true });
  }
</script>
