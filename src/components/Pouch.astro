---
// The 250 g pouch, drawn from the packaging brief: one printed bag for every coffee,
// the product told only by the 80 × 80 front sticker. Valve upper right, pattern kept off the logo.
import type { Coffee, Lang } from '../data/products';
import { SPICES } from '../data/products';

interface Props { coffee: Coffee; lang: Lang; class?: string; label?: boolean }
const { coffee, lang, class: cls = '', label = true } = Astro.props;
const uid = `p${coffee.id.replace(/[^a-z]/g, '')}${Math.random().toString(36).slice(2, 6)}`;
const BAND: Record<Coffee['fam'], string> = { palm: '#E6D2A6', mountain: '#C69C70', house: '#33211A', husk: '#A93B28' };
const band = BAND[coffee.fam];
const dots = [...coffee.spices, 'cardamom', 'saffron'].slice(0, 3).map(s => SPICES[s as keyof typeof SPICES].c);
const desc = coffee.ingredients[0].replace(/\. Contains.*$/, '').replace(/\.$/, '');
const roast = coffee.roast;
const bubbles = [
  [34, 52, '#A93B28', 0], [226, 120, '#CF9C0C', 1], [30, 168, '#33211A', 1], [232, 206, '#A93B28', 0],
  [26, 300, '#CF9C0C', 0], [236, 330, '#33211A', 1], [42, 402, '#A93B28', 1], [218, 404, '#CF9C0C', 0], [130, 30, '#33211A', 0],
] as const;
---
<svg class={`pouch ${cls}`} viewBox="0 0 260 450" role={label ? 'img' : undefined} aria-hidden={label ? undefined : 'true'} aria-label={label ? `${coffee.name[lang]} · ${coffee.size}` : undefined}>
  <defs>
    <clipPath id={`${uid}c`}><path d="M20 26 H240 L248 418 Q249 432 235 433 H25 Q11 432 12 418 Z" /></clipPath>
    <linearGradient id={`${uid}s`} x1="0" x2="1">
      <stop offset="0" stop-color="#33211A" stop-opacity=".16" />
      <stop offset=".1" stop-color="#33211A" stop-opacity="0" />
      <stop offset=".86" stop-color="#33211A" stop-opacity="0" />
      <stop offset="1" stop-color="#33211A" stop-opacity=".2" />
    </linearGradient>
    <linearGradient id={`${uid}t`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity=".55" />
      <stop offset=".35" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
  </defs>
  <ellipse cx="130" cy="436" rx="124" ry="9" fill="#33211A" opacity=".16" />
  <g clip-path={`url(#${uid}c)`}>
    <rect x="0" y="0" width="260" height="450" fill="#FBF7EE" />
    {bubbles.map(([x, y, c, f]) => (
      <g transform={`translate(${x} ${y})${f ? ' scale(-1 1)' : ''}`}>
        <path fill={c} d="M0 -7a7 7 0 1 1 -4.6 12.3l-3.4 1.7 1-3.6A7 7 0 0 1 0 -7z" />
        <circle cx="-2.6" cy=".2" r=".9" fill="#F5EFE3" /><circle cx="0" cy=".2" r=".9" fill="#F5EFE3" /><circle cx="2.6" cy=".2" r=".9" fill="#F5EFE3" />
      </g>
    ))}
    <rect x="0" y="0" width="260" height="450" fill={`url(#${uid}s)`} />
    <rect x="0" y="0" width="260" height="450" fill={`url(#${uid}t)`} />
    <path d="M60 26 L56 433 M200 26 L204 433" stroke="#33211A" stroke-opacity=".05" stroke-width="2" />
  </g>
  <!-- top seal with crimp -->
  <path d="M18 8 H242 L240 30 H20 Z" fill="#F3ECDD" />
  <path d="M22 14 H238 M22 19 H238 M22 24 H238" stroke="#33211A" stroke-opacity=".08" stroke-width="1" />
  <!-- one-way valve, upper right -->
  <circle cx="214" cy="70" r="8" fill="#F1E9D8" stroke="#33211A" stroke-opacity=".12" />
  <circle cx="214" cy="70" r="2.4" fill="#33211A" opacity=".18" />
  <!-- logo + wordmark, on clear paper -->
  <image href="/brand/logo.svg" x="88" y="58" width="84" height="70" />
  <text x="130" y="170" text-anchor="middle" font-family="El Messiri, serif" font-weight="700" font-size="38" fill="#33211A">حكاية</text>
  <!-- front sticker 80 × 80 -->
  <g transform="translate(43 196)">
    <rect width="174" height="174" rx="10" fill="#FFFDF8" />
    <path d="M0 10 Q0 0 10 0 H164 Q174 0 174 10 V50 H0 Z" fill={band} />
    <g transform="translate(87 25)">
      <path fill="#FFFDF8" d="M0 -15a15 15 0 1 1 -9.8 26.3l-7.4 3.6 2.2-7.7A15 15 0 0 1 0 -15z" />
      {dots.map((c, i) => <circle cx={-6 + i * 6} cy="0.5" r="2.3" fill="none" stroke={c} stroke-width="1.6" />)}
    </g>
    <text x="87" y="86" text-anchor="middle" font-family="El Messiri, serif" font-weight="700" font-size="24" fill="#33211A">{coffee.name.ar}</text>
    <text x="87" y="102" text-anchor="middle" font-family="IBM Plex Sans, sans-serif" font-weight="600" font-size="8.5" letter-spacing="2.6" fill="#33211A">{coffee.name.en.toUpperCase()}</text>
    <text x="87" y="117" text-anchor="middle" font-family="IBM Plex Sans, sans-serif" font-size="6.6" fill="#66503F">{desc}</text>
    <line x1="12" x2="162" y1="127" y2="127" stroke="#DFD1BA" />
    {roast > 0 && (
      <g transform="translate(12 140)">
        <text font-family="IBM Plex Sans, sans-serif" font-weight="600" font-size="6.5" letter-spacing="1.4" fill="#33211A" y="3">ROAST</text>
        {[1, 2, 3, 4, 5].map(i => <rect x={30 + (i - 1) * 13} y="-3" width="11" height="6" rx="1.5" fill={i <= roast ? '#33211A' : 'none'} stroke="#33211A" stroke-width=".9" />)}
      </g>
    )}
    <text x="162" y="160" text-anchor="end" font-family="IBM Plex Sans, sans-serif" font-weight="600" font-size="11" fill="#33211A">{coffee.size}</text>
    <text x="12" y="160" font-family="IBM Plex Sans, sans-serif" font-size="5.6" fill="#66503F">{coffee.ingredients[1].replace(/\. Contient.*$/, '').slice(0, 42)}</text>
  </g>
</svg>

<style>
  .pouch { width: 100%; height: auto; overflow: visible; }
</style>
