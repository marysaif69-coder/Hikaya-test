---
// The front of the 250 g pouch, drawn to match the packaging artwork (mockup_*.png):
// muted bubble print, logo + حكاية | HIKAYA lockup, ring valve upper right, and the 80 × 80 front sticker.
// Coffees with finished artwork show the real file; the rest are drawn in the same layout.
import type { Coffee, Lang } from '../data/products';
import { SPICES } from '../data/products';

interface Props { coffee: Coffee; lang: Lang; class?: string; label?: boolean; side?: 'front' | 'back' }
const { coffee, lang, class: cls = '', label = true, side = 'front' } = Astro.props;
const alt = `${coffee.name[lang]} · ${coffee.size}`;
const uid = `p${coffee.id.replace(/[^a-z]/g, '')}${Math.random().toString(36).slice(2, 6)}`;
const BAND: Record<Coffee['fam'], string> = { palm: '#F3CF7E', mountain: '#8C5B33', house: '#3A2620', husk: '#A93B28' };
const band = BAND[coffee.fam];
const dots = coffee.spices.length ? coffee.spices.slice(0, 3).map(s => SPICES[s].c) : ['#33211A', '#33211A', '#33211A'];
const ringFirst = coffee.spices.length === 0 || coffee.spices.length < 3;
const desc = { palm: ['Gulf-style ground coffee with spices', 'Café moulu à la façon du Golfe, aux épices'], mountain: ['Yemeni-style ground coffee with spices', 'Café moulu à la yéménite, aux épices'], house: ['Levantine-style ground coffee', 'Café moulu à la levantine'], husk: ['Dried coffee cherry husks', 'Écorces de cerises de café séchées'] }[coffee.fam];
// Muted bubble print, staggered like the bag. Mostly pale; a few warm accents.
const PALE = '#E6DCC6', ACC = ['#D4B08C', '#F1B7A0', '#B9A99B'];
const print: [number, number, string, boolean][] = [];
for (let r = 0; r < 17; r++) for (let c = 0; c < 8; c++) {
  const x = c * 31 + (r % 2 ? 15 : 0) + 6, y = r * 28 + 10;
  const k = (r * 7 + c * 3) % 23;
  print.push([x, y, k === 4 ? ACC[0] : k === 11 ? ACC[1] : k === 17 ? ACC[2] : PALE, (r + c) % 2 === 0]);
}
---
{coffee.art ? (
  <img class={`pouch pouch-art ${cls}`} src={side === 'back' ? coffee.art.back : coffee.art.front} alt={label ? alt : ''} width="800" height={side === 'back' ? 1257 : 1590} loading="lazy" decoding="async" />
) : (
<svg class={`pouch ${cls}`} viewBox="0 0 229 455" direction="ltr" role={label ? 'img' : undefined} aria-hidden={label ? undefined : 'true'} aria-label={label ? alt : undefined}>
  <defs>
    <clipPath id={`${uid}c`}><rect x="44" y="196" width="141" height="69" /></clipPath>
    <mask id={`${uid}m`}>
      <rect width="229" height="455" fill="#fff" />
      <rect x="58" y="72" width="113" height="120" rx="20" fill="#000" />
      <rect x="14" y="200" width="200" height="196" rx="14" fill="#000" />
      <circle cx="210" cy="103" r="24" fill="#000" />
    </mask>
  </defs>
  <rect width="229" height="455" fill="#F2EBE1" />
  <g mask={`url(#${uid}m)`}>
    {print.map(([x, y, c, f]) => (
      <path transform={`translate(${x} ${y})${f ? ' scale(-1 1)' : ''}`} fill={c} d="M0 -6.5a6.5 6.5 0 1 1 -4.3 11.4l-2.9 1.6.9-3.3A6.5 6.5 0 0 1 0 -6.5z" />
    ))}
  </g>
  <!-- valve -->
  <circle cx="210" cy="103" r="17" fill="#FFFFFF" stroke="#C9C1B6" stroke-width="1.2" />
  <circle cx="210" cy="103" r="9" fill="none" stroke="#C9C1B6" stroke-width="1" />
  <!-- logo + lockup -->
  <image href="/brand/logo.svg" x="65" y="78" width="99" height="83" />
  <image href="/brand/wordmark.svg" x="70" y="170" width="89" height="16.5" />
  <!-- front sticker -->
  <g transform="translate(20 207)">
    <rect width="180" height="180" rx="9" fill="#FFFDF9" />
    <path d="M0 9 Q0 0 9 0 H171 Q180 0 180 9 V64 H0 Z" fill={band} />
    <g transform="translate(90 32)">
      <path fill="#FFFDF9" d="M1 -16a16 16 0 1 1 -10.5 28.2l-8.5 4 2.6-8.7A16 16 0 0 1 1 -16z" />
      {dots.map((c, i) => <circle cx={-6 + i * 6.5} cy="1" r="2.3" fill={ringFirst && i === 0 ? 'none' : c} stroke={c} stroke-width="1" />)}
    </g>
    <text x="90" y="98" text-anchor="middle" font-family="El Messiri, serif" font-weight="700" font-size="25" fill="#33211A">{coffee.name.ar}</text>
    <text x="90" y="112" text-anchor="middle" font-family="IBM Plex Sans, sans-serif" font-weight="600" font-size="7.2" letter-spacing="2.6" fill="#33211A">{coffee.name.en.toUpperCase()}</text>
    <text x="90" y="125" text-anchor="middle" font-family="IBM Plex Sans, sans-serif" font-size="5.6" fill="#66503F">{desc[0]}</text>
    <text x="90" y="132" text-anchor="middle" font-family="IBM Plex Sans, sans-serif" font-style="italic" font-size="5.6" fill="#66503F">{desc[1]}</text>
    <line x1="12" x2="168" y1="139" y2="139" stroke="#E4D9C8" stroke-width=".7" />
    {coffee.spices.slice(0, 3).map((s, i) => (
      <g transform={`translate(${14 + i * 46} 150)`}><circle r="3.6" fill={SPICES[s].c} /><text x="7" y="2" font-family="IBM Plex Sans, sans-serif" font-weight="600" font-size="5.4" fill="#33211A">{SPICES[s].name.en}</text></g>
    ))}
    {coffee.roast > 0 && (
      <g transform="translate(12 167)">
        <text y="2" font-family="IBM Plex Sans, sans-serif" font-weight="600" font-size="5.2" letter-spacing="1.4" fill="#33211A">ROAST</text>
        {[1, 2, 3, 4].map(i => <rect x={26 + (i - 1) * 13} y="-2.6" width="11" height="5.4" rx="2.7" fill={i <= coffee.roast ? '#33211A' : 'none'} stroke="#33211A" stroke-width=".8" />)}
      </g>
    )}
    <text x="168" y="170" text-anchor="end" font-family="IBM Plex Sans, sans-serif" font-weight="600" font-size="10" fill="#33211A">{coffee.size}</text>
  </g>
</svg>
)}

<style>
  .pouch { direction: ltr; width: 100%; height: auto; display: block; border-radius: 6px; box-shadow: 0 1px 0 rgba(51, 33, 26, .06), 0 24px 34px -22px rgba(51, 33, 26, .5); }
</style>
