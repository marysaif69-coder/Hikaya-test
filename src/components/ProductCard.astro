---
import type { Product, Lang } from '../data/products';
import { FAMILIES, DATES, money } from '../data/products';
import { UI, path } from '../data/i18n';
import Pouch from './Pouch.astro';
interface Props { p: Product; lang: Lang }
const { p, lang } = Astro.props;
const href = path(lang, `shop/${p.id}`);
const sub = p.kind === 'coffee' ? `${FAMILIES[p.fam].name[lang]} · ${p.size}` : `${FAMILIES[p.fam].name[lang]} · ${p.size[lang]}`;
const defaultOpt = p.kind === 'coffee' ? (p.grinds[0] ?? '') : p.chooseDate ? 'khalas' : '';
---
<article class={`pc pc-${p.kind}`}>
  <a href={href} class="pc-media" tabindex="-1" aria-hidden="true">
    {p.kind === 'coffee'
      ? <div class={`pc-pouch ${p.art ? 'has-back' : ''}`}><div class="face"><Pouch coffee={p} lang={lang} label={false} /></div>{p.art && <div class="face back"><img src={p.art.back} alt="" loading="lazy" width="800" height="1257" /></div>}</div>
      : <img src={p.img} alt="" loading="lazy" width="600" height="750" />}
  </a>
  <div class="pc-body">
    <h3><a href={href}>{p.name[lang]}</a>{lang === 'en' && <span lang="ar">{p.name.ar}</span>}</h3>
    <p class="pc-sub">{sub}</p>
    {p.kind === 'coffee' && <p class="pc-taste">{p.taste[lang]}</p>}
    {p.kind === 'coffee' && <p class="pc-with">{UI.withDate[lang]} <b>{DATES[p.date].name[lang]}</b></p>}
    <div class="pc-row">
      <span class="price">{money(p.price, lang)}</span>
      <button class="pc-add" type="button" data-add={p.id} data-opt={defaultOpt} aria-label={`${UI.add[lang]}: ${p.name[lang]}`}>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 4v12M4 10h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <span>{UI.add[lang]}</span>
      </button>
    </div>
  </div>
</article>

<style>
  .pc { display: grid; grid-template-rows: auto 1fr; gap: 14px; }
  .pc-media { display: block; border-radius: 26px; overflow: hidden; background: var(--paper-2); aspect-ratio: 4 / 5; }
  .pc-pouch { height: 100%; display: grid; place-items: center; padding: 8% 20% 8%; position: relative; }
  .pc-pouch .face { width: 100%; transition: opacity .35s ease, transform .5s var(--ease), filter .35s ease; }
  .pc-pouch .back { position: absolute; inset: 8% 14%; display: grid; place-items: center; opacity: 0; transform: translateY(8px) scale(.98); filter: blur(3px); }
  .pc-pouch .back img { width: 100%; height: auto; border-radius: 6px; box-shadow: 0 24px 34px -22px rgba(51, 33, 26, .5); }
  @media (hover: hover) and (pointer: fine) {
    .pc:hover .has-back .face:first-child { opacity: 0; transform: translateY(-6px) scale(.98); filter: blur(3px); }
    .pc:hover .has-back .back { opacity: 1; transform: none; filter: none; }
    .pc:hover .pc-pouch:not(.has-back) .face { transform: translateY(-6px) rotate(-1.2deg); }
  }
  .pc-media > img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease); }
  @media (hover: hover) and (pointer: fine) { .pc:hover .pc-media > img { transform: scale(1.035); } }
  .pc-body { display: grid; gap: 4px; align-content: start; }
  .pc h3 { font-size: 25px; display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 2px 10px; }
  .pc h3 a { text-decoration: none; }
  .pc h3 a:hover { text-decoration: underline; }
  .pc h3 span { font-size: 21px; color: var(--tamr); }
  .pc-sub { font-size: 14.5px; color: var(--ink-2); }
  .pc-taste { font-size: 14px; font-weight: 600; color: var(--bunn); }
  .pc-with { font-size: 14.5px; }
  .pc-with b { color: var(--tamr); font-weight: 600; }
  .pc-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 10px; }
  .pc-row .price { font-size: 18px; }
  .pc-add { display: inline-flex; align-items: center; gap: 6px; border: 0; background: var(--bunn); color: var(--paper); border-radius: 999px; border-bottom-right-radius: 5px; padding: 10px 15px 10px 12px; font-weight: 600; font-size: 14.5px; transition: background .15s, transform .15s var(--ease); }
  .pc-add svg { width: 16px; height: 16px; }
  .pc-add:hover { background: var(--bunn-2); }
  .pc-add:active { transform: scale(.96); }
  .pc-add.done { background: var(--khalal); color: var(--bunn); }
</style>
