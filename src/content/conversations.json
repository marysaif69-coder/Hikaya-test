[
  {"bunn": {"ar": "ضيف جديد في كالغاري.", "en": "A new guest in Calgary."}, "tamr": {"ar": "مكانك محفوظ، والتمرة جاهزة.", "en": "Your seat is kept, the date is ready."}},
  {"bunn": {"ar": "من أين نبدأ؟", "en": "Where do we start?"}, "tamr": {"ar": "من الكيس، ثم كيف تشربها.", "en": "With the bag, then how you take it."}},
  {"bunn": {"ar": "أنا مُرّ اليوم.", "en": "I'm bitter today."}, "tamr": {"ar": "خذ تمرتين إذن.", "en": "Then take two dates."}},
  {"bunn": {"ar": "هيل وزعفران.", "en": "Cardamom and saffron."}, "tamr": {"ar": "وأنا أنتظر الفنجان الأول.", "en": "And I'm waiting for the first cup."}},
  {"bunn": {"ar": "قصيمية: أضف حليبك المبخّر، وأنا أكمل.", "en": "Qassimi: add your evaporated milk, I’ll do the rest."}, "tamr": {"ar": "وأنا بجانب الفنجان.", "en": "And I’m beside the cup."}},
  {"bunn": {"ar": "كنتُ قشراً قبل البُن.", "en": "I was a husk before the bean."}, "tamr": {"ar": "وأنا كنتُ هنا قبلكما.", "en": "And I was here before you both."}},
  {"bunn": {"ar": "كل بيت يصنعني بطريقته.", "en": "Every home makes me its own way."}, "tamr": {"ar": "فتركنا الطريقة لكم.", "en": "So we left the way to you."}},
  {"bunn": {"ar": "علبة لكل بيت.", "en": "A box for every house."}, "tamr": {"ar": "وتمرة لكل جار.", "en": "And a date for every neighbour."}},
  {"bunn": {"ar": "أنا لما بعد المغرب.", "en": "I'm for after sunset."}, "tamr": {"ar": "وأنا أوّل المائدة.", "en": "I'm first on the table."}},
  {"bunn": {"ar": "من نزور أولاً؟", "en": "Who do we visit first?"}, "tamr": {"ar": "الكبار دائماً.", "en": "The elders, always."}},
  {"bunn": {"ar": "السلة فارغة.", "en": "The cart is empty."}, "tamr": {"ar": "ابدأ بفنجان، وأنا أتبعك.", "en": "Start with a cup. I’ll follow."}},
  {"bunn": {"ar": "ثلاثة أسئلة فقط.", "en": "Only three questions."}, "tamr": {"ar": "وأنا أنتظر جوابك.", "en": "And I'll wait for your answer."}}
