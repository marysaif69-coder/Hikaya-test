---
import '../styles/fonts.css';
import '../styles/global.css';
import type { Lang } from '../data/products';
import { PRODUCTS, DATES, GRINDS, COFFEES, kitInside } from '../data/products';
import { UI, dir, other, path } from '../data/i18n';
import AskHikaya from '../components/AskHikaya.astro';
import TeamBar from '../components/TeamBar.astro';

interface Props { alertFor?: string; season?: 'ramadan' | 'eid'; lang: Lang; title: string; description?: string; current?: keyof typeof UI.nav; sleeve?: 'regular' | 'ramadan' | 'eid'; intro?: boolean; jsonld?: object; image?: string }
const { alertFor, season, lang, title, description = UI.footLine[lang], current, sleeve = 'regular', intro = false, jsonld, image = '/media/img/eid-coffee-dates.jpg' } = Astro.props;
// The business, on every page. No street address until it is confirmed.
const org = { '@context': 'https://schema.org', '@type': 'Store', name: 'Hikaya Coffee & Dates', alternateName: 'حكاية', url: new URL(`/${lang}/`, Astro.site).href, logo: new URL('/brand/logo.svg', Astro.site).href, areaServed: { '@type': 'City', name: 'Calgary' }, sameAs: ['https://www.instagram.com/hikaya.yyc/'] };
const alt = other(lang);
const here = Astro.url.pathname;
const altHref = here.replace(/^\/(en|ar)\//, `/${alt}/`);
const nav: [keyof typeof UI.nav, string][] = [['shop', 'shop'], ['ramadan', 'ramadan'], ['eid', 'eid'], ['brew', 'brew'], ['story', 'story'], ['visit', 'visit']];

// Small catalog for the client cart (names, prices, options) — no secrets, all public.
// Kits carry their base bag and packs, and packs the bag they are made for, so the cart can explain itself.
const grindsOf = (id: string) => COFFEES.find(c => c.id === id)?.grinds ?? [];
const catalog = Object.fromEntries(PRODUCTS.map(p => [p.id, {
  n: p.name, price: p.price, kind: p.kind,
  img: p.kind === 'box' ? p.img : p.kind === 'coffee' ? p.art?.front ?? null : null,
  opts: p.kind === 'coffee' || p.kind === 'kit' ? Object.fromEntries(grindsOf(p.kind === 'kit' ? p.base : p.id).map(g => [g, GRINDS[g]])) : p.kind === 'box' && p.chooseDate ? Object.fromEntries(Object.entries(DATES).map(([k, d]) => [k, d.name])) : null,
  ...(p.kind === 'kit' ? { base: p.base, inside: { en: kitInside(p, 'en'), ar: kitInside(p, 'ar') } } : {}),
  ...(p.kind === 'pack' ? { for: p.for } : {}),
  ...(p.kind === 'box' && p.packs?.coffee ? { bases: Object.keys(p.packs.coffee) } : {}),
}]));
const fullTitle = title ? `${title} · ${lang === 'ar' ? 'حكاية' : 'Hikaya'}` : (lang === 'ar' ? 'حكاية · قهوة وتمر في كالغاري' : 'Hikaya · Coffee & dates in Calgary');
---
<!doctype html>
<html lang={lang} dir={dir(lang)}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#F5EFE3" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="canonical" href={new URL(here, Astro.site)} />
  <link rel="alternate" hreflang={lang} href={new URL(here, Astro.site)} />
  <link rel="alternate" hreflang="x-default" href={new URL(here.replace(/^\/(en|ar)\//, '/en/'), Astro.site)} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" hreflang={alt} href={new URL(altHref, Astro.site)} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.site)} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={lang === 'ar' ? 'ar_CA' : 'en_CA'} />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(org)} />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  <link rel="preload" href="/fonts/ElMessiri-700-arabic.woff2" as="font" type="font/woff2" crossorigin />
  <script is:inline>document.documentElement.classList.add('js')</script>
  {intro && <script is:inline>try{if(!matchMedia('(prefers-reduced-motion: reduce)').matches&&!sessionStorage.getItem('hikaya-intro')){document.documentElement.classList.add('intro-on');if(localStorage.getItem('hikaya-seen'))document.documentElement.classList.add('intro-short')}}catch(e){}</script>}
</head>
<body>
<TeamBar />
  <a class="skip" href="#main">{UI.skip[lang]}</a>
  <div class={`sleeve ${sleeve}`} role="region" aria-label={lang === 'ar' ? 'الموسم' : 'Season'}><div class="wrap"><p data-season="ramadan">{UI.season[lang]}</p><p data-season-off="ramadan" hidden>{UI.seasonOff[lang]}</p></div></div>
  <header class="top">
    <div class="wrap">
      <a class="lockup" href={path(lang)} aria-label={lang === 'ar' ? 'حكاية، الصفحة الرئيسية' : 'Hikaya, home'}>
        <img src="/brand/logo.svg" alt="" width="52" height="44" />
        <picture><source media="(max-width: 430px)" srcset="/brand/wordmark-ar.svg" /><img class="wm-img" src="/brand/wordmark.svg" alt="" width="163" height="30" /></picture>
      </a>
      <nav id="nav" aria-label={lang === 'ar' ? 'الرئيسية' : 'Main'}>
        {nav.map(([k, p]) => <a href={path(lang, p)} aria-current={current === k ? 'page' : undefined} data-season={k === 'ramadan' || k === 'eid' ? k : undefined}>{UI.nav[k][lang]}</a>)}
      </nav>
      <div class="acts">
        <a class="langsw" href={altHref} lang={alt} hreflang={alt}>{UI.langName[lang]}</a>
        <a class="acctbtn" href={path(lang, 'account')} aria-label={lang === 'ar' ? 'حسابي' : 'My account'}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8.5" r="3.6" /><path d="M4.8 19.5c1.4-3.3 4-5 7.2-5s5.8 1.7 7.2 5" /></svg></a>
        <a class="cartbtn" href={path(lang, 'cart')} id="cartBtn"><span class="lbl">{UI.cart[lang]}</span><span class="n tnum" id="cartN" aria-live="polite">0</span></a>
        <button class="menubtn" type="button" aria-controls="nav" aria-expanded="false" id="menuBtn">{UI.menu[lang]}</button>
      </div>
    </div>
  </header>

  <main id="main">
    {season ? <>
      <div data-season={season}><slot /></div>
      <section class="wrap offseason" data-season-off={season} hidden>
        <h1 class="h-l">{season === 'ramadan' ? (lang === 'ar' ? 'صناديق رمضان ترتاح حتى الموسم القادم.' : 'The Ramadan boxes are resting until next season.') : (lang === 'ar' ? 'إصدار العيد يعود في العيد القادم.' : 'The Eid edition returns next Eid.')}</h1>
        <p class="lead">{lang === 'ar' ? 'القهوة والتمر معنا طوال السنة.' : 'Our coffee and dates are here all year.'}</p>
        {alertFor && <div data-notify={alertFor}></div>}
        <p><a class="btn primary" href={path(lang, 'shop')}>{lang === 'ar' ? 'إلى المتجر' : 'To the shop'}</a></p>
      </section>
    </> : <slot />}
  </main>

  <footer class="foot">
    <div class="wrap">
      <div class="grid">
        <div class="stack" style="--gap:16px">
          <a class="lockup" href={path(lang)} aria-label="Hikaya"><img src="/brand/logo.svg" alt="" width="52" height="44" /><picture><source media="(max-width: 430px)" srcset="/brand/wordmark-ar.svg" /><img class="wm-img" src="/brand/wordmark.svg" alt="" width="163" height="30" /></picture></a>
          <p class="muted measure">{UI.footLine[lang]}</p>
          <p><a class="ig" href="https://www.instagram.com/hikaya.yyc/" rel="me noopener" target="_blank"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8" /><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8" /><circle cx="17.3" cy="6.7" r="1.2" fill="currentColor" /></svg><span dir="ltr">@hikaya.yyc</span><span class="sr"> · Instagram</span></a></p>
          <p class="open-line"><span lang="ar">{UI.open.ar}</span>{lang === 'en' && <span class="muted"> · {UI.openEn.en}</span>}</p>
        </div>
        <div>
          <h2 class="fh">{UI.nav.shop[lang]}</h2>
          <ul>
            <li><a href={path(lang, 'shop')}>{lang === 'ar' ? 'كل القهوة والتمر' : 'All coffee & dates'}</a></li>
            <li data-season="ramadan"><a href={path(lang, 'ramadan')}>{UI.nav.ramadan[lang]}</a></li>
            <li data-season="eid"><a href={path(lang, 'eid')}>{UI.nav.eid[lang]}</a></li>
            <li><a href={path(lang, 'brew')}>{UI.nav.brew[lang]}</a></li>
            <li><a href={path(lang, 'gift-card')}>{lang === 'ar' ? 'بطاقات الهدايا' : 'Gift cards'}</a></li>
          </ul>
        </div>
        <div>
          <h2 class="fh">{lang === 'ar' ? 'معلومات' : 'Info'}</h2>
          <ul>
            <li><a href={path(lang, 'story')}>{UI.nav.story[lang]}</a></li>
            <li><a href={path(lang, 'visit')}>{UI.nav.visit[lang]}</a></li>
            <li><a href={path(lang, 'visit') + '#questions'}>{lang === 'ar' ? 'أسئلة' : 'Questions'}</a></li>
            <li><a href={path(lang, 'visit') + '#policies'}>{lang === 'ar' ? 'السياسات' : 'Policies'}</a></li>
            <li><a href={path(lang, 'help')}>{lang === 'ar' ? 'المساعدة' : 'Help'}</a></li>
          </ul>
        </div>
        <div>
          <h2 class="fh">{lang === 'ar' ? 'قائمة البريد' : 'The list'}</h2>
          <p class="muted">{UI.listLine[lang]}</p>
          <form class="listform" id="listForm" novalidate>
            <label class="sr" for={`list-${lang}`}>{UI.email[lang]}</label>
            <input id={`list-${lang}`} type="email" name="email" required autocomplete="email" placeholder={UI.email[lang]} />
            <button class="btn primary" type="submit" style="min-height:46px;padding:11px 18px">{UI.join[lang]}</button>
            <label class="consent"><input type="checkbox" name="consent" required /> <span>{lang === 'ar' ? 'أوافق على أن تصلني رسائل حكاية (نحو ثلاث في السنة). أستطيع إلغاء الاشتراك في أي وقت.' : 'I agree to receive Hikaya letters (about three a year). I can unsubscribe at any time.'}</span></label>
            <p class="list-msg" id="listMsg" aria-live="polite"></p>
          </form>
        </div>
      </div>
      <div class="legal">
        <p>© 2026 Hikaya Coffee Ltd. · Calgary, Alberta</p>
        <p>{lang === 'ar' ? 'الأسعار مبدئية حتى الإطلاق.' : 'Prices are drafts until launch.'}</p>
      </div>
    </div>
  </footer>


  <div class="scrim" id="scrim" hidden></div>
  <aside class="drawer" id="drawer" aria-label={UI.cart[lang]} aria-hidden="true" inert>
    <div class="dr-head">
      <h2 class="h-s">{lang === 'ar' ? 'سلتك' : 'Your cart'}</h2>
      <button class="dr-x" type="button" id="drClose" aria-label={UI.close[lang]}><svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></button>
    </div>
    <div class="dr-free"><p id="drFree"></p><span class="dr-bar"><b id="drBar"></b></span></div>
    <ul class="dr-lines" id="drLines"></ul>
    <div class="dr-foot">
      <p class="dr-sub"><span>{lang === 'ar' ? 'المجموع الفرعي' : 'Subtotal'}</span><b class="tnum" id="drSub"></b></p>
      <a class="btn primary" href={path(lang, 'checkout')}>{lang === 'ar' ? 'أكمل الطلب المسبق' : 'Continue to pre-order'}</a>
      <a class="dr-link" href={path(lang, 'cart')}>{lang === 'ar' ? 'عرض السلة' : 'View cart'}</a>
      <p class="dr-note">{lang === 'ar' ? 'لا دفع الآن. نؤكد طلبك بالبريد.' : 'Nothing is paid now. We confirm by email.'}</p>
    </div>
  </aside>

  <AskHikaya lang={lang} />

  <script type="application/json" id="catalog" set:html={JSON.stringify({ lang, cart: path(lang, 'cart'), added: UI.added[lang], add: UI.add[lang], items: catalog })} />
  <script>
    import { initCart } from '../scripts/cart';
    import { applyLive } from '../scripts/live';
    initCart();
    applyLive();
    // Cookie-free visit count: just the page and the site that linked here.
    try { navigator.sendBeacon?.('/api/hit', new Blob([JSON.stringify({ path: location.pathname, ref: document.referrer })], { type: 'application/json' })); } catch { /* not important */ }
    // Mailing list: express consent (CASL), then a confirmation email.
    const lf = document.getElementById('listForm') as HTMLFormElement | null;
    lf?.addEventListener('submit', async e => {
      e.preventDefault();
      const ar = document.documentElement.lang === 'ar';
      const msg = document.getElementById('listMsg')!;
      const email = (lf.elements.namedItem('email') as HTMLInputElement).value.trim();
      const consent = (lf.elements.namedItem('consent') as HTMLInputElement).checked;
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) { msg.textContent = ar ? 'تحقق من البريد.' : 'Check the email.'; return; }
      if (!consent) { msg.textContent = ar ? 'ضع علامة في المربع للموافقة.' : 'Tick the box to agree.'; return; }
      try {
        const r = await fetch('/api/list', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ email, consent, lang: ar ? 'ar' : 'en' }) });
        const d = await r.json();
        if (!r.ok) throw new Error(d.message);
        msg.textContent = d.already ? (ar ? 'أنت على القائمة بالفعل.' : 'You are already on the list.') : (ar ? 'أرسلنا لك رسالة للتأكيد. افتحها واضغط الزر.' : 'We sent you an email to confirm. Open it and click the button.');
        lf.reset();
      } catch (x) { msg.textContent = (x as Error).message || (ar ? 'حدث خطأ.' : 'Something went wrong.'); }
    });
    const btn = document.getElementById('menuBtn');
    const nav = document.getElementById('nav');
    btn?.addEventListener('click', () => {
      const open = nav!.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });
    const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll('.rise').forEach(el => io.observe(el));
  </script>
  <style>
    .acctbtn { width: 42px; height: 42px; border-radius: 50%; display: grid; place-items: center; color: var(--bunn); }
    .acctbtn:hover { background: var(--paper-2); }
    .acctbtn svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; }
    .ig { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; text-decoration: none; }
    .ig:hover { color: var(--tamr); }
    .ig svg { width: 20px; height: 20px; }
    .open-line { font-family: var(--display); font-size: 22px; }
    .open-line .muted { font-family: var(--body); font-size: 15px; }
    .lockup img:not(.wm-img) { width: 52px; height: auto; }
    .offseason { display: grid; gap: 18px; padding-block: clamp(64px, 10vw, 140px); max-width: 760px; }
    :global(.sold-out-tag) { font-size: 13px; font-weight: 600; color: var(--tamr-2); }
    .listform { flex-wrap: wrap; }
    .listform .consent { flex: 1 0 100%; display: flex; gap: 8px; align-items: flex-start; font-size: 13.5px; color: var(--ink-2); line-height: 1.4; }
    .listform .consent input { flex: none; width: 18px; height: 18px; padding: 0; margin: 2px 0 0; border-radius: 4px; accent-color: var(--bunn); }
    .listform .list-msg { flex: 1 0 100%; margin: 0; }
    .list-msg { grid-column: 1 / -1; font-size: 14px; font-weight: 500; }
    :global(.notify-me) { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; width: 100%; }
    :global(.notify-me input) { flex: 1; min-width: 150px; border: 1.5px solid var(--line); border-radius: 999px; padding: 8px 12px; font: inherit; font-size: 14px; background: #fff; }
    :global(.notify-me button) { border: 1.5px solid var(--bunn); background: none; border-radius: 999px; padding: 7px 12px; font: inherit; font-size: 14px; font-weight: 600; cursor: pointer; }
    :global(.notify-me p) { width: 100%; font-size: 13.5px; }
    :global([data-product].is-sold-out .pc-media) { opacity: .55; }
    @media (max-width: 520px) { .top .lockup img:not(.wm-img) { width: 42px; } }
  </style>
</body>
</html>
