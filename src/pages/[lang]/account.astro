---
// Customer account: log in with an email code, see every order placed with that email
// (guest orders included), follow status and pickup/delivery day. A guest can open one order
// from the link in their email without logging in.
import Base from '../../layouts/Base.astro';
import type { Lang } from '../../data/products';
import { path } from '../../data/i18n';

export const getStaticPaths = () => [{ params: { lang: 'en' } }, { params: { lang: 'ar' } }];
const lang = Astro.params.lang as Lang;
const ar = lang === 'ar';
---
<Base lang={lang} title={ar ? 'حسابي' : 'My account'}>
  <section class="wrap acc">
    <div class="acc-head">
      <h1 class="h-l" id="accTitle">{ar ? 'طلباتي' : 'My orders'}</h1>
      <div class="acc-who" id="who" hidden><span id="whoEmail"></span> <button type="button" class="linkish" id="logout">{ar ? 'تسجيل الخروج' : 'Log out'}</button></div>
    </div>
    <div id="loading" class="muted">{ar ? 'جارٍ التحميل…' : 'Loading…'}</div>
    <div id="login" hidden>
      <p class="lead">{ar ? 'ادخل ببريدك الإلكتروني لترى طلباتك ومواعيد الاستلام والتوصيل. لا كلمة مرور: نرسل لك رمزاً.' : 'Log in with your email to see your orders and their pickup or delivery days. No password: we email you a code.'}</p>
      <div id="loginBox" class="login-box"></div>
      <p class="muted small">{ar ? 'طلبت كضيف؟ استخدم البريد نفسه وستجد طلباتك هنا.' : 'Ordered as a guest? Use the same email and your orders will be here.'}</p>
    </div>
    <section id="subs" class="subs" hidden>
      <h2 class="h-m">{ar ? 'طلباتي المنتظمة' : 'My regular orders'}</h2>
      <div id="subList" class="orders"></div>
    </section>
    <div id="orders" class="orders"></div>
    <div id="empty" hidden class="empty">
      <p>{ar ? 'لا طلبات بعد بهذا البريد.' : 'No orders yet with this email.'}</p>
      <a class="btn primary" href={path(lang, 'shop')}>{ar ? 'إلى المتجر' : 'To the shop'}</a>
    </div>
    <p id="guestNote" class="muted small" hidden>{ar ? 'هذا طلب واحد من رابط بريدك. سجّل الدخول لترى كل طلباتك.' : 'This is one order from your email link. Log in to see all your orders.'} <a href={path(lang, 'account')}>{ar ? 'دخول' : 'Log in'}</a></p>
  </section>
</Base>

<style>
  :global(.eta) { background: var(--sheet, #EDE3D0); border-radius: 12px; padding: 10px 14px; font-weight: 600; margin: 8px 0; }
  .acc { padding-block: clamp(40px, 6vw, 80px) clamp(64px, 8vw, 104px); display: grid; gap: 22px; max-width: 920px; }
  .acc-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 10px 20px; }
  .acc-who { font-size: 15px; color: var(--ink-2); }
  .linkish { border: 0; background: none; padding: 0; color: var(--tamr); font-weight: 600; text-decoration: underline; text-underline-offset: .2em; margin-inline-start: 10px; }
  .login-box { max-width: 460px; background: var(--sheet); border-radius: 28px; border-bottom-right-radius: 6px; padding: 22px; }
  .login-box :global(.lg) { display: grid; gap: 14px; }
  .login-box :global(.lg-row) { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .login-box :global(.lg-back) { border: 0; background: none; color: var(--ink-2); text-decoration: underline; }
  .login-box :global(.lg-sent) { font-size: 15px; margin-bottom: 6px; }
  .login-box :global(#lg-c) { font-size: 26px; letter-spacing: .35em; text-align: center; }
  .small { font-size: 14.5px; }
  .orders { display: grid; gap: 18px; }
  .orders :global(.ord) { background: var(--sheet); border-radius: 28px; border-bottom-right-radius: 6px; padding: clamp(18px, 3vw, 28px); display: grid; gap: 14px; box-shadow: inset 0 0 0 1.5px var(--line); }
  .orders :global(.ord.hl) { box-shadow: inset 0 0 0 2px var(--tamr); }
  .orders :global(.ord-top) { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 16px; align-items: baseline; }
  .orders :global(.ref) { font-family: var(--display); font-weight: 700; font-size: 24px; color: var(--tamr); direction: ltr; }
  .orders :global(.when) { font-weight: 600; font-size: 17px; }
  .orders :global(.steps) { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
  .orders :global(.steps li) { font-size: 13px; font-weight: 600; color: var(--ink-2); border-top: 4px solid var(--line); padding-top: 6px; }
  .orders :global(.steps li.on) { border-color: var(--khalal); color: var(--bunn); }
  .orders :global(.steps li.now) { border-color: var(--bunn); color: var(--bunn); }
  .orders :global(.cancelled) { font-weight: 700; color: var(--tamr-2); }
  .orders :global(.its) { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; font-size: 15.5px; }
  .orders :global(.its li) { display: flex; justify-content: space-between; gap: 12px; }
  .orders :global(.its small) { color: var(--ink-2); }
  .orders :global(.tot) { display: flex; justify-content: space-between; font-weight: 700; border-top: 1px solid var(--line); padding-top: 10px; }
  .orders :global(.pay) { font-size: 15px; }
  .orders :global(.pay b) { color: var(--cardamom); }
  .orders :global(.acts) { display: flex; gap: 12px; flex-wrap: wrap; }
  .orders :global(.btn) { min-height: 44px; padding: 10px 18px; font-size: 15px; }
  .empty { display: grid; gap: 14px; justify-items: start; }
  .subs { display: grid; gap: 14px; }
  .orders :global(.mvbox) { display: grid; gap: 10px; background: var(--paper); border-radius: 18px; padding: 14px; }
  .orders :global(.mvbox input:not([type=radio])) { display: block; width: 100%; margin-top: 4px; border: 1.5px solid var(--line); border-radius: 10px; padding: 8px; font: inherit; background: var(--sheet); }
  .orders :global(.mvbox select) { margin-inline-start: 8px; border: 1.5px solid var(--line); border-radius: 10px; padding: 8px; font: inherit; background: var(--sheet); }
  .orders :global(.mvwins) { display: flex; flex-wrap: wrap; gap: 12px; }
  .orders :global(.again) { margin-inline-start: auto; }
  .orders :global(.sub-paused) { color: var(--tamr-2); font-weight: 700; }
</style>

<script>
  import { mountLogin, logout } from '../../scripts/login';
  import { add, catalog, openDrawer } from '../../scripts/cart';
  import { errorText } from '../../scripts/errors';
  const lang = document.documentElement.lang as 'en' | 'ar';
  const ar = lang === 'ar';
  const $ = (id: string) => document.getElementById(id)!;
  const q = new URLSearchParams(location.search);
  const money = (c: number) => { const v = (c / 100).toFixed(c % 100 ? 2 : 0); return ar ? `${v} $` : `$${v}`; };
  const fmtDay = (iso: string) => new Date(iso + 'T12:00:00Z').toLocaleDateString(ar ? 'ar-u-nu-arab' : 'en-CA', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' });
  // Payment state on an order card; "Not paid yet" only for unpaid orders.
  const PST: Record<string, string> = { paid: ar ? 'مدفوع' : 'Paid', 'partly-refunded': ar ? 'استُرد جزء منه' : 'Partly refunded', refunded: ar ? 'استُرد' : 'Refunded' };
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  const STEPS = {
    pickup: [['received', ar ? 'وصل الطلب' : 'Received'], ['confirmed', ar ? 'تأكّد' : 'Confirmed'], ['ready', ar ? 'جاهز للاستلام' : 'Ready for pickup'], ['completed', ar ? 'تم الاستلام' : 'Picked up']],
    delivery: [['received', ar ? 'وصل الطلب' : 'Received'], ['confirmed', ar ? 'تأكّد' : 'Confirmed'], ['out-for-delivery', ar ? 'في الطريق' : 'On its way'], ['completed', ar ? 'تم التوصيل' : 'Delivered']],
  } as const;
  const PAY: Record<string, string> = { 'at-pickup': ar ? 'الدفع عند الاستلام' : 'Pay at pickup or handover', 'e-transfer': 'Interac e-Transfer', card: ar ? 'بطاقة عبر Square' : 'Card through Square' };

  /** "2 stops before yours", in English or Arabic (with Arabic number agreement). */
  function aheadText(n: number) {
    if (ar) return n === 0 ? 'السائق في الطريق إليك الآن، أنت التالي.' : `السائق في الطريق: ${n === 1 ? 'قبلك توقّف واحد' : n === 2 ? 'قبلك توقّفان' : n <= 10 ? `قبلك ${n} توقّفات` : `قبلك ${n} توقّفاً`}.`;
    return n === 0 ? "Your driver is heading to you now. You're next." : `Your driver is on the way: ${n} ${n === 1 ? 'stop' : 'stops'} before yours.`;
  }
  let liveTimer: number | undefined;
  /** While an order is out for delivery, check again every minute. */
  function keepFresh(list: any[], again: () => void) {
    clearTimeout(liveTimer);
    if (list.some(o => o.status === 'out-for-delivery')) liveTimer = window.setTimeout(again, 60000);
  }
  function card(o: any) {
    const steps = STEPS[o.method as 'pickup' | 'delivery'];
    const idx = steps.findIndex(s => s[0] === o.status);
    const where = o.method === 'pickup' ? (ar ? 'استلام · [العنوان]، كالغاري' : 'Pickup · [address], Calgary') : `${ar ? 'توصيل إلى' : 'Delivery to'} ${esc(o.street)}, ${esc(o.postal)}`;
    const its = o.items.map((i: any) => `<li><span>${i.qty} × ${esc(ar ? i.name_ar : i.name_en)}${i.option_en ? `<br><small>${esc(ar ? i.option_ar : i.option_en)}</small>` : ''}</span><span class="tnum">${money(i.unit_cents * i.qty)}</span></li>`).join('');
    const canCancel = o.status === 'received' && o.paymentStatus === 'unpaid' && !o.paid && !q.has('t');
    const rest = o.paid > 0 && o.total > o.paid ? o.total - o.paid : 0;
    const canMove = !q.has('t') && ['received', 'confirmed'].includes(o.status);
    const canAddr = canMove && o.method === 'delivery';
    const canAgain = !q.has('t') && o.items.some((i: any) => catalog().items[i.product_id]);
    return `<article class="ord${q.get('order') === o.ref ? ' hl' : ''}" id="o-${esc(o.ref)}">
      <div class="ord-top"><span class="ref">${esc(o.ref)}</span><span class="when">${fmtDay(o.day)} · <span dir="ltr">${esc(o.window)}</span></span></div>
      <p>${where}</p>
      ${o.status === 'cancelled' ? `<p class="cancelled">${ar ? 'أُلغي هذا الطلب.' : 'This order was cancelled.'}</p>` :
        `<ol class="steps">${steps.map((s, i) => `<li class="${i < idx ? 'on' : i === idx ? 'now' : ''}">${s[1]}</li>`).join('')}</ol>`}
      ${o.stopsBefore != null ? `<p class="eta">${aheadText(o.stopsBefore)}</p>` : ''}
      <ul class="its">${its}${o.delivery ? `<li><span>${ar ? 'التوصيل' : 'Delivery'}</span><span class="tnum">${money(o.delivery)}</span></li>` : ''}${o.discount ? `<li><span>${ar ? 'خصم' : 'Discount'}${o.promo ? ` (${esc(o.promo)})` : ''}</span><span class="tnum">−${money(o.discount)}</span></li>` : ''}</ul>
      ${o.giftCard ? `<p class="its"><span>${ar ? 'بطاقة هدية' : 'Gift card'}: −${money(o.giftCard)}</span></p>` : ''}
      <p class="tot"><span>${ar ? 'الإجمالي' : 'Total'}</span><span class="tnum">${money(o.total)}</span></p>
      ${o.refunded ? `<p class="its"><span>${ar ? 'استُرد' : 'Refunded'}: <span class="tnum">${money(o.refunded)}</span></span></p>` : ''}
      <p class="pay">${o.total === 0 && o.giftCard ? (ar ? 'دُفع ببطاقة هدية' : 'Paid with a gift card') : PAY[o.payment] ?? ''} · ${PST[o.paymentStatus] ? `<b>${PST[o.paymentStatus]}</b>` : rest ? (ar ? `الباقي <span class="tnum">${money(rest)}</span>` : `<span class="tnum">${money(rest)}</span> still to pay`) : (ar ? 'لم يُدفع بعد' : 'Not paid yet')}</p>
      <div class="acts">${o.payUrl && o.status !== 'cancelled' ? `<a class="btn tamr" href="${esc(o.payUrl)}">${rest ? (ar ? 'ادفع الباقي' : 'Pay the rest') : ar ? 'ادفع الآن' : 'Pay now'}</a>` : ''}${canCancel ? `<button class="btn line" type="button" data-cancel="${esc(o.ref)}">${ar ? 'إلغاء الطلب' : 'Cancel order'}</button>` : ''}${canMove ? `<button class="btn line" type="button" data-move="${esc(o.ref)}">${ar ? 'غيّر الموعد' : 'Change day'}</button>` : ''}${canAddr ? `<button class="btn line" type="button" data-addr="${esc(o.ref)}">${ar ? 'غيّر العنوان' : 'Change address'}</button>` : ''}${canAgain ? `<button class="btn primary again" type="button" data-again="${esc(o.ref)}">${ar ? 'اطلبه مرة أخرى' : 'Order again'}</button>` : ''}</div>
    </article>`;
  }

  async function showMine() {
    $('loading').hidden = false;
    const r = await fetch('/api/my/orders');
    $('loading').hidden = true;
    if (r.status === 401) return showLogin();
    const { orders } = await r.json();
    mine = orders;
    $('orders').innerHTML = orders.map(card).join('');
    keepFresh(orders, showMine);
    loadSubs();
    $('empty').hidden = orders.length > 0;
    document.getElementById(`o-${q.get('order')}`)?.scrollIntoView({ block: 'center' });
  }
  function showLogin() {
    $('loading').hidden = true; $('login').hidden = false;
    mountLogin($('loginBox'), lang, user => {
      if (q.get('next') === 'checkout') { location.href = `/${lang}/checkout/`; return; }
      if (user.role === 'admin' && q.get('next') === 'admin') { location.href = '/admin/'; return; }
      $('login').hidden = true; setWho(user.email); showMine();
    });
  }
  let mine: any[] = [];
  // Change day: pick from the days and times that still have room for this order's method.
  async function openMove(ref: string) {
    const o = mine.find(x => x.ref === ref); if (!o) return;
    const art = document.getElementById(`o-${ref}`)!; art.querySelector('.mvbox')?.remove();
    const slots = await fetch('/api/slots').then(r => r.json());
    const days = (slots.days ?? []).filter((d: any) => d.windows.some((w: any) => (o.method === 'delivery' ? w.delivery : w.pickup) > 0));
    const box = document.createElement('div'); box.className = 'mvbox';
    box.innerHTML = `<label>${ar ? 'اليوم الجديد' : 'New day'} <select>${days.map((d: any) => `<option value="${d.date}" ${d.date === o.day ? 'selected' : ''}>${fmtDay(d.date)}</option>`).join('')}</select></label>
      <div class="mvwins">${['11:00–14:00', '14:00–17:00', '17:00–20:00'].map(w => `<label><input type="radio" name="mv-${esc(ref)}" value="${w}" ${w === o.window ? 'checked' : ''} /> <span dir="ltr">${w}</span></label>`).join('')}</div>
      <button class="btn primary" type="button" data-move-go="${esc(ref)}">${ar ? 'غيّر الموعد' : 'Move my order'}</button>`;
    art.querySelector('.acts')!.after(box);
  }
  // Change address: a delivery order's street and postal code, until the day's order deadline.
  function openAddr(ref: string) {
    const o = mine.find(x => x.ref === ref); if (!o) return;
    const art = document.getElementById(`o-${ref}`)!; art.querySelector('.mvbox')?.remove();
    const box = document.createElement('div'); box.className = 'mvbox';
    box.innerHTML = `<label>${ar ? 'الشارع (مع رقم الشقة ورمز الجرس)' : 'Street (with unit and buzz code)'} <input class="ad-street" maxlength="200" value="${esc(o.street ?? '')}" /></label>
      <label>${ar ? 'الرمز البريدي (كالغاري)' : 'Postal code (Calgary)'} <input class="ad-postal" maxlength="12" size="9" value="${esc(o.postal ?? '')}" /></label>
      <button class="btn primary" type="button" data-addr-go="${esc(ref)}">${ar ? 'احفظ العنوان' : 'Save the address'}</button>`;
    art.querySelector('.acts')!.after(box);
  }
  // "Order again": puts everything from that order that is still on sale back in the cart.
  function orderAgain(ref: string) {
    const o = mine.find(x => x.ref === ref);
    if (!o) return;
    let live: any = {};
    try { live = JSON.parse(localStorage.getItem('hikaya-live-v1') || '{}').products ?? {}; } catch { /* no live data yet */ }
    const items = catalog().items;
    let added = 0, missed: string[] = [];
    for (const i of o.items) {
      const ok = items[i.product_id] && (!live[i.product_id] || (live[i.product_id].shown && live[i.product_id].available));
      if (ok) { add(i.product_id, i.option ?? '', i.qty); added++; } else missed.push(ar ? i.name_ar : i.name_en);
    }
    if (missed.length) alert((ar ? 'غير متوفر الآن: ' : 'Not available right now: ') + missed.join('، '));
    if (added) openDrawer();
  }
  const EVERY = (n: number) => ar ? (n === 2 ? 'كل أسبوعين' : 'كل ٤ أسابيع') : `Every ${n} weeks`;
  async function loadSubs() {
    const r = await fetch('/api/my/subscriptions');
    if (!r.ok) return;
    const { subscriptions } = await r.json();
    $('subs').hidden = !subscriptions.length;
    $('subList').innerHTML = subscriptions.map((x: any) => `<article class="ord">
      <div class="ord-top"><span class="when">${EVERY(x.every)} · <span dir="ltr">${esc(x.window)}</span></span>${x.status === 'paused' ? `<span class="sub-paused">${ar ? 'متوقف مؤقتاً' : 'Paused'}</span>` : `<span>${ar ? 'المرة القادمة' : 'Next'}: <b>${fmtDay(x.next)}</b></span>`}</div>
      <ul class="its">${x.lines.map((l: any) => `<li><span>${l.qty} × ${esc(ar ? l.name.ar : l.name.en)}</span></li>`).join('')}</ul>
      <p class="muted small">${ar ? 'نرسل لك تأكيداً قبل كل مرة بأسبوع، بالأسعار الحالية.' : 'We email you a week before each one, at the prices of the day.'}</p>
      <div class="acts">${x.status === 'active' ? `<button class="btn line" type="button" data-sub="skip" data-id="${x.id}">${ar ? 'تخطَّ المرة القادمة' : 'Skip the next one'}</button><button class="btn line" type="button" data-sub="pause" data-id="${x.id}">${ar ? 'إيقاف مؤقت' : 'Pause'}</button>` : `<button class="btn primary" type="button" data-sub="resume" data-id="${x.id}">${ar ? 'استئناف' : 'Resume'}</button>`}<button class="btn line" type="button" data-sub="stop" data-id="${x.id}">${ar ? 'إنهاء' : 'Stop'}</button></div>
    </article>`).join('');
  }
  $('subList').addEventListener('click', async e => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-sub]');
    if (!b) return;
    if (b.dataset.sub === 'stop' && !confirm(ar ? 'إنهاء هذا الطلب المنتظم؟' : 'Stop this regular order?')) return;
    const r = await fetch('/api/my/subscriptions', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id: Number(b.dataset.id), action: b.dataset.sub }) });
    if (!r.ok) alert(errorText(await r.json(), ar)); else loadSubs();
  });
  const setWho = (email: string) => { $('whoEmail').textContent = email; $('who').hidden = false; };

  $('logout').addEventListener('click', async () => { await logout(); location.href = `/${lang}/account/`; });
  $('orders').addEventListener('click', async e => {
    const mv = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-move]');
    if (mv) { openMove(mv.dataset.move!); return; }
    const mvGo = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-move-go]');
    if (mvGo) {
      const box = mvGo.closest<HTMLElement>('.mvbox')!;
      const day = (box.querySelector('select') as HTMLSelectElement).value, win = box.querySelector<HTMLInputElement>('input[type=radio]:checked')?.value;
      if (!day || !win) { alert(ar ? 'اختر يوماً ووقتاً.' : 'Choose a day and a time.'); return; }
      const r = await fetch('/api/my/orders/move', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ ref: mvGo.dataset.moveGo, day, window: win }) });
      const d = await r.json(); if (!r.ok) { alert(errorText(d, ar)); return; }
      alert(ar ? 'تغيّر الموعد. أرسلنا لك بريداً.' : 'Done. We emailed you the new day.'); showMine(); return;
    }
    const ad = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-addr]');
    if (ad) { openAddr(ad.dataset.addr!); return; }
    const adGo = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-addr-go]');
    if (adGo) {
      const box = adGo.closest<HTMLElement>('.mvbox')!;
      const street = box.querySelector<HTMLInputElement>('.ad-street')!.value, postal = box.querySelector<HTMLInputElement>('.ad-postal')!.value;
      const r = await fetch('/api/my/orders/address', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ ref: adGo.dataset.addrGo, street, postal }) });
      const dd = await r.json(); if (!r.ok) { alert(errorText(dd, ar)); return; }
      alert(ar ? 'تغيّر العنوان. أرسلنا لك بريداً.' : 'Done. We emailed you the new address.'); showMine(); return;
    }
    const again = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-again]');
    if (again) { orderAgain(again.dataset.again!); return; }
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-cancel]');
    if (!b || !confirm(ar ? 'هل تريد إلغاء هذا الطلب؟' : 'Cancel this order?')) return;
    const r = await fetch('/api/my/orders/cancel', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ ref: b.dataset.cancel }) });
    const d = await r.json();
    if (!r.ok) alert(errorText(d, ar)); else showMine();
  });

  (async () => {
    // Guest link from an email: one order, no login needed.
    if (q.get('order') && q.get('t')) {
      const r = await fetch(`/api/orders/view?ref=${encodeURIComponent(q.get('order')!)}&t=${encodeURIComponent(q.get('t')!)}`);
      $('loading').hidden = true;
      if (r.ok) {
        const { order } = await r.json();
        $('accTitle').textContent = ar ? 'طلبك' : 'Your order';
        $('orders').innerHTML = card(order);
        keepFresh([order], () => location.reload());
        $('guestNote').hidden = false;
        return;
      }
    }
    const me = await fetch('/api/me').then(r => r.json()).catch(() => ({ user: null }));
    if (!me.user) return showLogin();
    setWho(me.user.email);
    showMine();
  })();
</script>
