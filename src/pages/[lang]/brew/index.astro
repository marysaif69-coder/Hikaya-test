---
// hikayacoffee.ca/brew — the QR code on the back of every pouch lands here. Phone first.
// Same way as the shop: choose the coffee (four cards), then only its guide shows. A slim bar
// stays at the top once the cards scroll away, so switching never means scrolling back up.
import Base from '../../../layouts/Base.astro';
import Pouch from '../../../components/Pouch.astro';
import { BREW } from '../../../data/brew';
import { COFFEES, KITS, packOf, type Lang } from '../../../data/products';
import { path } from '../../../data/i18n';

export const getStaticPaths = () => [{ params: { lang: 'en' } }, { params: { lang: 'ar' } }];
const lang = Astro.params.lang as Lang;
const ar = lang === 'ar';
const L = (en: string, a: string) => (ar ? a : en);
const fmt = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
const FAMS = [
  { f: 'palm', name: { en: 'Gulf coffee', ar: 'القهوة الخليجية' }, bag: 'gulf' },
  { f: 'mountain', name: { en: 'Yemeni coffee', ar: 'القهوة اليمنية' }, bag: 'yemeni' },
  { f: 'house', name: { en: 'Shami coffee', ar: 'القهوة الشامية' }, bag: 'shami' },
  { f: 'husk', name: { en: 'Qishr', ar: 'القشر' }, bag: 'qishr' },
] as const;
// "How do you take it?" on each guide: what goes into the pot for each style.
const takes = (f: string) => {
  const kits = KITS.filter(k => k.fam === f && !k.discovery).map(k => ({
    id: k.id, name: k.name[lang],
    adds: k.parts.map(x => packOf(x.id)!.name[lang]).join(' + ') + (k.id === 'qassimi' ? L(' + your own milk', ' + حليبك') : ''),
  }));
  const own = f === 'mountain' ? COFFEES.filter(c => c.id === 'jubani').map(c => ({ id: c.id, name: c.name[lang], adds: L('Its own bag: brew it like Yemeni qahwa, nothing to add', 'كيس قائم بذاته: حضّره كالقهوة اليمنية، بلا إضافات') })) : [];
  return kits.length ? [...kits, ...own, { id: 'plain', name: L('Nothing added', 'بدون إضافات'), adds: L('Just the coffee', 'القهوة وحدها') }] : [];
};
---
<Base lang={lang} title={ar ? 'طريقة التحضير' : 'How to brew'} current="brew" description={ar ? 'كيف تحضّر قهوة حكاية: الدلّة، الإبريق اليمني، الركوة، والقشر.' : 'How to brew Hikaya coffee: Gulf coffee in the dallah, Yemeni qahwa in the pot, Shami coffee in the rakwa, and qishr.'}>
  <section class="wrap brew-head">
    <h1 class="h-l">{ar ? 'من الكيس إلى الفنجان.' : 'From the bag to the cup.'}</h1>
    <p class="lead">{ar ? 'اختر قهوتك، ثم اتبع الخطوات. كل خطوة لها مؤقّت إن احتجته.' : 'Choose your coffee, then follow the steps. Every timed step has a timer.'}</p>
    <p class="muted small">{ar ? 'الكميات المكتوب عليها [يُحدد لاحقاً] نثبّتها بعد جلسات التذوق هذا الخريف.' : 'Amounts marked [TBD] are set after our tastings this autumn.'}</p>
  </section>

  <section class="wrap picker" aria-label={ar ? 'اختر قهوتك' : 'Choose your coffee'} id="picker">
    <div class="pick-cards" role="tablist">
      {FAMS.map(x => (
        <button type="button" role="tab" class="pick" aria-controls={x.f} aria-selected="false" data-pick={x.f}>
          <span class="pick-bag"><Pouch coffee={COFFEES.find(c => c.id === x.bag)!} lang={lang} label={false} /></span>
          <span class="pick-txt"><b>{x.name[lang]}</b><small>{BREW[x.f].vessel[lang]} · {BREW[x.f].yields[lang]}</small></span>
        </button>
      ))}
    </div>
  </section>

  <!-- The slim switcher: appears once the cards scroll away. -->
  <nav class="switch" id="switch" aria-label={ar ? 'قهوة أخرى' : 'Another coffee'} aria-hidden="true">
    <div class="wrap">{FAMS.map(x => <button type="button" data-pick={x.f} tabindex="-1">{x.name[lang]}</button>)}</div>
  </nav>

  {FAMS.map(x => {
    const b = BREW[x.f];
    const ways = takes(x.f);
    return (
      <section class="guide" id={x.f} role="tabpanel" data-panel={x.f} aria-labelledby={`g-${x.f}`}>
        <div class="wrap guide-grid">
          <header>
            <h2 id={`g-${x.f}`} class="h-m">{b.title[lang]}</h2>
            <dl>
              <div><dt>{ar ? 'الأداة' : 'Vessel'}</dt><dd>{b.vessel[lang]}</dd></div>
              <div><dt>{ar ? 'يكفي' : 'Makes'}</dt><dd>{b.yields[lang]}</dd></div>
            </dl>
            {ways.length > 0 && (
              <fieldset class="takes" data-takes>
                <legend>{ar ? 'كيف تشربها؟' : 'How do you take it?'}</legend>
                <div class="chips">{ways.map((w, i) => <label><input type="radio" name={`take-${x.f}`} value={w.id} checked={i === 0} data-adds={w.adds} /><span>{w.name}</span></label>)}</div>
                <p class="adds"><span class="label">{ar ? 'في الإبريق' : 'In the pot'}</span> <b data-adds-out>{ways[0].adds}</b></p>
              </fieldset>
            )}
            <a class="shop-link" href={path(lang, 'shop') + `#${x.f === 'palm' ? 'gulf' : x.f === 'mountain' ? 'yemen' : x.f === 'house' ? 'shami' : 'qishr'}`}>{ar ? 'إلى المتجر' : 'In the shop'} <span aria-hidden="true">{ar ? '←' : '→'}</span></a>
          </header>
          <div>
            <ol class="steps">
              {b.steps.map((s, n) => (
                <li>
                  <span class="n tnum">{n + 1}</span>
                  <p>{s.t[lang]}</p>
                  {s.secs && <button type="button" class="timer" data-secs={s.secs} aria-label={`${ar ? 'مؤقّت' : 'Timer'} ${fmt(s.secs)}`}><span class="tnum">{fmt(s.secs)}</span></button>}
                </li>
              ))}
            </ol>
            <p class="say tamr serve">{b.serve[lang]}</p>
          </div>
        </div>
      </section>
    );
  })}
</Base>

<style>
  .brew-head { display: grid; gap: 10px; padding-block: clamp(36px, 5vw, 64px) 24px; }
  .brew-head > * { max-width: 760px; }
  .small { font-size: 15px; }
  .picker { padding-bottom: 32px; }
  .pick-cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  @media (max-width: 1100px) { .pick-cards { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .pick-cards { grid-template-columns: 1fr; gap: 8px; } }
  .pick { display: grid; grid-template-columns: 52px 1fr; gap: 14px; align-items: center; text-align: start; border: 0; padding: 12px 16px; border-radius: 22px; background: var(--sheet); box-shadow: inset 0 0 0 1.5px var(--line); color: var(--ink); cursor: pointer; transition: box-shadow .15s, background .15s, transform .15s var(--ease); }
  .pick:hover { box-shadow: inset 0 0 0 1.5px var(--bunn); }
  .pick:active { transform: scale(.98); }
  .pick[aria-selected='true'] { box-shadow: inset 0 0 0 2.5px var(--bunn); background: color-mix(in srgb, var(--khalal) 14%, var(--sheet)); }
  .pick:focus-visible { outline: 2.5px solid var(--tamr); outline-offset: 3px; }
  .pick-bag { width: 52px; }
  .pick-txt { display: grid; gap: 2px; }
  .pick-txt b { font-family: var(--display); font-size: 20px; }
  .pick-txt small { color: var(--ink-2); font-size: 14px; }
  @media (max-width: 560px) { .pick { grid-template-columns: 40px 1fr; padding: 10px 14px; } .pick-bag { width: 40px; } }
  .switch { position: fixed; inset-inline: 0; top: 72px; z-index: 30; background: color-mix(in srgb, var(--paper) 94%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); transform: translateY(-120%); opacity: 0; transition: transform .3s cubic-bezier(.32, .72, 0, 1), opacity .2s; pointer-events: none; }
  .switch.on { transform: none; opacity: 1; pointer-events: auto; }
  @media (max-width: 760px) { .switch { top: 64px; } }
  .switch .wrap { display: flex; gap: 8px; padding-block: 10px; overflow-x: auto; }
  .switch button { flex: none; border: 0; background: none; font: inherit; font-weight: 600; font-size: 14.5px; padding: 8px 14px; border-radius: 999px; box-shadow: inset 0 0 0 1.5px var(--line); color: var(--ink); cursor: pointer; }
  .switch button[aria-selected='true'] { background: var(--bunn); color: var(--paper); box-shadow: none; }
  .guide { padding-block: 40px 64px; background: var(--paper-2); scroll-margin-top: 140px; }
  .guide-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: 24px clamp(28px, 5vw, 72px); }
  .guide-grid header { display: grid; gap: 18px; align-content: start; }
  .serve { font-size: 19px; max-width: 560px; margin-top: 20px; }
  @media (max-width: 820px) { .guide-grid { grid-template-columns: 1fr; } }
  dl { margin: 0; display: grid; gap: 10px; }
  dl div { display: grid; grid-template-columns: 90px 1fr; gap: 8px; }
  dt { font-size: 14px; font-weight: 600; color: var(--ink-2); }
  dd { margin: 0; }
  .takes { border: 0; padding: 0; margin: 0; display: grid; gap: 10px; }
  .takes legend { font-family: var(--display); font-weight: 700; font-size: 19px; margin-bottom: 8px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chips label { position: relative; }
  .chips input { position: absolute; opacity: 0; }
  .chips span { display: inline-block; padding: 8px 14px; border-radius: 999px; box-shadow: inset 0 0 0 1.5px var(--line); font-weight: 600; font-size: 14.5px; cursor: pointer; background: var(--sheet); }
  .chips input:checked + span { background: var(--bunn); color: var(--paper); box-shadow: none; }
  .chips input:focus-visible + span { outline: 2.5px solid var(--tamr); outline-offset: 3px; }
  .adds { margin: 0; padding: 12px 14px; border-radius: 16px; background: var(--sheet); font-size: 15.5px; }
  .adds .label { margin-inline-end: 6px; }
  .shop-link { justify-self: start; color: var(--tamr); font-weight: 600; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .steps li { display: grid; grid-template-columns: 44px 1fr auto; gap: 14px; align-items: center; padding-block: 16px; border-bottom: 1px dashed var(--line); font-size: 18px; }
  .n { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; background: var(--sheet); font-weight: 600; font-size: 15px; }
  .timer { border: 0; background: var(--bunn); color: var(--paper); border-radius: 999px; border-bottom-right-radius: 5px; padding: 9px 14px; font-weight: 600; min-width: 74px; font-size: 15px; }
  .timer.running { background: var(--khalal); color: var(--bunn); }
  .timer.done { background: var(--tamr); color: var(--tamr-ink); }
  @media (max-width: 560px) { .steps li { grid-template-columns: 36px 1fr; } .timer { grid-column: 2; justify-self: start; } }
</style>

<script>
  // One coffee at a time, like the shop. The address keeps it (#mountain), so the QR code on a
  // bag and links from product pages open the right guide. Without JavaScript all guides show.
  const ids = ['palm', 'mountain', 'house', 'husk'];
  const alias: Record<string, string> = { gulf: 'palm', yemen: 'mountain', yemeni: 'mountain', shami: 'house', qishr: 'husk' };
  const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-pick]')];
  function choose(id: string, scroll: boolean) {
    tabs.forEach(t => t.setAttribute('aria-selected', String(t.dataset.pick === id)));
    panels.forEach(p => { p.hidden = p.dataset.panel !== id; });
    history.replaceState(null, '', `#${id}`);
    if (scroll) document.getElementById(id)?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
  }
  tabs.forEach(t => t.addEventListener('click', () => choose(t.dataset.pick!, true)));
  const fromHash = () => { const h = location.hash.slice(1); const id = alias[h] ?? h; if (ids.includes(id)) { choose(id, true); return true; } return false; };
  if (!fromHash()) choose('palm', false);
  addEventListener('hashchange', fromHash);
  // The slim switcher shows once the four cards are out of view.
  const bar = document.getElementById('switch')!;
  new IntersectionObserver(([e]) => { const on = !e.isIntersecting && e.boundingClientRect.top < 0; bar.classList.toggle('on', on); bar.setAttribute('aria-hidden', String(!on)); bar.querySelectorAll('button').forEach(b => b.tabIndex = on ? 0 : -1); }).observe(document.getElementById('picker')!);
  // How do you take it: what goes into the pot.
  document.querySelectorAll<HTMLElement>('[data-takes]').forEach(f => f.addEventListener('change', e => {
    const r = e.target as HTMLInputElement; f.querySelector('[data-adds-out]')!.textContent = r.dataset.adds ?? '';
  }));
  // Timers count down in place.
  const fmt = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
  document.querySelectorAll<HTMLButtonElement>('.timer').forEach(b => {
    let left = 0, h: number | undefined;
    const total = Number(b.dataset.secs);
    const span = b.querySelector('span')!;
    b.addEventListener('click', () => {
      if (h) { clearInterval(h); h = undefined; b.classList.remove('running'); span.textContent = fmt(total); return; }
      left = total; b.classList.remove('done'); b.classList.add('running');
      h = window.setInterval(() => {
        left--; span.textContent = fmt(Math.max(0, left));
        if (left <= 0) { clearInterval(h); h = undefined; b.classList.remove('running'); b.classList.add('done'); navigator.vibrate?.(200); }
      }, 1000);
    });
  });
</script>
