---
// hikayacoffee.ca/brew — the QR code on the back of every pouch lands here. Phone first.
import Base from '../../../layouts/Base.astro';
import Pouch from '../../../components/Pouch.astro';
import { BREW } from '../../../data/brew';
import { COFFEES, FAMILIES, type Lang } from '../../../data/products';
import { path } from '../../../data/i18n';

export const getStaticPaths = () => [{ params: { lang: 'en' } }, { params: { lang: 'ar' } }];
const lang = Astro.params.lang as Lang;
const ar = lang === 'ar';
const fams = ['palm', 'mountain', 'house', 'husk'] as const;
const fmt = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
---
<Base lang={lang} title={ar ? 'طريقة التحضير' : 'How to brew'} current="brew" description={ar ? 'كيف تحضّر قهوة حكاية: الدلّة، الإبريق اليمني، الركوة، والقشر.' : 'How to brew Hikaya coffee: the dallah, the Yemeni pot, the rakweh, and qishr.'}>
  <section class="wrap brew-head">
    <h1 class="h-l">{ar ? 'من الكيس إلى الفنجان.' : 'From the bag to the cup.'}</h1>
    <p class="lead">{ar ? 'اختر عائلة قهوتك. كل خطوة لها مؤقّت إن احتجته.' : 'Pick your coffee’s family. Every timed step has a timer if you need one.'}</p>
    <div class="tabs" role="tablist">
      {fams.map((f, i) => (
        <a role="tab" href={`#${f}`} aria-selected={i === 0 ? 'true' : 'false'} data-tab={f}>
          <span class="tab-bag"><Pouch coffee={COFFEES.find(c => c.fam === f)!} lang={lang} label={false} /></span>
          <span>{FAMILIES[f].name[lang]}</span>
        </a>
      ))}
    </div>
  </section>

  {fams.map((f, i) => {
    const b = BREW[f];
    return (
      <section class="guide" id={f} data-guide={f} aria-labelledby={`g-${f}`}>
        <div class="wrap guide-grid">
          <header>
            <h2 id={`g-${f}`} class="h-m">{b.title[lang]}</h2>
            <dl>
              <div><dt>{ar ? 'الأداة' : 'Vessel'}</dt><dd>{b.vessel[lang]}</dd></div>
              <div><dt>{ar ? 'يكفي' : 'Makes'}</dt><dd>{b.yields[lang]}</dd></div>
              <div><dt>{ar ? 'القهوة' : 'Coffees'}</dt><dd>{COFFEES.filter(c => c.fam === f).map(c => <a href={path(lang, `shop/${c.id}`)}>{c.name[lang]}</a>)}</dd></div>
            </dl>
          </header>
          <ol class="steps">
            {b.steps.map((s, n) => (
              <li>
                <span class="n tnum">{n + 1}</span>
                <p>{s.t[lang]}</p>
                {s.secs && <button type="button" class="timer" data-secs={s.secs} aria-label={`${ar ? 'مؤقّت' : 'Timer'} ${fmt(s.secs)}`}><span class="tnum">{fmt(s.secs)}</span></button>}
              </li>
            ))}
          </ol>
          <p class="say tamr serve">{b.serve[lang]}</p>
        </div>
      </section>
    );
  })}
</Base>

<style>
  .brew-head { display: grid; gap: 16px; padding-block: clamp(36px, 6vw, 72px) 20px; }
  .tabs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-top: 18px; }
  .tabs a { display: grid; justify-items: center; gap: 8px; text-decoration: none; padding: 14px 8px 12px; border-radius: 22px; box-shadow: inset 0 0 0 1.5px var(--line); font-weight: 600; font-size: 15px; text-align: center; }
  .tabs a[aria-selected='true'] { background: var(--bunn); color: var(--paper); box-shadow: none; border-bottom-right-radius: 6px; }
  .tab-bag { width: 44px; }
  .guide { padding-block: clamp(36px, 5vw, 64px); border-top: 1px solid var(--line); scroll-margin-top: 90px; }
  .guide-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: 24px clamp(28px, 5vw, 72px); }
  .guide-grid header { display: grid; gap: 18px; align-content: start; }
  .serve { grid-column: 2; font-size: 19px; max-width: 560px; }
  @media (max-width: 820px) { .guide-grid { grid-template-columns: 1fr; } .serve { grid-column: auto; } }
  dl { margin: 0; display: grid; gap: 10px; }
  dl div { display: grid; grid-template-columns: 90px 1fr; gap: 8px; }
  dt { font-size: 14px; font-weight: 600; color: var(--ink-2); }
  dd { margin: 0; display: flex; flex-wrap: wrap; gap: 4px 12px; }
  dd a { color: var(--tamr); font-weight: 500; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .steps li { display: grid; grid-template-columns: 44px 1fr auto; gap: 14px; align-items: center; padding-block: 16px; border-bottom: 1px dashed var(--line); font-size: 18px; }
  .n { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; background: var(--paper-2); font-weight: 600; font-size: 15px; }
  .timer { border: 0; background: var(--bunn); color: var(--paper); border-radius: 999px; border-bottom-right-radius: 5px; padding: 9px 14px; font-weight: 600; min-width: 74px; font-size: 15px; }
  .timer.running { background: var(--khalal); color: var(--bunn); }
  .timer.done { background: var(--tamr); color: var(--tamr-ink); }
  @media (max-width: 560px) { .tabs { grid-template-columns: repeat(2, 1fr); } .steps li { grid-template-columns: 36px 1fr; } .timer { grid-column: 2; justify-self: start; } }
</style>

<script>
  // Tabs: highlight the family in view; timers count down in place.
  const tabs = document.querySelectorAll<HTMLAnchorElement>('[data-tab]');
  const sel = (id: string) => tabs.forEach(t => t.setAttribute('aria-selected', String(t.dataset.tab === id)));
  const io = new IntersectionObserver(es => es.forEach(e => e.isIntersecting && sel((e.target as HTMLElement).dataset.guide!)), { rootMargin: '-45% 0px -50% 0px' });
  document.querySelectorAll('[data-guide]').forEach(s => io.observe(s));
  const fmt = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
  document.querySelectorAll<HTMLButtonElement>('.timer').forEach(b => {
    let left = 0, h: number | undefined;
    const total = Number(b.dataset.secs);
    const span = b.querySelector('span')!;
    b.addEventListener('click', () => {
      if (h) { clearInterval(h); h = undefined; b.classList.remove('running'); span.textContent = fmt(total); return; }
      left = total; b.classList.remove('done'); b.classList.add('running');
      h = window.setInterval(() => {
        left--; span.textContent = fmt(Math.max(0, left));
        if (left <= 0) { clearInterval(h); h = undefined; b.classList.remove('running'); b.classList.add('done'); navigator.vibrate?.(200); }
      }, 1000);
    });
  });
</script>
