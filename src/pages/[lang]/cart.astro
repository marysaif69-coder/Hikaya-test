---
import Base from '../../layouts/Base.astro';
import Pair from '../../components/Pair.astro';
import type { Lang } from '../../data/products';
import { path } from '../../data/i18n';

export const getStaticPaths = () => [{ params: { lang: 'en' } }, { params: { lang: 'ar' } }];
const lang = Astro.params.lang as Lang;
const ar = lang === 'ar';
---
<Base lang={lang} title={ar ? 'سلتك' : 'Your cart'}>
  <section class="wrap cart">
    <div class="lines-col">
      <h1 class="h-l">{ar ? 'سلتك' : 'Your cart'}</h1>
      <ul class="lines" id="lines" aria-live="polite"></ul>
      <div class="empty" id="empty" hidden>
        <Pair lang={lang} size="m" bunn={{ ar: 'السلة فارغة.', en: 'The cart is empty.' }} tamr={{ ar: 'ابدأ بفنجان، وأنا أتبعك.', en: 'Start with a cup. I’ll follow.' }} />
        <a class="btn primary" href={path(lang, 'shop')}>{ar ? 'إلى المتجر' : 'To the shop'}</a>
      </div>
    </div>
    <aside class="summary" id="summary" hidden>
      <h2 class="h-s">{ar ? 'الملخص' : 'Summary'}</h2>
      <dl class="tnum">
        <div><dt>{ar ? 'المجموع الفرعي' : 'Subtotal'}</dt><dd id="sub"></dd></div>
        <div><dt>{ar ? 'التوصيل' : 'Delivery'}</dt><dd>{ar ? 'يُحدد عند الطلب' : 'Chosen at checkout'}</dd></div>
      </dl>
      <p class="muted small">{ar ? 'استلام مجاني، أو توصيل ٩ $ داخل كالغاري، مجاني فوق ٨٠ $.' : 'Free pickup, or $9 Calgary delivery, free over $80.'}</p>
      <p class="free" id="free"></p>
      <p class="free" id="unpriced" hidden>{ar ? 'في سلتك ما لم يُحدد سعره بعد. الطلب يفتح حين نعلن الأسعار.' : 'Something in your cart has no price yet. Ordering opens when we announce prices.'}</p>
      <a class="btn primary" id="go" href={path(lang, 'checkout')}>{ar ? 'أكمل الطلب المسبق' : 'Continue to pre-order'}</a>
      <p class="muted small">{ar ? 'لا دفع الآن. نؤكد طلبك بالبريد.' : 'Nothing is paid now. We confirm your order by email.'}</p>
    </aside>
  </section>
</Base>

<style>
  .cart { display: grid; grid-template-columns: 1.4fr .6fr; gap: clamp(28px, 5vw, 72px); padding-block: clamp(40px, 6vw, 80px) clamp(64px, 8vw, 104px); align-items: start; }
  @media (max-width: 860px) { .cart { grid-template-columns: 1fr; } }
  .lines-col { display: grid; gap: 26px; }
  .lines { list-style: none; margin: 0; padding: 0; display: grid; }
  .lines :global(li) { display: grid; grid-template-columns: 1fr auto auto; gap: 16px; align-items: center; padding-block: 18px; border-bottom: 1px solid var(--line); }
  .lines :global(li:first-child) { border-top: 1px solid var(--line); }
  .lines :global(.nm) { font-family: var(--display); font-weight: 700; font-size: 22px; }
  .lines :global(.op) { font-size: 14.5px; color: var(--ink-2); }
  .lines :global(.qty) { display: inline-flex; align-items: center; border-radius: 999px; box-shadow: inset 0 0 0 1.5px var(--line); }
  .lines :global(.qty button) { border: 0; background: none; width: 40px; height: 40px; font-size: 19px; border-radius: 50%; }
  .lines :global(.qty button:hover) { background: var(--paper-2); }
  .lines :global(.qty span) { min-width: 24px; text-align: center; font-weight: 600; }
  .lines :global(.lp) { font-weight: 600; min-width: 64px; text-align: end; }
  .empty { display: grid; gap: 24px; max-width: 520px; }
  .empty .btn { justify-self: start; }
  .summary { background: var(--sheet); border-radius: 32px; border-bottom-right-radius: 6px; padding: 26px; display: grid; gap: 14px; position: sticky; top: 100px; }
  dl { margin: 0; display: grid; gap: 8px; }
  dl div { display: flex; justify-content: space-between; gap: 12px; }
  dd { margin: 0; font-weight: 600; }
  .small { font-size: 14px; }
  .free { font-weight: 600; color: var(--tamr); font-size: 15px; }
  .btn.off { opacity: .45; pointer-events: none; }
</style>

<script>
  import { read, setQty, totals, describe, paintAdvice } from '../../scripts/cart';
  const lang = document.documentElement.lang as 'en' | 'ar';
  const $ = (id: string) => document.getElementById(id)!;
  const money = (n: number) => (lang === 'ar' ? `${n} $` : `$${n}`);
  function paint() {
    const lines = read();
    const { sub } = totals(lines);
    $('empty').hidden = lines.length > 0;
    $('summary').hidden = lines.length === 0;
    $('lines').innerHTML = '';
    lines.forEach((l, i) => {
      const d = describe(l, lang);
      const li = document.createElement('li');
      li.innerHTML = `<div><div class="nm"></div><div class="op"></div></div>
        <div class="qty"><button type="button" data-d="-1" aria-label="${lang === 'ar' ? 'أنقص' : 'Less'}">−</button><span class="tnum">${l.qty}</span><button type="button" data-d="1" aria-label="${lang === 'ar' ? 'زد' : 'More'}">+</button></div>
        <div class="lp tnum">${d.priced ? money(d.price * l.qty) : (lang === 'ar' ? 'السعر قريباً' : 'Price coming')}</div>`;
      li.querySelector('.nm')!.textContent = d.name;
      li.querySelector('.op')!.textContent = d.opt;
      li.querySelectorAll<HTMLButtonElement>('[data-d]').forEach(b => b.addEventListener('click', () => { setQty(i, l.qty + Number(b.dataset.d)); paint(); }));
      $('lines').append(li);
    });
    paintAdvice($('lines'), lang, paint);
    $('sub').textContent = money(sub);
    const t = totals(lines);
    $('unpriced').hidden = !t.unpriced;
    ($('go') as HTMLAnchorElement).toggleAttribute('aria-disabled', t.unpriced > 0);
    $('go').classList.toggle('off', t.unpriced > 0);
    $('free').textContent = sub >= 80 ? (lang === 'ar' ? 'التوصيل مجاني لهذا الطلب.' : 'Delivery is free on this order.') : sub > 0 ? (lang === 'ar' ? `أضف ${80 - sub} $ ليصبح التوصيل مجاناً.` : `Add $${80 - sub} for free delivery.`) : '';
  }
  paint();
  document.addEventListener('catalog:live', () => paint());
</script>
