---
// Checkout: places the order through /api/orders (Netlify Function + Netlify Database).
// Guests check out with just an email; logged-in customers have it filled in. Slots are live.
import Base from '../../layouts/Base.astro';
import type { Lang } from '../../data/products';
import { path } from '../../data/i18n';

export const getStaticPaths = () => [{ params: { lang: 'en' } }, { params: { lang: 'ar' } }];
const lang = Astro.params.lang as Lang;
const ar = lang === 'ar';
---
<Base lang={lang} title={ar ? 'الطلب المسبق' : 'Pre-order'}>
  <section class="wrap co">
    <form class="co-form" id="co" novalidate>
      <h1 class="h-l">{ar ? 'الطلب المسبق' : 'Pre-order'}</h1>
      <p class="lead">{ar ? 'نرسل لك تأكيداً بالبريد. ادفع عند الاستلام أو بتحويل Interac، أو بالبطاقة حين يتوفر.' : 'We email you a confirmation. Pay at pickup, by Interac e-Transfer, or by card when it is available.'}</p>
      <div class="acct" id="acct">
        <p id="acctGuest">{ar ? 'لديك حساب؟' : 'Have an account?'} <a href={path(lang, 'account') + '?next=checkout'}>{ar ? 'سجّل الدخول' : 'Log in'}</a> {ar ? 'أو تابع كضيف.' : 'or continue as a guest.'}</p>
        <p id="acctUser" hidden>{ar ? 'مسجّل باسم' : 'Logged in as'} <b id="acctEmail"></b></p>
      </div>
      <noscript><p class="err">{ar ? 'نحتاج JavaScript لإتمام الطلب.' : 'Checkout needs JavaScript turned on.'}</p></noscript>

      <fieldset class="block">
        <legend class="h-s">{ar ? 'أنت' : 'You'}</legend>
        <div class="two">
          <div class="field"><label for="f-name">{ar ? 'الاسم' : 'Name'}</label><input id="f-name" name="name" required autocomplete="name" /><p class="err" hidden></p></div>
          <div class="field"><label for="f-phone">{ar ? 'الهاتف' : 'Phone'}</label><input id="f-phone" name="phone" type="tel" required autocomplete="tel" inputmode="tel" dir="ltr" /><p class="err" hidden></p></div>
        </div>
        <div class="field"><label for="f-email">{ar ? 'البريد الإلكتروني' : 'Email'}</label><input id="f-email" name="email" type="email" required autocomplete="email" dir="ltr" /><p class="hint">{ar ? 'نرسل التأكيد إلى هنا، ويمكنك متابعة طلبك به لاحقاً.' : 'Your confirmation goes here, and you can follow your order with it later.'}</p><p class="err" hidden></p></div>
      </fieldset>

      <fieldset class="block">
        <legend class="h-s">{ar ? 'الاستلام أو التوصيل' : 'Pickup or delivery'}</legend>
        <div class="choice">
          <label><input type="radio" name="method" value="pickup" checked /><span><b>{ar ? 'استلام' : 'Pickup'}</b><small>{ar ? 'مجاناً، [العنوان]، كالغاري' : 'Free, [address], Calgary'}</small></span></label>
          <label><input type="radio" name="method" value="delivery" /><span><b>{ar ? 'توصيل داخل كالغاري' : 'Calgary delivery'}</b><small>{ar ? '٩ $، مجاني فوق ٨٠ $' : '$9, free over $80'}</small></span></label>
        </div>
        <div class="addr" id="addr" hidden>
          <div class="field"><label for="f-street">{ar ? 'العنوان' : 'Street address'}</label><input id="f-street" name="street" autocomplete="street-address" /><p class="err" hidden></p></div>
          <div class="field"><label for="f-postal">{ar ? 'الرمز البريدي' : 'Postal code'}</label><input id="f-postal" name="postal" autocomplete="postal-code" placeholder="T2P 1J9" maxlength="7" dir="ltr" /><p class="hint">{ar ? 'نوصل داخل كالغاري: يبدأ الرمز بـ T1 أو T2 أو T3.' : 'We deliver in Calgary: codes starting T1, T2 or T3.'}</p><p class="err" hidden></p></div>
        </div>
      </fieldset>

      <fieldset class="block">
        <legend class="h-s">{ar ? 'اليوم والوقت' : 'Day and time'}</legend>
        <p class="orderby" id="orderBy" hidden></p>
        <p class="closed" id="closed" hidden>{ar ? 'الطلبات متوقفة مؤقتاً. عد قريباً.' : 'Orders are paused for the moment. Please check back soon.'}</p>
        <div class="field">
          <label for="f-day">{ar ? 'اليوم (الخميس إلى الأحد)' : 'Day (Thursday to Sunday)'}</label>
          <select id="f-day" name="day" required><option value="">{ar ? 'جارٍ التحميل…' : 'Loading days…'}</option></select>
          <p class="err" hidden></p>
        </div>
        <div class="choice row" id="windows">
          {['11:00–14:00', '14:00–17:00', '17:00–20:00'].map((w, i) => <label><input type="radio" name="window" value={w} checked={i === 0} /><span><b class="tnum" dir="ltr">{w}</b><small class="left"></small></span></label>)}
        </div>
      </fieldset>

      <fieldset class="block">
        <legend class="h-s">{ar ? 'الدفع' : 'Paying'}</legend>
        <div class="choice pay">
          <label id="payCard" hidden><input type="radio" name="payment" value="card" /><span><b>{ar ? 'بالبطاقة الآن' : 'Card, now'}</b><small>{ar ? 'صفحة دفع آمنة من Square' : 'Secure payment page by Square'}</small></span></label>
          <label><input type="radio" name="payment" value="at-pickup" checked /><span><b>{ar ? 'عند الاستلام أو التسليم' : 'At pickup or handover'}</b><small>{ar ? 'بطاقة أو نقداً' : 'Card or cash'}</small></span></label>
          <label><input type="radio" name="payment" value="e-transfer" /><span><b>Interac e-Transfer</b><small>{ar ? 'نرسل التفاصيل مع التأكيد' : 'Details come with your confirmation'}</small></span></label>
        </div>
        <div class="field"><label for="f-notes">{ar ? 'ملاحظة (اختياري)' : 'A note (optional)'}</label><textarea id="f-notes" name="notes" rows="3" placeholder={ar ? 'هدية؟ رسالة على البطاقة؟' : 'A gift? A message for the card?'}></textarea></div>
      </fieldset>

      <p class="err form-err" id="formErr" hidden role="alert"></p>
      <button class="btn tamr submit" type="submit"><span>{ar ? 'أرسل الطلب المسبق' : 'Send my pre-order'}</span></button>
    </form>
    <aside class="co-sum">
      <h2 class="h-s">{ar ? 'طلبك' : 'Your order'}</h2>
      <p class="empty-co" id="emptyCo" hidden>{ar ? 'سلتك فارغة، فلا شيء نرسله بعد.' : 'Your cart is empty, so there is nothing to send yet.'} <a class="btn primary" href={path(lang, 'shop')}>{ar ? 'إلى المتجر' : 'To the shop'}</a></p>
      <ul id="sumLines"></ul>
      <dl class="tnum">
        <div><dt>{ar ? 'المجموع الفرعي' : 'Subtotal'}</dt><dd id="sSub"></dd></div>
        <div><dt>{ar ? 'التوصيل' : 'Delivery'}</dt><dd id="sFee"></dd></div>
        <div id="sDiscRow" hidden><dt id="sDiscLabel"></dt><dd id="sDisc"></dd></div>
        <div><dt>{ar ? 'ضريبة السلع (مواد غذائية أساسية)' : 'GST (basic groceries)'}</dt><dd>{ar ? "0 $" : "$0"}</dd></div>
        <div class="tot"><dt>{ar ? 'الإجمالي' : 'Total'}</dt><dd id="sTot"></dd></div>
      </dl>
      <p class="muted small">{ar ? 'الأسعار مبدئية. معاملة الضريبة بانتظار التأكيد.' : 'Prices are drafts. GST treatment pending confirmation.'}</p>
      <form class="promo" id="promoForm" novalidate>
        <label for="f-promo">{ar ? 'رمز خصم' : 'Promo code'}</label>
        <div class="promo-row"><input id="f-promo" autocomplete="off" autocapitalize="characters" dir="ltr" /><button type="submit" class="btn line">{ar ? 'طبّق' : 'Apply'}</button></div>
        <p class="promo-msg" id="promoMsg" aria-live="polite"></p>
      </form>
      <a href={path(lang, 'cart')} class="small">{ar ? 'عدّل السلة' : 'Edit cart'}</a>
    </aside>
  </section>
</Base>

<style>
  .co { display: grid; grid-template-columns: 1.3fr .7fr; gap: clamp(28px, 5vw, 72px); padding-block: clamp(40px, 6vw, 80px) clamp(64px, 8vw, 104px); align-items: start; }
  @media (max-width: 900px) { .co { grid-template-columns: 1fr; } .co-sum { order: -1; position: static !important; } }
  .co-form { display: grid; gap: 28px; }
  .block { border: 0; margin: 0; padding: 0; display: grid; gap: 16px; padding-top: 24px; border-top: 1px solid var(--line); }
  .block legend { padding: 0; margin-bottom: 4px; float: left; width: 100%; }
  .block legend + * { clear: both; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  @media (max-width: 560px) { .two { grid-template-columns: 1fr; } }
  .choice { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .choice.row { grid-template-columns: repeat(3, 1fr); }
  @media (max-width: 560px) { .choice, .choice.row { grid-template-columns: 1fr; } }
  .choice label { cursor: pointer; }
  .choice input { position: absolute; opacity: 0; }
  .choice span { display: grid; gap: 2px; padding: 14px 16px; border-radius: 18px; box-shadow: inset 0 0 0 1.5px var(--line); background: var(--sheet); height: 100%; }
  .choice small { font-size: 14px; color: var(--ink-2); }
  .choice input:checked + span { box-shadow: inset 0 0 0 2px var(--bunn); border-bottom-right-radius: 5px; }
  .choice input:focus-visible + span { outline: 2.5px solid var(--tamr); outline-offset: 3px; }
  .addr { display: grid; grid-template-columns: 1.6fr 1fr; gap: 14px; }
  .addr[hidden] { display: none; }
  @media (max-width: 560px) { .addr { grid-template-columns: 1fr; } }
  .submit { justify-self: start; font-size: 17px; padding-inline: 28px; }
  .form-err { font-size: 15px; }
  .empty-co { font-weight: 600; display: grid; gap: 12px; justify-items: start; }
  .submit:disabled { opacity: .45; cursor: not-allowed; }
  .submit.busy { opacity: .7; pointer-events: none; }
  .acct { background: var(--sheet); border-radius: 16px; padding: 12px 16px; font-size: 15.5px; }
  .acct a { color: var(--tamr); font-weight: 600; }
  .closed { font-weight: 600; color: var(--tamr-2); }
  .choice .left { font-weight: 500; }
  .choice input:disabled + span { opacity: .45; cursor: not-allowed; }
  .choice.pay { grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
  .co-sum { background: var(--sheet); border-radius: 32px; border-bottom-right-radius: 6px; padding: 26px; display: grid; gap: 14px; position: sticky; top: 100px; }
  .co-sum ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .co-sum :global(li) { display: flex; justify-content: space-between; gap: 12px; font-size: 15.5px; }
  .co-sum :global(li small) { display: block; color: var(--ink-2); font-size: 13.5px; }
  dl { margin: 0; display: grid; gap: 8px; border-top: 1px solid var(--line); padding-top: 12px; }
  dl div { display: flex; justify-content: space-between; gap: 12px; }
  dd { margin: 0; font-weight: 600; }
  .tot { font-size: 20px; border-top: 1px solid var(--line); padding-top: 8px; }
  .small { font-size: 14px; }
  .orderby { font-weight: 600; background: color-mix(in srgb, var(--khalal) 22%, transparent); border-radius: 14px; padding: 10px 14px; }
  .promo { display: grid; gap: 6px; border-top: 1px solid var(--line); padding-top: 12px; }
  .promo label { font-size: 14px; font-weight: 600; }
  .promo-row { display: flex; gap: 8px; }
  .promo-row input { flex: 1; min-width: 0; border: 1.5px solid var(--line); border-radius: 12px; padding: 9px 12px; background: #fff; text-transform: uppercase; }
  .promo-row .btn { min-height: 42px; padding: 8px 16px; font-size: 15px; }
  .promo-msg { font-size: 14px; }
  .promo-msg.bad { color: var(--tamr-2); font-weight: 500; }
</style>

<script>
  import { read, totals, describe, clear } from '../../scripts/cart';
  const lang = document.documentElement.lang as 'en' | 'ar';
  const ar = lang === 'ar';
  const money = (n: number) => { const v = Number.isInteger(n) ? String(n) : n.toFixed(2); return ar ? `${v} $` : `$${v}`; };
  const form = document.getElementById('co') as HTMLFormElement;
  const $ = (id: string) => document.getElementById(id)!;
  const val = (n: string) => (form.elements.namedItem(n) as RadioNodeList | HTMLInputElement).value;
  const delivery = () => val('method') === 'delivery';
  type Day = { date: string; windows: { window: string; pickup: number; delivery: number }[] };
  let days: Day[] = [];
  let open = true;
  type Promo = { code: string; discount: number; freeDelivery: boolean; label: { en: string; ar: string } };
  let promo: Promo | null = null;

  function paint() {
    const lines = read();
    const t = totals(lines, delivery());
    $('sumLines').innerHTML = '';
    lines.forEach(l => {
      const d = describe(l, lang);
      const li = document.createElement('li');
      const left = document.createElement('span');
      left.textContent = `${l.qty} × ${d.name}`;
      if (d.opt) { const s = document.createElement('small'); s.textContent = d.opt; left.append(s); }
      const right = document.createElement('span'); right.className = 'tnum'; right.textContent = money(d.price * l.qty);
      li.append(left, right); $('sumLines').append(li);
    });
    const fee = promo?.freeDelivery ? 0 : t.fee;
    const disc = Math.min(promo ? promo.discount / 100 : 0, t.sub);
    $('sSub').textContent = money(t.sub);
    $('sFee').textContent = delivery() ? (fee ? money(fee) : (ar ? 'مجاناً' : 'Free')) : (ar ? 'استلام · مجاناً' : 'Pickup · free');
    $('sDiscRow').hidden = !promo;
    if (promo) { $('sDiscLabel').textContent = `${promo.code} · ${promo.label[lang]}`; $('sDisc').textContent = disc ? `−${money(+disc.toFixed(2))}` : '✓'; }
    $('sTot').textContent = money(+(t.sub - disc + fee).toFixed(2));
    $('addr').hidden = !delivery();
    $('emptyCo').hidden = lines.length > 0;
    paintWindows();
    form.querySelector<HTMLButtonElement>('.submit')!.disabled = lines.length === 0 || !open;
    return { lines, t };
  }

  // Live slots: how many places are left in each window for pickup or delivery.
  const fmtDay = (iso: string) => new Date(iso + 'T12:00:00Z').toLocaleDateString(ar ? 'ar-u-nu-arab' : 'en-CA', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' });
  function paintDays() {
    const sel = $('f-day') as HTMLSelectElement;
    const keep = sel.value;
    sel.innerHTML = `<option value="">${ar ? 'اختر يوماً' : 'Choose a day'}</option>` + days.map(d => {
      const left = d.windows.reduce((s, w) => s + (delivery() ? w.delivery : w.pickup), 0);
      return `<option value="${d.date}" ${left ? '' : 'disabled'}>${fmtDay(d.date)}${left ? '' : (ar ? ' · ممتلئ' : ' · full')}</option>`;
    }).join('');
    if (keep) sel.value = keep;
  }
  function paintWindows() {
    const day = days.find(d => d.date === ($('f-day') as HTMLSelectElement).value);
    $('windows').querySelectorAll<HTMLInputElement>('input').forEach(inp => {
      const w = day?.windows.find(x => x.window === inp.value);
      const left = w ? (delivery() ? w.delivery : w.pickup) : null;
      inp.disabled = left === 0;
      const small = inp.parentElement!.querySelector('.left')!;
      small.textContent = left === null ? '' : left === 0 ? (ar ? 'ممتلئ' : 'Full') : left <= 3 ? (ar ? `بقي ${left}` : `${left} left`) : '';
      if (inp.disabled && inp.checked) { inp.checked = false; $('windows').querySelector<HTMLInputElement>('input:not(:disabled)')?.click(); }
    });
  }

  async function load() {
    try {
      const [slots, cfg, me] = await Promise.all([fetch('/api/slots').then(r => r.json()), fetch('/api/config').then(r => r.json()), fetch('/api/me').then(r => r.json())]);
      days = slots.days ?? []; open = slots.open !== false;
      if (slots.next) {
        const d = (iso: string, o: Intl.DateTimeFormatOptions) => new Date(iso + 'T12:00:00Z').toLocaleDateString(ar ? 'ar-u-nu-arab' : 'en-CA', { ...o, timeZone: 'UTC' });
        const h = slots.next.orderBy.hour, hh = ar ? `${h > 12 ? h - 12 : h} ${h >= 12 ? 'مساءً' : 'صباحاً'}` : `${h > 12 ? h - 12 : h} ${h >= 12 ? 'pm' : 'am'}`;
        const by = `${d(slots.next.orderBy.date, { weekday: 'long', day: 'numeric', month: 'long' })}, ${hh}`;
        const range = slots.next.from === slots.next.to ? d(slots.next.from, { weekday: 'long', day: 'numeric', month: 'long' }) : `${d(slots.next.from, { weekday: 'long', day: 'numeric' })} – ${d(slots.next.to, { weekday: 'long', day: 'numeric', month: 'long' })}`;
        $('orderBy').textContent = ar ? `اطلب قبل ${by} ليصلك ${range}.` : `Order by ${by} to get it ${range}.`;
        $('orderBy').hidden = false;
      }
      $('closed').hidden = open;
      $('payCard').hidden = !cfg.card;
      if (me.user) {
        const em = $('f-email') as HTMLInputElement;
        em.value = me.user.email; em.readOnly = true;
        $('acctEmail').textContent = me.user.email; $('acctUser').hidden = false; $('acctGuest').hidden = true;
      }
    } catch {
      $('formErr').textContent = ar ? 'تعذّر تحميل المواعيد. أعد تحميل الصفحة.' : 'We could not load the days. Refresh the page.'; $('formErr').hidden = false;
    }
    paintDays(); paint();
  }
  document.addEventListener('catalog:live', () => paint());
  const cartLines = () => read().map(l => ({ id: l.id, opt: l.opt, qty: l.qty }));
  async function applyPromo(code: string, quiet = false) {
    const msg = $('promoMsg');
    if (!code) { promo = null; msg.textContent = ''; paint(); return; }
    try {
      const r = await fetch('/api/promo', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ code, lines: cartLines(), email: val('email') }) });
      const d = await r.json();
      if (!r.ok) throw new Error(d.message);
      promo = d; msg.className = 'promo-msg'; msg.textContent = ar ? `طُبّق: ${d.label.ar}` : `Applied: ${d.label.en}`;
    } catch (e) {
      promo = null; if (!quiet) { msg.className = 'promo-msg bad'; msg.textContent = (e as Error).message || (ar ? 'تعذّر تطبيق الرمز.' : 'That code could not be applied.'); }
    }
    paint();
  }
  $('promoForm').addEventListener('submit', e => { e.preventDefault(); applyPromo(($('f-promo') as HTMLInputElement).value.trim()); });
  form.addEventListener('change', e => { if ((e.target as HTMLInputElement).name === 'method') paintDays(); paint(); });
  load();

  const MSG: Record<string, string> = {
    required: ar ? 'نحتاج هذا لنؤكد طلبك.' : 'We need this to confirm your order.',
    email: ar ? 'تحقق من البريد، مثل name@example.com' : 'Check the email, like name@example.com',
    phone: ar ? 'اكتب رقم هاتف من ١٠ أرقام.' : 'Enter a 10-digit phone number.',
    postal: ar ? 'نوصل داخل كالغاري فقط: يبدأ الرمز بـ T1 أو T2 أو T3. اختر الاستلام إن كنت خارجها.' : 'We only deliver in Calgary: codes start T1, T2 or T3. Choose pickup if you are outside it.',
  };
  const FIELD: Record<string, string> = { name: 'f-name', phone: 'f-phone', email: 'f-email', street: 'f-street', postal: 'f-postal' };
  const setErr = (el: HTMLElement, msg: string) => {
    const e = el.closest('.field')?.querySelector<HTMLElement>('.err');
    el.setAttribute('aria-invalid', msg ? 'true' : 'false');
    if (e) { e.textContent = msg; e.hidden = !msg; }
  };

  form.addEventListener('submit', async ev => {
    ev.preventDefault();
    const { lines } = paint();
    form.querySelectorAll<HTMLElement>('[aria-invalid]').forEach(el => setErr(el, ''));
    const fe = $('formErr'); fe.hidden = true;
    if (!($('f-day') as HTMLSelectElement).value) { setErr($('f-day'), ar ? 'اختر يوماً.' : 'Choose a day.'); $('f-day').focus(); return; }
    const btn = form.querySelector<HTMLButtonElement>('.submit')!;
    btn.classList.add('busy');
    try {
      const res = await fetch('/api/orders', {
        method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          lang, name: val('name'), phone: val('phone'), email: val('email'), method: val('method'), street: val('street'), postal: val('postal'),
          day: val('day'), window: val('window'), payment: val('payment'), notes: val('notes'),
          lines: lines.map(l => ({ id: l.id, opt: l.opt, qty: l.qty })), promo: promo?.code ?? '',
        }),
      });
      const data = await res.json();
      if (!res.ok) {
        if (data.fields) {
          for (const [k, v] of Object.entries(data.fields)) if (FIELD[k]) setErr($(FIELD[k]), MSG[v as string] ?? MSG.required);
          form.querySelector<HTMLElement>('[aria-invalid=true]')?.focus();
        }
        if (data.error === 'promo') { promo = null; $('promoMsg').className = 'promo-msg bad'; $('promoMsg').textContent = data.message; paint(); }
        if (data.error === 'slot-full' || data.error === 'too-soon') { const s = await fetch('/api/slots').then(r => r.json()); days = s.days; paintDays(); paint(); }
        fe.textContent = data.message ?? (ar ? 'تعذّر إرسال الطلب.' : 'We could not send your order.'); fe.hidden = false;
        return;
      }
      clear();
      if (data.payUrl) { location.href = data.payUrl; return; }
      location.href = `/${lang}/thanks/?order=${encodeURIComponent(data.ref)}&t=${encodeURIComponent(data.token)}`;
    } catch {
      fe.textContent = ar ? 'انقطع الاتصال. حاول مرة أخرى.' : 'The connection dropped. Please try again.'; fe.hidden = false;
    } finally { btn.classList.remove('busy'); }
  });
</script>
