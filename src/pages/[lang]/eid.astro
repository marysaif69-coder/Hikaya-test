---
import Base from '../../layouts/Base.astro';
import Pair from '../../components/Pair.astro';
import ProductCard from '../../components/ProductCard.astro';
import SeasonLead from '../../components/SeasonLead.astro';
import { BOXES, type Lang } from '../../data/products';
import { path } from '../../data/i18n';

export const getStaticPaths = () => [{ params: { lang: 'en' } }, { params: { lang: 'ar' } }];
const lang = Astro.params.lang as Lang;
const ar = lang === 'ar';
// The same gift boxes as all year, with the Eid sticker chosen. Eid Hosting (the Reserve box of 24,
// Mixed) and the visit gift (Two Coffees) lead; the names are only this page's headlines.
const box = (id: string) => BOXES.find(b => b.id === id)!;
// Coffee & Dates (half dates, half coffee) is the box in the Eid film, so it leads the list.
const eid = ['guest-box', 'stuffed-12', 'stuffed-24'].map(box);
---
<Base season="eid" lang={lang} title={ar ? 'العيد' : 'Eid'} current="eid" sleeve="eid" description={ar ? 'إصدار العيد من حكاية: قهوة وتمر للزيارات، في كالغاري.' : 'The Hikaya Eid edition: coffee and dates for the visits, in Calgary.'}>
  <section class="e-hero">
    <div class="wrap e-grid">
      <div class="e-copy">
        <h1 class="h-xl">{ar ? 'عيدكم مبارك' : <><span lang="ar">عيدكم مبارك</span><span class="en">Eid Mubarak</span></>}</h1>
        <p class="lead">{ar ? 'العيد زيارات قبل أن يكون هدايا. علبنا بحزامها الأحمر وملصق العيد، لأول بيت تطرقون بابه.' : 'Eid is about visiting before it is about gifts. Our boxes in their red band with the Eid sticker, for the first door you knock on.'}</p>
        <div class="cta"><a class="btn primary" href="#eid-boxes">{ar ? 'صناديق العيد' : 'The Eid boxes'}</a></div>
      </div>
      <figure class="e-film">
        <video class="e-vid" muted playsinline preload="metadata" poster="/media/vid/eid.webp" width="540" height="960" aria-label={ar ? 'فيلم زيارة العيد' : 'The Eid visit film'}><source src="/media/vid/eid.mp4" type="video/mp4" /></video>
        <button class="snd" type="button" aria-pressed="false" data-on={ar ? 'كتم الصوت' : 'Mute'} data-off={ar ? 'شغّل الصوت' : 'Sound on'}>
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 8h3l4-3v10l-4-3H3z" fill="currentColor" /><path class="w" d="M13 7.5a3.5 3.5 0 0 1 0 5M15 5.5a6.5 6.5 0 0 1 0 9" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" /><path class="m" d="M13 8l4 4M17 8l-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
          <span>{ar ? 'شغّل الصوت' : 'Sound on'}</span>
        </button>
      </figure>
    </div>
  </section>

  <section class="sec visits" aria-labelledby="v-h">
    <div class="wrap v-grid">
      <h2 id="v-h" class="h-l">{ar ? 'ترتيب الزيارات' : 'The order of visits'}</h2>
      <div class="v-pairs">
        <Pair lang={lang} size="l" bunn={{ ar: 'من نزور أولاً؟', en: 'Who do we visit first?' }} tamr={{ ar: 'الكبار دائماً.', en: 'The elders, always.' }} />
        <Pair lang={lang} size="l" bunn={{ ar: 'وماذا نحمل؟', en: 'And what do we carry?' }} tamr={{ ar: 'قهوة وتمر.', en: 'Coffee and dates.' }} />
        <Pair lang={lang} size="l" bunn={{ ar: 'والصغار؟', en: 'And the little ones?' }} tamr={{ ar: 'لهم تمرة.', en: 'A date for them.' }} />
      </div>
    </div>
  </section>

  <section class="sec" id="eid-boxes" aria-labelledby="eb-h">
    <div class="wrap">
      <h2 id="eb-h" class="h-l">{ar ? 'إصدار العيد' : 'The Eid edition'}</h2>
      <p class="lead" style="margin-top:12px">{ar ? 'علب الهدايا نفسها، مع ملصق العيد. بلا معمول: نترك المعمول لبيوتكم.' : 'Our gift boxes, with the Eid sticker. No maamoul: we leave that to your kitchens.'}</p>
      <p class="order-by" id="eidBy" hidden></p>
      <SeasonLead p={box('reserve-24')} lang={lang} sleeve="eid" opt="mixed" title={{ ar: 'ضيافة العيد', en: 'Eid Hosting' }} line={{ ar: 'لصينية الضيوف صباح العيد.', en: 'For the guests’ tray on Eid morning.' }} />
      <SeasonLead p={box('coffee-duo')} lang={lang} sleeve="eid" title={{ ar: 'هدية الزيارة', en: 'The visit gift' }} line={{ ar: 'الهدية التي تحملها حين تزور.', en: 'The gift you bring when you visit.' }} />
      <div class="grid">{eid.map(p => <ProductCard p={p} lang={lang} sleeve="eid" />)}</div>
      <p class="muted when">{ar ? 'العيد متوقع نحو ٩ مارس ٢٠٢٧. طلبات العيد تصل قبل صباح العيد.' : 'Eid is expected around 9 March 2027. Eid orders arrive before Eid morning.'} <a href={path(lang, 'visit')}>{ar ? 'الاستلام والتوصيل' : 'Pickup & delivery'}</a></p>
    </div>
  </section>

</Base>

<style>
  .e-hero { background: var(--khalal); padding-block: clamp(40px, 6vw, 88px); overflow: hidden; }
  .e-grid { display: grid; grid-template-columns: 1.2fr .8fr; gap: clamp(28px, 5vw, 80px); align-items: center; }
  @media (max-width: 860px) { .e-grid { grid-template-columns: 1fr; } }
  .e-copy { display: grid; gap: 20px; }
  .e-copy h1 span { display: block; }
  .e-copy h1 .en { font-size: .55em; color: var(--tamr-2); margin-top: 8px; }
  .e-copy .lead { color: var(--bunn); }
  /* The film plays in the page, sized by the screen height so the whole frame always shows. */
  .e-film { position: relative; margin: 0; justify-self: center; height: min(70vh, 620px); aspect-ratio: 9 / 16; border-radius: 34px; border-bottom-right-radius: 8px; overflow: hidden; background: var(--bunn); box-shadow: 0 30px 60px -30px rgba(51, 33, 26, .7); }
  @media (max-width: 860px) { .e-film { height: min(62vh, 520px); } }
  .e-vid { display: block; width: 100%; height: 100%; object-fit: cover; }
  .snd { position: absolute; inset-inline-start: 14px; bottom: 14px; display: inline-flex; align-items: center; gap: 8px; border: 2px solid var(--paper); cursor: pointer; background: var(--bunn); color: var(--paper); border-radius: 999px; padding: 11px 18px 11px 14px; font: 700 16px/1 var(--body); box-shadow: 0 6px 18px rgba(28, 18, 14, .45); }
  .snd[aria-pressed="true"] { background: var(--tamr); }
  .snd:focus-visible { outline: 3px solid var(--bunn); outline-offset: 3px; }
  .snd svg { width: 20px; height: 20px; }
  .snd .w { display: none; } .snd[aria-pressed="true"] .w { display: inline; } .snd[aria-pressed="true"] .m { display: none; }
  .cta { display: flex; gap: 12px; }
  .visits { background: var(--sheet); }
  .v-grid { display: grid; grid-template-columns: .7fr 1.3fr; gap: 32px clamp(28px, 5vw, 80px); align-items: start; }
  @media (max-width: 860px) { .v-grid { grid-template-columns: 1fr; } }
  .v-pairs { display: grid; gap: 40px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 36px 24px; margin-top: 32px; }
  .when { margin-top: 28px; }
  .order-by { margin-top: 14px; font-weight: 600; color: var(--tamr); }
  .when a { color: var(--tamr); font-weight: 600; }
</style>

<script>
  // The Eid film plays in the page, on a loop, silent by default. The first visit tries the sound
  // once (browsers only allow it after the visitor has clicked on the site); when that play ends it
  // goes silent. The button turns the sound on (for one play) or off at any time.
  const vid = document.querySelector<HTMLVideoElement>('.e-vid')!;
  const snd = document.querySelector<HTMLButtonElement>('.snd')!;
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let seen = false, onScreen = false;
  try { seen = localStorage.getItem('hikaya-eid-sound') === '1'; } catch { /* storage blocked */ }
  const paint = () => { snd.setAttribute('aria-pressed', String(!vid.muted)); snd.querySelector('span')!.textContent = vid.muted ? snd.dataset.off! : snd.dataset.on!; };
  const start = () => vid.play().catch(() => { vid.muted = true; paint(); return vid.play().catch(() => {}); });
  vid.addEventListener('ended', () => { vid.muted = true; paint(); vid.currentTime = 0; if (onScreen && !calm) vid.play().catch(() => {}); });
  snd.addEventListener('click', () => {
    if (vid.muted) { vid.muted = false; vid.currentTime = 0; vid.play().catch(() => {}); } else vid.muted = true;
    paint();
  });
  new IntersectionObserver(([e]) => {
    onScreen = e.isIntersecting;
    // Scrolled away: stop, and silence it, so it never comes back with sound.
    if (!onScreen) { vid.pause(); vid.muted = true; paint(); return; }
    if (calm && vid.paused && vid.muted) return;
    if (!seen && !calm) { seen = true; try { localStorage.setItem('hikaya-eid-sound', '1'); } catch { /* fine */ } vid.muted = false; }
    paint(); start();
  }, { threshold: 0.4 }).observe(vid);
  // Order by: the last day before Eid and its deadline, from the same settings as checkout.
  (async () => {
    try {
      const d = (await (await fetch('/api/slots')).json()).eid;
      if (!d) return;
      const ar = document.documentElement.lang === 'ar';
      const f = (iso: string) => new Intl.DateTimeFormat(ar ? 'ar-u-nu-arab' : 'en-CA', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' }).format(new Date(iso + 'T12:00:00Z'));
      const h = new Intl.NumberFormat(ar ? 'ar-u-nu-arab' : 'en').format(d.orderBy.hour);
      const el = document.getElementById('eidBy')!;
      el.textContent = ar ? `لتصلك العلب قبل العيد، آخر يوم استلام وتوصيل ${f(d.day)}: اطلب قبل ${f(d.orderBy.date)}، الساعة ${h}:٠٠.` : `For your boxes before Eid, the last pickup and delivery day is ${f(d.day)}: order by ${f(d.orderBy.date)}, ${h}:00.`;
      el.hidden = false;
    } catch { /* the line stays hidden */ }
  })();
</script>
