---
import Base from '../../layouts/Base.astro';
import Intro from '../../components/Intro.astro';
import Pair from '../../components/Pair.astro';
import Pouch from '../../components/Pouch.astro';
import Sachet from '../../components/Sachet.astro';
import BoxBuilder from '../../components/BoxBuilder.astro';
import Films from '../../components/Films.astro';
import GuestWall from '../../components/GuestWall.astro';
import BlackBox from '../../components/BlackBox.astro';
import { dateSvg } from '../../data/date-art';
import { COFFEES, SPECIALTY, KITS, DATES, LINES, BOXES, money, priceText, packOf, baseOf, allergyNote, type Lang, type CoffeeLine, type Coffee, type Kit } from '../../data/products';
import { path } from '../../data/i18n';
import { sunsetMinutes, hhmm, RAMADAN_START } from '../../data/calendar';

export const getStaticPaths = () => [{ params: { lang: 'en' } }, { params: { lang: 'ar' } }];
const lang = Astro.params.lang as Lang;
const ar = lang === 'ar';
const najdi = COFFEES[0];
const dateBox = BOXES.find(b => b.id === 'date-box')!;
const shelf = [
  ...(['gulf', 'yemen', 'shami'] as CoffeeLine[]).map(l => ({ id: l, name: LINES[l].name, line: LINES[l].line, fam: LINES[l].fam, c: COFFEES.find(c => c.line === l)!, items: [...COFFEES.filter(c => c.line === l && c.id !== 'qishr'), ...KITS.filter(k => k.line === l && !k.discovery)] })),
  // Qishr is a drink of its own, as in the shop.
  { id: 'qishr', name: { en: 'Qishr', ar: 'القشر' }, line: { en: 'From Yemen: the dried coffee cherry husk, brewed like tea.', ar: 'من اليمن: قشر ثمرة البن المجفف، يُغلى مثل الشاي.' }, fam: 'husk', c: COFFEES.find(c => c.id === 'qishr')!, items: [] as { name: { en: string; ar: string } }[] },
];
// What people actually drink: the styles, then Jubani, Shami with cardamom and Qishr.
// Only coffees with a date chosen (after the tasting); with none, the pairing section is not shown.
const cups: (Kit | Coffee)[] = [...KITS.filter(k => !k.discovery), ...COFFEES.filter(c => ['jubani', 'shami', 'qishr'].includes(c.id))].filter(c => c.date);
const bagOf = (c: Kit | Coffee) => (c.kind === 'kit' ? baseOf(c) : c);
const tasting = KITS.filter(k => k.discovery);
const firstIftar = hhmm(sunsetMinutes(RAMADAN_START));
---
<Base lang={lang} title="" intro>
  <Intro />
  <!-- First viewport: the conversation is the headline; the bag stands beside the box. -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-talk">
        <Pair lang={lang} size="xl" class="hero-pair"
          bunn={{ ar: 'ضيف جديد في كالغاري.', en: 'A new guest in Calgary.' }}
          tamr={{ ar: 'مكانك محفوظ، والتمرة جاهزة.', en: 'Your seat is kept, the date is ready.' }} />
        <div class="hero-copy">
          <h1 class="h-m">{ar ? 'لكل بيت فنجانه. اختر فنجانك.' : 'Every home has its cup. Find yours.'}</h1>
          <p class="lead">{ar ? 'قهوة خليجية ويمنية وشامية، محمّصة بكميات صغيرة في كالغاري، وتمرٌ لمن يحبّه معها. استلام من الخميس إلى الأحد، أو نوصلها لبيتك.' : 'Gulf, Yemeni and Shami coffee, roasted in small batches in Calgary, and dates for those who take one with it. Pick up Thursday to Sunday, or we bring it to your door.'}</p>
          <div class="cta">
            <a class="btn primary" href={path(lang, 'find')}>{ar ? 'اعثر على فنجانك' : 'Find your cup'}</a>
            <a class="btn ghost" href={path(lang, 'shop')}>{ar ? 'تسوّق القهوة والتمر' : 'Shop coffee & dates'}</a>
            <a class="btn tamr" href={path(lang, 'ramadan')} data-season="ramadan">{ar ? 'اطلب لرمضان مسبقاً' : 'Pre-order for Ramadan'}</a>
          </div>
        </div>
      </div>
      <div class="hero-pack" aria-hidden="true">
        <div class="pack-panel patterned">
          <img class="pack-box" src="/media/img/giftbox.webp" alt="" width="1000" height="1250" fetchpriority="high" />
          <div class="pack-pouch"><Pouch coffee={najdi} lang={lang} label={false} /><span class="pack-sachet"><Sachet pack={packOf('pack-saffron')!} lang={lang} /></span></div>
        </div>
      </div>
    </div>
  </section>


  <ul class="wrap promises" aria-label={ar ? 'وعودنا' : 'Our promises'}>
    <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3c2 3 5 4.5 5 9a5 5 0 0 1-10 0c0-2 1-3.5 2-4.5.3 1.6 1.2 2.5 2 2.5 0-2.6-.6-4.6 1-7z" /></svg><span>{ar ? 'محمّصة في كالغاري بكميات صغيرة' : 'Small-batch roasted in Calgary'}</span></li>
    <li><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="3" /><path d="M8 3v4M16 3v4M4 10h16" /></svg><span>{ar ? 'تاريخ التحميص على كل كيس' : 'Roast date on every bag'}</span></li>
    <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l-1 12H6z" /><path d="M9 8a3 3 0 0 1 6 0" /></svg><span>{ar ? 'استلام مجاني، الخميس إلى الأحد' : 'Free pickup, Thursday to Sunday'}</span></li>
    <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7" /><circle cx="7" cy="17.5" r="1.8" /><circle cx="17" cy="17.5" r="1.8" /></svg><span>{ar ? 'توصيل مجاني في كالغاري فوق ٨٠ $' : 'Free Calgary delivery over $80'}</span></li>
  </ul>

  <div class="print-band patterned" aria-hidden="true"></div>

  <!-- The story: one bag, made the way your family makes it. -->
  <section class="sec story-sec" aria-labelledby="story-h">
    <div class="wrap story-grid">
      <div class="story-text">
        <h2 id="story-h" class="h-l">{ar ? 'لكل منطقة طريقتها، ولكل بيت فنجان.' : 'Every region has its way, every home its cup.'}</h2>
        <p class="lead">{ar ? 'اسأل عشرة بيوت كيف يصنعون القهوة، تسمع عشر حكايات. في نجد شقراء بالزعفران، وفي القصيم أغنى، وفي الحجاز أعطر. وفي اليمن لكل بلدة إضافتها: السمسم واللوز في رداع، والذرة الرفيعة في البيضاء. وفي الشام ناعمة كالبودرة، برغوتها في الركوة.' : 'Ask ten homes how they make their coffee and you will hear ten stories. In Najd it is pale, with saffron; in Qassim, richer; in the Hijaz, more fragrant. In Yemen every town adds its own: sesame and almonds in Rada’a, sorghum in Al-Bayda. In the Levant it is powder-fine, with its foam, in the rakwa.'}</p>
        <p>{ar ? 'لذلك نحمّص القهوة طازجة في كالغاري، ونترك إضافات كل بيت في ظروفها المختومة، فتشربها كما تشربها في بيتك.' : 'So we roast the coffee fresh in Calgary, keep each home’s additions in their own sealed packs, and you make it the way you take it at home.'}</p>
        <div class="cta">
          <a class="btn primary" href={path(lang, 'find')}>{ar ? 'اعثر على قهوتك' : 'Find your coffee'}</a>
          <a class="btn ghost" href={path(lang, 'our-recipes')}>{ar ? 'كيف اخترنا وصفاتنا' : 'How we chose our recipes'}</a>
        </div>
      </div>
      <ol class="story-steps">
        <li><b>{ar ? '١ · الكيس' : '1 · The bag'}</b><span>{ar ? 'خليجية أو يمنية أو شامية: القهوة وبهارها الأساسي فقط.' : 'Gulf, Yemeni or Shami: the coffee and its everyday spice, nothing more.'}</span></li>
        <li><b>{ar ? '٢ · كيف تشربها' : '2 · How you take it'}</b><span>{ar ? 'نجدية، قصيمية، حجازية، حضرمية، رداعية، بيضانية: الكيس مع ظروفه في علبة واحدة.' : 'Najdi, Qassimi, Hijazi, Hadrami, Rada’i, Baydani: the bag with its packs, in one box.'}</span></li>
        <li class="try"><b>{ar ? 'جديد عليها؟' : 'New to it?'}</b><span>{ar ? 'تذوّق النكهة الخليجية وتذوّق النكهة اليمنية: كيس مع ظرف صغير من كل طريقة، لتجد طريقتك.' : 'Taste the Gulf and Taste Yemen: one bag with a small pack of each style, so you find yours.'} <a href={path(lang, 'shop') + '#start'}>{ar ? 'ابدأ من هنا' : 'Start here'}</a></span></li>
        <li><b>{ar ? '٣ · الظرف وحده' : '3 · Just the pack'}</b><span>{ar ? 'عندك كيس جديد بلا إضافات؟ خذ ظرفه وحده.' : 'Have a fresh plain bag? Take its pack on its own.'}</span></li>
      </ol>
    </div>
  </section>

  <!-- The shelf: three coffees standing like bags on a counter. -->
  <section class="sec shelf-sec" aria-labelledby="shelf-h">
    <div class="wrap">
      <div class="split-head">
        <h2 id="shelf-h" class="h-l">{ar ? 'على الرف.' : 'On the shelf.'}</h2>
        <p class="lead">{ar ? 'كيس لكل قهوة، والظروف تجعلها كما تشربها.' : 'A bag for each coffee, and the packs make it the way you take it.'}</p>
      </div>
      <ul class="shelf">
        {shelf.map(x => (
          <li class={`rise shelf-${x.fam}`}>
            <a href={path(lang, 'shop') + `#${x.id}`}>
              <div class="shelf-bag"><Pouch coffee={x.c} lang={lang} label={false} /></div>
              <h3 class="h-s">{x.name[lang]}</h3>
              <p class="muted">{x.line[lang]}</p>
              {x.items.length > 0 && <p class="count">{x.items.map(p => p.name[lang]).join(' · ')}</p>}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- New to it? The tasting boxes, right after the shelf. -->
  <section class="sec tasting-sec" aria-labelledby="tasting-h">
    <div class="wrap tasting-grid">
      <div class="tasting-copy">
        <h2 id="tasting-h" class="h-l">{ar ? 'جديد عليها؟ تذوّق قبل أن تختار.' : 'New to it? Taste before you choose.'}</h2>
        <p class="lead">{ar ? 'كيس واحد مع ظرف صغير من كل طريقة. جرّبها في بيتك، ثم اختر فنجانك.' : 'One bag with a small pack of each style. Try them at home, then choose your cup.'}</p>
        <a class="btn ghost" href={path(lang, 'find')}>{ar ? 'أو أجب عن ثلاثة أسئلة' : 'Or answer three questions'}</a>
      </div>
      <div class="tasting-cards">
        {tasting.map(k => (
          <a class="t-card" href={path(lang, `shop/${k.id}`)}>
            <span class="t-art"><span class="t-bag"><Pouch coffee={baseOf(k)} lang={lang} label={false} /></span><span class="t-packs">{k.parts.map(x => <Sachet pack={packOf(x.id)!} lang={lang} mini={x.mini} />)}</span></span>
            <b>{k.name[lang]}</b>
            <small>{k.taste[lang]}</small>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Signature: choose a coffee, Tamr answers with its date. Works without JS via :checked. -->
  {cups.length > 0 && <section class="pairing" aria-labelledby="pairing-h">
    <div class="wrap">
      <div class="pairing-head">
        <h2 id="pairing-h" class="h-l">{ar ? 'اختر قهوتك، وتمر تردّ.' : 'Choose a coffee. Tamr answers.'}</h2>
        <p class="lead">{ar ? 'بعض القهوة تُشرب مع تمرة، وبعضها لا. اختر قهوتك، وتمر تقترح ما يليق بها إن أردت.' : 'Some coffees are drunk with a date, some are not. Choose yours, and Tamr will suggest one if you want it.'}</p>
      </div>
      <fieldset class="chips">
        <legend class="sr">{ar ? 'القهوة' : 'Coffee'}</legend>
        {cups.map((c, i) => (
          <label class="chip"><input type="radio" name="pick" value={c.id} checked={i === 0} /><span>{c.name[lang]}</span></label>
        ))}
      </fieldset>
      <div class="panels">
        {cups.map((c, i) => {
          const d = DATES[c.date!];
          const bag = bagOf(c);
          return (
            <div class="panel" data-for={c.id} hidden={i !== 0}>
              <div class="panel-pouch"><Pouch coffee={bag} lang={lang} /></div>
              <div class="panel-chat">
                <Pair lang={lang} size="l"
                  bunn={c.bunn}
                  tamr={{ ar: `خذ معها ${d.name.ar}.`, en: `Take ${d.name.en} with it.` }} />
                <p class="why">{c.why[lang]} <span>{d.name[lang]} · {d.region[lang]}</span></p>
                <div class="panel-buy">
                  <p><span class="price" data-price-for={`${c.id},date-box`}>{c.price == null || dateBox.price == null ? priceText(null, lang) : money(c.price + dateBox.price, lang)}</span> <span class="muted">{ar ? `${c.name.ar} + ٥٠٠ غ ${d.name.ar}` : `${c.name.en} + 500 g ${d.name.en}`}</span></p>
                  {c.kind === 'kit' && <p class={`allergy ${allergyNote(c, lang).none ? 'none' : ''}`}>{allergyNote(c, lang).text}</p>}
                  <button class="btn tamr" type="button" data-add={`${c.id},date-box`} data-opt={`${bag.grinds[0] ?? ""},${c.date}`} disabled={c.price == null}><span>{ar ? 'أضف الاثنين' : 'Add the pair'}</span></button>
                  <a href={path(lang, `shop/${c.id}`)}>{ar ? 'عن هذه القهوة' : 'About this coffee'}</a>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>}

  <!-- Dates: the three tiers, each opening its tab in the shop. -->
  <section class="sec home-dates" aria-labelledby="hd-h">
    <div class="wrap">
      <div class="split-head">
        <h2 id="hd-h" class="h-l">{ar ? 'وتمر بجانب الفنجان.' : 'And a date beside the cup.'}</h2>
        <p class="lead">{ar ? 'تمر كل يوم بالوزن للبيت، والنخبة والمحشي في علب.' : 'Everyday dates by weight for the house; Reserve and stuffed, boxed.'}</p>
      </div>
      <ul class="hd-grid">
        {[
          { id: 'everyday', t: { ar: 'تمر كل يوم', en: 'Everyday' }, d: { ar: 'خلاص وسكري قصيمي · ٢٥٠ غ إلى ١ كغ', en: 'Khalas, Sukkari Qassimi · 250 g to 1 kg' }, art: dateSvg(DATES.khalas.c) },
          { id: 'reserve', t: { ar: 'تمر النخبة', en: 'Reserve' }, d: { ar: 'مفتّل، عجوة، مجدول · ١٢ أو ٢٤', en: 'Mufattal, Ajwa, Medjool · 12 or 24' }, art: dateSvg(DATES.ajwa.c), pick: true },
          { id: 'stuffed', t: { ar: 'تمر محشي', en: 'Stuffed' }, d: { ar: 'فستق، كاجو، كريمة البسكويت · ١٢ أو ٢٤', en: 'Pistachio, cashew, biscuit cream · 12 or 24' }, art: dateSvg(DATES.mufattal.c, 'pistachio') },
        ].map(c => (
          <li><a href={path(lang, 'shop') + `#${c.id}`}>
            <svg viewBox="-26 -46 52 92" aria-hidden="true" set:html={c.art} />
            <span><b>{c.t[lang]}{!ar && <small lang="ar"> {c.t.ar}</small>}</b><small>{c.d[lang]}</small>{c.pick && <em>{ar ? 'ننصح بها' : 'Our pick'}</em>}</span>
          </a></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Yemeni beans: hidden by itself (data-group) when the owners hide all three products. -->
  <section class="home-beans" aria-labelledby="hb-h" data-group>
    {SPECIALTY.map(c => <span data-product={c.id} hidden></span>)}
    <div class="wrap hb-grid">
      <div class="hb-art"><BlackBox coffee={SPECIALTY[0]} lang={lang} /></div>
      <div class="hb-copy">
        <h2 id="hb-h" class="h-l">{ar ? 'بن اليمن' : 'Yemeni beans'}</h2>
        <p class="hb-slogan">{ar ? 'من مزارعنا' : <>From our farms <span lang="ar">· من مزارعنا</span></>}</p>
        <p class="lead">{ar ? 'من مدرجات جبال اليمن، حيث بدأت حكاية القهوة. دفعات صغيرة نتذوقها ونقيّمها، حبوباً محمّصة كاملة في العلبة السوداء.' : 'From the mountain terraces of Yemen, where the story of coffee began. Small lots, cupped and scored by us, whole roasted beans in the black box.'}</p>
        <a class="btn tamr" href={path(lang, 'shop') + '#beans'}>{ar ? 'بن اليمن' : 'See the Yemeni beans'}</a>
      </div>
    </div>
  </section>

  <BoxBuilder lang={lang} />

  <!-- Ramadan: the Calgary window at sunset. -->
  <section class="ramadan-cta" aria-labelledby="ram-h" data-season="ramadan">
    <img src="/media/img/ramadan-window.webp" alt={ar ? 'غروب الشمس فوق كالغاري من نافذة بيت' : 'Sunset over Calgary from a home window'} loading="lazy" width="1000" height="1250" />
    <div class="wrap ram-inner">
      <div class="ram-card">
        <h2 id="ram-h" class="h-l">{ar ? 'أول إفطار في كالغاري' : 'First iftar in Calgary'}</h2>
        <p class="ram-time tnum"><b>{firstIftar}</b> <span>{ar ? 'مساءً' : 'p.m.'}</span></p>
        <p class="muted">{ar ? 'الاثنين ٨ فبراير ٢٠٢٧، إن شاء الله. موعد متوقع، والهلال يقرر.' : 'Monday, 8 February 2027, expected. The moon decides.'}</p>
        <p>{ar ? 'طلبات رمضان تصل قبل الغروب.' : 'Ramadan orders arrive before sunset.'}</p>
        <a class="btn tamr" href={path(lang, 'ramadan')}>{ar ? 'جدول رمضان والصناديق' : 'The Ramadan table & boxes'}</a>
      </div>
    </div>
  </section>

  <Films lang={lang} />
  <GuestWall lang={lang} />
</Base>

<style>
  /* ---------- hero ---------- */
  .hero { padding-block: clamp(28px, 5vw, 72px) clamp(56px, 7vw, 104px); }
  .hero-grid { display: grid; grid-template-columns: 1.12fr .88fr; gap: clamp(28px, 5vw, 80px); align-items: center; }
  .hero-talk { display: grid; gap: clamp(28px, 4vw, 48px); }
  .hero-pair { max-width: 760px; }
  .hero-copy { display: grid; gap: 16px; max-width: 600px; }
  .hero-copy h1 { font-size: clamp(24px, 2.4vw, 32px); line-height: 1.25; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  .pack-panel { position: relative; border-radius: clamp(28px, 4vw, 48px); border-bottom-left-radius: 8px; overflow: hidden; aspect-ratio: 4 / 5; }
  .pack-box { position: absolute; inset: 9% 8% 16% 18%; width: 74%; height: 75%; object-fit: cover; object-position: 60% 40%; border-radius: clamp(20px, 3vw, 34px); box-shadow: 0 24px 40px -24px rgba(51, 33, 26, .45); }
  html[dir='rtl'] .pack-box { inset: 9% 18% 16% 8%; }
  .pack-sachet { position: absolute; width: 34%; inset-inline-end: -22%; bottom: 4%; transform: rotate(7deg); }
  .tasting-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 28px clamp(28px, 5vw, 72px); align-items: center; }
  @media (max-width: 860px) { .tasting-grid { grid-template-columns: 1fr; } }
  .tasting-copy { display: grid; gap: 16px; justify-items: start; }
  .tasting-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .t-card { display: grid; gap: 4px; padding: 16px; border-radius: 26px; border-bottom-left-radius: 6px; background: var(--sheet); text-decoration: none; color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--line); transition: box-shadow .15s; }
  .t-card:hover { box-shadow: inset 0 0 0 1.5px var(--bunn); }
  .t-card b { font-family: var(--display); font-size: 21px; }
  .t-card small { color: var(--ink-2); font-size: 14px; }
  .t-art { position: relative; display: block; padding: 6% 34% 6% 10%; background: var(--paper-2); border-radius: 18px; margin-bottom: 8px; }
  .t-packs { position: absolute; inset-inline-end: 6%; bottom: 8%; width: 26%; display: grid; }
  .t-packs :global(.sachet:nth-child(n+2)) { margin-top: -40%; }
  .pack-pouch { position: absolute; width: 44%; inset-inline-start: 6%; bottom: 3%; filter: drop-shadow(0 22px 22px rgba(51, 33, 26, .28)); }
  html[dir='rtl'] .pack-pouch { inset-inline-start: auto; left: 6%; }
  /* Keep the saffron packet where it sits in English, inside the panel. */
  html[dir='rtl'] .pack-sachet { inset-inline-end: auto; right: -22%; }
  .js .hero-pair .say { opacity: 0; transform: translateY(10px) scale(.98); animation: say .7s var(--ease) forwards; }
  .js .hero-pair .say.tamr { animation-delay: .55s; }
  .js .pack-pouch { animation: stand .9s .25s var(--ease) both; }
  @keyframes say { to { opacity: 1; transform: none; } }
  @keyframes stand { from { opacity: 0; transform: translateY(26px) rotate(-3deg); } }
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-pack { max-width: 520px; width: 100%; margin-inline: auto; }
    .pack-panel { aspect-ratio: 5 / 4; }
    .pack-pouch { width: 34%; }
  }

  .print-band { height: clamp(120px, 12vw, 168px); }

  :global(html.intro-on) .hero-pair .say, :global(html.intro-on) .pack-pouch { animation-play-state: paused; }
  .promises { list-style: none; margin: 0 auto; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px 28px; padding-block: 0 clamp(40px, 5vw, 64px); }
  .promises li { display: flex; align-items: center; gap: 12px; font-size: 15px; font-weight: 500; }
  .promises svg { width: 26px; height: 26px; flex: none; fill: none; stroke: var(--tamr); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  @media (max-width: 900px) { .promises { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 480px) { .promises li { font-size: 14px; } }

  /* ---------- pairing (Bunn-drenched) ---------- */
