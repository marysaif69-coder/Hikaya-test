---
// How we chose our recipes: the bag, the packs, the beans, and what is still being decided.
import Base from '../../layouts/Base.astro';
import Pair from '../../components/Pair.astro';
import type { Lang } from '../../data/products';
import { path } from '../../data/i18n';

export const getStaticPaths = () => [{ params: { lang: 'en' } }, { params: { lang: 'ar' } }];
const lang = Astro.params.lang as Lang;
const ar = lang === 'ar';
const parts = ar ? [
  { h: 'بدأنا من الفناجين', p: ['قبل أن نختار أي حبّة، جلسنا مع الفناجين التي نعرفها: الدلّة الخليجية، والإبريق اليمني، والركوة الشامية. ولكل واحدة طريقتها، ولكل بيت إضافته.'] },
  { h: 'الكيس بسيط، والإضافات في ظروف', p: ['كل كيس فيه القهوة وبهارها الأساسي فقط: الهيل في الخليجية واليمنية، والهيل أو لا شيء في الشامية.', 'وما يجعلها كما تشربها في بيتك يأتي في ظرف مختوم: الزعفران للنجدية، والخلطة القصيمية والحجازية، والخلطات الحضرمية والرداعية والبيضانية، وفيها الزنجبيل. هكذا يبقى الكيس طازجاً، وتبقى مسببات الحساسية بعيدة عن القهوة.'] },
  { h: 'النجدية فيها زعفرانها دائماً', p: ['الزعفران هو ما يجعل القهوة الخليجية نجدية، فهو في علبة النجدية دائماً. ومن يريدها بالهيل فقط يختار «قهوة خليجية، بالهيل فقط».'] },
  { h: 'الحبوب، بأسمائها الصحيحة', p: ['قهوتنا اليمنية على الطريقة اليمنية، من حبوب إثيوبية. لا نسميها حبوباً يمنية ولا «موكا». وقهوتنا الشامية من حبوب برازيلية [يُحدد لاحقاً: قد تضم بعض الحبوب الإثيوبية].', 'نختار الحبوب النهائية في جلسة تذوق نحو ٢٠ أكتوبر، ثم في تذوق أعمى بين ٣ و١٠ نوفمبر.'] },
  { h: 'التحميص، خطة مبدئية', p: ['الخليجية: تحميص أشقر. اليمنية: متوسط فاتح. الشامية: متوسط. نثبّتها بعد التذوق.'] },
  { h: 'ما زلنا نقرره', p: ['كم غراماً من القهوة ومن كل ظرف للإبريق، ومكونات الظرف الحضرمي، وهل الجُبَني بالزنجبيل أم سادة، وهل القشر محمّص أم نيء، وهل في الخلطة الحجازية مستكة. حين نقرر، نكتبه هنا وعلى الملصق.'] },
] : [
  { h: 'We started with the cups', p: ['Before choosing a single bean, we sat with the cups we know: the Gulf dallah, the Yemeni pot and the Shami rakwa. Each has its own way, and every home adds its own touch.'] },
  { h: 'A simple bag, the additions in packs', p: ['Each bag holds the coffee and its everyday spice only: cardamom in the Gulf coffee and the Yemeni qahwa, cardamom or nothing in the Shami.', 'What makes it the way you take it at home comes in a sealed pack: saffron for Najdi, the Qassim and Hijazi blends, and the Hadrami, Rada’i and Baydani packs, which carry the ginger. The bag stays fresh, and the allergens stay out of the coffee.'] },
  { h: 'Najdi always has its saffron', p: ['Saffron is what makes Gulf coffee Najdi, so it is always in the Najdi box. If you want it with cardamom only, choose “Gulf coffee, cardamom only”.'] },
  { h: 'The beans, by their right names', p: ['Our Yemeni coffee is Yemeni-style, made from Ethiopian beans. We do not call them Yemeni beans or Mocha. Our Shami coffee uses Brazilian beans [TBD: may include some Ethiopian].', 'We choose the final beans at a cupping around 20 October, then a blind tasting between 3 and 10 November.'] },
  { h: 'The roast, a working plan', p: ['Gulf: blonde. Yemeni: medium-light. Shami: medium. We confirm them after the tastings.'] },
  { h: 'Still being decided', p: ['How many grams of coffee and of each pack go in a pot, what is in the Hadrami pack, whether Jubani has ginger, whether the qishr husk is roasted or raw, and whether the Hijazi blend has mastic. When we decide, we write it here and on the label.'] },
];
---
<Base lang={lang} title={ar ? 'كيف اخترنا وصفاتنا' : 'How we chose our recipes'} current="story" description={ar ? 'الكيس، والظروف، والحبوب، وما زلنا نقرره.' : 'The bag, the packs, the beans, and what we are still deciding.'}>
  <section class="wrap recipes">
    <h1 class="h-l">{ar ? 'كيف اخترنا وصفاتنا' : 'How we chose our recipes'}</h1>
    <Pair lang={lang} size="m" bunn={{ ar: 'كل بيت يصنعني بطريقته.', en: 'Every home makes me its own way.' }} tamr={{ ar: 'فتركنا الطريقة لكم.', en: 'So we left the way to you.' }} />
    {parts.map(x => (
      <section class="part">
        <h2 class="h-s">{x.h}</h2>
        {x.p.map(t => <p>{t}</p>)}
      </section>
    ))}
    <p class="cta"><a class="btn primary" href={path(lang, 'find')}>{ar ? 'اعثر على قهوتك' : 'Find your coffee'}</a> <a class="btn ghost" href={path(lang, 'shop')}>{ar ? 'إلى المتجر' : 'To the shop'}</a></p>
  </section>
</Base>

<style>
  .recipes { display: grid; gap: 26px; padding-block: clamp(40px, 6vw, 80px); max-width: 760px; }
  .part { display: grid; gap: 10px; }
  .part p { color: var(--ink-2); font-size: 17px; }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; }
</style>
