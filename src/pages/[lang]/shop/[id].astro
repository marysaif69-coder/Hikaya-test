---
import Base from '../../../layouts/Base.astro';
import Pouch from '../../../components/Pouch.astro';
import Sachet from '../../../components/Sachet.astro';
import Pair from '../../../components/Pair.astro';
import ProductCard from '../../../components/ProductCard.astro';
import { PRODUCTS, COFFEES, KITS, PACKS, FAMILIES, SPICES, GRINDS, DATES, ALLERGENS, priceText, baseOf, packOf, stylesFor, allergyNote, kitInside, type Lang, type Product, type Coffee } from '../../../data/products';
import { BREW } from '../../../data/brew';
import { UI, path } from '../../../data/i18n';

export function getStaticPaths() {
  return (['en', 'ar'] as const).flatMap(lang => PRODUCTS.map(p => ({ params: { lang, id: p.id }, props: { p } })));
}
const lang = Astro.params.lang as Lang;
const { p } = Astro.props as { p: Product };
const ar = lang === 'ar';
const L = (en: string, a: string) => (ar ? a : en);
// The bag behind this page: itself, a style's base, or the bag a pack is made for.
const bag: Coffee | null = p.kind === 'coffee' ? p : p.kind === 'kit' ? baseOf(p) : p.kind === 'pack' ? COFFEES.find(c => c.id === p.for) ?? null : null;
const img = p.kind === 'box' ? p.img : p.kind === 'coffee' ? p.art?.front ?? '/brand/logo.svg' : '/brand/logo.svg';
const pageUrl = new URL(path(lang, `shop/${p.id}`), Astro.site).href;
const jsonld = {
  '@context': 'https://schema.org', '@type': 'Product', name: p.name[lang], alternateName: p.name[lang === 'en' ? 'ar' : 'en'],
  description: p.notes[lang], image: new URL(img, Astro.site).href, brand: { '@type': 'Brand', name: 'Hikaya' }, sku: p.id,
  ...(p.price != null ? { offers: { '@type': 'Offer', price: p.price.toFixed(2), priceCurrency: 'CAD', availability: 'https://schema.org/PreOrder', url: pageUrl, areaServed: { '@type': 'City', name: 'Calgary' } } } : {}),
};
const cup = p.kind === 'coffee' || p.kind === 'kit' ? p : null; // has a taste, a date and a Bunn line
const pairDate = cup ? DATES[cup.date] : null;
const dateBox = PRODUCTS.find(o => o.id === 'date-box')!;
// "Make it the way your family does": on a bag's page, the bag alone or one of its styles.
const styles = p.kind === 'coffee' ? stylesFor(p.id) : [];
// Other bags of the same line that are ways of their own (Jubani, Qishr on the Yemeni page).
const ownWays = styles.length ? COFFEES.filter(c => c.line === (p as Coffee).line && c.id !== p.id && c.id !== 'qishr') : [];
// The style ticked when the page opens: the classic one where we know it (Najdi for Gulf coffee),
// otherwise the bag with nothing added.
const DEFAULT_STYLE: Record<string, string> = { gulf: 'najdi' };
const startId = styles.some(k => k.id === DEFAULT_STYLE[p.id]) ? DEFAULT_STYLE[p.id] : p.id;
const start = PRODUCTS.find(x => x.id === startId)!;
const packsFor = p.kind === 'coffee' ? PACKS.filter(k => k.for === p.id) : [];
const discoveryFor = p.kind === 'coffee' ? KITS.find(k => k.discovery && k.base === p.id) : null;
const grinds = bag && p.kind !== 'pack' ? bag.grinds : [];
const lineKey = p.kind === 'box' ? null : p.line;
const related = p.kind === 'box'
  ? PRODUCTS.filter(o => o.fam === p.fam && o.id !== p.id).slice(0, 4)
  : PRODUCTS.filter(o => o.kind !== 'box' && o.line === lineKey && o.id !== p.id && (o.kind !== 'pack' || p.kind === 'pack')).slice(0, 4);
const fill = related.length < 3 ? PRODUCTS.filter(o => o.kind === 'box' && o.fam === 'dates' && !related.includes(o)).slice(0, 3 - related.length) : [];
const occasionPair: Record<string, { bunn: { ar: string; en: string }; tamr: { ar: string; en: string } }> = {
  dates: { bunn: { ar: 'علبة لكل بيت.', en: 'A box for every house.' }, tamr: { ar: 'وتمرة لكل جار.', en: 'And a date for every neighbour.' } },
  ramadan: { bunn: { ar: 'أنا لما بعد المغرب.', en: "I'm for after sunset." }, tamr: { ar: 'وأنا أوّل المائدة.', en: "I'm first on the table." } },
  eid: { bunn: { ar: 'من نزور أولاً؟', en: 'Who do we visit first?' }, tamr: { ar: 'الكبار دائماً.', en: 'The elders, always.' } },
};
const kitsUsing = p.kind === 'pack' ? KITS.filter(k => !k.discovery && k.parts.some(x => x.id === p.id)) : [];
const brewFam = p.kind === 'coffee' || p.kind === 'kit' ? p.fam : null;
const sizeText = p.kind === 'coffee' ? p.size : p.kind === 'kit' ? kitInside(p, lang) : p.size[lang];
---
<Base season={p.fam === 'ramadan' || p.fam === 'eid' ? p.fam : undefined} alertFor={p.id} lang={lang} title={p.name[lang]} current="shop" description={p.notes[lang]} jsonld={jsonld} image={img}>
  <nav class="wrap crumbs" aria-label={ar ? 'المسار' : 'Breadcrumb'}>
    <a href={path(lang, 'shop')}>{UI.nav.shop[lang]}</a><span aria-hidden="true">/</span>
    <a href={path(lang, 'shop') + `#${p.kind === 'pack' ? 'packs' : p.kind === 'kit' && p.discovery ? 'start' : p.kind === 'box' ? p.fam : p.id === 'qishr' ? 'qishr' : p.line}`}>{p.kind === 'pack' ? L('Just the pack', 'الظرف وحده') : p.kind === 'kit' && p.discovery ? L('Start here', 'ابدأ من هنا') : FAMILIES[p.fam].name[lang]}</a><span aria-hidden="true">/</span>
    <span aria-current="page">{p.name[lang]}</span>
  </nav>

  <section class="wrap pdp" data-pdp={p.id}>
    <div class="pdp-media">
      {p.kind === 'coffee'
        ? <div class="gal">
            <div class="pdp-pouch">
              <div class="slide on" data-slide="0"><Pouch coffee={p} lang={lang} /></div>
              {p.art && <div class="slide" data-slide="1"><Pouch coffee={p} lang={lang} side="back" /></div>}
            </div>
          </div>
        : p.kind === 'kit'
        ? <div class="pdp-pouch kit-media"><div class="kit-bag"><Pouch coffee={baseOf(p)} lang={lang} /></div><div class="kit-packs">{p.parts.map(x => <Sachet pack={packOf(x.id)!} lang={lang} mini={x.mini} />)}</div></div>
        : p.kind === 'pack'
        ? <div class="pdp-pouch pack-media"><Sachet pack={p} lang={lang} /></div>
        : <img src={p.img} alt={p.name[lang]} width="1000" height="1250" />}
    </div>

    <div class="pdp-info">
      <h1 class="h-l">{p.name[lang]}{lang === 'en' && <span lang="ar">{p.name.ar}</span>}</h1>
      <p class="pdp-price"><span class="price" data-price-for={startId} id="mainPrice">{priceText(start.price, lang)}</span> {p.price != null && <span class="draft">· {UI.draftPrice[lang]}</span>} <span class="muted">· {sizeText}</span></p>
      <p class="pdp-notes">{p.notes[lang]}</p>
      {cup && <p class="taste"><span class="label">{ar ? 'الطعم' : 'Tastes like'}</span> {cup.taste[lang]}</p>}

      {cup ? (
        <>
          <Pair lang={lang} size="m" bunn={cup.bunn} tamr={{ ar: `خذ معها ${DATES[cup.date].name.ar}.`, en: `Take ${DATES[cup.date].name.en} with it.` }} />
          {p.kind === 'coffee' && (
            <div class="facts">
              {p.spices.length > 0 && <div class="spices">{p.spices.map(s => <span><i style={`background:${SPICES[s].c}`}></i>{SPICES[s].name[lang]}</span>)}</div>}
              {p.roast > 0 && <p class="roast"><span class="label">{UI.roast[lang]}</span> <span class="roastbar" role="img" aria-label={`${p.roast} / 4`}>{[1, 2, 3, 4].map(i => <i class={i <= p.roast ? 'on' : ''}></i>)}</span> <small class="muted">{L('working plan', 'خطة مبدئية')}</small></p>}
            </div>
          )}
        </>
      ) : p.kind === 'box' ? (
        <Pair lang={lang} size="m" bunn={occasionPair[p.fam].bunn} tamr={occasionPair[p.fam].tamr} />
      ) : null}

      {p.kind === 'kit' && (
        <div class="inbox">
          <h2 class="h-s">{L('In the box', 'في العلبة')}</h2>
          <ul>
            <li><a href={path(lang, `shop/${p.base}`)}>{baseOf(p).name[lang]}</a> <span class="muted">{baseOf(p).size} · {L('coffee and spice only', 'قهوة وبهار فقط')}</span></li>
            {p.parts.map(x => { const k = packOf(x.id)!; return <li><a href={path(lang, `shop/${k.id}`)}>{x.mini ? L('Small ', 'ظرف صغير: ') : ''}{k.name[lang]}</a> <span class={`allergy ${allergyNote(k, lang).none ? 'none' : ''}`}>{allergyNote(k, lang).text}</span>{k.maybe && <small class="muted"> · {k.maybe[lang]}</small>}</li>; })}
          </ul>
          {/* Tasting boxes: one small pack per pot, one style at a time. Full styles: the pack goes into the bag; saffron never does (it is soaked and added at the end). */}
          {p.id === 'radai' || p.id === 'baydani'
            ? <p class="howto"><b>{L('How to use: ', 'طريقة الاستعمال: ')}</b>{L('decided at our tasting [TBD]. The pack stays sealed until then.', 'تُحدد في جلسة التذوق [يُحدد لاحقاً]. ويبقى الظرف مختوماً حتى ذلك الحين.')}</p>
            : p.discovery
            ? <p class="howto"><b>{L('How to use: ', 'طريقة الاستعمال: ')}</b>{L('one small pack per pot, one style at a time: empty it into the pot with the coffee ([TBD] for each pot) and keep the others sealed.', 'ظرف صغير واحد لكل إبريق، طريقة بعد طريقة: أفرغه في الإبريق مع القهوة ([يُحدد لاحقاً] لكل إبريق)، وأبقِ الباقي مختوماً.')}{p.parts.some(x => x.id === 'pack-saffron') && L(' The saffron is soaked and added to the serving dallah at the end, never boiled.', ' والزعفران يُنقع ويوضع في دلّة التقديم في النهاية، ولا يُغلى أبداً.')}</p>
            : <p class="howto"><b>{L('How to use: ', 'طريقة الاستعمال: ')}</b>{p.parts.some(x => x.id !== 'pack-saffron') && L('pour the pack into the bag, close it and shake well. Every pot after that is ready. ', 'اسكب الظرف في الكيس، وأغلقه ورجّه جيداً. وكل إبريق بعدها جاهز. ')}{p.parts.some(x => x.id === 'pack-saffron') && L('Keep the saffron sealed: for each pot, soak a little in hot water, put it in the serving dallah and pour the coffee over it. Never boil it.', 'أبقِ الزعفران مختوماً: لكل إبريق، انقع قليلاً منه في ماء ساخن، وضعه في دلّة التقديم وصبّ القهوة فوقه. لا تغلِه أبداً.')}{p.id === 'qassimi' && L(' Add evaporated milk when you make each pot.', ' وأضف الحليب المبخّر عند تحضير كل إبريق.')}</p>}
          {p.parts.some(x => x.id === 'pack-saffron') && <p class="muted">{L('The saffron is part of the recipe, so it is always in the box.', 'الزعفران جزء من الوصفة، لذلك هو في العلبة دائماً.')}</p>}
        </div>
      )}

      {p.kind === 'pack' && bag && (
        <div class="inbox">
          <h2 class="h-s">{L('Made for', 'مصنوعة لـ')} <a href={path(lang, `shop/${bag.id}`)}>{bag.name[lang]}</a></h2>
          <p>{p.contents[lang]}</p>
          <p class="howto"><b>{L('How to use: ', 'طريقة الاستعمال: ')}</b>{L('pour it into the bag, close it and shake well. One pack is for one 250 g bag.', 'اسكبه في الكيس، وأغلقه ورجّه جيداً. الظرف الواحد لكيس ٢٥٠ غ.')}</p>
          <p class={`allergy ${allergyNote(p, lang).none ? 'none' : ''}`}>{allergyNote(p, lang).text}</p>
          {p.maybe && <p class="muted">{p.maybe[lang]}</p>}
          <p class="muted">{L(`This is the pack on its own, for a bag you already have. New to it? ${kitsUsing.map(k => k.name.en).join(' and ')} come${kitsUsing.length === 1 ? 's' : ''} with the bag and the pack together.`, `هذا الظرف وحده، لكيس عندك من قبل. جديد عليها؟ ${kitsUsing.map(k => k.name.ar).join(' و')} تأتي مع الكيس والظرف معاً.`)}</p>
          <p class="kit-links">{kitsUsing.map(k => <a class="btn ghost" href={path(lang, `shop/${k.id}`)}>{k.name[lang]}</a>)}</p>
        </div>
      )}

      <form class="buy" onsubmit="return false">
        {styles.length > 0 && (
          <fieldset class="styles" id="styles">
            <legend>{L('How do you take it?', 'كيف تشربها؟')}<small>{L('Every region has its way, every home its cup.', 'لكل منطقة طريقتها، ولكل بيت فنجان.')}</small></legend>
            {styles.map(k => (
              <label><input type="radio" name="style" value={k.id} checked={k.id === startId} data-priced={k.price != null ? '1' : ''} data-price-text={priceText(k.price, lang)} /><span><b>{k.name[lang]}</b><small>{L('The bag + ', 'الكيس + ')}{k.parts.map(x => packOf(x.id)!.name[lang]).join(' + ')}</small><small class={`allergy ${allergyNote(k, lang).none ? 'none' : ''}`}>{allergyNote(k, lang).text}</small></span></label>
            ))}
            {ownWays.map(c => (
              <label><input type="radio" name="style" value={c.id} data-priced={c.price != null ? '1' : ''} data-price-text={priceText(c.price, lang)} /><span><b>{c.name[lang]}</b><small>{L('A bag of its own: ', 'كيس قائم بذاته: ')}{c.notes[lang]}</small></span></label>
            ))}
            <label class="nothing"><input type="radio" name="style" value={p.id} checked={startId === p.id} data-priced={p.price != null ? '1' : ''} data-price-text={priceText(p.price, lang)} /><span><b>{L('Nothing added', 'بدون إضافات')}</b><small>{p.spices.length ? L(`${p.name.en} with ${p.spices.map(x => SPICES[x].name.en.toLowerCase()).join(' and ')} only`, `${p.name.ar} بال${p.spices.map(x => SPICES[x].name.ar).join(' وال')} فقط`) : L('Just the bag', 'الكيس وحده')}</small></span></label>
            {packsFor.length > 0 && <p class="muted try">{L('Already have the bag? Take the pack by itself: ', 'عندك الكيس؟ خذ الظرف وحده: ')}{packsFor.map((k, i) => <>{i > 0 && (ar ? '، ' : ', ')}<a href={path(lang, `shop/${k.id}`)}>{k.name[lang]}</a></>)}</p>}
            {discoveryFor && <p class="muted try">{L('Not sure which? ', 'لست متأكداً؟ ')}<a href={path(lang, `shop/${discoveryFor.id}`)}>{discoveryFor.name[lang]}</a>{L(' has a small pack of each.', ' فيها ظرف صغير من كل طريقة.')}</p>}
          </fieldset>
        )}
        {grinds.length > 0 && (
          <p class="grind-line"><span class="label">{UI.grind[lang]}</span> {GRINDS[grinds[0]][lang]}<input type="hidden" name="opt" value={grinds[0]} /></p>
        )}
        {p.kind === 'box' && p.chooseDate && (
          <fieldset class="choice">
            <legend>{UI.date[lang]}</legend>
            {Object.entries(DATES).map(([k, d], i) => <label><input type="radio" name="opt" value={k} checked={i === 1} /><span><i class="dot" style={`background:${d.c}`}></i>{d.name[lang]}</span></label>)}
          </fieldset>
        )}
        <div class="buy-row">
          <label class="qty"><span class="sr">{UI.qty[lang]}</span>
            <select name="qty">{[1, 2, 3, 4, 5, 6].map(n => <option value={n}>{n}</option>)}</select>
          </label>
          <button class="btn primary grow" type="button" id="mainAdd" data-add={startId} data-opt="" disabled={start.price == null}><span>{UI.add[lang]} · <span data-price-for={startId} id="addPrice">{priceText(start.price, lang)}</span></span></button>
        </div>
      </form>

      {cup && pairDate && (
        <div class="pour-with">
          <svg class="pw-date" viewBox="-26 -46 52 92" aria-hidden="true"><path fill={pairDate.c} d="M-2 -42c13 0 22 12 22 40c0 27-9 44-22 44c-12 0-21-15-21-43c0-29 8-41 21-41z" /><path d="M-12 -18q6 3 11 0M-14 4q7 4 14 0M-11 24q6 3 12-1M4 -30q5 2 9-1" stroke="#33211A" stroke-opacity=".3" stroke-width="2" fill="none" stroke-linecap="round" /></svg>
          <div class="pw-text">
            <p class="label">{UI.withDate[lang]}</p>
            <p class="pw-name">{pairDate.name[lang]} <span>· {pairDate.region[lang]}</span></p>
            <p class="muted">{cup.why[lang]}</p>
          </div>
          <button class="btn tamr pw-add" type="button" data-add="date-box" data-opt={cup.date}><span>{ar ? 'أضف ٥٠٠ غ · ' : 'Add 500 g · '}<span data-price-for="date-box">{priceText(dateBox.price, lang)}</span></span></button>
        </div>
      )}

      <ul class="assure">
        <li>{ar ? 'طلب مسبق: نؤكد بالبريد قبل أي دفع.' : 'Pre-order: we confirm by email before anything is paid.'}</li>
        <li>{ar ? 'استلام مجاني من الخميس إلى الأحد، من ٢٢ يناير ٢٠٢٧.' : 'Free pickup Thursday to Sunday, from 22 January 2027.'}</li>
        <li>{ar ? 'توصيل داخل كالغاري ٩ $، مجاني فوق ٨٠ $.' : 'Calgary delivery $9, free over $80.'}</li>
      </ul>

      <div class="acc">
        <details open>
          <summary>{ar ? 'الحكاية' : 'The story'}</summary>
          <p>{p.kind === 'coffee' || p.kind === 'kit' ? p.story[lang] : p.kind === 'pack' ? p.notes[lang] : p.contents[lang]}</p>
        </details>
        {brewFam && (
          <details>
            <summary>{UI.howToBrew[lang]}</summary>
            <ol>{BREW[brewFam].steps.map(s => <li>{s.t[lang]}</li>)}</ol>
            <a href={path(lang, 'brew') + `#${brewFam}`}>{ar ? 'الدليل مع المؤقّت' : 'The guide, with a timer'}</a>
          </details>
        )}
        {p.kind !== 'box' && (
          <details>
            <summary>{UI.ingredients[lang]} · English / Français</summary>
            {(p.kind === 'kit' ? [baseOf(p), ...p.parts.map(x => packOf(x.id)!)] : [p]).map(x => (
              <div class="label-box">
                {p.kind === 'kit' && <p><b>{x.name.en}</b></p>}
                <p><b>Ingredients:</b> {x.ingredients[0]}</p>
                <p lang="fr"><b>Ingrédients :</b> {x.ingredients[1]}</p>
                {x.kind === 'coffee' && <p><b>Net weight / Poids net:</b> {x.size}</p>}
                <p>Made in Calgary by Hikaya Coffee Ltd., [address], Calgary, AB · Fait à Calgary.</p>
              </div>
            ))}
          </details>
        )}
      </div>
    </div>
  </section>

  <div class="sticky-buy" id="stickyBuy" aria-hidden="true">
    <div><b>{p.name[lang]}</b><span class="price" data-price-for={p.id}>{priceText(p.price, lang)}</span></div>
    <button class="btn primary" type="button" id="stickyAdd" tabindex="-1">{UI.add[lang]}</button>
  </div>

  <section class="wrap related" aria-labelledby="rel-h">
    <h2 id="rel-h" class="h-m">{ar ? 'ومن الرف نفسه' : 'From the same shelf'}</h2>
    <div class="grid">{[...related, ...fill].map(o => <ProductCard p={o} lang={lang} />)}</div>
  </section>
</Base>

<script>
  // Gallery: front / back of the bag.
  const slides = document.querySelectorAll<HTMLElement>('.pdp-pouch .slide');
  document.querySelectorAll<HTMLButtonElement>('.thumbs [data-go]').forEach(b => b.addEventListener('click', () => {
    slides.forEach(s => s.classList.toggle('on', s.dataset.slide === b.dataset.go));
    document.querySelectorAll('.thumbs [data-go]').forEach(t => t.setAttribute('aria-selected', String(t === b)));
  }));
  // "Make it the way your family does": the add button follows the chosen style.
  const main = document.querySelector<HTMLButtonElement>('#mainAdd');
  const styleBox = document.getElementById('styles');
  if (styleBox && main) {
    const sync = () => {
      const r = styleBox.querySelector<HTMLInputElement>('input[name=style]:checked');
      if (!r) return;
      main.dataset.add = r.value;
      const live = (window as any).hikayaPrice?.(r.value) as string | undefined;
      const text = live ?? r.dataset.priceText ?? '';
      for (const id of ['addPrice', 'mainPrice']) { const el = document.getElementById(id); if (el) { el.dataset.priceFor = r.value; el.textContent = text; } }
      const ok = (window as any).hikayaOrderable?.(r.value) as boolean | undefined;
      main.disabled = ok === undefined ? !r.dataset.priced : !ok;
      const tag = main.parentElement?.querySelector<HTMLElement>('.sold-out-tag');
      if (tag) tag.hidden = !main.disabled;
    };
    styleBox.addEventListener('change', sync);
    sync();
    document.addEventListener('catalog:live', sync);
  }
  // Sticky add-to-cart on phones once the main button scrolls away.
  const bar = document.getElementById('stickyBuy');
  if (main && bar) {
    let ticking = false;
    const check = () => { ticking = false; bar.classList.toggle('on', main.getBoundingClientRect().bottom < 0); };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(check); } }, { passive: true });
    check();
    document.getElementById('stickyAdd')!.addEventListener('click', () => main.click());
  }
</script>

<style>
  .crumbs { display: flex; gap: 8px; flex-wrap: wrap; padding-block: 20px; font-size: 14.5px; color: var(--ink-2); }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .pdp { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 5vw, 80px); align-items: start; padding-bottom: clamp(56px, 8vw, 104px); }
  @media (max-width: 900px) { .pdp { grid-template-columns: 1fr; } }
  .pdp-media { position: sticky; top: 96px; }
  @media (max-width: 900px) { .pdp-media { position: static; } }
  .pdp-pouch { background: var(--paper-2); border-radius: 40px; border-bottom-left-radius: 8px; aspect-ratio: 4 / 5; display: grid; place-items: center; }
  .pdp-pouch { position: relative; }
  .pdp-pouch .slide { position: absolute; width: 52%; opacity: 0; transform: scale(.97); filter: blur(4px); transition: opacity .3s ease, transform .4s var(--ease), filter .3s ease; }
  .pdp-pouch .slide[data-slide='1'] { width: 66%; }
