---
import Base from '../../../layouts/Base.astro';
import ProductCard from '../../../components/ProductCard.astro';
import Pair from '../../../components/Pair.astro';
import { COFFEES, KITS, PACKS, BOXES, FAMILIES, LINES, type Lang, type CoffeeLine } from '../../../data/products';
import { path } from '../../../data/i18n';
import Pouch from '../../../components/Pouch.astro';
import Sachet from '../../../components/Sachet.astro';
import { packOf } from '../../../data/products';

export const getStaticPaths = () => [{ params: { lang: 'en' } }, { params: { lang: 'ar' } }];
const lang = Astro.params.lang as Lang;
const ar = lang === 'ar';
// Three lines. Each starts with the bag; the family styles are the bag plus its packs.
const lines = (['gulf', 'yemen', 'shami'] as CoffeeLine[]).map(l => ({
  id: l, bases: COFFEES.filter(c => c.line === l), styles: KITS.filter(k => k.line === l && !k.discovery),
})).map(l => l.styles.length
  // Where a line has styles, its other bags (Jubani, Qishr) are ways of their own and stand with
  // the styles; only the main bag stays under "Or the bag on its own".
  ? { ...l, bases: l.bases.slice(0, 1), ways: [...l.styles, ...l.bases.slice(1)] }
  : { ...l, ways: [] as typeof l.bases });
const discovery = KITS.filter(k => k.discovery);
const others = [
  { id: 'dates', items: BOXES.filter(b => b.fam === 'dates') },
  { id: 'ramadan', items: BOXES.filter(b => b.fam === 'ramadan') },
  { id: 'eid', items: BOXES.filter(b => b.fam === 'eid') },
] as const;
// Step 1 cards: each names everything inside it, so the smaller types are never hidden.
const PICK_LINE: Record<CoffeeLine, { en: string; ar: string }> = {
  gulf: { en: 'Pale and golden, from the dallah', ar: 'شقراء وذهبية، من الدلّة' },
  yemen: { en: 'From the pot, ginger in the packs', ar: 'من الإبريق، والزنجبيل في الظروف' },
  shami: { en: 'Powder-fine, with foam, from the rakwa', ar: 'ناعمة برغوتها، من الركوة' },
};
const T = {
  yemenNote: { en: 'Hadrami, Rada’i and Baydani are the Yemeni bag with its sealed pack, ginger included, in one box at one price. Jubani (the coffee with its own husk) and Qishr (the husk alone, with ginger) are bags of their own.', ar: 'الحضرمية والرداعية والبيضانية هي الكيس اليمني مع ظرفه المختوم، وفيه الزنجبيل، في علبة واحدة وبسعر واحد. والجُبَني (القهوة مع قشرها) والقشر (القشر وحده مع الزنجبيل) كيسان قائمان بذاتهما.' },
  bag: { en: 'The bag', ar: 'الكيس' },
  styles: { en: 'Make it the way your family does', ar: 'اصنعها على طريقة أهلك' },
  stylesNote: { en: 'Each style is the same bag with its sealed packs, in one box at one price. The spices that carry allergens stay in their packs, never in the coffee.', ar: 'كل طريقة هي الكيس نفسه مع ظروفه المختومة، في علبة واحدة وبسعر واحد. البهارات التي فيها مسببات حساسية تبقى في ظروفها، لا في القهوة.' },
};
---
<Base lang={lang} title={ar ? 'المتجر' : 'Shop'} current="shop">
  <section class="wrap shop-head">
    <div>
      <h1 class="h-l">{ar ? 'القهوة والتمر' : 'Coffee & dates'}</h1>
      <p class="lead">{ar ? 'محمّصة بكميات صغيرة في كالغاري. اختر قهوتك، ثم اصنعها على طريقة أهلك. الأسعار تُعلن قريباً، والطلب المسبق يفتح قرابة عيد الميلاد، استعداداً لرمضان.' : 'Roasted in small batches in Calgary. Choose your coffee, then make it the way your family does. Prices are announced soon, and pre-orders open around Christmas, in time for Ramadan.'}</p>
    </div>
    <Pair lang={lang} size="s" bunn={{ ar: 'من أين نبدأ؟', en: 'Where do we start?' }} tamr={{ ar: 'من الكيس، ثم طريقة أهلك.', en: 'With the bag, then your family’s way.' }} />
  </section>

  <!-- How it works, in one line of pictures: bag + packs = your family's way, all in one box. -->
  <section class="wrap how" aria-labelledby="how-h">
    <h2 id="how-h" class="sr">{ar ? 'كيف يعمل' : 'How it works'}</h2>
    <div class="how-row">
      <div class="how-item">
        <span class="how-pic"><Pouch coffee={COFFEES[0]} lang={lang} label={false} /></span>
        <p><b>{ar ? 'الكيس' : 'The bag'}</b><span>{ar ? 'القهوة والهيل مخلوط فيها، في الخليجية واليمنية.' : 'The coffee, with cardamom already mixed in, Gulf and Yemeni alike.'}</span></p>
      </div>
      <span class="how-op" aria-hidden="true">+</span>
      <div class="how-item">
        <span class="how-pic packs"><Sachet pack={packOf('pack-saffron')!} lang={lang} /><Sachet pack={packOf('pack-qassim')!} lang={lang} /></span>
        <p><b>{ar ? 'الظروف' : 'The packs'}</b><span>{ar ? 'ما يضيفه أهلك: الزعفران، الخلطة القصيمية، الزنجبيل والسمسم... مختومة، وعلى كل ظرف مكوناته.' : 'What your family adds: saffron, the Qassim blend, ginger and sesame... sealed, each with its own label.'}</span></p>
      </div>
      <span class="how-op" aria-hidden="true">=</span>
      <div class="how-item how-end">
        <p><b>{ar ? 'طريقة أهلك، في علبة واحدة' : 'Your family’s way, in one box'}</b><span>{ar ? 'تختار الطريقة، فتأتي مع ظروفها. لا شيء آخر تشتريه.' : 'Choose a style and its packs come with it. Nothing else to buy.'}</span></p>
      </div>
    </div>
  </section>

  <!-- Step 1: choose the coffee. Without JavaScript every panel below simply shows. -->
  <section class="wrap picker" aria-labelledby="pick-h">
    <h2 id="pick-h" class="step"><span>1</span>{ar ? 'اختر قهوتك' : 'Choose your coffee'}</h2>
    <div class="pick-cards" role="tablist" aria-labelledby="pick-h">
      {lines.map(l => (
        <button type="button" role="tab" class="pick" id={`tab-${l.id}`} aria-controls={l.id} aria-selected="false" data-pick={l.id}>
          <span class="pick-bag"><Pouch coffee={l.bases[0]} lang={lang} label={false} /></span>
          <span class="pick-txt">
            <b>{LINES[l.id].name[lang]}</b>
            <small>{PICK_LINE[l.id][lang]}</small>
            <em>{[...l.bases, ...l.ways].map(p => p.name[lang]).join(' · ')}</em>
          </span>
        </button>
      ))}
    </div>
    <div class="pick-more" role="tablist" aria-label={ar ? 'خيارات أخرى' : 'More ways in'}>
      <button type="button" role="tab" class="pill try" id="tab-start" aria-controls="start" aria-selected="false" data-pick="start">{ar ? 'جديد عليها؟ جرّب الطرق كلها في علبة' : 'New to it? Try every style in one box'}</button>
      <button type="button" role="tab" class="pill" id="tab-packs" aria-controls="packs" aria-selected="false" data-pick="packs">{ar ? 'عندي كيس: الظرف وحده' : 'I have a bag: just the pack'}</button>
      <a class="pill ghost" href={path(lang, 'find')}>{ar ? 'لست متأكداً؟ ثلاثة أسئلة' : 'Not sure? Three questions'}</a>
      <a class="pill ghost" href="#dates">{ar ? 'التمر والصناديق' : 'Dates & boxes'}</a>
    </div>
  </section>

  <!-- Step 2: the chosen coffee. -->
  <div class="panels" id="panels">
    {lines.map(l => (
      <section class="fam panel" id={l.id} role="tabpanel" aria-labelledby={`tab-${l.id}`} data-panel={l.id}>
        <div class="wrap">
          <div class="fam-head">
            <h2 class="h-m">{LINES[l.id].name[lang]}</h2>
            <p class="muted">{LINES[l.id].line[lang]}</p>
          </div>
          <h3 class="step"><span>2</span>{l.ways.length ? T.styles[lang] : (ar ? 'اختر كيسك' : 'Choose your bag')}</h3>
          {l.ways.length > 0 && <p class="muted step-note">{l.id === 'yemen' ? T.yemenNote[lang] : T.stylesNote[lang]}</p>}
          {discovery.filter(k => k.line === l.id).map(k => (
            <a class="try-box" href={path(lang, `shop/${k.id}`)}>
              <span class="try-pics">{k.parts.map(x => <Sachet pack={packOf(x.id)!} lang={lang} mini={x.mini} />)}</span>
              <span class="try-txt"><b>{ar ? `لست متأكداً؟ ${k.name.ar}` : `Not sure which? ${k.name.en}`}</b><span>{k.notes[lang]}</span></span>
              <span class="try-go" aria-hidden="true">{ar ? '←' : '→'}</span>
            </a>
          ))}
          {l.ways.length > 0 && <div class="grid">{l.ways.map(p => <ProductCard p={p} lang={lang} />)}</div>}
          {l.ways.length > 0 && <h4 class="sub-h">{ar ? 'أو الكيس وحده' : 'Or the bag on its own'}</h4>}
          <div class="grid">{l.bases.map(p => <ProductCard p={p} lang={lang} />)}</div>
        </div>
      </section>
    ))}

    <section class="fam panel start" id="start" role="tabpanel" aria-labelledby="tab-start" data-panel="start">
      <div class="wrap">
        <div class="fam-head">
          <h2 class="h-m">{ar ? 'جديد عليها؟ ابدأ من هنا' : 'New to it? Start here'}</h2>
          <p class="muted">{ar ? 'كيس واحد مع ظروف صغيرة: جرّب كل طريقة في بيتك، ثم اختر طريقتك.' : 'One bag with small packs: try each style at home, then choose yours.'}</p>
        </div>
        <div class="grid">{discovery.map(p => <ProductCard p={p} lang={lang} />)}</div>
      </div>
    </section>

    <section class="fam panel" id="packs" role="tabpanel" aria-labelledby="tab-packs" data-panel="packs">
      <div class="wrap">
        <div class="fam-head">
          <h2 class="h-m">{ar ? 'الظرف وحده' : 'Just the pack'}</h2>
          <p class="muted">{ar ? 'للبيت الذي عنده كيس. كل ظرف مكتوب عليه الكيس الذي صُنع له.' : 'For the house that already has a bag. Each pack says which bag it is made for.'}</p>
        </div>
        <div class="grid">{PACKS.map(p => <ProductCard p={p} lang={lang} />)}</div>
      </div>
    </section>
  </div>

  {others.map((g, gi) => (
    <section class={`fam ${gi % 2 ? '' : 'alt'}`} id={g.id} aria-labelledby={`h-${g.id}`} data-group data-season={g.id === 'ramadan' || g.id === 'eid' ? g.id : undefined}>
      <div class="wrap">
        <div class="fam-head">
          <h2 id={`h-${g.id}`} class="h-m">{FAMILIES[g.id].name[lang]}</h2>
          <p class="muted">{FAMILIES[g.id].line[lang]}</p>
        </div>
        <div class="grid">{g.items.map(p => <ProductCard p={p} lang={lang} />)}</div>
      </div>
    </section>
  ))}
</Base>

<script>
  // One coffee at a time: the chosen card opens its panel. The address keeps the choice (#yemen),
  // so links from the homepage, the brew guide and product pages open the right one.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-pick]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
  const ids = tabs.map(t => t.dataset.pick!);
  document.getElementById('panels')!.classList.add('js');
  function choose(id: string, scroll: boolean) {
    tabs.forEach(t => t.setAttribute('aria-selected', String(t.dataset.pick === id)));
    panels.forEach(p => { p.hidden = p.dataset.panel !== id; });
    history.replaceState(null, '', `#${id}`);
    if (scroll) document.getElementById(id)?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
  }
  tabs.forEach(t => t.addEventListener('click', () => choose(t.dataset.pick!, true)));
  const fromHash = () => { const h = location.hash.slice(1); if (ids.includes(h)) { choose(h, true); return true; } return false; };
  if (!fromHash()) { tabs.forEach(t => t.setAttribute('aria-selected', 'false')); panels.forEach(p => { p.hidden = p.dataset.panel !== 'gulf'; }); tabs[0].setAttribute('aria-selected', 'true'); }
  addEventListener('hashchange', fromHash);
</script>

<style>
  .shop-head { display: grid; grid-template-columns: 1.3fr .7fr; gap: 24px 64px; align-items: end; padding-block: clamp(40px, 6vw, 80px) 28px; }
  .shop-head > div { display: grid; gap: 14px; }
  @media (max-width: 860px) { .shop-head { grid-template-columns: 1fr; } }
  .how { padding-bottom: 28px; }
  .how-row { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; gap: 14px; align-items: center; padding: 18px; border-radius: 28px; border-bottom-left-radius: 6px; background: var(--sheet); }
  .how-item { display: grid; grid-template-columns: auto 1fr; gap: 12px; align-items: center; }
  .how-item p { margin: 0; display: grid; gap: 2px; }
  .how-item b { font-family: var(--display); font-size: 18px; }
  .how-item span { font-size: 14px; color: var(--ink-2); }
  .how-pic { width: 46px; display: block; }
  .how-pic.packs { width: 64px; display: flex; gap: 4px; }
  .how-pic.packs :global(.sachet) { width: 30px; }
  .how-op { font-family: var(--display); font-size: 30px; color: var(--tamr); }
  .how-end { grid-template-columns: 1fr; padding: 12px 14px; border-radius: 18px; background: color-mix(in srgb, var(--khalal) 18%, var(--sheet)); }
  @media (max-width: 860px) { .how-row { grid-template-columns: 1fr; gap: 8px; } .how-op { justify-self: center; line-height: 1; } }
  .pill.try { background: var(--tamr); color: var(--tamr-ink, #fff); box-shadow: none; }
  .pill.try[aria-selected='true'] { background: var(--bunn); }
  .try-box { display: grid; grid-template-columns: auto 1fr auto; gap: 16px; align-items: center; margin: 0 0 28px; padding: 14px 18px; border-radius: 22px; border-bottom-right-radius: 6px; background: var(--sheet); box-shadow: inset 0 0 0 2px var(--tamr); text-decoration: none; color: var(--ink); }
  .try-box:hover { background: color-mix(in srgb, var(--tamr) 6%, var(--sheet)); }
  .try-pics { display: flex; gap: 4px; width: 96px; }
  .try-pics :global(.sachet) { width: 30px; }
  .try-txt { display: grid; gap: 2px; }
  .try-txt b { font-family: var(--display); font-size: 19px; color: var(--tamr); }
  .try-txt span { font-size: 14.5px; color: var(--ink-2); }
  .try-go { font-size: 22px; color: var(--tamr); }
  .picker { display: grid; gap: 16px; padding-bottom: 36px; }
  .pick-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  @media (max-width: 760px) { .pick-cards { grid-template-columns: 1fr; gap: 10px; } }
  .pick { display: grid; grid-template-columns: 74px 1fr; gap: 14px; align-items: center; text-align: start; border: 0; padding: 14px 16px; border-radius: 26px; border-bottom-left-radius: 6px; background: var(--sheet); box-shadow: inset 0 0 0 1.5px var(--line); color: var(--ink); cursor: pointer; transition: box-shadow .15s, transform .15s var(--ease); }
  .pick:hover { box-shadow: inset 0 0 0 1.5px var(--bunn); }
  .pick:active { transform: scale(.98); }
  .pick[aria-selected='true'] { box-shadow: inset 0 0 0 2.5px var(--bunn); background: color-mix(in srgb, var(--khalal) 14%, var(--sheet)); }
  .pick:focus-visible { outline: 2.5px solid var(--tamr); outline-offset: 3px; }
  .pick-bag { width: 74px; }
  .pick-txt { display: grid; gap: 3px; }
  .pick-txt b { font-family: var(--display); font-size: 21px; }
  .pick-txt small { color: var(--ink-2); font-size: 14px; }
  .pick-txt em { font-style: normal; font-size: 13px; font-weight: 600; color: var(--tamr); }
  @media (max-width: 760px) { .pick { grid-template-columns: 52px 1fr; padding: 10px 14px; } .pick-bag { width: 52px; } }
  .pick-more { display: flex; flex-wrap: wrap; gap: 8px; }
  .pill { border: 0; background: var(--paper); color: var(--ink); font: inherit; font-weight: 600; font-size: 15px; padding: 9px 15px; border-radius: 999px; box-shadow: inset 0 0 0 1.5px var(--line); text-decoration: none; cursor: pointer; }
  .pill:hover { box-shadow: inset 0 0 0 1.5px var(--bunn); }
  .pill[aria-selected='true'] { background: var(--bunn); color: var(--paper); box-shadow: none; }
  .pill.ghost { font-weight: 500; color: var(--ink-2); }
  .fam { padding-block: 40px 64px; scroll-margin-top: 90px; }
  .panel { background: var(--paper-2); }
  .fam.alt { background: var(--paper-2); }
  .fam-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6px 24px; margin-bottom: 22px; }
  .step { display: flex; align-items: center; gap: 10px; font-size: 21px; margin: 8px 0 16px; }
  .step span { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--bunn); color: var(--paper); font-size: 15px; flex: none; }
  .sub-h { font-size: 17px; margin: 40px 0 16px; color: var(--ink-2); }
  .step-note { margin: -8px 0 18px; max-width: 70ch; font-size: 15px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); gap: 36px 24px; }
</style>
