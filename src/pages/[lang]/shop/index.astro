---
import Base from '../../../layouts/Base.astro';
import ProductCard from '../../../components/ProductCard.astro';
import { COFFEES, KITS, PACKS, BOXES, FAMILIES, LINES, type Lang, type CoffeeLine } from '../../../data/products';
import { path } from '../../../data/i18n';
import Pouch from '../../../components/Pouch.astro';

export const getStaticPaths = () => [{ params: { lang: 'en' } }, { params: { lang: 'ar' } }];
const lang = Astro.params.lang as Lang;
const ar = lang === 'ar';
// Step 1 cards. Each coffee line starts with its bag; the family styles are the bag plus its packs.
// Qishr is a drink of its own (the husk, brewed like tea), so it gets its own card.
const SUB: Record<string, { en: string; ar: string }> = {
  gulf: { en: 'Pale and golden, from the dallah', ar: 'شقراء وذهبية، من الدلّة' },
  yemen: { en: 'From the pot, ginger in the packs', ar: 'من الإبريق، والزنجبيل في الظروف' },
  shami: { en: 'Powder-fine, with foam, from the rakwa', ar: 'ناعمة برغوتها، من الركوة' },
  qishr: { en: 'From Yemen: the coffee cherry, brewed like tea', ar: 'من اليمن: ثمرة البن، تُغلى مثل الشاي' },
};
const lines = (['gulf', 'yemen', 'shami'] as CoffeeLine[]).map(l => ({
  id: l as string, name: LINES[l].name, sub: SUB[l],
  bases: COFFEES.filter(c => c.line === l && c.id !== 'qishr'), styles: KITS.filter(k => k.line === l && !k.discovery),
})).map(l => l.styles.length
  // Where a line has styles, its other bags (Jubani, Qishr) are ways of their own and stand with
  // the styles; only the main bag stays under "Or the bag on its own".
  ? { ...l, bases: l.bases.slice(0, 1), ways: [...l.styles, ...l.bases.slice(1)] }
  : { ...l, ways: [] as typeof l.bases });
lines.push({ id: 'qishr', name: { en: 'Qishr', ar: 'القشر' }, sub: SUB.qishr, bases: COFFEES.filter(c => c.id === 'qishr'), styles: [], ways: [] });
const discovery = KITS.filter(k => k.discovery);
const others = [
  { id: 'dates', items: BOXES.filter(b => b.fam === 'dates') },
  { id: 'ramadan', items: BOXES.filter(b => b.fam === 'ramadan') },
  { id: 'eid', items: BOXES.filter(b => b.fam === 'eid') },
] as const;
---
<Base lang={lang} title={ar ? 'المتجر' : 'Shop'} current="shop">
  <section class="wrap shop-head">
    <h1 class="h-l">{ar ? 'القهوة والتمر' : 'Coffee & dates'}</h1>
    <p class="lead">{ar ? 'اختر قهوتك، ثم اختر كيف تشربها.' : 'Choose your coffee, then how you take it.'}</p>
    <p class="muted small">{ar ? 'كل طريقة تأتي في علبة واحدة، الكيس وظروفه معاً. الأسعار تُعلن قريباً.' : 'Each style comes in one box, the bag and its packs together. Prices are announced soon.'}</p>
  </section>

  <!-- Step 1: choose the coffee. Without JavaScript every panel below simply shows. -->
  <section class="wrap picker" aria-label={ar ? 'اختر قهوتك' : 'Choose your coffee'}>
    <div class="pick-cards" role="tablist">
      {lines.map(l => (
        <button type="button" role="tab" class="pick" id={`tab-${l.id}`} aria-controls={l.id} aria-selected="false" data-pick={l.id}>
          <span class="pick-bag"><Pouch coffee={l.bases[0]} lang={lang} label={false} /></span>
          <span class="pick-txt">
            <b>{l.name[lang]}</b>
            <small>{l.sub[lang]}</small>
            {l.ways.length + l.bases.length > 1 && <em>{l.ways.length + l.bases.length} {ar ? 'خيارات' : 'choices'}</em>}
          </span>
        </button>
      ))}
    </div>
    <p class="pick-more">
      <button type="button" role="tab" class="link" id="tab-start" aria-controls="start" aria-selected="false" data-pick="start">{ar ? 'جديد عليها؟ جرّب علبة التذوق' : 'New to it? Try a tasting box'}</button>
      <span aria-hidden="true">·</span>
      <button type="button" role="tab" class="link" id="tab-packs" aria-controls="packs" aria-selected="false" data-pick="packs">{ar ? 'عندك كيس؟ الظرف وحده' : 'Have a bag? Just the pack'}</button>
    </p>
  </section>

  <!-- Step 2: the chosen coffee. -->
  <div class="panels" id="panels">
    {lines.map(l => {
      const tasting = discovery.find(k => k.line === l.id);
      return (
        <section class="fam panel" id={l.id} role="tabpanel" aria-labelledby={`tab-${l.id}`} data-panel={l.id}>
          <div class="wrap">
            <div class="panel-head">
              <div><h2 class="h-m">{l.ways.length ? (ar ? 'كيف تشربها؟' : 'How do you take it?') : l.name[lang]}</h2>{l.ways.length > 0 && <p class="muted tagline">{ar ? 'لكل منطقة طريقتها، ولكل بيت فنجان.' : 'Every region has its way, every home its cup.'}</p>}</div>
              {tasting && <a class="link" href={path(lang, `shop/${tasting.id}`)}>{ar ? `لست متأكداً؟ ${tasting.name.ar}، فيها قليل من كل طريقة` : `Not sure? ${tasting.name.en} has a little of each`} <span aria-hidden="true">{ar ? '←' : '→'}</span></a>}
            </div>
            {l.ways.length > 0 && <div class="grid">{l.ways.map(p => <ProductCard p={p} lang={lang} />)}</div>}
            {l.ways.length > 0
              ? <div class="plain">
                  <div><h3 class="sub-h">{ar ? 'بدون إضافات' : 'Nothing added'}</h3>{l.bases.map(p => <ProductCard p={p} lang={lang} row />)}</div>
                  <div class="by-itself"><h3 class="sub-h">{ar ? 'عندك الكيس؟ الظرف وحده' : 'Have the bag? The pack by itself'}</h3>
                    <ul>{PACKS.filter(k => k.line === l.id).map(k => <li><a href={path(lang, `shop/${k.id}`)}>{k.name[lang]}</a></li>)}</ul>
                  </div>
                </div>
              : <>
                  {l.id === 'qishr' && <p class="muted panel-note">{ar ? 'أقدم مشروبات البن في اليمن: قشر الثمرة المجفف مع الزنجبيل، يُغلى في الإبريق. قليل الكافيين.' : 'Yemen’s oldest coffee drink: the dried cherry husk with ginger, brewed in the pot. Light on caffeine.'}</p>}
                  <div class="grid">{l.bases.map(p => <ProductCard p={p} lang={lang} />)}</div>
                </>}
          </div>
        </section>
      );
    })}

    <section class="fam panel" id="start" role="tabpanel" aria-labelledby="tab-start" data-panel="start">
      <div class="wrap">
        <div class="panel-head">
          <h2 class="h-m">{ar ? 'علب التذوق' : 'Tasting boxes'}</h2>
          <a class="link" href={path(lang, 'find')}>{ar ? 'أو أجب عن ثلاثة أسئلة' : 'Or answer three questions'} <span aria-hidden="true">{ar ? '←' : '→'}</span></a>
        </div>
        <p class="muted panel-note">{ar ? 'كيس واحد مع ظرف صغير من كل طريقة. جرّبها في بيتك، ثم اختر طريقتك.' : 'One bag with a small pack of each style. Try them at home, then choose yours.'}</p>
        <div class="grid">{discovery.map(p => <ProductCard p={p} lang={lang} />)}</div>
      </div>
    </section>

    <section class="fam panel" id="packs" role="tabpanel" aria-labelledby="tab-packs" data-panel="packs">
      <div class="wrap">
        <div class="panel-head"><h2 class="h-m">{ar ? 'الظرف وحده' : 'Just the pack'}</h2></div>
        <p class="muted panel-note">{ar ? 'لكيس عندك في البيت. كل ظرف مكتوب عليه الكيس الذي صُنع له.' : 'For a bag you already have. Each pack says which bag it is made for.'}</p>
        <div class="grid">{PACKS.map(p => <ProductCard p={p} lang={lang} />)}</div>
      </div>
    </section>
  </div>

  {others.map((g, gi) => (
    <section class={`fam ${gi % 2 ? '' : 'alt'}`} id={g.id} aria-labelledby={`h-${g.id}`} data-group data-season={g.id === 'ramadan' || g.id === 'eid' ? g.id : undefined}>
      <div class="wrap">
        <div class="fam-head">
          <h2 id={`h-${g.id}`} class="h-m">{FAMILIES[g.id].name[lang]}</h2>
          <p class="muted">{FAMILIES[g.id].line[lang]}</p>
        </div>
        <div class="grid">{g.items.map(p => <ProductCard p={p} lang={lang} />)}</div>
      </div>
    </section>
  ))}
</Base>

<script>
  // One coffee at a time: the chosen card opens its panel. The address keeps the choice (#yemen),
  // so links from the homepage, the brew guide and product pages open the right one.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-pick]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
  const ids = tabs.map(t => t.dataset.pick!);
  document.getElementById('panels')!.classList.add('js');
  function choose(id: string, scroll: boolean) {
    tabs.forEach(t => t.setAttribute('aria-selected', String(t.dataset.pick === id)));
    panels.forEach(p => { p.hidden = p.dataset.panel !== id; });
    history.replaceState(null, '', `#${id}`);
    if (scroll) document.getElementById(id)?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
  }
  tabs.forEach(t => t.addEventListener('click', () => choose(t.dataset.pick!, true)));
  const fromHash = () => { const h = location.hash.slice(1); if (ids.includes(h)) { choose(h, true); return true; } return false; };
  if (!fromHash()) { tabs.forEach(t => t.setAttribute('aria-selected', 'false')); panels.forEach(p => { p.hidden = p.dataset.panel !== 'gulf'; }); tabs[0].setAttribute('aria-selected', 'true'); }
  addEventListener('hashchange', fromHash);
</script>

<style>
  .shop-head { display: grid; gap: 10px; padding-block: clamp(36px, 5vw, 64px) 24px; }
  .shop-head > * { max-width: 760px; }
  .small { font-size: 15px; }
  .picker { display: grid; gap: 14px; padding-bottom: 32px; }
  .pick-cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  @media (max-width: 1100px) { .pick-cards { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 760px) { .pick-cards { grid-template-columns: 1fr; gap: 8px; } }
  .pick { display: grid; grid-template-columns: 60px 1fr; gap: 14px; align-items: center; text-align: start; border: 0; padding: 14px 16px; border-radius: 22px; background: var(--sheet); box-shadow: inset 0 0 0 1.5px var(--line); color: var(--ink); cursor: pointer; transition: box-shadow .15s, background .15s, transform .15s var(--ease); }
  .pick:hover { box-shadow: inset 0 0 0 1.5px var(--bunn); }
  .pick:active { transform: scale(.98); }
  .pick[aria-selected='true'] { box-shadow: inset 0 0 0 2.5px var(--bunn); background: color-mix(in srgb, var(--khalal) 14%, var(--sheet)); }
  .pick:focus-visible { outline: 2.5px solid var(--tamr); outline-offset: 3px; }
  .pick-bag { width: 60px; }
  .pick-txt { display: grid; gap: 2px; }
  .pick-txt b { font-family: var(--display); font-size: 21px; }
  .pick-txt small { color: var(--ink-2); font-size: 14px; }
  .pick-txt em { font-style: normal; font-size: 13px; color: var(--ink-2); opacity: .8; }
  @media (max-width: 760px) { .pick { grid-template-columns: 44px 1fr; padding: 10px 14px; } .pick-bag { width: 44px; } }
  .pick-more { display: flex; flex-wrap: wrap; gap: 6px 12px; align-items: center; margin: 0; color: var(--ink-2); }
  @media (max-width: 560px) { .pick-more > span { display: none; } }
  .link { border: 0; background: none; padding: 4px 0; font: inherit; font-weight: 600; font-size: 15px; color: var(--tamr); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; cursor: pointer; }
  .link[aria-selected='true'] { color: var(--bunn); text-decoration-thickness: 2px; }
  .fam { padding-block: 40px 64px; scroll-margin-top: 90px; }
  .panel { background: var(--paper-2); }
  .fam.alt { background: var(--paper-2); }
  .panel-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 24px; margin-bottom: 24px; }
  .tagline { margin-top: 4px; font-size: 15.5px; }
  .panel-note { margin: -12px 0 24px; font-size: 15px; }
  .fam-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6px 24px; margin-bottom: 22px; }
  .plain { display: grid; grid-template-columns: 1.5fr 1fr; gap: 24px; margin-top: 44px; align-items: start; }
  .plain > div { display: grid; gap: 12px; }
  @media (max-width: 860px) { .plain { grid-template-columns: 1fr; } }
  .by-itself ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .by-itself a { display: inline-block; padding: 8px 14px; border-radius: 999px; background: var(--sheet); box-shadow: inset 0 0 0 1.5px var(--line); text-decoration: none; font-weight: 600; font-size: 14.5px; color: var(--ink); }
  .by-itself a:hover { box-shadow: inset 0 0 0 1.5px var(--bunn); }
  .sub-h { font-size: 16px; color: var(--ink-2); font-weight: 600; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr)); gap: 36px 24px; }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr 1fr; gap: 28px 12px; } .grid :global(.pc h3) { font-size: 19px; } .grid :global(.pc h3 span) { font-size: 16px; } .grid :global(.pc-add span) { display: none; } .grid :global(.pc-add) { padding: 9px 11px; } }
</style>
