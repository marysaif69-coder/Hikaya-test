---
import Base from '../../../layouts/Base.astro';
import ProductCard from '../../../components/ProductCard.astro';
import { COFFEES, SPECIALTY, KITS, PACKS, BOXES, FAMILIES, LINES, DATES, EVERYDAY, FILLINGS, ALLERGENS, MIXED, varietiesOf, mixedOk, priceText, type Lang, type CoffeeLine, type Box, type DateId, type FillingId } from '../../../data/products';
import { path } from '../../../data/i18n';
import Pouch from '../../../components/Pouch.astro';
import { dateSvg } from '../../../data/date-art';

export const getStaticPaths = () => [{ params: { lang: 'en' } }, { params: { lang: 'ar' } }];
const lang = Astro.params.lang as Lang;
const ar = lang === 'ar';
// Step 1 cards. Each coffee line starts with its bag; the family styles are the bag plus its packs.
// Qishr is a drink of its own (the husk, brewed like tea), so it gets its own card.
const SUB: Record<string, { en: string; ar: string }> = {
  gulf: { en: 'Pale and golden, from the dallah', ar: 'شقراء وذهبية، من الدلّة' },
  yemen: { en: 'From the pot, ginger in the packs', ar: 'من الإبريق، والزنجبيل في الظروف' },
  shami: { en: 'Powder-fine, with foam, from the rakwa', ar: 'ناعمة برغوتها، من الركوة' },
  qishr: { en: 'From Yemen: the dried coffee cherry husk, brewed like tea', ar: 'من اليمن: قشر ثمرة البن المجفف، يُغلى مثل الشاي' },
};
const lines = (['gulf', 'yemen', 'shami'] as CoffeeLine[]).map(l => ({
  id: l as string, name: LINES[l].name, sub: SUB[l],
  bases: COFFEES.filter(c => c.line === l && c.id !== 'qishr'), styles: KITS.filter(k => k.line === l && !k.discovery),
})).map(l => l.styles.length
  // Where a line has styles, its other bags (Jubani, Qishr) are ways of their own and stand with
  // the styles; only the main bag stays under "Or the bag on its own".
  ? { ...l, bases: l.bases.slice(0, 1), ways: [...l.styles, ...l.bases.slice(1)] }
  : { ...l, ways: [] as typeof l.bases });
lines.push({ id: 'qishr', name: { en: 'Qishr', ar: 'القشر' }, sub: SUB.qishr, bases: COFFEES.filter(c => c.id === 'qishr'), styles: [], ways: [] });
const discovery = KITS.filter(k => k.discovery);
// Dates view. Everyday is sold by weight: one card per variety, a chip per size (each size is its
// own product, priced on the server by id). Reserve and stuffed: the variety or filling is chosen
// on the product page.
const BY_ID = Object.fromEntries(BOXES.map(b => [b.id, b]));
const SIZES = ['dates-250', 'date-box', 'dates-1kg'].map(id => BY_ID[id]);
const reserve = BOXES.filter(b => b.tier === 'reserve');
const stuffed = BOXES.filter(b => b.tier === 'stuffed');
// One date, or (Mixed) three side by side; stuffed dates show their filling.
const VIEWS = [
  { id: 'coffee', name: { ar: 'القهوة', en: 'Coffee' } },
  { id: 'dates', name: { ar: 'التمر', en: 'Dates' } },
  { id: 'gifts', name: { ar: 'الهدايا', en: 'Gifts' } },
  { id: 'beans', name: { ar: 'بن اليمن', en: 'Yemeni beans' } },
];
const dateArt = (c: string, filling?: string | null, mix?: { c: string; f?: string | null }[]) => mix
  ? `<svg viewBox="-72 -46 144 92" aria-hidden="true">${mix.map((m, i) => `<g transform="translate(${(i - 1) * 46} 0) scale(.9)">${dateSvg(m.c, m.f as FillingId | undefined)}</g>`).join('')}</svg>`
  : `<svg viewBox="-26 -46 52 92" aria-hidden="true">${dateSvg(c, filling as FillingId | undefined)}</svg>`;
// Reserve and stuffed: like Everyday, one card per kind (a variety, a filling, or Mixed) with a
// chip per box size (12 or 24); each size is its own product, and the kind is the option.
type Kind = { key: string; name: { en: string; ar: string }; sub: string; c: string; boxes: Box[]; art: string };
const toAr = (n: number) => (ar ? String(n).replace(/\d/g, d => '٠١٢٣٤٥٦٧٨٩'[+d]) : String(n));
const reserveKinds: Kind[] = [
  ...varietiesOf(reserve[0]).map((v: DateId) => ({ key: v, name: DATES[v].name, sub: `${DATES[v].region[lang]} · ${DATES[v].notes[lang]}`, c: DATES[v].c, boxes: reserve, art: dateArt(DATES[v].c) })),
  { key: 'mixed', name: MIXED, sub: ar ? `من كل صنف بالتساوي: ${toAr(4)} في علبة ١٢، و${toAr(8)} في علبة ٢٤.` : 'An even mix of the three: 4 of each in the 12, 8 of each in the 24.', c: DATES.medjool.c, boxes: reserve.filter(mixedOk), art: dateArt('', null, varietiesOf(reserve[0]).map(v => ({ c: DATES[v].c }))) },
];
const contains = (keys: FillingId[]) => (ar ? 'يحتوي على: ' : 'Contains: ') + [...new Set(keys.flatMap(k => FILLINGS[k].allergens))].map(a => ALLERGENS[a][lang]).join(ar ? '، ' : ', ');
const stuffedKinds: Kind[] = [
  ...(stuffed[0].fillings ?? []).map((f: FillingId) => ({ key: f, name: FILLINGS[f].name, sub: contains([f]) + (FILLINGS[f].maybe ? ` ${FILLINGS[f].maybe![lang]}` : ''), c: DATES.mufattal.c, boxes: stuffed, art: dateArt(DATES.mufattal.c, f) })),
  ...(stuffed.some(mixedOk) ? [{ key: 'mixed', name: MIXED, sub: `${ar ? 'كل الحشوات بالتساوي. ' : 'All the fillings, evenly. '}${contains(stuffed[0].fillings ?? [])}`, c: DATES.mufattal.c, boxes: stuffed.filter(mixedOk), art: dateArt('', null, (stuffed[0].fillings ?? []).slice(0, 3).map(f => ({ c: DATES.mufattal.c, f }))) }] : []),
];
// The gift boxes: Coffee & Dates, Two Coffees, Reserve and Stuffed (12), and Four Palms.
const gifts = ['guest-box', 'coffee-duo', 'reserve-12', 'stuffed-12', 'four-palms'].map(id => BY_ID[id]);
const DATE_PICKS = [
  { id: 'everyday', name: { ar: 'تمر كل يوم', en: 'Everyday' }, sub: { ar: 'خلاص وسكري قصيمي، بالوزن', en: 'Khalas and Sukkari Qassimi, by weight' }, c: DATES.khalas.c },
  { id: 'reserve', name: { ar: 'تمر النخبة', en: 'Reserve' }, sub: { ar: 'سكري ملكي مفتّل، عجوة، مجدول', en: 'Royal Sukkari Mufattal, Ajwa, Medjool' }, c: DATES.ajwa.c, badge: true },
  { id: 'stuffed', name: { ar: 'تمر محشي', en: 'Stuffed' }, sub: { ar: 'فستق، كاجو، كريمة البسكويت…', en: 'Pistachio, cashew, biscuit cream…' }, c: DATES.mufattal.c },
];
---
<Base lang={lang} title={ar ? 'المتجر' : 'Shop'} current="shop">
  <section class="wrap shop-head">
    <h1 class="h-l">{ar ? 'القهوة والتمر' : 'Coffee & dates'}</h1>
    <p class="lead">{ar ? 'اختر قهوتك وطريقتك في شربها، أو تمرك، أو هدية.' : 'Choose your coffee and how you take it, your dates, or a gift.'}</p>
    <p class="muted small">{ar ? 'كل طريقة قهوة تأتي في علبة واحدة، الكيس وظروفه معاً. الأسعار تُعلن قريباً.' : 'Each coffee style comes in one box, the bag and its packs together. Prices are announced soon.'}</p>
  </section>

  <!-- Coffee | Dates | Gift boxes | Yemeni beans. Without JavaScript the tabs stay hidden and the
       views simply show (the Yemeni beans only once the owners show them). -->
  <div class="wrap top-tabs" role="tablist" aria-label={ar ? 'أقسام المتجر' : 'Shop sections'} id="topTabs" hidden>
    {VIEWS.map((v, i) => <button type="button" role="tab" id={`view-tab-${v.id}`} aria-controls={`view-${v.id}`} aria-selected={i === 0 ? 'true' : 'false'} data-view={v.id}>{v.name[lang]}{!ar && <span lang="ar">{v.name.ar}</span>}</button>)}
  </div>

  <div id="view-coffee" role="tabpanel" aria-labelledby="view-tab-coffee" data-view-panel="coffee">
  <!-- Step 1: choose the coffee. Without JavaScript every panel below simply shows. -->
  <section class="wrap picker" aria-label={ar ? 'اختر قهوتك' : 'Choose your coffee'}>
    <div class="pick-cards" role="tablist">
      {lines.map(l => (
        <button type="button" role="tab" class="pick" id={`tab-${l.id}`} aria-controls={l.id} aria-selected="false" data-pick={l.id}>
          <span class="pick-bag"><Pouch coffee={l.bases[0]} lang={lang} label={false} /></span>
          <span class="pick-txt">
            <b>{l.name[lang]}</b>
            <small>{l.sub[lang]}</small>
            {l.ways.length + l.bases.length > 1 && <em>{ar ? (l.ways.length + l.bases.length === 2 ? 'خياران' : `${l.ways.length + l.bases.length} خيارات`) : `${l.ways.length + l.bases.length} choices`}</em>}
          </span>
        </button>
      ))}
    </div>
    <div class="pick-more" role="tablist" aria-label={ar ? 'خيارات أخرى' : 'More ways'}>
      <button type="button" role="tab" class="link" id="tab-start" aria-controls="start" aria-selected="false" data-pick="start">{ar ? 'جديد عليها؟ جرّب علبة التذوق' : 'New to it? Try a tasting box'}</button>
      <span aria-hidden="true">·</span>
      <button type="button" role="tab" class="link" id="tab-packs" aria-controls="packs" aria-selected="false" data-pick="packs">{ar ? 'عندك كيس جديد؟ الظرف وحده' : 'Have a fresh bag? Just the pack'}</button>
    </div>
  </section>

  <!-- Step 2: the chosen coffee. -->
  <div class="panels" id="panels">
    {lines.map(l => {
      const tasting = discovery.find(k => k.line === l.id);
      return (
        <section class="fam panel" id={l.id} role="tabpanel" aria-labelledby={`tab-${l.id}`} data-panel={l.id}>
          <div class="wrap">
            <div class="panel-head">
              <div><h2 class="h-m">{l.ways.length ? (ar ? 'كيف تشربها؟' : 'How do you take it?') : l.name[lang]}</h2>{l.ways.length > 0 && <p class="muted tagline">{ar ? 'لكل منطقة طريقتها، ولكل بيت فنجان.' : 'Every region has its way, every home its cup.'}</p>}</div>
              {tasting && <a class="link" href={path(lang, `shop/${tasting.id}`)}>{ar ? `لست متأكداً؟ ${tasting.name.ar}، فيها قليل من كل طريقة` : `Not sure? ${tasting.name.en} has a little of each`} <span aria-hidden="true">{ar ? '←' : '→'}</span></a>}
            </div>
            {l.ways.length > 0 && <div class="grid">{l.ways.map(p => <ProductCard p={p} lang={lang} />)}</div>}
            {l.ways.length > 0
              ? <div class="plain">
                  <div><h3 class="sub-h">{ar ? 'بدون إضافات' : 'Nothing added'}</h3>{l.bases.map(p => <ProductCard p={p} lang={lang} row />)}</div>
                  <div class="by-itself"><h3 class="sub-h">{ar ? 'عندك الكيس؟ الظرف وحده' : 'Have the bag? The pack by itself'}</h3>
                    <ul>{PACKS.filter(k => k.line === l.id).map(k => <li data-product={k.id}><a href={path(lang, `shop/${k.id}`)}>{k.name[lang]}</a></li>)}</ul>
                  </div>
                </div>
              : <>
                  {l.id === 'qishr' && <p class="muted panel-note">{ar ? 'أقدم مشروبات البن في اليمن: قشر الثمرة المجفف مع الزنجبيل، يُغلى في الإبريق. قليل الكافيين.' : 'Yemen’s oldest coffee drink: the dried cherry husk with ginger, brewed in the pot. Light on caffeine.'}</p>}
                  <div class="grid">{l.bases.map(p => <ProductCard p={p} lang={lang} />)}</div>
                </>}
          </div>
        </section>
      );
    })}

    <section class="fam panel" id="start" role="tabpanel" aria-labelledby="tab-start" data-panel="start">
      <div class="wrap">
        <div class="panel-head">
          <h2 class="h-m">{ar ? 'علب التذوق' : 'Tasting boxes'}</h2>
          <a class="link" href={path(lang, 'find')}>{ar ? 'أو أجب عن ثلاثة أسئلة' : 'Or answer three questions'} <span aria-hidden="true">{ar ? '←' : '→'}</span></a>
        </div>
        <p class="muted panel-note">{ar ? 'كيس واحد مع ظرف صغير من كل طريقة. جرّبها في بيتك، ثم اختر طريقتك.' : 'One bag with a small pack of each style. Try them at home, then choose yours.'}</p>
        <div class="grid">{discovery.map(p => <ProductCard p={p} lang={lang} />)}</div>
      </div>
    </section>

    <section class="fam panel" id="packs" role="tabpanel" aria-labelledby="tab-packs" data-panel="packs">
      <div class="wrap">
        <div class="panel-head"><h2 class="h-m">{ar ? 'الظرف وحده' : 'Just the pack'}</h2></div>
        <p class="muted panel-note">{ar ? 'لكيس عندك في البيت. كل ظرف مكتوب عليه الكيس الذي صُنع له.' : 'For a bag you already have. Each pack says which bag it is made for.'}</p>
        <div class="grid">{PACKS.map(p => <ProductCard p={p} lang={lang} />)}</div>
      </div>
    </section>
  </div>

  </div>

  <div id="view-dates" role="tabpanel" aria-labelledby="view-tab-dates" data-view-panel="dates">
    <section class="wrap picker" aria-label={ar ? 'اختر تمرك' : 'Choose your dates'}>
      <div class="pick-cards three" role="tablist" aria-label={ar ? 'اختر تمرك' : 'Choose your dates'}>
        {DATE_PICKS.map(d => (
          <button type="button" role="tab" class="pick" id={`dtab-${d.id}`} aria-controls={d.id} aria-selected="false" data-dpick={d.id}>
            <span class="pick-bag date-art" set:html={d.id === 'stuffed' ? dateArt(d.c, 'pistachio') : dateArt(d.c)} />
            <span class="pick-txt">
              <b>{d.name[lang]}{!ar && <span lang="ar" class="pick-ar">{d.name.ar}</span>}</b>
              <small>{d.sub[lang]}</small>
              {d.badge && <em class="badge">{ar ? 'ننصح بها' : 'Our pick'}{!ar && <span lang="ar"> · ننصح بها</span>}</em>}
            </span>
          </button>
        ))}
      </div>
      <p class="pick-more"><a class="link" href="#gifts">{ar ? 'هدية؟ علب الهدايا، مع القهوة أو بدونها' : 'A gift? Gift boxes, with coffee or without'}</a></p>
    </section>

    <section class="fam dsec" id="everyday" aria-labelledby="h-everyday" data-dpanel="everyday">
      <div class="wrap">
        <div class="panel-head"><h2 id="h-everyday" class="h-m">{ar ? 'تمر كل يوم' : 'Everyday dates'}</h2><p class="muted">{ar ? 'بالوزن، للبيت، في علبة شفافة.' : 'By weight, for the house, in a clear tray.'}</p></div>
        <fieldset class="kinds" data-kinds="everyday" hidden>
          <legend class="sr">{ar ? 'النوع' : 'Kind'}</legend>
          {EVERYDAY.map((k, i) => <label><input type="radio" name="kind-everyday" value={k} checked={i === 0} /><span>{DATES[k].name[lang]}</span></label>)}
        </fieldset>
        <div class="ed-grid">
          {EVERYDAY.map(v => { const d = DATES[v]; const def = BY_ID['date-box']; return (
            <article class="ed" data-chips={v} data-kind={v} data-kind-of="everyday">
              <span class="ed-art" set:html={dateArt(d.c)} />
              <div class="ed-txt">
                <h3>{d.name[lang]}{!ar && <span lang="ar">{d.name.ar}</span>}</h3>
                <p class="muted">{d.region[lang]} · {d.notes[lang]}</p>
                <fieldset class="sizes">
                  <legend class="sr">{ar ? 'الحجم' : 'Size'}</legend>
                  {SIZES.map(b => <label data-product={b.id}><input type="radio" name={`size-${v}`} value={b.id} checked={b.id === 'date-box'} data-price-text={priceText(b.price, lang)} data-priced={b.price != null ? '1' : ''} /><span>{b.size[lang]}</span></label>)}
                </fieldset>
                <div class="ed-buy">
                  <span class="price" data-price-for={def.id}>{priceText(def.price, lang)}</span>
                  <button class="btn primary sm" type="button" data-add={def.id} data-opt={v} disabled={def.price == null}><span>{ar ? 'أضف' : 'Add'}</span></button>
                </div>
              </div>
            </article>
          ); })}
        </div>
      </div>
    </section>

    <section class="fam dsec alt" id="reserve" aria-labelledby="h-reserve" data-dpanel="reserve">
      <div class="wrap">
        <div class="panel-head"><h2 id="h-reserve" class="h-m">{ar ? 'تمر النخبة' : 'Reserve dates'} <em class="badge">{ar ? 'ننصح بها' : 'Our pick'}</em></h2></div>
        <p class="muted panel-note">{ar ? 'تمر كل يوم بالوزن للبيت؛ والنخبة أكبر وأعتنى بها، في علب.' : 'Everyday dates by weight for the house; Reserve dates are larger and more carefully kept, boxed.'}</p>
        <fieldset class="kinds" data-kinds="reserve" hidden>
          <legend class="sr">{ar ? 'النوع' : 'Kind'}</legend>
          {reserveKinds.map((k, i) => <label><input type="radio" name="kind-reserve" value={k.key} checked={i === 0} /><span>{k.name[lang]}</span></label>)}
        </fieldset>
        <div class="ed-grid">
          {reserveKinds.map(k => <article class="ed" data-chips={`reserve-${k.key}`} data-kind={k.key} data-kind-of="reserve">
            <span class="ed-art" set:html={k.art} />
            <div class="ed-txt">
              <h3>{k.name[lang]}{!ar && <span lang="ar">{k.name.ar}</span>}</h3>
              <p class="muted">{k.sub}</p>
              <fieldset class="sizes"><legend class="sr">{ar ? 'العلبة' : 'Box'}</legend>
                {k.boxes.map((b, i) => <label data-product={b.id}><input type="radio" name={`size-reserve-${k.key}`} value={b.id} checked={i === 0} data-price-text={priceText(b.price, lang)} data-priced={b.price != null ? '1' : ''} /><span>{b.size[lang]}</span></label>)}
              </fieldset>
              <div class="ed-buy"><span class="price" data-price-for={k.boxes[0].id}>{priceText(k.boxes[0].price, lang)}</span>
                <button class="btn primary sm" type="button" data-add={k.boxes[0].id} data-opt={k.key} disabled={k.boxes[0].price == null}><span>{ar ? 'أضف' : 'Add'}</span></button></div>
            </div>
          </article>)}
        </div>
        <p class="muted more"><a href={path(lang, 'shop/reserve-12')}>{ar ? 'عن علبة النخبة' : 'About the Reserve box'}</a></p>
      </div>
    </section>

    <section class="fam dsec" id="stuffed" aria-labelledby="h-stuffed" data-dpanel="stuffed">
      <div class="wrap">
        <div class="panel-head"><h2 id="h-stuffed" class="h-m">{ar ? 'تمر محشي' : 'Stuffed dates'}</h2></div>
        <p class="muted panel-note">{ar ? 'حشوة واحدة لكل علبة، أو مشكّل. كل تمرة مغلّفة وحدها، مع ملصق مسببات الحساسية.' : 'One filling per box, or Mixed. Each date sealed on its own, with its allergen label.'}</p>
        <fieldset class="kinds" data-kinds="stuffed" hidden>
          <legend class="sr">{ar ? 'النوع' : 'Kind'}</legend>
          {stuffedKinds.map((k, i) => <label><input type="radio" name="kind-stuffed" value={k.key} checked={i === 0} /><span>{k.name[lang]}</span></label>)}
        </fieldset>
        <div class="ed-grid">
          {stuffedKinds.map(k => <article class="ed" data-chips={`stuffed-${k.key}`} data-kind={k.key} data-kind-of="stuffed">
            <span class="ed-art" set:html={k.art} />
            <div class="ed-txt">
              <h3>{k.name[lang]}{!ar && <span lang="ar">{k.name.ar}</span>}</h3>
              <p class="muted allergy">{k.sub}</p>
              <fieldset class="sizes"><legend class="sr">{ar ? 'العلبة' : 'Box'}</legend>
                {k.boxes.map((b, i) => <label data-product={b.id}><input type="radio" name={`size-stuffed-${k.key}`} value={b.id} checked={i === 0} data-price-text={priceText(b.price, lang)} data-priced={b.price != null ? '1' : ''} /><span>{b.size[lang]}</span></label>)}
              </fieldset>
              <div class="ed-buy"><span class="price" data-price-for={k.boxes[0].id}>{priceText(k.boxes[0].price, lang)}</span>
                <button class="btn primary sm" type="button" data-add={k.boxes[0].id} data-opt={k.key} disabled={k.boxes[0].price == null}><span>{ar ? 'أضف' : 'Add'}</span></button></div>
            </div>
          </article>)}
        </div>
        <p class="muted more"><a href={path(lang, 'shop/stuffed-12')}>{ar ? 'عن التمر المحشي' : 'About the stuffed dates'}</a></p>
      </div>
    </section>


  </div>

  <div id="view-gifts" role="tabpanel" aria-labelledby="view-tab-gifts" data-view-panel="gifts">
    <section class="fam dsec alt" id="gifts" aria-labelledby="h-gifts">
      <div class="wrap">
        <div class="panel-head"><h2 id="h-gifts" class="h-m">{ar ? 'علب الهدايا' : 'Gift boxes'}</h2><p class="muted">{ar ? 'قهوة وتمر بالحزام الذهبي، لأي زيارة وطوال السنة.' : 'Coffee and dates in the gold band, for any visit, all year.'}</p></div>
        <p class="muted panel-note">{ar ? 'اختر ما في العلبة في صفحتها: القهوة، والتمر صنفاً واحداً أو مشكّلاً.' : 'Choose what goes in on each box’s page: the coffee, and the dates, one kind or Mixed.'}</p>
        <p class="muted panel-note" data-season="ramadan eid">{ar ? 'في رمضان والعيد: اختر ملصق رمضان أو العيد في صفحة العلبة.' : 'In Ramadan and Eid: choose the Ramadan or Eid sticker on the box’s page.'}</p>
        <div class="grid">{gifts.map(p => <ProductCard p={p} lang={lang} />)}</div>
      </div>
    </section>
  </div>

  <!-- Yemeni beans: coffee grown in Yemen, 100 g in the black box. The tab goes away by itself when
       the owners hide all of them in Admin → Shop → Products. -->
  <div id="view-beans" role="tabpanel" aria-labelledby="view-tab-beans" data-view-panel="beans">
    <section class="fam dsec" id="beans" aria-labelledby="h-beans">
      <div class="wrap">
        <div class="panel-head"><div><h2 id="h-beans" class="h-m">{ar ? 'بن اليمن' : 'Yemeni beans'}{!ar && <span lang="ar" class="h-ar">بن اليمن</span>}</h2><p class="slogan">{ar ? 'من مزارعنا' : <>From our farms <span lang="ar">· من مزارعنا</span></>}</p></div><p class="muted">{ar ? 'زُرع في اليمن، ونحمّصه في كالغاري.' : 'Grown in Yemen, roasted in Calgary.'}</p></div>
        <p class="muted panel-note">{ar ? 'قهوتنا اليمنية على الطريقة اليمنية، من حبوب إثيوبية. وهذه حبوب من اليمن نفسه، من مدرجاته العالية، في دفعات صغيرة: ١٠٠ غ في علبة سوداء، لفنجان يُشرب وحده بلا هيل ولا بهار.' : 'Our Yemeni qahwa is Yemeni-style, from Ethiopian beans. These are beans from Yemen itself, from its high terraces, in small lots: 100 g in a black box, for a cup on its own, no cardamom, no spice.'}</p>
        <div class="grid">{SPECIALTY.map(p => <ProductCard p={p} lang={lang} />)}</div>
      </div>
    </section>
  </div>
</Base>

<script>
  // One coffee at a time: the chosen card opens its panel. The address keeps the choice (#yemen),
  // so links from the homepage, the brew guide and product pages open the right one.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-pick]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
  const ids = tabs.map(t => t.dataset.pick!);
  document.getElementById('panels')!.classList.add('js');
  function choose(id: string, scroll: boolean) {
    tabs.forEach(t => t.setAttribute('aria-selected', String(t.dataset.pick === id)));
    panels.forEach(p => { p.hidden = p.dataset.panel !== id; });
    history.replaceState(null, '', `#${id}`);
    if (scroll) document.getElementById(id)?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
  }
  tabs.forEach(t => t.addEventListener('click', () => choose(t.dataset.pick!, true)));
  // Coffee | Dates: one view at a time. Coffee opens first; #dates and its sections open Dates.
  const DATE_IDS = ['dates', 'everyday', 'reserve', 'stuffed'];
  type View = 'coffee' | 'dates' | 'gifts' | 'beans';
  const viewTabs = [...document.querySelectorAll<HTMLButtonElement>('[data-view]')];
  const views = [...document.querySelectorAll<HTMLElement>('[data-view-panel]')];
  document.getElementById('topTabs')!.hidden = false;
  function setView(v: View) {
    viewTabs.forEach(t => t.setAttribute('aria-selected', String(t.dataset.view === v)));
    views.forEach(p => { p.hidden = p.dataset.viewPanel !== v; });
  }
  const motion = () => (matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth') as ScrollBehavior;
  viewTabs.forEach(t => t.addEventListener('click', () => {
    const v = t.dataset.view as View;
    setView(v);
    if (v !== 'coffee') history.replaceState(null, '', `#${v}`);
    else { const cur = tabs.find(x => x.getAttribute('aria-selected') === 'true')?.dataset.pick ?? 'gulf'; history.replaceState(null, '', `#${cur}`); }
  }));
  // Arrow keys move between the tabs (in reading order, so right-to-left on the Arabic page).
  viewTabs.forEach(t => t.addEventListener('keydown', e => {
    if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
    const shown = viewTabs.filter(x => !x.hidden), i = shown.indexOf(t);
    const fwd = (e.key === 'ArrowRight') !== (document.documentElement.dir === 'rtl');
    const n = shown[(i + (fwd ? 1 : -1) + shown.length) % shown.length]; n.focus(); n.click();
  }));
  // The Yemeni beans tab shows only while the owners show at least one of them.
  const beansOn = () => [...document.querySelectorAll<HTMLElement>('#view-beans [data-product]')].some(c => !c.hidden);
  document.addEventListener('catalog:live', () => {
    const tab = document.getElementById('view-tab-beans')!, on = beansOn();
    tab.hidden = !on;
    if (!on && tab.getAttribute('aria-selected') === 'true') setView('coffee');
    if (on && location.hash === '#beans') setView('beans');
  });
  // Dates: Everyday, Reserve, Stuffed (and the gift boxes) one at a time, like the coffees; inside
  // each, the kind chosen shows its card. Without JavaScript everything shows.
  const dtabs = [...document.querySelectorAll<HTMLButtonElement>('[data-dpick]')];
  const dpanels = [...document.querySelectorAll<HTMLElement>('[data-dpanel]')];
  function chooseDates(id: string, scroll: boolean) {
    dtabs.forEach(t => t.setAttribute('aria-selected', String(t.dataset.dpick === id)));
    dpanels.forEach(p => { p.hidden = p.dataset.dpanel !== id; });
    if (scroll) requestAnimationFrame(() => document.getElementById(id)?.scrollIntoView({ behavior: motion(), block: 'start' }));
  }
  dtabs.forEach(t => t.addEventListener('click', () => { chooseDates(t.dataset.dpick!, true); history.replaceState(null, '', `#${t.dataset.dpick}`); }));
  document.querySelectorAll<HTMLFieldSetElement>('[data-kinds]').forEach(f => {
    const tier = f.dataset.kinds!;
    const cards = [...document.querySelectorAll<HTMLElement>(`[data-kind-of="${tier}"]`)];
    const show = () => { const v = f.querySelector<HTMLInputElement>('input:checked')?.value; cards.forEach(c => { c.hidden = c.dataset.kind !== v; }); };
    f.hidden = false; f.addEventListener('change', show); show();
  });
  const fromHash = () => {
    const h = location.hash.slice(1);
    if (ids.includes(h)) { setView('coffee'); choose(h, true); return true; }
    // Ramadan and Eid are the gift boxes with their sticker: the old shop links go to the season pages.
    if (h === 'ramadan' || h === 'eid') { location.replace(`/${document.documentElement.lang === 'ar' ? 'ar' : 'en'}/${h}/`); return true; }
    if (h === 'gifts') { setView('gifts'); requestAnimationFrame(() => document.getElementById('topTabs')?.scrollIntoView({ behavior: motion(), block: 'start' })); return true; }
    if (h === 'beans') { setView(document.getElementById('view-tab-beans')!.hidden ? 'coffee' : 'beans'); return true; }
    if (DATE_IDS.includes(h)) {
      setView('dates');
      chooseDates(h === 'dates' ? 'everyday' : h, false);
      const el = h === 'dates' ? document.getElementById('topTabs') : document.getElementById(h);
      requestAnimationFrame(() => el?.scrollIntoView({ behavior: motion(), block: 'start' }));
      return true;
    }
    return false;
  };
  tabs.forEach(t => t.setAttribute('aria-selected', 'false')); panels.forEach(p => { p.hidden = p.dataset.panel !== 'gulf'; }); tabs[0].setAttribute('aria-selected', 'true');
  chooseDates('everyday', false);
  if (!fromHash()) setView('coffee');
  addEventListener('hashchange', fromHash);
  // Dates cards (Everyday, Reserve, Stuffed): the size chips set what the Add button adds, its price
  // and whether it can be ordered; the kind (variety, filling or Mixed) is the option.
  document.querySelectorAll<HTMLElement>('[data-chips]').forEach(card => {
    const btn = card.querySelector<HTMLButtonElement>('[data-add]')!, price = card.querySelector<HTMLElement>('.price')!;
    const sync = () => {
      const r = card.querySelector<HTMLInputElement>('input[type=radio]:checked'); if (!r) return;
      btn.dataset.add = r.value; price.dataset.priceFor = r.value;
      price.textContent = ((window as any).hikayaPrice?.(r.value) as string | undefined) ?? r.dataset.priceText ?? '';
      const ok = (window as any).hikayaOrderable?.(r.value) as boolean | undefined;
      btn.disabled = ok === undefined ? !r.dataset.priced : !ok;
      const tag = btn.parentElement?.querySelector<HTMLElement>('.sold-out-tag'); if (tag) tag.hidden = !btn.disabled;
    };
    card.addEventListener('change', sync); sync();
    document.addEventListener('catalog:live', sync);
  });
  // When the owners hide a product, live.ts hides a tab whose cards are all hidden: open another.
  document.addEventListener('catalog:live', () => {
    const cur = tabs.find(t => t.getAttribute('aria-selected') === 'true');
    if (cur?.hidden) { const next = tabs.find(t => !t.hidden); if (next) choose(next.dataset.pick!, false); }
  });
</script>

