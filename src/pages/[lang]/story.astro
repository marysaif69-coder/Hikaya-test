---
import Base from '../../layouts/Base.astro';
import Pair from '../../components/Pair.astro';
import { DATES, type Lang } from '../../data/products';
import { path } from '../../data/i18n';
import fs from 'node:fs';

export const getStaticPaths = () => [{ params: { lang: 'en' } }, { params: { lang: 'ar' } }];
const lang = Astro.params.lang as Lang;
const ar = lang === 'ar';
const CH = {
  bunn: { name: 'بُن', en: 'Bunn · the coffee', pts: { en: ['The traveller and the teller', 'Learned his ways on the terraces of Haraz', 'Bitter, quick, proud', 'Speaks first'], ar: ['المسافر والحكّاء', 'تعلّم طرقه في مدرجات حراز', 'مُرّ وسريع وفخور', 'يتكلم أولاً'] } },
  tamr: { name: 'تمر', en: 'Tamr · the date', pts: { en: ['The host and the listener', 'Of any palm, and knows Al-Ahsa by heart', 'Sweet, patient, teasing', 'Always answers'], ar: ['المضيفة والمستمعة', 'من كل نخلة، وتعرف الأحساء عن ظهر قلب', 'حلوة وصبورة ومشاكسة', 'تردّ دائماً'] } },
};
// The logo (official paths), drawn large at the top of the page.
const LOGO = fs.readFileSync('public/brand/logo.svg', 'utf8');
const [lTamr, lSeed, lBunn, lGroove, lDots] = [...LOGO.matchAll(/<path fill="(#[0-9A-F]+)" d="([^"]+)"\/>/g)].map(m => m[2]);
const lVb = LOGO.match(/viewBox="([^"]+)"/)![1];
const lG = LOGO.match(/<g transform="([^"]+)">/)![1];
const STEPS = [
  { tamr: false, t: { ar: 'بُن', en: 'Bunn' }, s: { ar: 'بُن', en: 'Bunn' }, d: { ar: 'القهوة. يتكلم أولاً، كما تُصبّ القهوة أولاً للضيف.', en: 'The coffee. He speaks first, the way coffee is poured first for a guest.' } },
  { tamr: true, apart: true, t: { ar: 'تمر', en: 'Tamr' }, s: { ar: 'تمر', en: 'Tamr' }, d: { ar: 'التمرة. تردّ، كما تكون التمرة بجانب الفنجان.', en: 'The date. She answers, the way a date sits beside the cup.' } },
  { tamr: true, lens: 'dash', t: { ar: 'يلتقيان', en: 'They meet' }, s: { ar: 'يلتقيان', en: 'They meet' }, d: { ar: 'فنجان وتمرة، والحديث بينهما.', en: 'A cup and a date, and the talk between them.' } },
  { tamr: true, lens: 'gold', t: { ar: 'هنا تحدث الحكاية', en: 'The hikaya happens here' }, s: { ar: 'الحكاية', en: 'The hikaya' }, d: { ar: 'حيث يلتقيان: حبّة بن بلون الخلال، أول ذهب التمر.', en: 'Where they meet: a coffee bean in the gold of khalal, the date’s first colour.' } },
  { tamr: true, lens: 'gold', dots: true, t: { ar: 'وللحكاية بقية', en: 'The story goes on' }, s: { ar: 'بقية', en: 'Goes on' }, d: { ar: 'تمر ما زالت تكتب.', en: 'Tamr is still typing.' } },
] as const;
const STAGES = [
  { t: { en: 'Now', ar: 'الآن' }, d: { en: 'Setting up in Calgary: roasting, tasting, packaging.', ar: 'نؤسس في كالغاري: تحميص وتذوق وتغليف.' }, on: true },
  { t: { en: 'December 2026', ar: 'ديسمبر ٢٠٢٦' }, d: { en: 'Coming soon: the waiting list opens, and the coffee story with it.', ar: 'قريباً: تفتح قائمة الانتظار، ومعها حكاية القهوة.' }, on: false },
  { t: { en: 'Around Christmas', ar: 'قرابة عيد الميلاد' }, d: { en: 'Online pre-orders open; pickups and deliveries from 22 January 2027.', ar: 'يفتح الطلب المسبق عبر الإنترنت، والاستلام والتوصيل من ٢٢ يناير ٢٠٢٧.' }, ds: { en: 'Ramadan and Eid boxes with them.', ar: 'ومعه صناديق رمضان والعيد.' }, on: false },
  { t: { en: 'Later', ar: 'لاحقاً' }, d: { en: 'More shops, more houses, more tables.', ar: 'متاجر أكثر، وبيوت أكثر، وموائد أكثر.' }, on: false },
  { t: { en: 'One day', ar: 'يوماً ما' }, d: { en: 'The café. Its menu is already being written.', ar: 'المقهى. قائمته تُكتب منذ الآن.' }, on: false },
];
---
<Base lang={lang} title={ar ? 'حكايتنا' : 'Our story'} current="story">
  <!-- The logo builds itself one step at a time and stays; point at (or tap) a part to read it again. -->
  <section class="wrap s-hero" aria-labelledby="s-h">
    <div class="s-copy">
      <h1 id="s-h" class="h-xl">{ar ? 'حكاية' : 'Hikaya means “a story”.'}</h1>
      <p class="lead">{ar ? 'وكل حكاية تحتاج اثنين.' : 'And every story needs two.'}</p>
    </div>
    <div class="stage done" id="stage">
      <div class="art">
        <svg viewBox={lVb} aria-hidden="true"><g transform={lG}>
          <path class="st-tamr part" data-part="2" fill="#A93B28" d={lTamr} />
          <path class="st-bunn part" data-part="1" fill="#33211A" d={lBunn} />
          <g class="st-gold part" data-part="4"><path fill="#CF9C0C" d={lSeed} /><path fill="#33211A" d={lGroove} /></g>
          <path class="st-dots part" data-part="5" fill="#F5EFE3" d={lDots} />
        </g></svg>
        <p class="w w-bunn" lang="ar" aria-hidden="true">بُن</p>
        <p class="w w-tamr" lang="ar" aria-hidden="true">تمر</p>
      </div>
      <div class="side">
        <div class="cap">
          {STEPS.map((st, i) => <div class:list={['cap-l', { on: i === 4 }]} aria-hidden={i === 4 ? undefined : 'true'}><h2>{st.t[lang]}</h2><p>{st.d[lang]}</p></div>)}
        </div>
        <p class="hint"><button type="button" class="again" id="again">{ar ? 'شاهدها مرة أخرى' : 'Watch again'}</button> <span>{ar ? 'أو اختر أي جزء من الشعار.' : 'Or point at any part of the logo.'}</span></p>
      </div>
    </div>
    <script is:inline>if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.getElementById('stage').classList.remove('done');</script>
  </section>

  <section class="chars">
    <div class="wrap c-grid">
      {(['bunn', 'tamr'] as const).map(k => (
        <article class={`char ${k}`}>
          <h2><span lang="ar">{CH[k].name}</span><small>{CH[k].en}</small></h2>
          <ul>{CH[k].pts[lang].map(p => <li>{p}</li>)}</ul>
        </article>
      ))}
    </div>
  </section>

  <!-- Why Hikaya: a short note from us. DRAFT for the owners to rewrite in their own words. -->
  <section class="sec wrap why" aria-labelledby="why-h">
    <h2 id="why-h" class="h-l">{ar ? 'لماذا حكاية؟' : 'Why Hikaya?'}</h2>
    <div class="why-note">
      <p>{ar ? 'في بيوتنا، القهوة ترحيب قبل أن تكون مشروباً: دلّة على النار، وتمرة بجانب الفنجان، وحديث يطول.' : 'In our homes, coffee is a welcome before it is a drink: a dallah on the stove, a date beside the cup, a conversation that runs long.'}</p>
      <p>{ar ? 'أردنا هذا الفنجان في كالغاري كما نعرفه، وأن نشاركه مع جيراننا. فبدأنا حكاية: قهوة نحمّصها هنا بطريقة كل بيت، وتمر يليق بها.' : 'We wanted that cup in Calgary, the way we know it, and to share it with our neighbours. So we started Hikaya: coffee roasted here, made the way each home makes it, and dates that belong beside it.'}</p>
      <p class="sign">{ar ? '— حكاية' : '— Hikaya'}</p>
    </div>
  </section>

  <section class="sec wrap rules" aria-labelledby="rules-h">
    <h2 id="rules-h" class="h-l">{ar ? 'كيف يتكلمان' : 'How they talk'}</h2>
    <div class="r-grid">
      <Pair lang={lang} size="l" bunn={{ ar: 'أنا مُرّ اليوم.', en: "I'm bitter today." }} tamr={{ ar: 'خذ تمرتين إذن.', en: 'Then take two dates.' }} />
      <ul class="r-list">
        <li>{ar ? 'دائماً اثنان: بُن يبدأ وتمر تردّ.' : 'Always a pair: Bunn begins, Tamr replies.'}</li>
        <li>{ar ? 'العربية أولاً، ثماني كلمات أو أقل.' : 'Arabic first, eight words or fewer.'}</li>
        <li>{ar ? 'يحكيان ولا يبيعان.' : 'They tell, they don’t sell.'}</li>
        <li>{ar ? 'والحكاية لا تنتهي: وللحكاية بقية.' : 'And the story never ends: وللحكاية بقية.'}</li>
      </ul>
    </div>
      <p class="bt-link"><a class="btn ghost" href={path(lang, 'bunn-and-tamr')}>{ar ? 'كل حوارات بُن وتمر' : 'All of Bunn and Tamr’s conversations'}</a></p>
  </section>

  <section class="sec dates" aria-labelledby="dates-h">
    <div class="wrap">
      <h2 id="dates-h" class="h-l">{ar ? 'تمر، الصوت الآخر' : 'Tamr, the other voice'}</h2>
      <p class="lead">{ar ? 'نختار التمر كما يختاره المضيف: بالصنف والمنطقة والموسم.' : 'We choose dates the way a host does: by variety, region and season.'}</p>
      <ul class="d-row">
        {Object.values(DATES).map(d => (
          <li>
            <svg class="date" viewBox="-26 -46 52 92" aria-hidden="true"><path fill={d.c} d="M-2 -42c13 0 22 12 22 40c0 27-9 44-22 44c-12 0-21-15-21-43c0-29 8-41 21-41z" /><path d="M-12 -18q6 3 11 0M-14 4q7 4 14 0M-11 24q6 3 12-1M4 -30q5 2 9-1" stroke="#33211A" stroke-opacity=".3" stroke-width="2" fill="none" stroke-linecap="round" /></svg>
            <h3>{d.name[lang]}{lang === 'en' && <span lang="ar">{d.name.ar}</span>}</h3>
            <p class="rg">{d.region[lang]}</p>
            <p class="muted">{d.notes[lang]}</p>
            <p class="sweet"><span class="label">{ar ? 'الحلاوة' : 'Sweetness'}</span><span class="bar"><b style={`width:${d.sweet}%`}></b></span></p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec wrap stages" aria-labelledby="st-h">
    <h2 id="st-h" class="h-l">{ar ? 'خطوة بخطوة' : 'One step at a time'}</h2>
    <ol>
      {STAGES.map((s: any) => <li class={s.on ? 'on' : ''}><b>{s.t[lang]}</b><p class="muted">{s.d[lang]}{s.ds && <span data-season="ramadan eid"> {s.ds[lang]}</span>}</p></li>)}
    </ol>
    <a class="btn primary" href={path(lang, 'shop')}>{ar ? 'إلى المتجر' : 'To the shop'}</a>
  </section>
</Base>

<script>
  // Story page: opens like the site intro (the words بُن and تمر bloom into the bubbles), builds the logo
  // with one caption at a time, and stays. Point at (or tap) a part to read it again.
  const stage = document.getElementById('stage');
  const again = document.getElementById('again');
  if (stage && again) {
    const caps = [...stage.querySelectorAll<HTMLElement>('.cap-l')];
    const STATES = ['s-w1', 's-b1', 's-w2', 's-b2', 's-meet', 's-gold', 's-dots', 'done'];
    // [time, state, caption]: each motion runs into the next, no dead pauses.
    const TIMELINE: [number, string, number][] = [[150, 's-w1', 1], [800, 's-b1', 0], [1500, 's-w2', 2], [2100, 's-b2', 0], [2900, 's-meet', 3], [4000, 's-gold', 4], [5200, 's-dots', 5]];
    let timers: number[] = [];
    const stop = () => { timers.forEach(clearTimeout); timers = []; };
    const say = (n: number) => caps.forEach((c, i) => { c.classList.toggle('on', i === n - 1); c.toggleAttribute('aria-hidden', i !== n - 1); });
    const finish = () => { stage.classList.remove(...STATES); stage.classList.add('done'); };
    const play = () => {
      stop();
      stage.removeAttribute('data-hl');
      stage.classList.remove(...STATES);
      say(0);
      TIMELINE.forEach(([t, st, n]) => timers.push(window.setTimeout(() => { stage.classList.add(st); if (n) say(n); }, t)));
      timers.push(window.setTimeout(finish, 6400));
    };
    const point = (n: number) => { stop(); finish(); stage.dataset.hl = String(n); say(n); };
    const rest = () => { stage.removeAttribute('data-hl'); say(5); };
    stage.querySelectorAll<SVGElement>('.part').forEach(el => {
      const n = Number(el.dataset.part);
      el.addEventListener('pointerenter', e => { if (e.pointerType === 'mouse') point(n); });
      el.addEventListener('pointerleave', e => { if (e.pointerType === 'mouse') rest(); });
      el.addEventListener('click', e => { if ((e as PointerEvent).pointerType === 'mouse') return; e.stopPropagation(); stage.dataset.hl === String(n) ? rest() : point(n); });
    });
    document.addEventListener('click', e => { if (stage.dataset.hl && !(e.target as Element).closest('.part')) rest(); });
    again.addEventListener('click', e => { e.stopPropagation(); play(); });
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) play();
  }
</script>

<style>
  .why { display: grid; gap: 18px; }
  .bt-link { margin-top: 20px; }
  .why-note { max-width: 680px; display: grid; gap: 14px; padding: 24px 26px; border-radius: 28px; border-bottom-right-radius: 6px; background: var(--sheet); font-size: 18px; }
  .why-note p { margin: 0; }
  .why-note .sign { font-family: var(--display); font-weight: 700; color: var(--tamr); }
  .s-hero { display: grid; gap: clamp(20px, 3vw, 40px); padding-block: clamp(32px, 5vw, 72px); }
  .s-copy { display: grid; gap: 10px; }
  .s-copy h1 { font-size: clamp(44px, 5.4vw, 80px); }
  .stage { display: grid; grid-template-columns: minmax(0, 320px) minmax(0, 1fr); gap: clamp(28px, 5vw, 72px); align-items: center; }
  .stage svg { width: 100%; height: auto; display: block; overflow: visible; }
  .side { display: grid; gap: 18px; max-width: 440px; }
  .cap { display: grid; }
  .cap-l { grid-area: 1 / 1; display: grid; gap: 8px; align-content: center; opacity: 0; translate: 0 6px; transition: opacity .7s ease, translate .7s ease; pointer-events: none; }
  .cap-l.on { opacity: 1; translate: 0 0; }
  .cap h2 { font-size: clamp(26px, 2.8vw, 38px); }
  .cap p { margin: 0; color: var(--ink-2); font-size: 18px; }
  .hint { margin: 0; font-size: 14px; color: var(--ink-2); display: flex; flex-wrap: wrap; gap: 4px 10px; align-items: baseline; }
  .part { cursor: pointer; }
  .stage.stage[data-hl] .part { opacity: .22; }
  .stage.stage[data-hl="1"] .st-bunn, .stage.stage[data-hl="2"] .st-tamr, .stage.stage[data-hl="4"] .st-gold, .stage.stage[data-hl="5"] .st-dots, .stage.stage[data-hl="5"] .st-tamr { opacity: 1; }
  .again { background: none; border: 0; padding: 2px 0; font: 600 14px var(--body); color: var(--ink-2); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  /* Same opening as the site intro: the words appear, the bubbles bloom under them, the words turn light and go. */
  .art { position: relative; container-type: inline-size; }
  .w { position: absolute; margin: 0; translate: -50% -50%; font: 700 13cqi/1 var(--display); opacity: 0; filter: blur(4px); pointer-events: none; transition: opacity .6s cubic-bezier(.23, 1, .32, 1), filter .6s ease, color .45s ease, scale .5s ease; }
  .w-bunn { left: 70%; top: 36%; color: #33211A; }
  .w-tamr { left: 30%; top: 62%; color: #A93B28; }
  .s-w1 .w-bunn, .s-w2 .w-tamr { opacity: 1; filter: none; }
  .s-b1 .w-bunn, .s-b2 .w-tamr { color: #F5EFE3; }
  .stage.s-meet .w, .stage.done .w { opacity: 0; scale: .92; }
  .stage .part { transform-box: fill-box; transform-origin: center; transition: opacity .7s ease, scale .9s cubic-bezier(.2, .9, .3, 1.08), clip-path .9s steps(3, end); }
  .st-bunn, .st-tamr, .st-gold, .st-dots { opacity: 0; }
  .st-bunn, .st-tamr { scale: .25; }
  .st-gold { scale: .6; }
  .st-dots { clip-path: inset(0 100% 0 0); }
  .s-b1 .st-bunn, .s-b2 .st-tamr, .done .st-bunn, .done .st-tamr { opacity: 1; scale: 1; }
  .s-gold .st-gold, .done .st-gold { opacity: 1; scale: 1; }
  .s-dots .st-dots, .done .st-dots { opacity: 1; clip-path: inset(0 0 0 0); }
  @media (max-width: 820px) {
    .stage { grid-template-columns: 1fr; justify-items: center; }
    .art { width: 100%; max-width: 260px; }
    .side { width: 100%; justify-items: center; text-align: center; }
    .cap p { font-size: 17px; }
  }
  .chars { padding-bottom: 24px; }
  .c-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  @media (max-width: 760px) { .c-grid { grid-template-columns: 1fr; } }
  .char { border-radius: 44px; padding: clamp(24px, 3.4vw, 48px); display: grid; gap: 14px; }
  .char.bunn { background: var(--bunn); color: var(--paper); border-bottom-right-radius: 8px; }
  .char.tamr { background: var(--tamr); color: var(--tamr-ink); border-bottom-left-radius: 8px; }
  .char h2 { font-size: clamp(56px, 7vw, 96px); display: grid; }
  .char h2 small { font-family: var(--body); font-size: 15px; font-weight: 600; opacity: .85; }
  .char ul { margin: 0; padding-inline-start: 20px; display: grid; gap: 6px; font-size: 18px; }
  .r-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px clamp(28px, 5vw, 80px); margin-top: 32px; align-items: center; }
  @media (max-width: 760px) { .r-grid { grid-template-columns: 1fr; } }
  .r-list { margin: 0; padding-inline-start: 20px; display: grid; gap: 10px; font-size: 18px; }
  .dates { background: var(--paper-2); }
  .dates .lead { margin-top: 12px; }
  .d-row { list-style: none; margin: 36px 0 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 28px 22px; }
  @media (max-width: 960px) { .d-row { grid-template-columns: repeat(2, 1fr); } }
  .d-row li { display: grid; gap: 6px; align-content: start; }
  .date { width: 40px; height: 72px; margin-bottom: 8px; transform: rotate(-14deg); }
  .d-row h3 { font-size: 24px; display: flex; gap: 10px; align-items: baseline; }
  .d-row h3 span { font-size: 19px; color: var(--tamr); }
  .rg { font-size: 14px; font-weight: 600; color: var(--ink-2); }
  .sweet { display: grid; gap: 4px; margin-top: 6px; }
  .bar { height: 6px; background: var(--line); border-radius: 6px; overflow: hidden; }
  .bar b { display: block; height: 100%; background: var(--khalal); }
  .stages ol { list-style: none; margin: 32px 0 36px; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; counter-reset: s; }
  @media (max-width: 860px) { .stages ol { grid-template-columns: 1fr 1fr; } }
  .stages li { border-top: 3px solid var(--line); padding-top: 14px; display: grid; gap: 4px; }
  .stages li.on { border-color: var(--tamr); }
  .stages b { font-family: var(--display); font-size: 22px; }
</style>
