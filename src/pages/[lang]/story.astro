---
import Base from '../../layouts/Base.astro';
import Pair from '../../components/Pair.astro';
import { DATES, type Lang } from '../../data/products';
import { path } from '../../data/i18n';
import fs from 'node:fs';

export const getStaticPaths = () => [{ params: { lang: 'en' } }, { params: { lang: 'ar' } }];
const lang = Astro.params.lang as Lang;
const ar = lang === 'ar';
const CH = {
  bunn: { name: 'بُن', en: 'Bunn · the coffee', pts: { en: ['The traveller and the teller', 'Learned his ways on the terraces of Haraz', 'Bitter, quick, proud', 'Speaks first'], ar: ['المسافر والحكّاء', 'تعلّم طرقه في مدرجات حراز', 'مُرّ وسريع وفخور', 'يتكلم أولاً'] } },
  tamr: { name: 'تمر', en: 'Tamr · the date', pts: { en: ['The host and the listener', 'Of any palm, and knows Al-Ahsa by heart', 'Sweet, patient, teasing', 'Always answers'], ar: ['المضيفة والمستمعة', 'من كل نخلة، وتعرف الأحساء عن ظهر قلب', 'حلوة وصبورة ومشاكسة', 'تردّ دائماً'] } },
};
// The logo, piece by piece (official paths), for "Reading the logo".
const LOGO = fs.readFileSync('public/brand/logo.svg', 'utf8');
const [lTamr, lSeed, lBunn, lGroove, lDots] = [...LOGO.matchAll(/<path fill="(#[0-9A-F]+)" d="([^"]+)"\/>/g)].map(m => m[2]);
const lVb = LOGO.match(/viewBox="([^"]+)"/)![1];
const lG = LOGO.match(/<g transform="([^"]+)">/)![1];
const PARTS = [
  { n: 1, c: '#33211A', at: [76, 22], name: { ar: 'بُن · القهوة', en: 'Bunn · the coffee' }, d: { ar: 'الفقاعة الداكنة، عالية إلى اليمين. بلون البن المحمّص. يتكلم أولاً، كما تُصبّ القهوة أولاً للضيف.', en: 'The dark bubble, high on the right, the colour of roasted coffee. He speaks first, the way coffee is poured first for a guest.' } },
  { n: 2, c: '#A93B28', at: [20, 80], name: { ar: 'تمر · التمرة', en: 'Tamr · the date' }, d: { ar: 'الفقاعة الحمراء، منخفضة إلى اليسار. بلون التمر الناضج. تردّ دائماً، كما تكون التمرة بجانب الفنجان.', en: 'The red bubble, low on the left, the colour of a ripe date. She always answers, the way a date sits beside the cup.' } },
  { n: 3, c: '#CF9C0C', at: [50, 38], name: { ar: 'الحبّة الذهبية · الخلال', en: 'The gold bean · khalal' }, d: { ar: 'حيث تلتقي الفقاعتان: حبّة بن بلون الخلال، أي التمر في مرحلته الذهبية الأولى. هي الحكاية التي بينهما.', en: 'Where the bubbles meet: a coffee bean in the colour of khalal, the date at its first golden stage. It is the story they share.' } },
  { n: 4, c: '#F5EFE3', at: [27, 52], name: { ar: 'النقاط الثلاث', en: 'The three dots' }, d: { ar: 'تمر ما زالت تكتب. الحديث لم ينتهِ: وللحكاية بقية.', en: 'Tamr is still typing. The conversation goes on: وللحكاية بقية, and the story continues.' } },
];
const STAGES = [
  { t: { en: 'Now', ar: 'الآن' }, d: { en: 'Setting up in Calgary: roasting, tasting, packaging.', ar: 'نؤسس في كالغاري: تحميص وتذوق وتغليف.' }, on: true },
  { t: { en: 'December 2026', ar: 'ديسمبر ٢٠٢٦' }, d: { en: 'Coming soon: the waiting list opens, and the coffee story with it.', ar: 'قريباً: تفتح قائمة الانتظار، ومعها حكاية القهوة.' }, on: false },
  { t: { en: 'Around Christmas', ar: 'قرابة عيد الميلاد' }, d: { en: 'Online pre-orders open; pickups and deliveries from 22 January 2027.', ar: 'يفتح الطلب المسبق عبر الإنترنت، والاستلام والتوصيل من ٢٢ يناير ٢٠٢٧.' }, ds: { en: 'Ramadan and Eid boxes with them.', ar: 'ومعه صناديق رمضان والعيد.' }, on: false },
  { t: { en: 'Later', ar: 'لاحقاً' }, d: { en: 'More shops, more houses, more tables.', ar: 'متاجر أكثر، وبيوت أكثر، وموائد أكثر.' }, on: false },
  { t: { en: 'One day', ar: 'يوماً ما' }, d: { en: 'The café. Its menu is already being written.', ar: 'المقهى. قائمته تُكتب منذ الآن.' }, on: false },
];
---
<Base lang={lang} title={ar ? 'حكايتنا' : 'Our story'} current="story">
  <section class="wrap s-head">
    <div class="stack" style="--gap:18px">
      <h1 class="h-xl">{ar ? 'حكاية' : 'Hikaya means “a story”.'}</h1>
      <p class="lead">{ar ? 'شعارنا حوار. بُن، القهوة، يتكلم أولاً. تمر تردّ. وحيث تلتقي فقاعتاهما بذرة بلون الخلال: الحكاية التي بينهما.' : 'Our logo is a conversation. Bunn, the coffee, speaks first. Tamr, the date, answers. Where their bubbles meet sits a seed the colour of khalal: the story they share.'}</p>
    </div>
  </section>

  <!-- Reading the logo: what each piece means. -->
  <section class="sec wrap read" aria-labelledby="read-h">
    <h2 id="read-h" class="h-l">{ar ? 'قراءة الشعار' : 'Reading the logo'}</h2>
    <div class="read-grid">
      <div class="read-art">
        <svg viewBox={lVb} role="img" aria-label={ar ? 'شعار حكاية' : 'The Hikaya logo'}><g transform={lG}><path fill="#A93B28" d={lTamr} /><path fill="#CF9C0C" d={lSeed} /><path fill="#33211A" d={lBunn} /><path fill="#33211A" d={lGroove} /><path fill="#F5EFE3" d={lDots} /></g></svg>
        {PARTS.map(p => <span class="pin" style={`left:${p.at[0]}%;top:${p.at[1]}%`} aria-hidden="true">{ar ? ['١', '٢', '٣', '٤'][p.n - 1] : p.n}</span>)}
      </div>
      <ol class="read-list">
        {PARTS.map(p => (
          <li>
            <span class="pin static" aria-hidden="true">{ar ? ['١', '٢', '٣', '٤'][p.n - 1] : p.n}</span>
            <div><h3><i style={`background:${p.c}`}></i>{p.name[lang]}</h3><p>{p.d[lang]}</p></div>
          </li>
        ))}
      </ol>
    </div>
    <p class="muted read-colours">{ar ? 'الألوان من الفاكهة والمشروب نفسه: البن المحمّص، والتمر الناضج، والخلال الذهبي، وورق كريمي كالحليب في القهوة.' : 'The colours come from the fruit and the drink themselves: roasted coffee, ripe date, golden khalal, and a cream paper like milk in coffee.'}</p>
  </section>

  <section class="chars">
    <div class="wrap c-grid">
      {(['bunn', 'tamr'] as const).map(k => (
        <article class={`char ${k}`}>
          <h2><span lang="ar">{CH[k].name}</span><small>{CH[k].en}</small></h2>
          <ul>{CH[k].pts[lang].map(p => <li>{p}</li>)}</ul>
        </article>
      ))}
    </div>
  </section>

  <!-- Why Hikaya: a short note from us. DRAFT for the owners to rewrite in their own words. -->
  <section class="sec wrap why" aria-labelledby="why-h">
    <h2 id="why-h" class="h-l">{ar ? 'لماذا حكاية؟' : 'Why Hikaya?'}</h2>
    <div class="why-note">
      <p>{ar ? 'في بيوتنا، القهوة ترحيب قبل أن تكون مشروباً: دلّة على النار، وتمرة بجانب الفنجان، وحديث يطول.' : 'In our homes, coffee is a welcome before it is a drink: a dallah on the stove, a date beside the cup, a conversation that runs long.'}</p>
      <p>{ar ? 'أردنا هذا الفنجان في كالغاري كما نعرفه، وأن نشاركه مع جيراننا. فبدأنا حكاية: قهوة نحمّصها هنا بطريقة كل بيت، وتمر يليق بها.' : 'We wanted that cup in Calgary, the way we know it, and to share it with our neighbours. So we started Hikaya: coffee roasted here, made the way each home makes it, and dates that belong beside it.'}</p>
      <p class="sign">{ar ? '— حكاية' : '— Hikaya'}</p>
    </div>
  </section>

  <section class="sec wrap rules" aria-labelledby="rules-h">
    <h2 id="rules-h" class="h-l">{ar ? 'كيف يتكلمان' : 'How they talk'}</h2>
    <div class="r-grid">
      <Pair lang={lang} size="l" bunn={{ ar: 'أنا مُرّ اليوم.', en: "I'm bitter today." }} tamr={{ ar: 'خذ تمرتين إذن.', en: 'Then take two dates.' }} />
      <ul class="r-list">
        <li>{ar ? 'دائماً اثنان: بُن يبدأ وتمر تردّ.' : 'Always a pair: Bunn begins, Tamr replies.'}</li>
        <li>{ar ? 'العربية أولاً، ثماني كلمات أو أقل.' : 'Arabic first, eight words or fewer.'}</li>
        <li>{ar ? 'يحكيان ولا يبيعان.' : 'They tell, they don’t sell.'}</li>
        <li>{ar ? 'والحكاية لا تنتهي: وللحكاية بقية.' : 'And the story never ends: وللحكاية بقية.'}</li>
      </ul>
    </div>
      <p class="bt-link"><a class="btn ghost" href={path(lang, 'bunn-and-tamr')}>{ar ? 'كل حوارات بُن وتمر' : 'All of Bunn and Tamr’s conversations'}</a></p>
  </section>

  <section class="sec dates" aria-labelledby="dates-h">
    <div class="wrap">
      <h2 id="dates-h" class="h-l">{ar ? 'تمر، الصوت الآخر' : 'Tamr, the other voice'}</h2>
      <p class="lead">{ar ? 'نختار التمر كما يختاره المضيف: بالصنف والمنطقة والموسم.' : 'We choose dates the way a host does: by variety, region and season.'}</p>
      <ul class="d-row">
        {Object.values(DATES).map(d => (
          <li>
            <svg class="date" viewBox="-26 -46 52 92" aria-hidden="true"><path fill={d.c} d="M-2 -42c13 0 22 12 22 40c0 27-9 44-22 44c-12 0-21-15-21-43c0-29 8-41 21-41z" /><path d="M-12 -18q6 3 11 0M-14 4q7 4 14 0M-11 24q6 3 12-1M4 -30q5 2 9-1" stroke="#33211A" stroke-opacity=".3" stroke-width="2" fill="none" stroke-linecap="round" /></svg>
            <h3>{d.name[lang]}{lang === 'en' && <span lang="ar">{d.name.ar}</span>}</h3>
            <p class="rg">{d.region[lang]}</p>
            <p class="muted">{d.notes[lang]}</p>
            <p class="sweet"><span class="label">{ar ? 'الحلاوة' : 'Sweetness'}</span><span class="bar"><b style={`width:${d.sweet}%`}></b></span></p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec wrap stages" aria-labelledby="st-h">
    <h2 id="st-h" class="h-l">{ar ? 'خطوة بخطوة' : 'One step at a time'}</h2>
    <ol>
      {STAGES.map((s: any) => <li class={s.on ? 'on' : ''}><b>{s.t[lang]}</b><p class="muted">{s.d[lang]}{s.ds && <span data-season="ramadan eid"> {s.ds[lang]}</span>}</p></li>)}
    </ol>
    <a class="btn primary" href={path(lang, 'shop')}>{ar ? 'إلى المتجر' : 'To the shop'}</a>
  </section>
</Base>

<style>
  .read { display: grid; gap: 24px; }
  .read-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(24px, 5vw, 64px); align-items: center; }
  @media (max-width: 760px) { .read-grid { grid-template-columns: 1fr; } }
  .read-art { position: relative; max-width: 420px; width: 100%; justify-self: center; }
  .read-art svg { width: 100%; height: auto; display: block; }
  .pin { position: absolute; transform: translate(-50%, -50%); width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; background: var(--paper); color: var(--bunn); font-weight: 700; font-size: 15px; box-shadow: 0 0 0 2px var(--bunn); }
  .pin.static { position: static; transform: none; flex: none; }
  .read-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 18px; }
  .read-list li { display: flex; gap: 14px; align-items: flex-start; }
  .read-list h3 { display: flex; align-items: center; gap: 8px; font-size: 19px; margin: 2px 0 4px; }
  .read-list h3 i { width: 14px; height: 14px; border-radius: 50%; box-shadow: inset 0 0 0 1px rgba(51, 33, 26, .25); }
  .read-list p { margin: 0; color: var(--ink-2); }
  .read-colours { max-width: 70ch; }
  .why { display: grid; gap: 18px; }
  .bt-link { margin-top: 20px; }
  .why-note { max-width: 680px; display: grid; gap: 14px; padding: 24px 26px; border-radius: 28px; border-bottom-right-radius: 6px; background: var(--sheet); font-size: 18px; }
  .why-note p { margin: 0; }
  .why-note .sign { font-family: var(--display); font-weight: 700; color: var(--tamr); }
  .s-head > * { max-width: 900px; }
  .s-head { display: grid; grid-template-columns: 1fr; gap: clamp(24px, 5vw, 80px); align-items: center; padding-block: clamp(48px, 7vw, 104px); }
  .s-logo { width: 100%; max-width: 300px; }
  @media (max-width: 760px) { .s-head { grid-template-columns: 1fr; } .s-logo { max-width: 160px; } }
  .chars { padding-bottom: 24px; }
  .c-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  @media (max-width: 760px) { .c-grid { grid-template-columns: 1fr; } }
  .char { border-radius: 44px; padding: clamp(24px, 3.4vw, 48px); display: grid; gap: 14px; }
  .char.bunn { background: var(--bunn); color: var(--paper); border-bottom-right-radius: 8px; }
  .char.tamr { background: var(--tamr); color: var(--tamr-ink); border-bottom-left-radius: 8px; }
  .char h2 { font-size: clamp(56px, 7vw, 96px); display: grid; }
  .char h2 small { font-family: var(--body); font-size: 15px; font-weight: 600; opacity: .85; }
  .char ul { margin: 0; padding-inline-start: 20px; display: grid; gap: 6px; font-size: 18px; }
  .r-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px clamp(28px, 5vw, 80px); margin-top: 32px; align-items: center; }
  @media (max-width: 760px) { .r-grid { grid-template-columns: 1fr; } }
  .r-list { margin: 0; padding-inline-start: 20px; display: grid; gap: 10px; font-size: 18px; }
  .dates { background: var(--paper-2); }
  .dates .lead { margin-top: 12px; }
  .d-row { list-style: none; margin: 36px 0 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 28px 22px; }
  @media (max-width: 960px) { .d-row { grid-template-columns: repeat(2, 1fr); } }
  .d-row li { display: grid; gap: 6px; align-content: start; }
  .date { width: 40px; height: 72px; margin-bottom: 8px; transform: rotate(-14deg); }
  .d-row h3 { font-size: 24px; display: flex; gap: 10px; align-items: baseline; }
  .d-row h3 span { font-size: 19px; color: var(--tamr); }
  .rg { font-size: 14px; font-weight: 600; color: var(--ink-2); }
  .sweet { display: grid; gap: 4px; margin-top: 6px; }
  .bar { height: 6px; background: var(--line); border-radius: 6px; overflow: hidden; }
  .bar b { display: block; height: 100%; background: var(--khalal); }
  .stages ol { list-style: none; margin: 32px 0 36px; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; counter-reset: s; }
  @media (max-width: 860px) { .stages ol { grid-template-columns: 1fr 1fr; } }
  .stages li { border-top: 3px solid var(--line); padding-top: 14px; display: grid; gap: 4px; }
  .stages li.on { border-color: var(--tamr); }
  .stages b { font-family: var(--display); font-size: 22px; }
</style>
