---
import Base from '../../layouts/Base.astro';
import type { Lang } from '../../data/products';

export const getStaticPaths = () => [{ params: { lang: 'en' } }, { params: { lang: 'ar' } }];
const lang = Astro.params.lang as Lang;
const ar = lang === 'ar';
const WAYS = [
  { h: { en: 'Pickup', ar: 'الاستلام' }, p: { en: 'Free, at [address], Calgary. Thursday to Sunday, 11:00 to 20:00, from 22 January 2027. Pick a time window at checkout.', ar: 'مجاناً من [العنوان]، كالغاري. من الخميس إلى الأحد، ١١:٠٠ حتى ٢٠:٠٠، من ٢٢ يناير ٢٠٢٧. اختر موعدك عند الطلب.' } },
  { h: { en: 'Calgary delivery', ar: 'التوصيل داخل كالغاري' }, p: { en: 'We deliver ourselves, $9, free over $80. Calgary postal codes only, not nearby towns.', ar: 'نوصل بأنفسنا، ٩ $، ومجاناً فوق ٨٠ $. لرموز كالغاري البريدية فقط، لا المدن المجاورة.' }, ps: [{ s: 'ramadan', en: 'Ramadan orders arrive before sunset.', ar: 'طلبات رمضان تصل قبل الغروب.' }, { s: 'eid', en: 'Eid orders arrive before Eid morning.', ar: 'وطلبات العيد قبل صباح العيد.' }] },
  { h: { en: 'Paying', ar: 'الدفع' }, p: { en: 'For now: at pickup (card or cash) or by Interac e-Transfer once we confirm your order. Card payment online comes with the full launch.', ar: 'حالياً: عند الاستلام (بطاقة أو نقداً) أو بتحويل Interac بعد تأكيد طلبك. الدفع بالبطاقة عبر الموقع يأتي مع الإطلاق الكامل.' } },
];
const FAQ = [
  { q: { en: 'When can I order?', ar: 'متى أستطيع الطلب؟' }, a: { en: 'Pre-orders open around Christmas, in time for Ramadan; pickups and deliveries start on 22 January 2027. Join the list and we will email you when they open.', ar: 'يفتح الطلب المسبق قرابة عيد الميلاد، استعداداً لرمضان، ويبدأ الاستلام والتوصيل في ٢٢ يناير ٢٠٢٧. انضم إلى القائمة ونراسلك حين يفتح.' }, ps: [{ s: 'ramadan eid', en: 'Ramadan is expected to begin around 8 February 2027, and Eid around 9 March.', ar: 'يُتوقع أن يبدأ رمضان نحو ٨ فبراير ٢٠٢٧ والعيد نحو ٩ مارس.' }] },
  { q: { en: 'Is the coffee ground?', ar: 'هل القهوة مطحونة؟' }, a: { en: 'Yes, every coffee comes ground and ready to brew: Gulf coffee coarse (brewed in a pot, served from the dallah), Yemeni qahwa fine for the pot, Shami coffee to powder for the rakwa. Every bag has its roast date on the back.', ar: 'نعم، كل قهوتنا تأتي مطحونة وجاهزة: الخليجية خشنة (تُحضَّر في إبريق وتُقدَّم من الدلّة)، واليمنية ناعمة للإبريق، والشامية كالبودرة للركوة. وتاريخ التحميص على ظهر كل كيس.' } },
  { q: { en: 'Why are the spices in packs?', ar: 'لماذا البهارات في ظروف؟' }, a: { en: 'One fresh bag can be made many families’ ways. You choose the bag, then the style; the style comes with its sealed packs in the same box. And if you have a fresh plain bag, take its pack on its own.', ar: 'الكيس الطازج الواحد يُصنع على طرق كثيرة، لكل بيت طريقته. تختار الكيس ثم الطريقة، فتأتي الطريقة مع ظروفها المختومة في العلبة نفسها. وإن كان عندك كيس جديد بلا إضافات، فخذ ظرفه وحده.' } },
  { q: { en: 'Why is the saffron separate?', ar: 'لماذا الزعفران منفصل؟' }, a: { en: 'Saffron is what makes Gulf coffee Najdi, so it is always in the Najdi box, along with Qassimi and Hijazi. It comes in its own sealed packet and is never boiled: soak a little in hot water, put it in the serving dallah and pour the coffee over it, so it stays bright.', ar: 'الزعفران هو ما يجعل القهوة الخليجية نجدية، لذلك هو في علبة النجدية دائماً، ومع القصيمية والحجازية. يأتي في ظرفه المختوم ولا يُغلى أبداً: انقع قليلاً منه في ماء ساخن، وضعه في دلّة التقديم وصبّ القهوة فوقه، فيبقى زاهياً.' } },
  { q: { en: 'Are your beans Yemeni?', ar: 'هل حبوبكم يمنية؟' }, a: { en: 'Our Yemeni coffee is Yemeni-style, made from Ethiopian beans: roasted, ground and spiced the way Yemeni homes make it. Our Shami coffee uses Brazilian beans. The final beans are chosen at our cupping and blind tasting this autumn.', ar: 'قهوتنا اليمنية على الطريقة اليمنية، من حبوب إثيوبية: تُحمّص وتُطحن وتُبهّر كما في البيوت اليمنية. وقهوتنا الشامية من حبوب برازيلية. نختار الحبوب النهائية في جلسة التذوق والتذوق الأعمى هذا الخريف.' } },
  { q: { en: 'Will you sell ready-mixed bags?', ar: 'هل ستبيعون أكياساً مخلوطة جاهزة؟' }, a: { en: 'Later, perhaps. At launch every style is the bag plus its sealed packs, so the coffee stays fresh and the allergens stay out of it.', ar: 'ربما لاحقاً. عند الافتتاح كل طريقة هي الكيس مع ظروفه المختومة، لتبقى القهوة طازجة وتبقى مسببات الحساسية خارجها.' } },
  { q: { en: 'Do you ship outside Calgary?', ar: 'هل تشحنون خارج كالغاري؟' }, a: { en: 'Not yet. Pickup and our own delivery in Calgary only, for now.', ar: 'ليس بعد. الاستلام وتوصيلنا داخل كالغاري فقط حالياً.' } },
  { q: { en: 'Is there a café?', ar: 'هل هناك مقهى؟' }, a: { en: 'Not yet. The café comes after the shop grows.', ar: 'ليس بعد. يأتي المقهى بعد أن يكبر المتجر.' } },
  { q: { en: 'Allergens?', ar: 'مسببات الحساسية؟' }, a: { en: 'The coffee bags hold coffee and spices only. Allergens are only in the sealed packs: Rada’i has sesame and almonds, Baydani has sorghum. There is no milk in any pack: for Qassimi you add evaporated milk. The Qassim blend may contain barley (gluten) [TBD]; the Hadrami and Hijazi allergens are confirmed with the final recipe. Each pack and style shows what it contains, and every label lists its ingredients in English and French.', ar: 'أكياس القهوة فيها قهوة وبهارات فقط. مسببات الحساسية في الظروف المختومة وحدها: الرداعية فيها سمسم ولوز، والبيضانية فيها ذرة رفيعة. ولا حليب في أي ظرف: للقصيمية تضيف الحليب المبخّر بنفسك. قد تحتوي الخلطة القصيمية على الشعير (غلوتين) [يُحدد لاحقاً]، ومسببات الحساسية في الحضرمية والحجازية تُؤكد مع الوصفة النهائية. كل ظرف وكل طريقة يذكر ما فيه، وكل ملصق يذكر مكوناته بالإنجليزية والفرنسية.' } },
];
const POL = [
  { h: { en: 'Refunds', ar: 'الاسترجاع' }, p: { en: "Coffee and dates are food, so we can't take them back once they leave us. If something arrives damaged or wrong, tell us within 48 hours and we'll replace it or refund you.", ar: 'القهوة والتمر طعام، فلا نستطيع استرجاعهما بعد الاستلام. إن وصل شيء تالفاً أو خاطئاً أخبرنا خلال ٤٨ ساعة ونستبدله أو نعيد المبلغ.' } },
  { h: { en: 'Privacy', ar: 'الخصوصية' }, p: { en: "We keep your name, phone, email and address only to prepare and deliver your order, and to write to you if you join our list. We don't sell or share them.", ar: 'نحتفظ باسمك وهاتفك وبريدك وعنوانك فقط لتجهيز طلبك وتوصيله، ولمراسلتك إن اشتركت في قائمتنا. لا نبيعها ولا نشاركها.' } },
  { h: { en: 'Terms', ar: 'الشروط' }, p: { en: 'Prices are drafts until launch and in Canadian dollars. Pre-orders are confirmed by email before anything is charged. GST shown as 0% on basic groceries is pending confirmation. Hikaya Coffee Ltd., [address], Calgary, AB.', ar: 'الأسعار مبدئية حتى الإطلاق وبالدولار الكندي. نؤكد الطلبات المسبقة بالبريد قبل أي دفع. ضريبة ٠٪ على المواد الغذائية الأساسية بانتظار التأكيد. حكاية للقهوة المحدودة، [العنوان]، كالغاري.' } },
];
---
<Base lang={lang} title={ar ? 'الاستلام والتوصيل' : 'Pickup & delivery'} current="visit">
  <section class="wrap v-head">
    <h1 class="h-l">{ar ? 'كيف تصلك' : 'How it reaches you'}</h1>
    <p class="lead">{ar ? '[العنوان]، كالغاري.' : '[address], Calgary.'} <span data-biz-pending>{ar ? 'العنوان والساعات النهائية تُعلن قبل افتتاح الطلبات.' : 'The final address and hours are announced before pre-orders open.'}</span> <span data-biz-hours hidden></span></p>
  </section>
  <section class="wrap ways">
    {WAYS.map((w: any, i) => <div class={`way w${i}`}><h2 class="h-s">{w.h[lang]}</h2><p>{w.p[lang]}{(w.ps ?? []).map((x: any) => <span data-season={x.s}> {x[lang]}</span>)}</p></div>)}
  </section>
  <section class="sec wrap faq" id="questions" aria-labelledby="q-h">
    <h2 id="q-h" class="h-l">{ar ? 'أسئلة' : 'Questions'}</h2>
    <div class="acc">{FAQ.map((f: any) => <details><summary>{f.q[lang]}</summary><p>{f.a[lang]}{(f.ps ?? []).map((x: any) => <span data-season={x.s}> {x[lang]}</span>)}</p></details>)}</div>
    <p class="more">{ar ? 'سؤالك ليس هنا؟' : 'Question not here?'} <a href="#ask">{ar ? 'اسأل حكاية' : 'Ask Hikaya'}</a> {ar ? 'أو' : 'or'} <a href={`/${lang}/help/`}>{ar ? 'راسل الفريق' : 'write to the team'}</a>.</p>
  </section>
  <section class="sec-tight wrap pol" id="policies" aria-labelledby="p-h">
    <h2 id="p-h" class="h-m">{ar ? 'السياسات' : 'Policies'}</h2>
    <div class="pol-grid">{POL.map(p => <div><h3 class="h-s">{p.h[lang]}</h3><p class="muted">{p.p[lang]}</p></div>)}</div>
  </section>
</Base>

<style>
  .v-head { display: grid; gap: 14px; padding-block: clamp(40px, 6vw, 80px) 32px; }
  .ways { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  @media (max-width: 860px) { .ways { grid-template-columns: 1fr; } }
  .way { border-radius: 32px; padding: 26px; display: grid; gap: 10px; align-content: start; }
  .w0 { background: var(--bunn); color: var(--paper); border-bottom-right-radius: 6px; }
  .w1 { background: var(--tamr); color: var(--tamr-ink); border-bottom-left-radius: 6px; }
  .w2 { background: var(--sheet); box-shadow: inset 0 0 0 1.5px var(--line); }
  .faq h2 { margin-bottom: 24px; }
  .acc { max-width: 860px; }
  .acc details { border-bottom: 1px solid var(--line); padding-block: 18px; }
  .acc details:first-child { border-top: 1px solid var(--line); }
  .acc summary { cursor: pointer; font-weight: 600; font-size: 19px; list-style: none; display: flex; justify-content: space-between; gap: 12px; }
  .acc summary::after { content: '+'; font-size: 24px; line-height: 1; }
  .acc details[open] summary::after { content: '–'; }
  .acc p { margin-top: 10px; color: var(--ink-2); max-width: 70ch; }
  .more { margin-top: 22px; font-weight: 500; }
  .more a { font-weight: 600; color: var(--tamr-2); }
  .pol { padding-bottom: clamp(56px, 8vw, 104px); scroll-margin-top: 100px; }
  .pol-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; margin-top: 22px; }
  .pol-grid > div { display: grid; gap: 8px; align-content: start; }
  @media (max-width: 860px) { .pol-grid { grid-template-columns: 1fr; } }
</style>
