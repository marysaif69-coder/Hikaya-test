---
// Hikaya Deliveries: the drivers' app (installable on iPhone and Android from this page).
// Drivers log in with the email code, set themselves up once (details + driver guide), then see
// their stops: start the route (customers get "on its way"), photo at every door, collect cash
// or card when due, Delivered (customer gets the thank-you email). Owners and helpers can use it too.
import '../../styles/fonts.css';
import '../../styles/global.css';
---
<!doctype html>
<html lang="en" dir="ltr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#33211A" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="Hikaya Drive" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <link rel="manifest" href="/admin-driver.webmanifest" />
  <link rel="apple-touch-icon" href="/brand/app-180.png" />
  <title>Hikaya Deliveries</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body class="drv">
  <header class="d-top">
    <b class="brand">Hikaya Drive</b>
    <input type="date" id="day" aria-label="Day" hidden />
    <button type="button" id="reload" aria-label="Refresh" hidden>↻</button>
    <button type="button" id="reportBtn" class="ghost" hidden>Report</button>
    <button type="button" id="guideBtn" class="ghost" hidden>Guide</button>
  </header>
  <main>
    <section id="login" hidden class="card"><h1 class="h-m">Log in</h1><p class="muted">Use the email the owners added. We email you a 6-digit code.</p><div id="loginBox"></div><p class="err" id="notTeam" hidden>This email is not on the drivers list yet. Ask the owners to add you.</p></section>

    <section id="install" class="card install" hidden>
      <b>Put the app on your home screen</b>
      <p id="installHow"></p>
      <div class="row1"><button type="button" class="b go" id="installBtn" hidden>Install</button><button type="button" class="b ghost2" id="installClose">Got it</button></div>
    </section>

    <section id="onboard" hidden class="card">
      <h1 class="h-m">Welcome to the team</h1>
      <p class="muted">Two minutes to set up. The owners see these details.</p>
      <form id="obForm" novalidate>
        <label>Your name<input name="name" autocomplete="name" required /></label>
        <label>Your phone<input name="phone" type="tel" inputmode="tel" autocomplete="tel" required /></label>
        <label>Car (optional, e.g. "Grey Corolla, ABC 123")<input name="vehicle" /></label>
        <div class="guide" id="obGuide"></div>
        <label class="tick"><input type="checkbox" name="agree" /> <span>I have read the driver guide and will follow it.</span></label>
        <p class="err" id="obErr" hidden></p>
        <button type="submit" class="b done">Start</button>
      </form>
    </section>

    <section id="reportBox" hidden class="card">
      <h1 class="h-m">My report</h1>
      <div class="from"><label>From <input type="date" id="rFrom" /></label><label>To <input type="date" id="rTo" /></label></div>
      <div id="rTotals" class="totals"></div>
      <div class="rtable"><table id="rDays"></table></div>
      <a class="b map" id="rCsv">Download mileage log (CSV)</a>
      <p class="muted small">Km come from your odometer readings when you type them, otherwise from the planned route to each stop you delivered. Keep the CSV for taxes; the CRA asks for the date, km and purpose of each trip.</p>
      <button type="button" class="b ghost2" id="reportClose">Close</button>
    </section>

    <section id="guideBox" hidden class="card"><div class="guide" id="guideText"></div><button type="button" class="b ghost2" id="guideClose">Close</button></section>

    <section id="app" hidden>
      <div class="filter" id="filter" hidden><label><input type="radio" name="who" value="1" checked /> My stops</label><label><input type="radio" name="who" value="0" /> Everyone</label></div>
      <p id="summary" class="muted"></p>
      <div class="card" id="startBox" hidden>
        <b>Start your route</b>
        <p class="muted small" id="planNote"></p>
        <div class="from" id="fromRow"><label><input type="radio" name="from" value="shop" checked /> From the shop</label><label><input type="radio" name="from" value="here" /> From where I am</label></div>
        <label class="lbl">Odometer, km (optional)<input id="odoStart" type="number" inputmode="numeric" min="0" placeholder="e.g. 84213" /></label>
        <button type="button" class="b go" id="startBtn">Start route</button>
      </div>
      <div class="card next" id="routeBox" hidden>
        <div class="nx" id="nextBox"></div>
        <p class="muted small" id="routeInfo"></p>
        <div class="links" id="routeLinks"></div>
        <button type="button" class="b ghost2" id="endBtn">End route</button>
      </div>
      <ol id="stops" class="stops"></ol>
    </section>
  </main>
  <input type="file" accept="image/*" capture="environment" id="cam" hidden />
</body>
</html>

<style>
  .drv { background: var(--paper); padding-bottom: env(safe-area-inset-bottom); }
  .d-top { position: sticky; top: 0; z-index: 5; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; padding: calc(10px + env(safe-area-inset-top)) 14px 10px; background: var(--bunn); color: var(--paper); }
  .d-top .brand { margin-inline-end: auto; font-family: var(--display); font-size: 18px; }
  .d-top #day { order: 5; flex: 1; }
  .d-top #reload { order: 6; }
  .d-top input { border: 0; border-radius: 10px; padding: 8px 10px; font: inherit; color: #33211A; -webkit-text-fill-color: #33211A; background: var(--sheet); }
  .d-top button { border: 0; background: var(--khalal); color: var(--bunn); border-radius: 10px; min-width: 42px; height: 40px; font-size: 16px; font-weight: 700; padding: 0 10px; }
  .d-top .ghost { background: transparent; color: var(--paper); box-shadow: inset 0 0 0 1.5px var(--paper); }
  main { padding: 14px; display: grid; gap: 12px; max-width: 640px; margin: 0 auto; }
  .card { background: var(--sheet); border-radius: 20px; padding: 18px; display: grid; gap: 12px; box-shadow: inset 0 0 0 1px var(--line); }
  .card[hidden], #app[hidden] { display: none; }
  form { display: grid; gap: 12px; }
  form label { display: grid; gap: 4px; font-weight: 600; font-size: 14px; }
  form input:not([type=checkbox]) { border: 1.5px solid var(--line); border-radius: 12px; padding: 12px; font: inherit; font-weight: 400; background: var(--paper); }
  .tick { display: flex !important; gap: 10px; align-items: flex-start; }
  .tick input { width: 22px; height: 22px; accent-color: var(--bunn); }
  .guide { background: var(--paper); border-radius: 14px; padding: 12px 14px; font-size: 15px; line-height: 1.5; }
  .guide :global(ol) { margin: 6px 0 0; padding-inline-start: 20px; display: grid; gap: 8px; }
  .filter { display: flex; gap: 16px; font-weight: 600; }
  .row1 { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .install { background: #F4E6BF; }
  .stops { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; counter-reset: stop; }
  .stops :global(li) { background: var(--sheet); border-radius: 20px; padding: 16px; display: grid; gap: 8px; box-shadow: inset 0 0 0 1px var(--line); counter-increment: stop; }
  .stops :global(li.done) { opacity: .55; }
  .stops :global(.h) { display: flex; justify-content: space-between; gap: 8px; align-items: baseline; }
  .stops :global(.h b::before) { content: counter(stop) '. '; color: var(--tamr); }
  .stops :global(.h b[data-seq]::before) { content: attr(data-seq) '. '; }
  .stops :global(.addr) { font-size: 19px; font-weight: 600; }
  .stops :global(.gift) { background: #F1DCD3; border-radius: 12px; padding: 8px 10px; }
  .stops :global(.collect) { background: #F4E6BF; border-radius: 12px; padding: 10px; font-weight: 600; display: grid; gap: 8px; }
  .stops :global(.collect label) { display: inline-flex; gap: 6px; align-items: center; margin-inline-end: 16px; font-weight: 600; }
  .stops :global(.collect input) { width: 20px; height: 20px; accent-color: var(--bunn); }
  .stops :global(.warn) { background: #F1DCD3; border-radius: 12px; padding: 8px 10px; font-weight: 600; }
  .stops :global(.note) { background: var(--paper-2); border-radius: 12px; padding: 8px 10px; font-size: 14.5px; }
  .stops :global(.row) { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .stops :global(.thumbs) { display: flex; gap: 6px; flex-wrap: wrap; }
  .stops :global(.thumbs img) { width: 64px; height: 64px; object-fit: cover; border-radius: 10px; }
  a.b, button.b, .stops :global(a.b), .stops :global(button.b) { display: grid; place-items: center; min-height: 52px; border-radius: 14px; font-weight: 700; font-size: 16px; text-decoration: none; border: 0; padding: 0 10px; }
  .b.map, .stops :global(.b.map), .stops :global(.b.call) { background: var(--paper-2); color: var(--bunn); }
  .b.go, .stops :global(.b.go) { background: var(--khalal); color: var(--bunn); }
  .b.done, .stops :global(.b.done) { background: var(--bunn); color: var(--paper); }
  .stops :global(.b.done:disabled) { opacity: .4; }
  .stops :global(.b.photo) { background: var(--paper-2); color: var(--bunn); box-shadow: inset 0 0 0 2px var(--bunn); }
  .stops :global(.b.miss) { background: none; color: var(--tamr-2); box-shadow: inset 0 0 0 1.5px var(--tamr); }
  .b.ghost2 { background: none; color: var(--bunn); box-shadow: inset 0 0 0 1.5px var(--bunn); }
  .stops :global(small) { color: var(--ink-2); }
  .err { color: var(--tamr-2); font-weight: 600; }
  .small { font-size: 14px; }
  .from { display: flex; flex-wrap: wrap; gap: 14px; font-weight: 600; }
  .from input[type=date] { border: 1.5px solid var(--line); border-radius: 10px; padding: 6px 8px; font: inherit; }
  .lbl { display: grid; gap: 4px; font-weight: 600; font-size: 14px; }
  .lbl input { border: 1.5px solid var(--line); border-radius: 12px; padding: 12px; font: inherit; background: var(--paper); }
  .next { background: var(--bunn); color: var(--paper); }
  .next .muted { color: #E7DCCB; }
  .nx :global(b) { font-size: 13px; letter-spacing: .06em; text-transform: uppercase; color: var(--khalal); }
  .nx :global(.where) { font-size: 21px; font-weight: 700; margin: 2px 0 10px; }
  .nx :global(a.b) { display: grid; place-items: center; min-height: 56px; border-radius: 14px; font-weight: 700; font-size: 17px; text-decoration: none; background: var(--khalal); color: var(--bunn); }
  .links { display: flex; flex-wrap: wrap; gap: 8px; }
  .links :global(a) { color: var(--paper); font-weight: 600; font-size: 14px; }
  .next .b.ghost2 { color: var(--paper); box-shadow: inset 0 0 0 1.5px var(--paper); }
  .totals { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .totals :global(div) { background: var(--paper); border-radius: 12px; padding: 10px; text-align: center; }
  .totals :global(b) { display: block; font-size: 20px; }
  .totals :global(small) { color: var(--ink-2); font-size: 12px; }
  .rtable { overflow-x: auto; }
  .rtable table { width: 100%; border-collapse: collapse; font-size: 14px; }
  .rtable :global(th), .rtable :global(td) { padding: 6px 4px; border-bottom: 1px solid var(--line); text-align: start; white-space: nowrap; }
</style>

<script>
  import { mountLogin } from '../../scripts/login';
  const $ = (id: string) => document.getElementById(id)!;
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  const money = (c: number) => `$${(c / 100).toFixed(c % 100 ? 2 : 0)}`;
  const show = (id: string) => { for (const s of ['login', 'onboard', 'app', 'guideBox', 'reportBox']) $(s).hidden = s !== id; };
  const api = async (url: string, data?: object) => {
    const r = await fetch(url, data ? { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(data) } : undefined);
    const b = await r.json().catch(() => ({}));
    if (r.status === 401 && b.error === 'preview') { location.replace(`/admin/driver/?code=${Date.now()}`); throw new Error('preview'); }
    if (r.status === 401) { showLogin(); throw new Error('login'); }
    if (r.status === 403 && b.error === 'onboarding') { boot(); throw new Error('onboarding'); }
    if (!r.ok) { alert(b.message ?? 'Something went wrong. Try again.'); throw new Error(b.error); }
    return b;
  };
  const dayIn = $('day') as HTMLInputElement;
  let me: any = null, list: any[] = [];

  // ---------- install hint (iPhone: Safari share menu; Android: Chrome install prompt) ----------
  const standalone = matchMedia('(display-mode: standalone)').matches || (navigator as any).standalone;
  let deferred: any = null;
  addEventListener('beforeinstallprompt', (e: any) => { e.preventDefault(); deferred = e; $('installBtn').hidden = false; });
  function installHint() {
    try { if (standalone || localStorage.getItem('hk-drive-installed')) return; } catch { if (standalone) return; }
    const ios = /iPhone|iPad|iPod/.test(navigator.userAgent);
    $('installHow').textContent = ios ? 'In Safari, tap the Share button (the square with an arrow), then "Add to Home Screen".' : 'In Chrome, tap Install below, or the ⋮ menu → "Install app" / "Add to Home screen".';
    $('install').hidden = false;
  }
  $('installBtn').addEventListener('click', async () => { if (deferred) { deferred.prompt(); await deferred.userChoice; } $('install').hidden = true; });
  $('installClose').addEventListener('click', () => { $('install').hidden = true; try { localStorage.setItem('hk-drive-installed', '1'); } catch { /* private mode */ } });

  const guideHtml = (g: any) => `<b>${esc(g.title.en)}</b><ol>${g.points.map((p: any) => `<li>${esc(p.t.en)}</li>`).join('')}</ol>`;

  // ---------- stops ----------
  const addrOf = (o: any) => `${o.street}, ${o.postal}, Calgary, AB`;
  async function load() {
    const mine = me.role === 'driver' || (document.querySelector<HTMLInputElement>('input[name=who]:checked')?.value ?? '1') === '1';
    const d = await api(`/api/driver/stops?mine=${mine ? 1 : 0}${dayIn.value ? `&date=${dayIn.value}` : ''}`);
    dayIn.value = d.date; list = d.stops;
    const left = list.filter(o => o.status !== 'completed');
    const notOut = left.filter(o => o.status !== 'out-for-delivery' && o.driver === me.email);
    $('summary').textContent = list.length ? `${list.length} ${list.length === 1 ? 'stop' : 'stops'}, ${left.length} to go. In order of postal area.` : (mine ? 'No stops for you this day. The owners assign them in the desk.' : 'No deliveries this day.');
    const rt = (await api(`/api/driver/route${dayIn.value ? `?date=${dayIn.value}` : ''}`)).route;
    const myLeft = left.filter(o => o.driver === me.email);
    $('startBox').hidden = !(notOut.length && !rt?.open);
    $('fromRow').hidden = !me.routing?.shop;
    $('planNote').textContent = me.routing?.planner ? 'We put your stops in the shortest driving order, time window by time window. Your customers get the "on its way" email.' : 'Your stops go in order of time window and area. Your customers get the "on its way" email.';
    $('routeBox').hidden = !(rt?.open && myLeft.length) && !(rt?.open);
    if (rt?.open) {
      $('nextBox').innerHTML = rt.next ? `<b>Next stop</b><div class="where">${esc(rt.next.address.replace(', Calgary, AB', ''))}</div><a class="b" href="${esc(rt.next.url)}" target="_blank" rel="noopener">Navigate to next stop</a>` : '<b>All stops done</b><div class="where">Head back and end your route.</div>';
      $('routeInfo').textContent = [rt.km !== null ? `Planned ${rt.km} km, about ${rt.minutes} min of driving` : '', rt.kmSoFar !== null ? `${rt.kmSoFar} km so far` : '', rt.startOdometer !== null ? `started at ${rt.startOdometer} km` : ''].filter(Boolean).join(' · ');
      $('routeLinks').innerHTML = rt.links.length > 1 || (rt.links.length === 1 && myLeft.length > 1) ? rt.links.map((l: any) => `<a href="${esc(l.url)}" target="_blank" rel="noopener">${esc(l.label)} in Google Maps</a>`).join('') : '';
    }
    $('stops').innerHTML = list.map(o => {
      const done = o.status === 'completed';
      const phone = o.gift?.phone || o.phone;
      return `<li class="${done ? 'done' : ''}" data-ref="${esc(o.ref)}">
        <div class="h"><b${o.seq ? ` data-seq="${o.seq}"` : ''}>${esc(o.window)}</b><small>${esc(o.ref)} · ${done ? 'Delivered' : o.status === 'out-for-delivery' ? 'On the way' : 'Not left yet'}${o.driver && o.driver !== me.email ? ` · ${esc(o.driver)}` : ''}</small></div>
        <div class="addr">${esc(o.street)}<br><small>${esc(o.postal)}</small></div>
        <div>${esc(o.gift ? o.gift.to : o.name)}${o.gift ? ` <small>(gift from ${esc(o.name)})</small>` : ''}</div>
        ${o.gift ? `<div class="gift">Gift${o.gift.message ? `: card says “${esc(o.gift.message)}”` : ''}</div>` : ''}
        ${o.notes ? `<div class="note">Customer's note: ${esc(o.notes)}</div>` : ''}
        ${o.customerNote ? `<div class="note">Team note: ${esc(o.customerNote)}</div>` : ''}
        ${o.unpaid ? `<div class="warn">Not paid yet (e-Transfer or card). Hand it over, and tell the owners.</div>` : ''}
        <div><small>${o.items.map((i: any) => `${i.qty}× ${esc(i.name)}${i.option ? ` (${esc(i.option)})` : ''}`).join(', ')}</small></div>
        <div class="row"><a class="b map" href="https://www.google.com/maps/dir/?api=1&travelmode=driving&destination=${encodeURIComponent(addrOf(o))}" target="_blank" rel="noopener">Map</a><a class="b call" href="tel:${esc(phone)}">Call</a></div>
        ${o.photos.length ? `<div class="thumbs">${o.photos.map((id: number) => `<img src="/api/driver/photo/${id}" alt="Delivery photo" loading="lazy" />`).join('')}</div>` : ''}
        ${done ? (o.collected ? `<small>Collected ${money(o.collected.cents)} by ${esc(o.collected.method)}</small>` : '') : `
          <button type="button" class="b photo" data-act="photo">${o.photos.length ? 'Add another photo' : 'Photo at the door'}</button>
          ${o.collect ? `<div class="collect">Collect ${money(o.collect)}<div><label><input type="radio" name="c-${esc(o.ref)}" value="cash" /> Cash</label><label><input type="radio" name="c-${esc(o.ref)}" value="card" /> Card</label></div></div>` : ''}
          <button type="button" class="b done" data-act="done" ${o.photos.length ? '' : 'disabled'}>${o.photos.length ? 'Delivered' : 'Delivered (photo first)'}</button>
          <button type="button" class="b miss" data-act="miss">Couldn't deliver</button>`}
      </li>`;
    }).join('');
  }

  // Photos: shrink on the phone (longest side 1600 px) before sending.
  let photoFor = '';
  $('cam').addEventListener('change', async () => {
    const f = ($('cam') as HTMLInputElement).files?.[0]; ($('cam') as HTMLInputElement).value = '';
    if (!f || !photoFor) return;
    let blob: Blob = f;
    try {
      const bmp = await createImageBitmap(f, { imageOrientation: 'from-image' } as ImageBitmapOptions);
      const k = Math.min(1, 1600 / Math.max(bmp.width, bmp.height));
      const c = document.createElement('canvas'); c.width = Math.round(bmp.width * k); c.height = Math.round(bmp.height * k);
      c.getContext('2d')!.drawImage(bmp, 0, 0, c.width, c.height);
      blob = await new Promise<Blob>((res, rej) => c.toBlob(b => (b ? res(b) : rej()), 'image/jpeg', 0.8));
    } catch { /* send as is */ }
    const r = await fetch(`/api/driver/photo?ref=${encodeURIComponent(photoFor)}`, { method: 'POST', headers: { 'content-type': blob.type || 'image/jpeg' }, body: blob });
    if (!r.ok) alert((await r.json().catch(() => ({}))).message ?? 'The photo did not upload. Try again.');
    load();
  });

  $('stops').addEventListener('click', async e => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-act]');
    if (!b) return;
    const li = b.closest<HTMLElement>('li')!, ref = li.dataset.ref!, o = list.find(x => x.ref === ref);
    if (b.dataset.act === 'photo') { photoFor = ref; $('cam').click(); return; }
    if (b.dataset.act === 'done') {
      const collected = li.querySelector<HTMLInputElement>(`input[name="c-${ref}"]:checked`)?.value;
      if (o?.collect && !collected) { alert(`Choose cash or card for the ${money(o.collect)} you collected.`); return; }
      if (o?.collect && !confirm(`Collected ${money(o.collect)} by ${collected}?`)) return;
      b.disabled = true;
      await api('/api/driver/delivered', { ref, collected: collected ?? null }).finally(() => { b.disabled = false; });
    }
    if (b.dataset.act === 'miss') {
      const why = prompt('What happened? The owners get this right away.', 'Nobody home. Called, no answer.');
      if (!why) return;
      await api('/api/driver/missed', { ref, why });
      alert('Sent to the owners. Keep the order with you and follow what they say.');
    }
    load();
  });
  const here = () => new Promise<{ lat: number; lng: number } | null>(res => {
    if (!navigator.geolocation) return res(null);
    navigator.geolocation.getCurrentPosition(p => res({ lat: p.coords.latitude, lng: p.coords.longitude }), () => res(null), { enableHighAccuracy: true, timeout: 8000 });
  });
  $('startBtn').addEventListener('click', async () => {
    if (!confirm('Start your route? Each of your customers gets an email that their order is on its way.')) return;
    const from = (document.querySelector<HTMLInputElement>('input[name=from]:checked')?.value) ?? 'shop';
    const pos = from === 'here' || !me.routing?.shop ? await here() : null;
    const odo = ($('odoStart') as HTMLInputElement).value;
    const b = $('startBtn') as HTMLButtonElement; b.disabled = true; b.textContent = 'Planning your route…';
    try {
      const r = await api(`/api/driver/start${dayIn.value ? `?date=${dayIn.value}` : ''}`, { from, lat: pos?.lat ?? null, lng: pos?.lng ?? null, startOdometer: odo === '' ? null : Number(odo) });
      if (r.km !== null) alert(`Route planned: ${r.km} km, about ${r.minutes} min of driving. Tap "Navigate to next stop" for each stop.`);
    } finally { b.disabled = false; b.textContent = 'Start route'; }
    load();
  });
  $('endBtn').addEventListener('click', async () => {
    const odo = prompt("End of route. Odometer now, in km (optional; leave empty to use the app's km):", '');
    if (odo === null) return;
    const r = await api(`/api/driver/end${dayIn.value ? `?date=${dayIn.value}` : ''}`, { endOdometer: odo.trim() === '' ? null : Number(odo) });
    alert(r.km !== null ? `Route ended: ${r.km} km. Thank you.` : 'Route ended. Thank you.');
    load();
  });

  // ---------- my report ----------
  const rFrom = $('rFrom') as HTMLInputElement, rTo = $('rTo') as HTMLInputElement;
  const hm = (m: number) => `${Math.floor(m / 60)}h ${String(m % 60).padStart(2, '0')}`;
  async function loadReport() {
    if (!rFrom.value) { const t = new Date(); const y = t.getFullYear(), m = t.getMonth(); rFrom.value = `${y}-${String(m + 1).padStart(2, '0')}-01`; rTo.value = new Date(Date.UTC(y, m + 1, 0)).toISOString().slice(0, 10); }
    const qs = `from=${rFrom.value}&to=${rTo.value}`;
    const r = await api(`/api/driver/report?${qs}`);
    rFrom.value = r.from; rTo.value = r.to;
    const t = r.total, hasPay = r.rates.perDelivery || r.rates.perKm || r.rates.perHour;
    $('rTotals').innerHTML = `<div><b>${t.deliveries}</b><small>deliveries</small></div><div><b>${t.km}</b><small>km</small></div><div><b>${hm(t.minutes)}</b><small>on the road</small></div>
      <div><b>${money(t.cash)}</b><small>cash collected</small></div><div><b>${money(t.cashOpen)}</b><small>cash to hand in</small></div><div><b>${hasPay ? money(t.pay) : '–'}</b><small>${hasPay ? 'estimated pay' : 'pay not set yet'}</small></div>`;
    $('rDays').innerHTML = '<tr><th>Day</th><th>Stops</th><th>Km</th><th>Time</th><th>Cash</th><th>Card</th></tr>' + (r.days.map((d: any) => `<tr><td>${new Date(d.day + 'T12:00:00Z').toLocaleDateString('en-CA', { weekday: 'short', month: 'short', day: 'numeric', timeZone: 'UTC' })}</td><td>${d.deliveries}</td><td>${d.km}${d.open ? '*' : ''}</td><td>${d.minutes ? hm(d.minutes) : '–'}</td><td>${d.cash ? money(d.cash) : '–'}</td><td>${d.card ? money(d.card) : '–'}</td></tr>`).join('') || '<tr><td colspan="6">No deliveries in these dates.</td></tr>');
    ($('rCsv') as HTMLAnchorElement).href = `/api/driver/report.csv?${qs}`;
  }
  $('reportBtn').addEventListener('click', () => { show('reportBox'); $('install').hidden = true; loadReport(); });
  $('reportClose').addEventListener('click', () => show('app'));
  rFrom.addEventListener('change', loadReport); rTo.addEventListener('change', loadReport);
  dayIn.addEventListener('change', load);
  $('reload').addEventListener('click', load);
  document.querySelectorAll('input[name=who]').forEach(r => r.addEventListener('change', load));
  $('guideBtn').addEventListener('click', () => show('guideBox'));
  $('guideClose').addEventListener('click', () => show('app'));

  // ---------- onboarding ----------
  $('obForm').addEventListener('submit', async e => {
    e.preventDefault();
    const f = e.target as HTMLFormElement, v = (n: string) => (f.elements.namedItem(n) as HTMLInputElement);
    $('obErr').hidden = true;
    const r = await fetch('/api/driver/onboard', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ name: v('name').value, phone: v('phone').value, vehicle: v('vehicle').value, agree: v('agree').checked }) });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) { $('obErr').textContent = d.message ?? 'Check the form.'; $('obErr').hidden = false; return; }
    boot();
  });

  function showLogin() {
    show('login');
    mountLogin($('loginBox'), 'en', user => { if (user.role === 'customer') { $('notTeam').hidden = false; return; } boot(); });
  }
  async function boot() {
    const r = await fetch('/api/driver/me');
    const d = await r.json().catch(() => ({}));
    if (d.error === 'preview') { location.replace(`/admin/driver/?code=${Date.now()}`); return; }
    if (r.status === 401) return showLogin();
    if (r.status === 403) { showLogin(); $('notTeam').hidden = false; return; }
    me = d;
    $('guideText').innerHTML = guideHtml(d.guide);
    installHint();
    if (d.needsOnboarding) {
      show('onboard'); $('obGuide').innerHTML = guideHtml(d.guide);
      const f = $('obForm') as HTMLFormElement; if (d.member?.name) (f.elements.namedItem('name') as HTMLInputElement).value = d.member.name;
      return;
    }
    show('app');
    for (const id of ['day', 'reload', 'guideBtn', 'reportBtn']) $(id).hidden = false;
    $('filter').hidden = d.role === 'driver';
    load();
  }
  boot();
</script>
