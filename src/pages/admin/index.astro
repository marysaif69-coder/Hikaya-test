      <div class="acts"><button type="button" id="testMail">Send me a test email</button> <span id="testMailRes" class="ev"></span></div>
      ${line(c.square.enabled, 'Card payments (Square)', c.square.enabled
        ? `On, ${c.square.env === 'production' ? '<b>live</b> payments' : '<b>sandbox</b> (test cards only)'}. ${c.square.webhook ? 'Payment confirmations are connected.' : `Payment confirmations are <b>not</b> connected yet: in Square add the webhook <code>${esc(c.square.webhookUrl)}</code> for <code>payment.updated</code> and put its signature key in SQUARE_WEBHOOK_SIGNATURE_KEY.`}`
        : 'Off: checkout offers pay at pickup and e-Transfer. Add the Square keys in Netlify to turn card payment on.')}
      <div class="acts"><button type="button" id="testSquare">Test Square</button> <span id="testSquareRes" class="ev"></span></div>
      ${line(Boolean(c.etransfer), 'e-Transfer', c.etransfer ? `Customers are told to send e-Transfers to ${esc(c.etransfer)}.` : 'ETRANSFER_EMAIL is not set: the e-Transfer instructions have no address.')}
      ${line(c.ask.enabled, 'Ask Hikaya', c.ask.enabled ? 'On. Status and training are in Customers → Ask Hikaya answers.' : 'Off: ANTHROPIC_API_KEY is not set.')}
      ${c.checklist.length ? `<h2 class="h-s" style="margin-top:14px">Settings to add in Netlify</h2>
      <p class="muted">Netlify → Project configuration → Environment variables → Add a variable. Tick “Contains secret values” for the ones marked secret, then Deploys → Trigger deploy. ${c.checklist.filter((x: any) => !x.set && x.group !== 'Launch day only').length} still to add.</p>
      <table class="a-table mini-t chk"><tr><th></th><th>Name</th><th>What it does</th><th>Where to get it</th></tr>
      ${c.checklist.map((x: any, i: number) => `${i === 0 || c.checklist[i - 1].group !== x.group ? `<tr class="grp"><td colspan="4">${esc(x.group)}</td></tr>` : ''}<tr class="${x.set ? 'set' : ''}"><td>${x.set ? '✓' : x.group === 'Launch day only' ? '·' : '○'}</td><td><code>${esc(x.name)}</code>${x.secret ? ' <small>secret</small>' : ''}</td><td>${esc(x.what)}</td><td>${x.set ? '<small>Added</small>' : esc(x.where)}</td></tr>`).join('')}</table>` : ''}`;
    $('testMail').addEventListener('click', async () => {
      $('testMailRes').textContent = 'Sending…';
      const r = await api('/api/admin/connections/test-email', {});
      $('testMailRes').textContent = r.status === 'sent' ? `Sent to ${r.to}. Check the inbox (and spam).` : r.status === 'skipped' ? 'Not sent: no RESEND_API_KEY.' : `Failed: ${r.error ?? 'unknown'}`;
    });
    $('testSquare').addEventListener('click', async () => {
      $('testSquareRes').textContent = 'Checking…';
      const r = await api('/api/admin/connections/test-square', {});
      $('testSquareRes').innerHTML = `${r.ok ? '✓' : '!'} ${esc(r.message)}${r.locations?.length && !r.ok ? '<br>' + r.locations.map((l: any) => `${esc(l.name)}: <code>${esc(l.id)}</code>`).join('<br>') : ''}`;
    });
  }

  $('actShow').addEventListener('click', async () => {
    const d = await api('/api/admin/activity'); $('actBox').hidden = false;
    $('actTable').innerHTML = '<tr><th>When</th><th>Who</th><th>What</th><th>Details</th></tr>' + d.activity.map((a: any) => `<tr><td>${new Date(a.created_at).toLocaleString('en-CA', { dateStyle: 'short', timeStyle: 'short' })}</td><td>${esc(a.actor)}</td><td>${esc(a.action.replace(/^POST /, ''))}</td><td><small>${esc(a.detail ?? '')}</small></td></tr>`).join('');
  });
  async function loadBusiness() {
    const d = await api('/api/admin/business');
    const long = new Set(['PICKUP_ADDRESS', 'PICKUP_HOURS', 'OWNER_EMAILS']);
    $('bizForm').innerHTML = Object.entries(d).map(([k, x]: [string, any]) => `<label>${esc(x.label)}${k === 'OWNER_EMAILS' && x.netlify ? `<small>Owners set in Netlify (can't be removed here): ${esc(x.netlify)}</small>` : ''}
      ${long.has(k) ? `<textarea name="${k}" rows="2" placeholder="${esc(k === 'OWNER_EMAILS' ? 'e.g. ahmed@gmail.com' : x.netlify || '')}">${esc(x.value)}</textarea>` : `<input name="${k}" value="${esc(x.value)}" placeholder="${esc(x.netlify || '')}" />`}</label>`).join('') + '<button class="btn primary sm" type="submit">Save business details</button>';
  }
  $('bizForm').addEventListener('submit', async e => {
    e.preventDefault(); const f = e.target as HTMLFormElement;
    const data = Object.fromEntries([...f.querySelectorAll<HTMLInputElement>('[name]')].map(i => [i.name, i.value]));
    await api('/api/admin/business', data); alert('Saved. The site and emails use it within a minute.'); loadBusiness(); loadConnections();
  });
  async function loadSettings() {
    if (ROLE === 'admin') loadBusiness();
    loadConnections();
    const s = await api('/api/admin/settings');
    const f = $('setForm') as HTMLFormElement;
    (f.elements.namedItem('open') as HTMLInputElement).checked = s.ordering.open;
    (f.elements.namedItem('autoConfirm') as HTMLInputElement).checked = Boolean(s.ordering.autoConfirm);
    (f.elements.namedItem('capDaily') as HTMLInputElement).value = s.caps?.dailyOrders ?? '';
    (f.elements.namedItem('capBoxes') as HTMLInputElement).value = s.caps?.giftBoxesPerDay ?? '';
    (f.elements.namedItem('capStops') as HTMLInputElement).value = s.caps?.stopsPerDriver ?? '';
    (f.elements.namedItem('capShifts') as HTMLInputElement).checked = Boolean(s.caps?.deliveryFromShifts);
    (f.elements.namedItem('pickup') as HTMLInputElement).value = s.capacity.pickup;
    (f.elements.namedItem('delivery') as HTMLInputElement).value = s.capacity.delivery;
    f.querySelectorAll<HTMLInputElement>('[name=cutoffMode]').forEach(i => { i.checked = i.value === s.ordering.cutoffMode; });
    (f.elements.namedItem('cutoffWeekday') as HTMLSelectElement).value = String(s.ordering.cutoffWeekday);
    (f.elements.namedItem('cutoffHour') as HTMLSelectElement).value = String(s.ordering.cutoffHour);
    (f.elements.namedItem('firstDay') as HTMLInputElement).value = s.ordering.firstDay;
    (f.elements.namedItem('closedDates') as HTMLTextAreaElement).value = (s.ordering.closedDates ?? []).join('\n');
    previewCut();
  }
  const DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
  function previewCut() {
    const f = $('setForm') as HTMLFormElement;
    const mode = (f.querySelector('[name=cutoffMode]:checked') as HTMLInputElement | null)?.value ?? 'day-before';
    const h = Number((f.elements.namedItem('cutoffHour') as HTMLSelectElement).value), hh = `${h % 12 || 12} ${h >= 12 ? 'pm' : 'am'}`;
    $('cutDayField').hidden = mode !== 'weekly';
    $('cutPreview').textContent = mode === 'weekly'
      ? `Customers see: “Order by ${DAYS[Number((f.elements.namedItem('cutoffWeekday') as HTMLSelectElement).value)]}, ${hh} to get it Thursday to Sunday.”`
      : `Customers see: “Order by ${hh} the evening before.”`;
  }
  $('setForm').addEventListener('change', previewCut);
  $('setForm').addEventListener('submit', async e => {
    e.preventDefault();
    const f = e.target as HTMLFormElement;
    await api('/api/admin/settings', {
      open: (f.elements.namedItem('open') as HTMLInputElement).checked,
      autoConfirm: (f.elements.namedItem('autoConfirm') as HTMLInputElement).checked,
      caps: { dailyOrders: (f.elements.namedItem('capDaily') as HTMLInputElement).value, giftBoxesPerDay: (f.elements.namedItem('capBoxes') as HTMLInputElement).value,
        stopsPerDriver: (f.elements.namedItem('capStops') as HTMLInputElement).value, deliveryFromShifts: (f.elements.namedItem('capShifts') as HTMLInputElement).checked },
      capacity: { pickup: Number((f.elements.namedItem('pickup') as HTMLInputElement).value), delivery: Number((f.elements.namedItem('delivery') as HTMLInputElement).value) },
      cutoffMode: (f.querySelector('[name=cutoffMode]:checked') as HTMLInputElement | null)?.value,
      cutoffWeekday: Number((f.elements.namedItem('cutoffWeekday') as HTMLSelectElement).value),
      cutoffHour: Number((f.elements.namedItem('cutoffHour') as HTMLSelectElement).value),
      firstDay: (f.elements.namedItem('firstDay') as HTMLInputElement).value,
      closedDates: (f.elements.namedItem('closedDates') as HTMLTextAreaElement).value.split(/\s+/).filter(Boolean),
    });
    $('saved').hidden = false; setTimeout(() => { $('saved').hidden = true; }, 2000);
  });

  (async () => {
    const me = await fetch('/api/me').then(r => r.json()).catch(() => ({ user: null }));
    if (me.error === 'preview') { location.replace(`/admin/?code=${Date.now()}`); return; }
    if (me.user?.role === 'driver' || me.user?.role === 'packer') { location.href = '/admin/driver/'; return; }
    if (me.user?.role === 'admin' || me.user?.role === 'staff') {
      start(me.user.email, me.user.role);
      $('whoEmail').textContent = whoLabel(me); $('switchWho').hidden = !me.people?.length;
      askWho(me);
      $('switchWho').onclick = () => askWho(me, true);
    } else showLogin();
  })();
</script>
