    $('mgTotals').innerHTML = `${t.orders} orders · products ${money(t.sales)} − discounts ${money(t.discounts)} − refunds ${money(t.refunds)} − cost ${money(t.cost)} = <b>${money(t.left)}</b> left (${pct(t.pct)}). Delivery fees ${money(t.delivery)}.`
