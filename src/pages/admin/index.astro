---
// The team's order desk. Static page; every action goes through /api/admin/*, which checks
// the session belongs to an email in ADMIN_EMAILS. Hidden from search engines.
import '../../styles/fonts.css';
import '../../styles/global.css';
---
<!doctype html>
<html lang="en" dir="ltr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Order desk · Hikaya</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body class="adm">
  <header class="a-top">
    <a class="lockup" href="/en/"><img src="/brand/logo.svg" alt="" width="40" height="34" /><span class="wm"><b>حكاية</b><small>ORDER DESK</small></span></a>
    <nav class="a-tabs" id="tabs" hidden aria-label="Desk">
      <button type="button" data-main="orders" aria-pressed="true">Orders</button>
      <button type="button" data-main="customers" aria-pressed="false">Customers <span class="badge" id="inboxMain" hidden></span><span class="badge warn-badge owner-only" id="askWarnMain" hidden>!</span></button>
      <button type="button" data-main="shop" aria-pressed="false" class="owner-only">Shop</button>
      <button type="button" data-main="team" aria-pressed="false">Team</button>
      <button type="button" data-main="numbers" aria-pressed="false" class="owner-only">Numbers</button>
      <button type="button" data-main="settings" aria-pressed="false" class="owner-only">Settings</button>
    </nav>
    <div class="qs" id="qsBox" hidden><input type="search" id="qs" placeholder="Search orders, customers…  ( / )" aria-label="Search orders, customers and messages" autocomplete="off" /><div class="qs-list" id="qsList" hidden role="listbox"></div></div>
    <div class="a-who" id="who" hidden><span id="whoEmail"></span><button type="button" id="switchWho" hidden>Switch person</button><button type="button" id="logout">Log out</button></div>
    <nav class="a-sub" id="subtabs" hidden aria-label="Section">
      <button type="button" data-tab="today" data-group="orders" aria-pressed="false">Today</button>
      <button type="button" data-tab="orders" data-group="orders" aria-pressed="true">All orders</button>
      <button type="button" data-tab="day" data-group="orders" aria-pressed="false">Day sheet</button>
      <button type="button" data-tab="week" data-group="orders" aria-pressed="false">Week sheet</button>
      <button type="button" data-tab="customers" data-group="customers" aria-pressed="false">Customers</button>
      <button type="button" data-tab="inbox" data-group="customers" aria-pressed="false">Inbox <span class="badge" id="inboxN" hidden></span></button>
      <button type="button" data-tab="chats" data-group="customers" aria-pressed="false">Ask Hikaya chats</button>
      <button type="button" data-tab="assistant" data-group="customers" aria-pressed="false" class="owner-only">Ask Hikaya answers <span class="badge warn-badge" id="askWarn" hidden>!</span></button>
      <button type="button" data-tab="products" data-group="shop" aria-pressed="false" class="owner-only">Products</button>
      <button type="button" data-tab="promos" data-group="shop" aria-pressed="false" class="owner-only">Promotions</button>
      <button type="button" data-tab="words" data-group="shop" aria-pressed="false" class="owner-only">Words</button>
      <button type="button" data-tab="drivers" data-group="team" aria-pressed="false">Team</button>
      <button type="button" data-tab="production" data-group="team" aria-pressed="false">Production</button>
      <a class="drv-link" data-group="team" href="/admin/driver/">Team app ↗</a>
      <button type="button" data-tab="numbers" data-group="numbers" aria-pressed="false" class="owner-only">Numbers</button>
      <button type="button" data-tab="plan" data-group="numbers" aria-pressed="false" class="owner-only">Plan</button>
      <button type="button" data-tab="settings" data-group="settings" aria-pressed="false" class="owner-only">Settings</button>
    </nav>
  </header>

  <main class="a-main">
    <section id="login" hidden class="a-login">
      <h1 class="h-m">Team login</h1>
      <p class="muted">Use your Hikaya email. Only emails on the team list can open the desk.</p>
      <div id="loginBox"></div>
      <p class="err" id="notAdmin" hidden>This email is not on the team list. Owners are in Netlify (ADMIN_EMAILS); helpers and drivers are added in the Drivers tab.</p>
    </section>

    <!-- ORDERS -->
    <section id="v-today" hidden>
      <div class="td-head"><h1 class="h-m" id="tdTitle">Today</h1><button type="button" class="btn line sm" id="tdReload">Refresh</button></div>
      <div class="a-stats" id="tdStats"></div>
      <h2 class="h-s td-h">To do</h2>
      <ul class="td-list" id="tdList"></ul>
    </section>

    <section id="v-orders" hidden>
      <div class="a-stats" id="stats"></div>
      <form class="a-filters" id="filters">
        <input type="search" name="q" placeholder="Search name, email, phone, postal, HK-…" />
        <select name="status"><option value="">All statuses</option></select>
        <select name="method"><option value="">Pickup & delivery</option><option value="pickup">Pickup</option><option value="delivery">Delivery</option></select>
        <label>From <input type="date" name="from" /></label>
        <label>To <input type="date" name="to" /></label>
        <select name="sample"><option value="">Real & sample orders</option><option value="hide">Real orders only</option><option value="only">Sample orders only</option></select>
        <a class="btn line sm owner-only" id="csv" href="/api/admin/export.csv">Export CSV</a>
      </form>
      <div class="samples">
        <span class="muted">New orders wait as “Received” until you confirm them (or turn on automatic confirmation in Settings).</span>
        <button type="button" class="btn primary sm" id="confirmNew">Confirm all new orders</button>
      </div>
      <div class="samples owner-only">
        <span class="muted">Sample orders are made up, marked <span class="pill sample">SAMPLE</span>, never email anyone and are left out of the CSV.</span>
        <button type="button" class="btn line sm" id="mkSamples">Add sample orders (5 weeks)</button>
        <button type="button" class="btn line sm danger" id="rmSamples">Remove all sample orders</button>
      </div>
      <div class="a-table-wrap"><table class="a-table" id="list">
        <thead><tr><th>Order</th><th>Day</th><th>Customer</th><th>How</th><th>Items</th><th>Total</th><th>Paid</th><th>Status</th></tr></thead>
        <tbody></tbody>
      </table></div>
      <p class="muted" id="none" hidden>No orders match.</p>
    </section>

    <!-- INBOX: help requests from the form and from Ask Hikaya -->
    <section id="v-inbox" hidden>
      <div class="a-filters" id="inboxFilter">
        <div class="acts seg">
          <button type="button" data-st="open" class="cur">Open</button><button type="button" data-st="waiting">Waiting on customer</button><button type="button" data-st="resolved">Resolved</button><button type="button" data-st="">All</button>
        </div>
      </div>
      <div class="a-table-wrap"><table class="a-table" id="tickets">
        <thead><tr><th>Request</th><th>Received</th><th>Customer</th><th>About</th><th>Summary</th><th>Order</th><th>Status</th></tr></thead>
        <tbody></tbody>
      </table></div>
      <p class="muted" id="noTickets" hidden>Nothing here. Requests from the help form and from Ask Hikaya land in this list, and each one is also emailed to the team.</p>
    </section>

    <!-- CONVERSATIONS: what people ask Ask Hikaya -->
    <section id="v-chats" hidden>
      <p class="muted a-intro">Every conversation with Ask Hikaya. Read them to see what customers really ask, where the answers fall short, and what to add to the handbook or the test questions.</p>
      <div class="a-table-wrap"><table class="a-table" id="chats">
        <thead><tr><th>Last message</th><th>Lang</th><th>First question</th><th>Turns</th><th>Sent to team</th><th>Helpful?</th></tr></thead>
        <tbody></tbody>
      </table></div>
      <p class="muted" id="noChats" hidden>No conversations yet.</p>
    </section>

    <!-- DAY SHEET -->
    <section id="v-day" hidden>
      <div class="a-dayhead">
        <label class="h-s">Day <input type="date" id="dayPick" /></label>
        <button type="button" class="btn line sm" onclick="window.print()">Print</button>
        <button type="button" class="btn line sm" id="slips">Packing slips &amp; gift cards</button>
      </div>
      <div class="a-daygrid">
        <div><h2 class="h-s">To pack</h2><ul id="pack" class="a-pack"></ul></div>
        <div><h2 class="h-s">Pickups</h2><div id="pickups"></div></div>
        <div><h2 class="h-s">Deliveries <small class="muted">by area</small></h2><ol id="deliveries" class="a-route"></ol></div>
      </div>
    </section>

    <!-- PRODUCTS: price, shown on the site, sold out, stock; seasons -->
    <section id="v-products" hidden>
      <div class="seasons" id="seasons"></div>
      <p class="muted a-intro">Changes show on the site within a minute. <b>Shown</b> off hides a product everywhere (not launched, out of season). <b>Sold out</b> keeps it visible but stops orders. <b>Stock</b> left empty means no limit; a number counts down with each order and comes back when an order is cancelled. Leave the price empty to use the price from the product file. <b>Waiting</b> is how many people asked to be emailed when a product is back; they are emailed automatically when you turn it on again.</p>
      <div class="a-table-wrap"><table class="a-table" id="products">
        <thead><tr><th>Product</th><th>Family</th><th>Price</th><th>Shown</th><th>Sold out</th><th>Stock left</th><th>Per day</th><th>Waiting</th><th></th></tr></thead>
        <tbody></tbody>
      </table></div>
    </section>

    <!-- PROMOTIONS: promo codes -->
    <section id="v-promos" hidden>
      <form class="promo-form" id="promoForm">
        <h2 class="h-s">New code</h2>
        <div class="grid3">
          <div class="field"><label for="pc-code">Code</label><input id="pc-code" name="code" required placeholder="RAMADAN10" /></div>
          <div class="field"><label for="pc-kind">Type</label><select id="pc-kind" name="kind"><option value="percent">% off</option><option value="amount">$ off</option><option value="free-delivery">Free delivery</option></select></div>
          <div class="field"><label for="pc-value">Amount</label><input id="pc-value" name="value" type="number" min="1" step="1" placeholder="10" /></div>
          <div class="field"><label for="pc-min">Minimum order ($)</label><input id="pc-min" name="min" type="number" min="0" step="1" placeholder="0" /></div>
          <div class="field"><label for="pc-start">Starts</label><input id="pc-start" name="starts_on" type="date" /></div>
          <div class="field"><label for="pc-end">Ends</label><input id="pc-end" name="ends_on" type="date" /></div>
          <div class="field"><label for="pc-max">Uses in total</label><input id="pc-max" name="max_uses" type="number" min="1" placeholder="No limit" /></div>
          <div class="field"><label for="pc-note">Note (only the team sees it)</label><input id="pc-note" name="note" placeholder="Instagram giveaway" /></div>
          <label class="a-switch"><input type="checkbox" name="once" /> <span>Once per customer email</span></label>
        </div>
        <button class="btn primary" type="submit">Save code</button>
      </form>
      <div class="promo-form" id="listBox"></div>
      <div class="promo-form owner-only" id="letterBox">
        <h2 class="h-s">Letters to the mailing list</h2>
        <p class="muted">Write it in English and Arabic; each subscriber gets their language, with an unsubscribe link. Send yourself a test first. A blank line starts a new paragraph; **like this** makes bold; links work as they are.</p>
        <form id="letterForm" class="letter-form" novalidate>
          <input name="id" type="hidden" />
          <div class="two-col"><label>Subject (English)<input name="subject_en" maxlength="150" /></label><label dir="rtl">الموضوع (عربي)<input name="subject_ar" maxlength="150" dir="rtl" /></label></div>
          <div class="two-col"><label>Letter (English)<textarea name="body_en" rows="8"></textarea></label><label dir="rtl">الرسالة (عربي)<textarea name="body_ar" rows="8" dir="rtl"></textarea></label></div>
          <div class="acts"><button type="submit" class="btn line sm">Save draft</button><button type="button" class="btn line sm" id="letterTest">Send me a test</button><button type="button" class="btn primary sm" id="letterSend">Send to everyone</button><button type="button" class="btn line sm" id="letterNew">New letter</button></div>
        </form>
        <div class="a-table-wrap"><table class="a-table mini-t" id="letterTable"></table></div>
      </div>
      <div class="promo-form" id="gcBox"><h2 class="h-s">Gift cards</h2><p class="muted">Sold on the Gift cards page (footer link). Card payments send the code by themselves. For e-Transfer, press “Money received” when it arrives and the code is emailed.</p>
        <details class="owner-only gc-sell"><summary><b>Sell one here</b> (market, pop-up, at the door)</summary>
          <form id="gcSell" class="biz" novalidate>
            <label>Amount ($5 to $500)<input name="amount" type="number" min="5" max="500" step="1" inputmode="numeric" required /></label>
            <label>Paid by<select name="payment"><option value="cash">Cash</option><option value="card-here">Card on the reader</option><option value="e-transfer">e-Transfer (already received)</option></select></label>
            <label>For<input name="to_name" placeholder="Their name (optional)" /></label>
            <label>Their email<small>Optional. The code is emailed to them.</small><input name="to_email" type="email" /></label>
            <label>From<small>Needed when it is emailed to someone else.</small><input name="buyer_name" /></label>
            <label>Buyer's email<small>Optional. If there is no email for them, the code goes here.</small><input name="buyer_email" type="email" /></label>
            <label>Message<input name="message" maxlength="300" /></label>
            <label>Language of the email<select name="lang"><option value="en">English</option><option value="ar">العربية</option></select></label>
            <button type="submit" class="btn primary sm">Sell and show the code</button></form>
          <div id="gcSold"></div></details>
        <div class="a-table-wrap"><table class="a-table mini-t" id="gcTable"></table></div></div>
      <div class="a-table-wrap"><table class="a-table" id="promos">
        <thead><tr><th>Code</th><th>Gives</th><th>When</th><th>Used</th><th>Discount given</th><th>Note</th><th></th></tr></thead>
        <tbody></tbody>
      </table></div>
    </section>

    <!-- ASSISTANT: train Ask Hikaya -->
    <section id="v-assistant" hidden class="a-assist">
      <div id="askState"></div>
      <div class="a-stats" id="askStats"></div>
      <form class="promo-form" id="noteForm">
        <h2 class="h-s">Teach it an answer</h2>
        <p class="muted">Write a question the way a customer would ask it and the answer you want. Ask Hikaya uses these straight away, in English and Arabic, and they win over its handbook. Use them for corrections and for anything new (a new product, a holiday closure, a change in policy).</p>
        <input type="hidden" name="id" /><input type="hidden" name="fromChat" />
        <div class="field"><label for="n-q">Customer asks</label><input id="n-q" name="question" required placeholder="Do you deliver to Airdrie?" /></div>
        <div class="field"><label for="n-a">Hikaya answers</label><textarea id="n-a" name="answer" rows="3" required placeholder="Not yet. We deliver in Calgary only; pickup is free."></textarea></div>
        <div class="acts"><button class="btn primary" type="submit">Save answer</button> <button class="btn line" type="reset">Clear</button></div>
      </form>
      <h2 class="h-s">Team answers</h2>
      <ul class="notes" id="notes"></ul>
      <div class="howto">
        <h2 class="h-s">How Ask Hikaya learns</h2>
        <ol>
          <li><b>Every week</b>, open <b>Customers → Ask Hikaya chats</b>. Read the chats marked “not helpful” first.</li>
          <li>If an answer was wrong or missing, click <b>Teach an answer</b> on that chat and write the right one. It works immediately.</li>
          <li>For bigger changes (a policy, new products), the handbook (<code>knowledge/handbook.md</code>) is updated in a Claude Code session, then the 40 test questions run on GitHub: Actions → Ask Hikaya eval → Run workflow.</li>
        </ol>
        <p><a href="https://github.com/marysaif69-coder/Hikaya-test/actions/workflows/ask-eval.yml" target="_blank" rel="noopener">Open the test runs on GitHub</a> · <a href="https://github.com/marysaif69-coder/Hikaya-test/blob/claude/frontend-design-skills-setup-2e6lwc/knowledge/handbook.md" target="_blank" rel="noopener">Read the handbook</a> · <a href="https://github.com/marysaif69-coder/Hikaya-test/blob/claude/frontend-design-skills-setup-2e6lwc/knowledge/test-questions.json" target="_blank" rel="noopener">Read the test questions</a></p>
      </div>
    </section>

    <!-- WEEK: roast and pack sheet -->
    <section id="v-week" hidden>
      <div class="a-dayhead">
        <label class="h-s">Week from <input type="date" id="weekPick" /></label>
        <select id="weekSample"><option value="hide">Real orders</option><option value="only">Sample orders</option><option value="">Both</option></select>
        <button type="button" class="btn line sm" onclick="window.print()">Print</button>
      </div>
      <p class="muted" id="weekHead"></p>
      <div class="a-daygrid week">
        <div><h2 class="h-s">Coffee to roast and grind</h2><table class="a-table mini-t" id="wkCoffee"></table><p class="ev" id="wkCoffeeTot"></p></div>
        <div><h2 class="h-s">Dates</h2><table class="a-table mini-t" id="wkDates"></table><p class="ev">Pieces go in gift boxes (24 and 12). Grams are 500 g everyday boxes of one variety.</p></div>
        <div><h2 class="h-s">Packaging</h2><ul class="a-pack" id="wkPack"></ul></div>
        <div><h2 class="h-s">Orders by day</h2><ul class="a-pack" id="wkDays"></ul><h2 class="h-s" style="margin-top:10px">Everything ordered</h2><ul class="a-pack" id="wkItems"></ul></div>
      </div>
      <div class="promo-form"><h2 class="h-s">Regular orders</h2><p class="muted">Customers who chose “the same again every 2 or 4 weeks”. Each one becomes a normal order a week before its day (it then shows in Orders and on this sheet).</p>
        <div class="a-table-wrap"><table class="a-table mini-t" id="subTable"></table></div></div>
    </section>

    <!-- NUMBERS: visits and sales -->
    <section id="v-numbers" hidden>
      <p class="muted a-intro">Last 30 days. Visits are counted without cookies: one number per page and day, nothing about the visitor. Sales leave out sample and cancelled orders and subtract refunds.</p>
      <div class="a-daygrid week">
        <div><h2 class="h-s">Visits by day</h2><table class="a-table mini-t" id="nDays"></table></div>
        <div><h2 class="h-s">Sales by week</h2><table class="a-table mini-t" id="nWeeks"></table><h2 class="h-s" style="margin-top:12px">Best sellers</h2><table class="a-table mini-t" id="nTop"></table></div>
        <div><h2 class="h-s">Most visited pages</h2><table class="a-table mini-t" id="nPages"></table></div>
        <div><h2 class="h-s">Sites that sent visitors</h2><table class="a-table mini-t" id="nRefs"></table></div>
      </div>
      <div class="promo-form"><h2 class="h-s">Monthly report</h2><p class="muted">Emailed to the owners on the 1st of every month. Preview it here, or send last month's now.</p>
        <p><button type="button" class="btn line sm" id="repShow">Preview last month</button> <button type="button" class="btn line sm" id="repSend">Email it to the owners now</button> <span class="ev" id="repMsg"></span></p>
        <div id="repBody"></div></div>
      <div class="promo-form owner-only"><h2 class="h-s">Costs and margins</h2><p class="muted">Enter what one of each costs to make: coffee or dates, pouch or box, sleeve and label. Margins count orders by their pickup or delivery day, use today's costs, and take discounts and refunds off the total. Delivery fees are shown on their own.</p>
        <div class="mg-pick"><label>From <input type="date" id="mgFrom" /></label><label>To <input type="date" id="mgTo" /></label><button type="button" class="btn line sm" id="mgShow">Show</button></div>
        <div class="a-table-wrap"><table class="a-table mini-t" id="mgTable"></table></div><p id="mgTotals"></p>
        <details><summary><b>Cost of one, per product</b></summary><p class="muted">Saved as you leave each box.</p><div class="a-table-wrap"><table class="a-table mini-t" id="costTable"></table></div></details></div>
    </section>

    <!-- WORDS: recipes and product text -->
    <section id="v-words" hidden>
      <div class="w-top">
        <select id="wFile"><option value="products">Product names and descriptions</option><option value="recipes">Recipes (brew guides)</option><option value="driver-guide">Driver guide</option></select>
        <button type="button" class="btn primary sm" id="wSave">Save and publish</button>
        <span class="muted" id="wNote"></span>
      </div>
      <p class="muted a-intro">Change the words in English and Arabic, then save. The site updates in about two minutes. Prices, sold out and seasons are in Products.</p>
      <div id="wForm" class="w-form"></div>
    </section>

    <!-- DRIVERS: who drives, today's assignments, cash to hand in -->
    <section id="v-drivers" hidden class="plan">
      <div class="promo-form">
        <h2 class="h-s">Message to the team</h2>
        <form class="acts" id="annForm"><textarea name="body" rows="2" placeholder="e.g. Eid week: everyone in at 8. Parking at the back." style="flex:1 1 360px"></textarea><label><input type="checkbox" name="email" checked /> Also email everyone</label><button class="btn primary sm" type="submit">Post</button></form>
        <ul class="ann" id="annList"></ul>
      </div>
      <div class="promo-form">
        <div class="a-dayhead"><h2 class="h-s">Shifts</h2><label>From <input type="date" id="shFrom" /></label></div>
        <p class="muted">Post the shifts you need; the team signs up in the team app (or you put someone on). Everyone gets a reminder the evening before, and you get an email if a shift tomorrow isn't full.</p>
        <form class="acts" id="shForm"><input type="date" name="day" required /><input type="time" name="starts" value="09:00" required /><input type="time" name="ends" value="12:00" required />
          <select name="kind"><option value="packing">Packing</option><option value="driving">Driving</option><option value="counter">Pickup counter</option><option value="other">Other</option></select>
          <label>People <input name="spots" type="number" min="1" value="1" style="width:60px" /></label><label>Repeat weekly for <input name="repeatWeeks" type="number" min="0" max="12" value="0" style="width:60px" /> weeks</label>
          <input name="note" placeholder="Note (optional)" /><button class="btn primary sm" type="submit">Add shift</button></form>
        <div class="a-table-wrap"><table class="a-table mini-t" id="shTable"></table></div>
      </div>
      <div class="promo-form">
        <div class="a-dayhead"><h2 class="h-s">Hours</h2><label>From <input type="date" id="hrFrom" /></label><label>To <input type="date" id="hrTo" /></label><a class="btn line sm owner-only" id="hrCsv">Download (CSV)</a></div>
        <p class="muted">From check-in and check-out in the team app. Volunteer hours are counted the same way (useful for reference letters). Fix a time by clicking it in the shifts table.</p>
        <div class="a-table-wrap"><table class="a-table mini-t" id="hrTable"></table></div>
      </div>
      <div class="promo-form">
        <div class="a-dayhead"><label class="h-s">Deliveries on <input type="date" id="asgDay" /></label></div>
        <p class="muted">Choose a driver for each delivery. Drivers see only their own stops in the team app. When they press <b>Start route</b>, their customers get the “on its way” email; <b>Delivered</b> (after a photo at the door) sends the thank-you email. You don't need to change those steps here.</p>
        <div class="acts"><select id="asgAll"></select><button type="button" class="btn line sm" id="asgAllBtn">Give all unassigned to this driver</button></div>
        <div class="a-table-wrap"><table class="a-table mini-t" id="asgTable"></table></div>
      </div>
      <div class="promo-form" id="cashBox"></div>
      <div class="promo-form">
        <div class="a-dayhead"><h2 class="h-s">Driver reports</h2><label>From <input type="date" id="drFrom" /></label><label>To <input type="date" id="drTo" /></label></div>
        <p class="muted">Km come from the driver's odometer when they type it, otherwise from the planned route (needs the Google Maps key in Settings). Each driver sees the same report for themselves in the app.</p>
        <div class="a-table-wrap"><table class="a-table mini-t" id="drTable"></table></div>
        <form class="acts owner-only" id="payForm"><b>Pay rates (optional)</b>
          <label>Per delivery $ <input name="perDelivery" type="number" min="0" step="0.01" style="width:90px" /></label>
          <label>Per km $ <input name="perKm" type="number" min="0" step="0.01" style="width:90px" /></label>
          <label>Per hour $ <input name="perHour" type="number" min="0" step="0.01" style="width:90px" /></label>
          <button class="btn line sm" type="submit">Save rates</button></form>
      </div>
      <div class="promo-form">
        <h2 class="h-s">The team</h2>
        <p class="muted">Add people by email, or tick “Uses our shared login” for people who log in with the shared email (hello@), pick their name and confirm with a code sent to their own email. Drivers and packers (paid or volunteer) get the team app: they log in with a code (Gmail or any email), fill in their details and papers, read the team guide (edit it in Words) and add the app to their phone. Helpers and managers get this order desk without money or settings; tick “Also drives” for anyone who also delivers (owners too: add yourself as Helper + Also drives to get deliveries and have your licence and insurance tracked; you stay an owner). Owners are set in Netlify (ADMIN_EMAILS).</p>
        <form class="acts owner-only" id="invForm" novalidate><input name="email" type="email" placeholder="their@email.com" /><input name="name" placeholder="Name (optional)" /><select name="role"><option value="driver">Driver</option><option value="packer">Packer</option><option value="helper">Helper / manager (order desk)</option></select><label><input type="checkbox" name="drives" /> Also drives</label><label><input type="checkbox" name="shared" /> Uses our shared login (their own email gets the confirmation code)</label><label><input type="checkbox" name="volunteer" /> Volunteer</label><button class="btn primary sm" type="submit">Add and email them</button></form>
        <div class="a-table-wrap"><table class="a-table mini-t" id="teamTable"></table></div>
        <p class="muted">Deliveries counted per driver for paying them; set how you pay later.</p>
      </div>
    </section>

    <!-- PRODUCTION: lots, recall, supplies -->
    <section id="v-production" hidden class="plan">
      <div class="promo-form">
        <h2 class="h-s">Production lots</h2>
        <p class="muted">Each batch you roast, grind or portion gets a lot code. Packing slips show the lots in each order, so if there's ever a problem with a batch you can find who got it. Put the lot code on the label too.</p>
        <form class="acts" id="lotForm">
          <select name="item"></select><label>Made <input type="date" name="made_on" /></label><label>Best before <input type="date" name="best_before" /></label>
          <input name="quantity" placeholder="Quantity, e.g. 10 kg" /><input name="supplier" placeholder="Supplier / origin (optional)" /><button class="btn primary sm" type="submit">Add lot</button></form>
        <div class="a-table-wrap"><table class="a-table mini-t" id="lotTable"></table></div>
      </div>
      <div class="promo-form">
        <h2 class="h-s">Labels</h2>
        <p class="muted">Print labels for a lot: English and French, ingredients and allergens, net quantity, best before and lot code. <b>Check the wording with the CFIA before selling</b>; the address shows as [address] until it's set. 10 labels per letter-size sheet (2 × 4 in).</p>
        <form class="acts" id="labelForm"><select name="lot"></select><label>Net quantity <input name="net" placeholder="250 g" style="width:90px" /></label><label>How many <input name="n" type="number" min="1" max="200" value="10" style="width:70px" /></label><button class="btn line sm" type="submit">Print labels</button></form>
      </div>
      <div class="promo-form">
        <div class="a-dayhead"><h2 class="h-s">Food safety log</h2><a class="btn line sm owner-only" id="fsEdit">Edit the checklists</a></div>
        <p class="muted">The checklists the team signs in the team app (Shifts tab), with temperatures. A draft to adjust with your food-safety training or AHS inspector.</p>
        <div id="fsEditor" hidden></div>
        <div class="a-table-wrap"><table class="a-table mini-t" id="fsTable"></table></div>
      </div>
      <div class="promo-form">
        <h2 class="h-s">Recall lookup</h2>
        <form class="acts" id="recallForm"><input name="code" placeholder="Lot code, e.g. NAJDI-270201-1" required /><button class="btn line sm" type="submit">Find orders</button></form>
        <div id="recallOut"></div>
      </div>
      <div class="promo-form">
        <div class="a-dayhead"><h2 class="h-s">Supplies</h2><label>Week from <input type="date" id="supFrom" /></label></div>
        <p class="muted">Type what you have on hand; the needs come from the week's orders. Set "warn at" to see when to reorder.</p>
        <div class="a-table-wrap"><table class="a-table mini-t" id="supTable"></table></div>
        <form class="acts" id="supNew"><input name="name" placeholder="Add a supply, e.g. Cardamom" required /><input name="unit" placeholder="Unit (kg, pcs)" style="width:100px" /><button class="btn line sm" type="submit">Add</button></form>
      </div>
    </section>

    <!-- CUSTOMERS -->
    <section id="v-customers" hidden>
      <form class="a-filters" id="custFilter"><input type="search" name="q" placeholder="Search name, email or phone" /></form>
      <div class="a-table-wrap"><table class="a-table" id="custTable"></table></div>
    </section>

    <!-- PLAN: what is built, what is left before launch, and ideas for later -->
    <section id="v-plan" hidden class="plan">
      <div class="promo-form">
        <h2 class="h-s">Before launch: who does what</h2>
        <p class="muted">Everything here is done in the desk or on your phones; nothing needs Claude. Items in order.</p>
        <h3 class="plan-h">Maryam and Shadi (owners)</h3>
        <ol class="plan-list">
          <li><b>Settings → Business details</b>: pickup address and hours, phone, e-Transfer email, Google review link, GST number. This replaces “[address]” on the site, in emails, labels and Ask Hikaya.</li>
          <li><b>Team</b>: add yourselves as shared people under hello@hikayacoffee.ca (each with your own email for the code), and Ahmed with his Gmail as a driver (or helper who also drives). To make Ahmed an owner, add his email under Business details → Owners.</li>
          <li><b>Shop → Products</b>: final prices. <b>Numbers → Costs</b>: what one of each costs to make, so margins are right.</li>
          <li><b>Photos</b> of the Guest Box and the Coffee Duo; final product text in <b>Shop → Words</b>.</li>
          <li><b>GST</b>: ask your accountant whether gift boxes are zero-rated; the site says “GST pending”.</li>
          <li><b>Settings → Limits</b>: orders per day, gift boxes per day, stops per driver. <b>Team</b>: post the first shifts.</li>
          <li><b>Production</b>: read the draft food-safety checklists and change them to how you work; count packaging in Supplies.</li>
          <li><b>Keys in Netlify</b> when you are ready (the list with ticks is in Settings): Square (cards online and the reader), GitHub token (for Words), and later Twilio (texts) and Google Maps (shortest route, worth it from about 8 stops a day).</li>
          <li><b>Two-factor login</b> on GitHub, Netlify, Square, Resend and Anthropic; GitHub secret scanning and push protection on.</li>
        </ol>
        <h3 class="plan-h">Everyone who packs or drives (Ahmed, Maryam)</h3>
        <ol class="plan-list">
          <li>Open the team app link from the invite email on your phone, add it to the Home Screen, and finish setting up (licence and insurance dates for drivers).</li>
          <li>Me → <b>Turn on</b> notifications → <b>Send a test</b>.</li>
        </ol>
        <h3 class="plan-h">Then</h3>
        <ol class="plan-list">
          <li>The <b>rehearsal</b> below with a real order to yourselves, then the launch-day steps in the launch plan.</li>
          <li>The held date changes stay off the site until you say “publish the dates”.</li>
        </ol>
      </div>
      <div class="promo-form">
        <h2 class="h-s">Rehearsal: one full order, start to finish (about 30 minutes)</h2>
        <p class="muted">Do it now with draft prices; changing prices later changes nothing else. Use your own email and phone. Afterwards tick “This is a sample / test order” on it so it stays out of the numbers.</p>
        <ol class="plan-list">
          <li>On your phone, open the site, add a coffee and a date box, check out as a guest with <b>delivery</b>, tick the gift, the text reminder and “every 4 weeks”.</li>
          <li>Check the email: right name, items, day, total, gift message. Reply to it and see where the reply lands.</li>
          <li>Desk → Orders: find it, mark Confirmed (email), then Week sheet and Day sheet: is it there, are the quantities right?</li>
          <li>Team app on your phone: assign the delivery to yourself (Team tab), Pack it, Deliver → Start route (email), see “You're next” on the order page, Photo at the door, Delivered (email); cash in on the Team tab.</li>
          <li>My account: log in with the code, see the order and the regular order; press Skip, then Stop.</li>
          <li>Refund $1 to store credit from the order; use the credit code on a second order.</li>
          <li>Buy a $25 gift card by e-Transfer, press Money received in Promotions, check the code arrives, use part of it.</li>
          <li>Ask Hikaya three questions, one by voice and one in Arabizi; read them in Customers → Ask Hikaya chats.</li>
          <li>When Square is connected: one $1 card order, then refund it from the desk.</li>
          <li>Team: add yourself as a packer with a second email, sign up for a shift, check in and out, and pack an order from the team app.</li>
          <li>Write down anything odd and tell Claude.</li>
        </ol>
      </div>
      <div class="promo-form">
        <h2 class="h-s">Built</h2>
        <ul class="plan-list done">
          <li>Shop, checkout, accounts, emails at every step, reminders the evening before</li>
          <li>Order desk, day and week sheets, packing slips and gift-message cards, Customers with team notes</li>
          <li>Drivers: add by email, onboarding with the driver guide, delivery app on iPhone and Android, assignments, Start route with the shortest order (Google Maps key), next-stop navigation, km from the app or odometer, drivers' own reports and mileage log, photo at every door, cash or card at the door, cash to hand in, deliveries counted per driver</li>
          <li>Confirm all new orders, or confirm automatically; customers change the day themselves; tomorrow's run sheet by email; low-stock emails</li>
          <li>Prices, show/hide, sold out, stock, Ramadan and Eid switches, promo codes, refunds, sample orders</li>
          <li>Gift orders and year-round gift boxes, gift cards, “email me when it's back”</li>
          <li>Regular orders (every 2 or 4 weeks), order again, text-message reminders</li>
          <li>Ask Hikaya with team answers, backup answers, voice input and Arabizi; Inbox</li>
          <li>Mailing list with consent, Google review emails, visit numbers, monthly report</li>
          <li>Team app for drivers and packers (paid or volunteer): shifts with sign-up, reminders and check-in, hours, papers with expiry reminders, packing list</li>
          <li>Limits: orders per day, gift boxes per day, per-product daily limits, deliveries tied to drivers on shift</li>
          <li>Production lots on every packing slip, recall lookup, supplies against the week's needs</li>
          <li>Shared team login with “Who's working?” confirmed by a code to each person's own email; owners and managers who also drive</li>
          <li>Change items in an order; “you're next” message to the next customer on a route; letters to the mailing list from the desk</li>
          <li>Printable English/French labels per lot; food-safety checklists signed in the team app; team messages; backup download; activity log</li>
          <li>Customers see how many stops are before theirs while a delivery is on the way (account page and Ask Hikaya)</li>
          <li>Quick search at the top of the desk (press /): orders, customers and messages by number, name, email or phone</li>
          <li>Today page: everything waiting (new orders, packing, deliveries with no driver, e-Transfers not in, messages, cash, low stock, shift gaps, papers, food-safety checklists)</li>
          <li>Phone notifications in the team app (Me → Turn on): new stops for drivers, team messages, shift reminders, new orders for owners</li>
          <li>Business details and extra owners in Settings; costs and margins in Numbers; gift cards sold in person with a printable card</li>
          <li>Words editor for product text and recipes; settings checklist; private preview gate</li>
        </ul>
      </div>
      <div class="promo-form">
        <h2 class="h-s">Ideas for later</h2>
        <ul class="plan-list">
          <li>Driver pay: decide per delivery or per hour; the deliveries are already counted per driver.</li>
          <li>An App Store / Google Play version of the delivery app, only if the home-screen app isn't enough.</li>
          <li>Loyalty: a free coffee after a number of orders, if customers ask for it.</li>
          <li>Wholesale price list for cafés, mosques and offices.</li>
        </ul>
      </div>
    </section>

    <!-- SETTINGS -->
    <section id="v-settings" hidden class="a-settings">
      <div class="conn" id="conn"></div>
      <div class="conn owner-only"><h2 class="h-s">Business details</h2>
        <p class="muted">Set these here instead of in Netlify; they're used on the site, in emails, labels, delivery routes and by Ask Hikaya. Empty = use the Netlify value (shown in grey). Keys and passwords stay in Netlify.</p>
        <form id="bizForm" class="biz" novalidate></form></div>
      <div class="conn owner-only"><h2 class="h-s">Backup and activity</h2>
        <p class="muted">Download everything (orders, customers, team, settings…) as one file, e.g. once a month, and keep it somewhere safe. Login codes and sessions are left out.</p>
        <p><a class="btn line sm" href="/api/admin/backup.json">Download a backup</a> <button type="button" class="btn line sm" id="actShow">Show the activity log</button></p>
        <div class="a-table-wrap" id="actBox" hidden><table class="a-table mini-t" id="actTable"></table></div></div>
      <form id="setForm">
        <h2 class="h-s">Taking orders</h2>
        <label class="a-switch"><input type="checkbox" name="open" /> <span>Open for new orders</span></label>
        <fieldset class="caps"><legend class="h-s">Limits (leave empty for none)</legend>
          <label>Orders per day, at most <input name="capDaily" type="number" min="1" /></label>
          <label>Gift boxes we can pack per day <input name="capBoxes" type="number" min="1" /></label>
          <label class="a-switch"><input type="checkbox" name="capShifts" /> <span>Delivery places follow the drivers on shift (Team → Shifts)</span></label>
          <label>Stops one driver can do per time window <input name="capStops" type="number" min="1" /></label>
          <p class="muted">With the switch on, a time window with no driver on shift takes no deliveries. A product's own daily limit is in Products (“Per day”).</p>
        </fieldset>
        <label class="a-switch"><input type="checkbox" name="autoConfirm" /> <span>Confirm new orders automatically (customers get the confirmation email straight away)</span></label>
        <h2 class="h-s">Places per time window</h2>
        <div class="two">
          <div class="field"><label for="capP">Pickups per window</label><input id="capP" name="pickup" type="number" min="0" max="200" /></div>
          <div class="field"><label for="capD">Deliveries per window</label><input id="capD" name="delivery" type="number" min="0" max="200" /></div>
        </div>
        <p class="muted">Windows: 11:00–14:00, 14:00–17:00, 17:00–20:00, Thursday to Sunday.</p>
        <h2 class="h-s">Order-by deadline</h2>
        <label class="a-switch"><input type="radio" name="cutoffMode" value="day-before" /> <span>The evening before each day</span></label>
        <label class="a-switch"><input type="radio" name="cutoffMode" value="weekly" /> <span>Once a week for the coming Thursday–Sunday</span></label>
        <div class="two">
          <div class="field" id="cutDayField"><label for="cutDay">Weekly deadline day</label><select id="cutDay" name="cutoffWeekday"><option value="0">Sunday</option><option value="1">Monday</option><option value="2">Tuesday</option><option value="3">Wednesday</option></select></div>
          <div class="field"><label for="cutHour">At (24-hour clock)</label><select id="cutHour" name="cutoffHour">{Array.from({ length: 24 }, (_, h) => <option value={h}>{String(h).padStart(2, '0')}:00</option>)}</select></div>
        </div>
        <p class="muted" id="cutPreview"></p>
        <h2 class="h-s">Dates</h2>
        <div class="field"><label for="firstDay">First day open for orders</label><input id="firstDay" name="firstDay" type="date" /></div>
        <div class="field"><label for="closed">Closed days (one per line, e.g. Eid day)</label><textarea id="closed" name="closedDates" rows="3" placeholder="2027-03-09"></textarea></div>
        <button class="btn primary" type="submit">Save</button> <span id="saved" class="muted" hidden>Saved.</span>
      </form>
    </section>
  </main>

  <!-- ORDER PANEL -->
  <div class="scrim" id="pScrim" hidden></div>
  <aside class="drawer a-panel" id="panel" aria-label="Order" aria-hidden="true" inert>
    <div class="dr-head"><h2 class="h-s" id="pRef"></h2><button class="dr-x" type="button" id="pClose" aria-label="Close"><svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></button></div>
    <div class="a-pbody" id="pBody"></div>
  </aside>
</body>
</html>

<style>
