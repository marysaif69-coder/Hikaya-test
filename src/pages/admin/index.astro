  // ---------- words: recipes and product text ----------
  const W_LABEL: Record<string, string> = { name: 'Name', taste: 'Taste line', notes: 'Description', story: 'Story', bunn: 'What Bunn says', why: 'Why this date', contents: "What's inside", size: 'Size', title: 'Title', vessel: 'You need', yields: 'Makes', steps: 'Steps', serve: 'How to serve', secs: 'Timer (seconds)' };
  let words: { file: string; data: any; sha: string | null } | null = null;
  const isPair = (v: any) => v && typeof v === 'object' && !Array.isArray(v) && typeof v.en === 'string' && typeof v.ar === 'string' && Object.keys(v).length === 2;
  function wField(v: any, path: (string | number)[], label: string): string {
    const p = esc(JSON.stringify(path));
    if (isPair(v)) {
      const long = Math.max(v.en.length, v.ar.length) > 70;
      const box = (l: 'en' | 'ar') => long ? `<textarea data-wpath="${esc(JSON.stringify([...path, l]))}" rows="3" ${l === 'ar' ? 'dir="rtl" lang="ar"' : ''}>${esc(v[l])}</textarea>` : `<input data-wpath="${esc(JSON.stringify([...path, l]))}" value="${esc(v[l])}" ${l === 'ar' ? 'dir="rtl" lang="ar"' : ''} />`;
      return `<div class="w-pair"><span class="w-l">${esc(label)}</span>${box('en')}${box('ar')}</div>`;
    }
    if (typeof v === 'number') return `<label class="w-num">${esc(label)} <input type="number" min="0" max="86400" data-wpath="${p}" data-num value="${v}" /></label>`;
    if (Array.isArray(v)) return `<div class="w-list"><span class="w-l">${esc(label)}</span>${v.map((x, i) => `<div class="w-step"><b>${i + 1}</b>${Object.entries(x).map(([k, y]) => wField(y, [...path, i, k], k === 't' ? '' : W_LABEL[k] ?? k)).join('')}</div>`).join('')}</div>`;
    if (v && typeof v === 'object') return Object.entries(v).map(([k, y]) => wField(y, [...path, k], W_LABEL[k] ?? k)).join('');
    return '';
  }
  async function loadWords() {
    const file = ($('wFile') as HTMLSelectElement).value;
    const d = await api(`/api/admin/content/${file}`);
    words = { file, data: d.data, sha: d.sha };
    ($('wSave') as HTMLButtonElement).disabled = !d.canSave;
    $('wNote').textContent = d.canSave ? '' : 'Saving is off until GITHUB_CONTENT_TOKEN is added in Netlify (see the guide).';
    $('wForm').innerHTML = Object.entries(d.data).map(([id, v]: [string, any]) => `<details class="w-item"><summary>${esc(v.name?.en ?? v.title?.en ?? id)} <small>${esc(v.name?.ar ?? v.title?.ar ?? '')}</small></summary>${wField(v, [id], '')}</details>`).join('');
  }
  $('wFile').addEventListener('change', loadWords);
  $('wSave').addEventListener('click', async () => {
    if (!words) return;
    const data = JSON.parse(JSON.stringify(words.data));
    document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('#wForm [data-wpath]').forEach(el => {
      const path = JSON.parse(el.dataset.wpath!); let o = data;
      for (const k of path.slice(0, -1)) o = o[k];
      o[path.at(-1)] = 'num' in el.dataset ? Number(el.value) : el.value;
    });
    const btn = $('wSave') as HTMLButtonElement; btn.disabled = true;
    try {
      const r = await api(`/api/admin/content/${words.file}`, { data, sha: words.sha });
      $('wNote').textContent = r.saved ? 'Saved. The site shows it in about two minutes.' : 'Nothing changed.';
      if (r.saved) { words.sha = r.sha; words.data = data; }
    } finally { btn.disabled = false; }
  });

