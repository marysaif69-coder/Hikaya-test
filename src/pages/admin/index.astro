---
// The team's order desk. Static page; every action goes through /api/admin/*, which checks
// the session belongs to an email in ADMIN_EMAILS. Hidden from search engines.
import '../../styles/fonts.css';
import '../../styles/global.css';
---
<!doctype html>
<html lang="en" dir="ltr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Order desk · Hikaya</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body class="adm">
  <header class="a-top">
    <a class="lockup" href="/en/"><img src="/brand/logo.svg" alt="" width="40" height="34" /><span class="wm"><b>حكاية</b><small>ORDER DESK</small></span></a>
    <nav class="a-tabs" id="tabs" hidden>
      <button type="button" data-tab="orders" aria-pressed="true">Orders</button>
      <button type="button" data-tab="inbox" aria-pressed="false">Inbox <span class="badge" id="inboxN" hidden></span></button>
      <button type="button" data-tab="day" aria-pressed="false">Day sheet</button>
      <button type="button" data-tab="products" aria-pressed="false">Products</button>
      <button type="button" data-tab="promos" aria-pressed="false">Promotions</button>
      <button type="button" data-tab="assistant" aria-pressed="false">Assistant <span class="badge warn-badge" id="askWarn" hidden>!</span></button>
      <button type="button" data-tab="chats" aria-pressed="false">Conversations</button>
      <button type="button" data-tab="settings" aria-pressed="false">Settings</button>
    </nav>
    <div class="a-who" id="who" hidden><span id="whoEmail"></span><button type="button" id="logout">Log out</button></div>
  </header>

  <main class="a-main">
    <section id="login" hidden class="a-login">
      <h1 class="h-m">Team login</h1>
      <p class="muted">Use your Hikaya email. Only emails on the team list can open the desk.</p>
      <div id="loginBox"></div>
      <p class="err" id="notAdmin" hidden>This email is not on the team list. Ask Maryam to add it in Netlify (ADMIN_EMAILS).</p>
    </section>

    <!-- ORDERS -->
    <section id="v-orders" hidden>
      <div class="a-stats" id="stats"></div>
      <form class="a-filters" id="filters">
        <input type="search" name="q" placeholder="Search name, email, phone, postal, HK-…" />
        <select name="status"><option value="">All statuses</option></select>
        <select name="method"><option value="">Pickup & delivery</option><option value="pickup">Pickup</option><option value="delivery">Delivery</option></select>
        <label>From <input type="date" name="from" /></label>
        <label>To <input type="date" name="to" /></label>
        <select name="sample"><option value="">Real & sample orders</option><option value="hide">Real orders only</option><option value="only">Sample orders only</option></select>
        <a class="btn line sm" id="csv" href="/api/admin/export.csv">Export CSV</a>
      </form>
      <div class="samples">
        <span class="muted">Sample orders are made up, marked <span class="pill sample">SAMPLE</span>, never email anyone and are left out of the CSV.</span>
        <button type="button" class="btn line sm" id="mkSamples">Add sample orders (5 weeks)</button>
        <button type="button" class="btn line sm danger" id="rmSamples">Remove all sample orders</button>
      </div>
      <div class="a-table-wrap"><table class="a-table" id="list">
        <thead><tr><th>Order</th><th>Day</th><th>Customer</th><th>How</th><th>Items</th><th>Total</th><th>Paid</th><th>Status</th></tr></thead>
        <tbody></tbody>
      </table></div>
      <p class="muted" id="none" hidden>No orders match.</p>
    </section>

    <!-- INBOX: help requests from the form and from Ask Hikaya -->
    <section id="v-inbox" hidden>
      <div class="a-filters" id="inboxFilter">
        <div class="acts seg">
          <button type="button" data-st="open" class="cur">Open</button><button type="button" data-st="waiting">Waiting on customer</button><button type="button" data-st="resolved">Resolved</button><button type="button" data-st="">All</button>
        </div>
      </div>
      <div class="a-table-wrap"><table class="a-table" id="tickets">
        <thead><tr><th>Request</th><th>Received</th><th>Customer</th><th>About</th><th>Summary</th><th>Order</th><th>Status</th></tr></thead>
        <tbody></tbody>
      </table></div>
      <p class="muted" id="noTickets" hidden>Nothing here. Requests from the help form and from Ask Hikaya land in this list, and each one is also emailed to the team.</p>
    </section>

    <!-- CONVERSATIONS: what people ask Ask Hikaya -->
    <section id="v-chats" hidden>
      <p class="muted a-intro">Every conversation with Ask Hikaya. Read them to see what customers really ask, where the answers fall short, and what to add to the handbook or the test questions.</p>
      <div class="a-table-wrap"><table class="a-table" id="chats">
        <thead><tr><th>Last message</th><th>Lang</th><th>First question</th><th>Turns</th><th>Sent to team</th><th>Helpful?</th></tr></thead>
        <tbody></tbody>
      </table></div>
      <p class="muted" id="noChats" hidden>No conversations yet.</p>
    </section>

    <!-- DAY SHEET -->
    <section id="v-day" hidden>
      <div class="a-dayhead">
        <label class="h-s">Day <input type="date" id="dayPick" /></label>
        <button type="button" class="btn line sm" onclick="window.print()">Print</button>
      </div>
      <div class="a-daygrid">
        <div><h2 class="h-s">To pack</h2><ul id="pack" class="a-pack"></ul></div>
        <div><h2 class="h-s">Pickups</h2><div id="pickups"></div></div>
        <div><h2 class="h-s">Deliveries <small class="muted">by area</small></h2><ol id="deliveries" class="a-route"></ol></div>
      </div>
    </section>

    <!-- PRODUCTS: price, shown on the site, sold out, stock; seasons -->
    <section id="v-products" hidden>
      <div class="seasons" id="seasons"></div>
      <p class="muted a-intro">Changes show on the site within a minute. <b>Shown</b> off hides a product everywhere (not launched, out of season). <b>Sold out</b> keeps it visible but stops orders. <b>Stock</b> left empty means no limit; a number counts down with each order and comes back when an order is cancelled. Leave the price empty to use the price from the product file.</p>
      <div class="a-table-wrap"><table class="a-table" id="products">
        <thead><tr><th>Product</th><th>Family</th><th>Price</th><th>Shown</th><th>Sold out</th><th>Stock left</th><th></th></tr></thead>
        <tbody></tbody>
      </table></div>
    </section>

    <!-- PROMOTIONS: promo codes -->
    <section id="v-promos" hidden>
      <form class="promo-form" id="promoForm">
        <h2 class="h-s">New code</h2>
        <div class="grid3">
          <div class="field"><label for="pc-code">Code</label><input id="pc-code" name="code" required placeholder="RAMADAN10" /></div>
          <div class="field"><label for="pc-kind">Type</label><select id="pc-kind" name="kind"><option value="percent">% off</option><option value="amount">$ off</option><option value="free-delivery">Free delivery</option></select></div>
          <div class="field"><label for="pc-value">Amount</label><input id="pc-value" name="value" type="number" min="1" step="1" placeholder="10" /></div>
          <div class="field"><label for="pc-min">Minimum order ($)</label><input id="pc-min" name="min" type="number" min="0" step="1" placeholder="0" /></div>
          <div class="field"><label for="pc-start">Starts</label><input id="pc-start" name="starts_on" type="date" /></div>
          <div class="field"><label for="pc-end">Ends</label><input id="pc-end" name="ends_on" type="date" /></div>
          <div class="field"><label for="pc-max">Uses in total</label><input id="pc-max" name="max_uses" type="number" min="1" placeholder="No limit" /></div>
          <div class="field"><label for="pc-note">Note (only the team sees it)</label><input id="pc-note" name="note" placeholder="Instagram giveaway" /></div>
          <label class="a-switch"><input type="checkbox" name="once" /> <span>Once per customer email</span></label>
        </div>
        <button class="btn primary" type="submit">Save code</button>
      </form>
      <div class="a-table-wrap"><table class="a-table" id="promos">
        <thead><tr><th>Code</th><th>Gives</th><th>When</th><th>Used</th><th>Discount given</th><th>Note</th><th></th></tr></thead>
        <tbody></tbody>
      </table></div>
    </section>

    <!-- ASSISTANT: train Ask Hikaya -->
    <section id="v-assistant" hidden class="a-assist">
      <div id="askState"></div>
      <div class="a-stats" id="askStats"></div>
      <form class="promo-form" id="noteForm">
        <h2 class="h-s">Teach it an answer</h2>
        <p class="muted">Write a question the way a customer would ask it and the answer you want. Ask Hikaya uses these straight away, in English and Arabic, and they win over its handbook. Use them for corrections and for anything new (a new product, a holiday closure, a change in policy).</p>
        <input type="hidden" name="id" /><input type="hidden" name="fromChat" />
        <div class="field"><label for="n-q">Customer asks</label><input id="n-q" name="question" required placeholder="Do you deliver to Airdrie?" /></div>
        <div class="field"><label for="n-a">Hikaya answers</label><textarea id="n-a" name="answer" rows="3" required placeholder="Not yet. We deliver in Calgary only; pickup is free."></textarea></div>
        <div class="acts"><button class="btn primary" type="submit">Save answer</button> <button class="btn line" type="reset">Clear</button></div>
      </form>
      <h2 class="h-s">Team answers</h2>
      <ul class="notes" id="notes"></ul>
      <div class="howto">
        <h2 class="h-s">How Ask Hikaya learns</h2>
        <ol>
          <li><b>Every week</b>, open <b>Conversations</b>. Read the chats marked “not helpful” first.</li>
          <li>If an answer was wrong or missing, click <b>Teach an answer</b> on that chat and write the right one. It works immediately.</li>
          <li>For bigger changes (a policy, new products), the handbook (<code>knowledge/handbook.md</code>) is updated in a Claude Code session, then the 40 test questions run on GitHub: Actions → Ask Hikaya eval → Run workflow.</li>
        </ol>
        <p><a href="https://github.com/marysaif69-coder/Hikaya-test/actions/workflows/ask-eval.yml" target="_blank" rel="noopener">Open the test runs on GitHub</a> · <a href="https://github.com/marysaif69-coder/Hikaya-test/blob/claude/frontend-design-skills-setup-2e6lwc/knowledge/handbook.md" target="_blank" rel="noopener">Read the handbook</a> · <a href="https://github.com/marysaif69-coder/Hikaya-test/blob/claude/frontend-design-skills-setup-2e6lwc/knowledge/test-questions.json" target="_blank" rel="noopener">Read the test questions</a></p>
      </div>
    </section>

    <!-- SETTINGS -->
    <section id="v-settings" hidden class="a-settings">
      <form id="setForm">
        <h2 class="h-s">Taking orders</h2>
        <label class="a-switch"><input type="checkbox" name="open" /> <span>Open for new orders</span></label>
        <h2 class="h-s">Places per time window</h2>
        <div class="two">
          <div class="field"><label for="capP">Pickups per window</label><input id="capP" name="pickup" type="number" min="0" max="200" /></div>
          <div class="field"><label for="capD">Deliveries per window</label><input id="capD" name="delivery" type="number" min="0" max="200" /></div>
        </div>
        <p class="muted">Windows: 11:00–14:00, 14:00–17:00, 17:00–20:00, Thursday to Sunday.</p>
        <h2 class="h-s">Order-by deadline</h2>
        <label class="a-switch"><input type="radio" name="cutoffMode" value="day-before" /> <span>The evening before each day</span></label>
        <label class="a-switch"><input type="radio" name="cutoffMode" value="weekly" /> <span>Once a week for the coming Thursday–Sunday</span></label>
        <div class="two">
          <div class="field" id="cutDayField"><label for="cutDay">Weekly deadline day</label><select id="cutDay" name="cutoffWeekday"><option value="0">Sunday</option><option value="1">Monday</option><option value="2">Tuesday</option><option value="3">Wednesday</option></select></div>
          <div class="field"><label for="cutHour">At (24-hour clock)</label><select id="cutHour" name="cutoffHour">{Array.from({ length: 24 }, (_, h) => <option value={h}>{String(h).padStart(2, '0')}:00</option>)}</select></div>
        </div>
        <p class="muted" id="cutPreview"></p>
        <h2 class="h-s">Dates</h2>
        <div class="field"><label for="firstDay">First day open for orders</label><input id="firstDay" name="firstDay" type="date" /></div>
        <div class="field"><label for="closed">Closed days (one per line, e.g. Eid day)</label><textarea id="closed" name="closedDates" rows="3" placeholder="2027-03-09"></textarea></div>
        <button class="btn primary" type="submit">Save</button> <span id="saved" class="muted" hidden>Saved.</span>
      </form>
    </section>
  </main>

  <!-- ORDER PANEL -->
  <div class="scrim" id="pScrim" hidden></div>
  <aside class="drawer a-panel" id="panel" aria-label="Order" aria-hidden="true" inert>
    <div class="dr-head"><h2 class="h-s" id="pRef"></h2><button class="dr-x" type="button" id="pClose" aria-label="Close"><svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></button></div>
    <div class="a-pbody" id="pBody"></div>
  </aside>
</body>
</html>

<style>
  .adm { background: var(--paper); }
  .a-top { position: sticky; top: 0; z-index: 30; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; padding: 12px clamp(16px, 3vw, 32px); background: var(--paper); border-bottom: 1px solid var(--line); }
  .a-top .lockup img { width: 40px; }
  .a-top .wm b { font-size: 24px; }
  .a-tabs { display: flex; gap: 4px; }
  .a-tabs button { border: 0; background: none; padding: 9px 14px; border-radius: 999px; font-weight: 600; }
  .a-tabs button[aria-pressed='true'] { background: var(--bunn); color: var(--paper); }
  .a-who { margin-inline-start: auto; display: flex; gap: 12px; align-items: center; font-size: 14px; color: var(--ink-2); }
  .a-who button { border: 0; background: none; color: var(--tamr); font-weight: 600; text-decoration: underline; }
  .a-main { padding: 24px clamp(16px, 3vw, 32px) 80px; display: grid; gap: 20px; }
  .a-login { max-width: 460px; display: grid; gap: 14px; margin: 40px auto; background: var(--sheet); padding: 26px; border-radius: 28px; }
  .a-login :global(.lg) { display: grid; gap: 14px; }
  .a-login :global(.lg-row) { display: flex; gap: 12px; flex-wrap: wrap; }
  .a-login :global(.lg-back) { border: 0; background: none; text-decoration: underline; color: var(--ink-2); }
  .a-login :global(#lg-c) { font-size: 26px; letter-spacing: .35em; text-align: center; }
  .a-stats { display: flex; flex-wrap: wrap; gap: 10px; }
  .a-stats :global(.st) { background: var(--sheet); border-radius: 16px; padding: 10px 14px; min-width: 120px; }
  .a-stats :global(.st b) { display: block; font-family: var(--display); font-size: 26px; }
  .a-stats :global(.st span) { font-size: 13px; color: var(--ink-2); }
  .a-filters { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .a-filters input, .a-filters select { border: 1.5px solid var(--line); background: var(--sheet); border-radius: 12px; padding: 9px 12px; font-size: 15px; }
  .a-filters input[type=search] { min-width: 260px; flex: 1; }
  .a-filters label { display: inline-flex; gap: 6px; align-items: center; font-size: 14px; color: var(--ink-2); }
  .sm { min-height: 40px; padding: 8px 14px; font-size: 14px; }
  .a-table-wrap { overflow-x: auto; background: var(--sheet); border-radius: 20px; }
  .a-table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  .a-table th { text-align: left; font-size: 12.5px; color: var(--ink-2); font-weight: 600; padding: 12px; border-bottom: 2px solid var(--line); white-space: nowrap; }
  .a-table :global(td) { padding: 12px; border-bottom: 1px solid var(--line); vertical-align: top; }
  .a-table :global(tr.row) { cursor: pointer; }
  .a-table :global(tr.row:hover) { background: color-mix(in srgb, var(--khalal) 10%, transparent); }
  .a-table :global(.ref) { font-weight: 700; color: var(--tamr); white-space: nowrap; }
  .a-table :global(.its) { color: var(--ink-2); max-width: 280px; }
  :global(.pill) { display: inline-block; border-radius: 999px; padding: 3px 10px; font-size: 12.5px; font-weight: 600; background: var(--paper-2); white-space: nowrap; }
  :global(.pill.received) { background: #F4E6BF; }
  :global(.pill.confirmed) { background: #E9DFCB; }
  :global(.pill.ready), :global(.pill.out-for-delivery) { background: #DCE6CF; }
  :global(.pill.completed) { background: var(--line); color: var(--ink-2); }
  :global(.pill.cancelled) { background: #F1DCD3; color: var(--tamr-2); }
  :global(.pill.paid) { background: #DCE6CF; }
  :global(.pill.unpaid) { background: #F1DCD3; color: var(--tamr-2); }
  :global(.pill.sample) { background: #E4DDF0; color: #4B3A6B; }
  :global(.pill.partly-refunded), :global(.pill.refunded) { background: #EDE3D0; }
  .samples { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin: 10px 0 14px; font-size: 14px; }
  .btn.danger, .a-pbody :global(button.danger) { border-color: var(--tamr); color: var(--tamr-2); }
  .seasons { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 14px; }
  .seasons :global(.season) { display: flex; gap: 12px; align-items: center; background: var(--sheet); border-radius: 18px; padding: 14px 18px; box-shadow: inset 0 0 0 1.5px var(--line); cursor: pointer; }
  .seasons :global(.season.on) { box-shadow: inset 0 0 0 2px var(--tamr); }
  .seasons :global(.season input) { width: 22px; height: 22px; accent-color: var(--tamr); }
  .seasons :global(.season span) { display: grid; }
  .seasons :global(.season small) { color: var(--ink-2); }
  #products :global(tr.off), #promos :global(tr.off), .notes :global(li.off) { opacity: .55; }
  #products :global(input[type=number]) { width: 96px; border: 1.5px solid var(--line); border-radius: 10px; padding: 6px 8px; font: inherit; }
  #products :global(input[type=checkbox]) { width: 20px; height: 20px; accent-color: var(--bunn); }
  #products :global(button), #promos :global(button), .notes :global(button) { border: 1.5px solid var(--bunn); background: none; border-radius: 999px; padding: 5px 12px; font-weight: 600; font-size: 13.5px; }
  .promo-form { display: grid; gap: 12px; background: var(--sheet); border-radius: 24px; padding: 22px; margin-bottom: 18px; max-width: 900px; }
  .promo-form .btn { justify-self: start; }
  .grid3 { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; align-items: end; }
  .a-assist { display: grid; gap: 16px; max-width: 900px; }
  .a-assist :global(.state) { font-weight: 600; padding: 12px 16px; border-radius: 14px; }
  .a-assist :global(.state.ok) { background: #DCE6CF; }
  .a-assist :global(.state.bad) { background: #F1DCD3; color: var(--tamr-2); }
  .notes { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .notes :global(li) { background: var(--sheet); border-radius: 16px; padding: 12px 16px; display: grid; gap: 4px; }
  .howto { background: var(--paper-2); border-radius: 20px; padding: 18px 22px; }
  .howto ol { padding-inline-start: 20px; display: grid; gap: 6px; }
  .warn-badge { background: var(--tamr); }
  .a-pbody :global(.refund) { display: grid; gap: 8px; }
  .a-pbody :global(.refund input), .a-pbody :global(.refund select) { border: 1.5px solid var(--line); border-radius: 10px; padding: 8px 10px; font: inherit; font-size: 14px; }
  .a-pbody :global(.refund input[type=number]) { width: 120px; }
  .badge { display: inline-grid; place-items: center; min-width: 20px; height: 20px; border-radius: 999px; background: var(--tamr); color: var(--tamr-ink); font-size: 12px; padding: 0 6px; margin-inline-start: 4px; }
  .seg { display: flex; flex-wrap: wrap; gap: 8px; }
  .seg button { border: 1.5px solid var(--bunn); background: none; border-radius: 999px; padding: 7px 14px; font-weight: 600; font-size: 14px; }
  .seg button.cur { background: var(--bunn); color: var(--paper); }
  .a-intro { max-width: 70ch; margin-bottom: 14px; }
  .a-pbody :global(.sum) { font-weight: 600; font-size: 17px; }
  .a-pbody :global(.warn), :global(.warn) { color: var(--tamr-2); font-weight: 600; font-size: 13.5px; }
  .a-pbody :global(.ph) { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 8px; }
  .a-pbody :global(.ph img) { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 12px; }
  .a-pbody :global(select) { border: 1.5px solid var(--line); border-radius: 999px; padding: 7px 12px; font: inherit; font-size: 14px; background: var(--sheet); }
  .a-pbody :global(.tx) { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .a-pbody :global(.tx li) { padding: 9px 12px; border-radius: 16px; font-size: 14.5px; max-width: 92%; unicode-bidi: plaintext; }
  .a-pbody :global(.tx .customer) { background: var(--bunn); color: var(--paper); justify-self: end; border-bottom-right-radius: 4px; }
  .a-pbody :global(.tx .hikaya) { background: var(--paper-2); border-bottom-left-radius: 4px; }
  .a-pbody :global(.tx .tool) { background: none; padding: 0 12px; max-width: 100%; }
  .a-pbody :global(.tx code) { font-size: 12px; color: var(--ink-2); word-break: break-word; }
  .a-dayhead { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
  .a-dayhead input { border: 1.5px solid var(--line); border-radius: 12px; padding: 8px 10px; margin-inline-start: 8px; font: inherit; }
  .a-daygrid { display: grid; grid-template-columns: .7fr 1fr 1.2fr; gap: 20px; align-items: start; }
  @media (max-width: 1000px) { .a-daygrid { grid-template-columns: 1fr; } }
  .a-daygrid > div { background: var(--sheet); border-radius: 20px; padding: 18px; display: grid; gap: 12px; }
  .a-pack { margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; }
  .a-pack :global(li) { display: flex; justify-content: space-between; gap: 10px; border-bottom: 1px dashed var(--line); padding-bottom: 6px; }
  .a-pack :global(li b) { font-size: 18px; }
  #pickups :global(h3) { font-size: 15px; margin: 10px 0 6px; font-family: var(--body); }
  :global(.mini) { border: 1.5px solid var(--line); border-radius: 14px; padding: 10px 12px; display: grid; gap: 2px; font-size: 14.5px; margin-bottom: 8px; cursor: pointer; background: var(--paper); }
  :global(.mini b) { color: var(--tamr); }
  .a-route { margin: 0; padding-inline-start: 22px; display: grid; gap: 8px; }
  .a-settings { max-width: 560px; }
  .a-settings form { display: grid; gap: 14px; background: var(--sheet); padding: 24px; border-radius: 24px; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .a-switch { display: flex; gap: 10px; align-items: center; font-weight: 600; }
  .a-switch input { width: 20px; height: 20px; accent-color: var(--bunn); }
  .a-panel { width: min(560px, 100%); grid-template-rows: auto 1fr; }
  .a-pbody { overflow: auto; padding: 18px 22px 40px; display: grid; gap: 16px; align-content: start; grid-auto-rows: max-content; }
  .a-pbody :global(h3) { font-size: 14px; color: var(--ink-2); font-family: var(--body); font-weight: 600; margin: 4px 0 -6px; }
  .a-pbody :global(.acts) { display: flex; flex-wrap: wrap; gap: 8px; }
  .a-pbody :global(.acts button) { border: 1.5px solid var(--bunn); background: none; border-radius: 999px; padding: 8px 14px; font-weight: 600; font-size: 14px; }
  .a-pbody :global(.acts button.cur) { background: var(--bunn); color: var(--paper); }
  .a-pbody :global(.acts button.danger) { border-color: var(--tamr); color: var(--tamr-2); }
  .a-pbody :global(.its li) { display: flex; justify-content: space-between; gap: 10px; }
  .a-pbody :global(ul) { margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; }
  .a-pbody :global(.ev) { font-size: 13.5px; color: var(--ink-2); }
  .a-pbody :global(textarea) { width: 100%; border: 1.5px solid var(--line); border-radius: 12px; padding: 10px; font: inherit; }
  .a-pbody :global(.notify) { display: flex; gap: 8px; align-items: center; font-size: 14px; }
  @media print {
    .a-top, .a-dayhead button, #v-orders, #v-settings { display: none !important; }
    .a-daygrid { grid-template-columns: 1fr; }
    .a-daygrid > div { break-inside: avoid; }
  }
</style>

<script>
  import { mountLogin, logout } from '../../scripts/login';
  const $ = (id: string) => document.getElementById(id)!;
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  const money = (c: number) => `$${(c / 100).toFixed(c % 100 ? 2 : 0)}`;
  const fmtDay = (iso: string) => new Date(iso + 'T12:00:00Z').toLocaleDateString('en-CA', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' });
  const api = async (url: string, data?: object) => {
    const r = await fetch(url, data ? { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(data) } : undefined);
    const body = await r.json().catch(() => ({}));
    if (r.status === 401) { showLogin(); throw new Error('login'); }
    if (!r.ok) { alert(body.message ?? 'Something went wrong.'); throw new Error(body.error); }
    return body;
  };
  const STATUS_LABEL: Record<string, string> = { received: 'Received', confirmed: 'Confirmed', ready: 'Ready for pickup', 'out-for-delivery': 'Out for delivery', completed: 'Completed', cancelled: 'Cancelled' };
  const PAY: Record<string, string> = { 'at-pickup': 'At pickup', 'e-transfer': 'e-Transfer', card: 'Card' };

  // ---------- auth ----------
  function showLogin() {
    for (const id of ['v-orders', 'v-inbox', 'v-day', 'v-products', 'v-promos', 'v-assistant', 'v-chats', 'v-settings', 'tabs', 'who']) $(id).hidden = true;
    $('login').hidden = false;
    mountLogin($('loginBox'), 'en', user => {
      if (user.role !== 'admin') { $('notAdmin').hidden = false; return; }
      start(user.email);
    });
  }
  function start(email: string) {
    $('login').hidden = true; $('tabs').hidden = false; $('who').hidden = false; $('whoEmail').textContent = email;
    const sel = document.querySelector<HTMLSelectElement>('#filters [name=status]')!;
    if (sel.options.length === 1) Object.entries(STATUS_LABEL).forEach(([k, v]) => sel.add(new Option(v, k)));
    tab('orders');
    const qs = new URLSearchParams(location.search);
    if (qs.get('order')) openOrder(qs.get('order')!);
    if (qs.get('ticket')) { tab('inbox'); openTicket(qs.get('ticket')!); }
    loadInboxCount(); loadAskWarn();
  }
  $('logout').addEventListener('click', async () => { await logout(); location.reload(); });

  // ---------- tabs ----------
  function tab(name: string) {
    document.querySelectorAll<HTMLButtonElement>('#tabs [data-tab]').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.tab === name)));
    for (const v of ['orders', 'inbox', 'day', 'products', 'promos', 'assistant', 'chats', 'settings']) $(`v-${v}`).hidden = v !== name;
    if (name === 'products') loadProducts();
    if (name === 'promos') loadPromos();
    if (name === 'assistant') loadAssistant();
    if (name === 'orders') loadOrders();
    if (name === 'inbox') loadTickets();
    if (name === 'chats') loadChats();
    if (name === 'day') loadDay();
    if (name === 'settings') loadSettings();
  }
  $('tabs').addEventListener('click', e => { const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-tab]'); if (b) tab(b.dataset.tab!); });

  // ---------- orders ----------
  let timer: number | undefined;
  $('filters').addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(loadOrders, 250); });
  async function loadOrders() {
    const f = new FormData($('filters') as HTMLFormElement);
    const qs = new URLSearchParams([...f.entries()].filter(([, v]) => v) as [string, string][]).toString();
    ($('csv') as HTMLAnchorElement).href = `/api/admin/export.csv?${qs}`;
    const d = await api(`/api/admin/orders?${qs}`);
    const c = d.counts ?? {};
    $('stats').innerHTML = [
      ['New', c.received ?? 0], ['Confirmed', c.confirmed ?? 0], ['Ready / on the way', (c.ready ?? 0) + (c['out-for-delivery'] ?? 0)], ['Completed', c.completed ?? 0],
      ['Unpaid', `${d.unpaid?.n ?? 0} · ${money(d.unpaid?.cents ?? 0)}`],
    ].map(([k, v]) => `<div class="st"><b>${v}</b><span>${k}</span></div>`).join('');
    $('none').hidden = d.orders.length > 0;
    document.querySelector('#list tbody')!.innerHTML = d.orders.map((o: any) => `<tr class="row" data-ref="${esc(o.ref)}">
      <td class="ref">${esc(o.ref)}${o.sample ? '<br><span class="pill sample">SAMPLE</span>' : ''}</td><td>${fmtDay(o.day)}<br><small>${esc(o.window)}</small></td>
      <td>${esc(o.name)}<br><small>${esc(o.phone)}</small></td>
      <td>${o.method === 'delivery' ? `Delivery<br><small>${esc(o.postal)}</small>` : 'Pickup'}</td>
      <td class="its">${(o.items ?? []).map((i: any) => `${i.qty}× ${esc(i.name)}${i.option ? ` (${esc(i.option)})` : ''}`).join(', ')}</td>
      <td>${money(o.total)}${o.discount ? `<br><small>−${money(o.discount)} ${esc(o.promo ?? '')}</small>` : ''}</td><td><span class="pill ${o.paymentStatus}">${o.paymentStatus}</span><br><small>${PAY[o.payment]}</small></td>
      <td><span class="pill ${o.status}">${STATUS_LABEL[o.status]}</span></td></tr>`).join('');
  }
  document.addEventListener('click', e => {
    const t = e.target as HTMLElement;
    const r = t.closest<HTMLElement>('[data-ref]'), tk = t.closest<HTMLElement>('[data-ticket]'), ch = t.closest<HTMLElement>('[data-chat]');
    if (t.closest('a')) return;
    if (r && (!t.closest('#panel') || r.classList.contains('to-order'))) openOrder(r.dataset.ref!);
    else if (tk && !t.closest('#panel')) openTicket(tk.dataset.ticket!);
    else if (ch && !t.closest('#panel')) openChat(Number(ch.dataset.chat));
  });

  // ---------- order panel ----------
  const panel = $('panel'), scrim = $('pScrim');
  const closePanel = () => { panel.classList.remove('on'); scrim.classList.remove('on'); panel.setAttribute('inert', ''); panel.setAttribute('aria-hidden', 'true'); setTimeout(() => { scrim.hidden = true; }, 300); };
  $('pClose').addEventListener('click', closePanel); scrim.addEventListener('click', closePanel);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closePanel(); });

  async function openOrder(ref: string) {
    const d = await api(`/api/admin/orders/${encodeURIComponent(ref)}`);
    const o = d.order;
    $('pRef').textContent = o.ref;
    const flow = o.method === 'pickup' ? ['received', 'confirmed', 'ready', 'completed'] : ['received', 'confirmed', 'out-for-delivery', 'completed'];
    $('pBody').innerHTML = `
      <p><span class="pill ${o.status}">${STATUS_LABEL[o.status]}</span> <span class="pill ${o.paymentStatus}">${o.paymentStatus}</span> · ${PAY[o.payment]}</p>
      <p><b>${fmtDay(o.day)} · ${esc(o.window)}</b><br>${o.method === 'delivery' ? `Delivery: ${esc(o.street)}, ${esc(o.postal)} · <a href="https://maps.google.com/?q=${encodeURIComponent(`${o.street}, ${o.postal}, Calgary`)}" target="_blank" rel="noopener">Map</a>` : 'Pickup'}</p>
      <p>${esc(o.name)} · <a href="tel:${esc(o.phone)}">${esc(o.phone)}</a> · <a href="mailto:${esc(o.email)}">${esc(o.email)}</a> · ${o.lang === 'ar' ? 'Arabic' : 'English'}</p>
      ${o.notes ? `<p><b>Customer note:</b> ${esc(o.notes)}</p>` : ''}
      <h3>Items</h3><ul class="its">${o.items.map((i: any) => `<li><span>${i.qty} × ${esc(i.name_en)}${i.option_en ? ` <small>(${esc(i.option_en)})</small>` : ''}</span><span>${money(i.unit_cents * i.qty)}</span></li>`).join('')}
        ${o.delivery ? `<li><span>Delivery</span><span>${money(o.delivery)}</span></li>` : ''}${o.discount ? `<li><span>Discount ${esc(o.promo ?? '')}</span><span>−${money(o.discount)}</span></li>` : ''}<li><b>Total</b><b>${money(o.total)}</b></li>${o.refunded ? `<li><span>Refunded</span><span>−${money(o.refunded)}</span></li>` : ''}</ul>
      <h3>Move the order</h3>
      <div class="acts">${flow.map(s => `<button type="button" data-status="${s}" class="${s === o.status ? 'cur' : ''}">${STATUS_LABEL[s]}</button>`).join('')}<button type="button" class="danger" data-status="cancelled">Cancel order</button></div>
      <label class="notify"><input type="checkbox" id="pNotify" checked /> Email the customer about the change</label>
      <h3>Payment</h3>
      <div class="acts"><button type="button" data-pay="paid" class="${o.paymentStatus === 'paid' ? 'cur' : ''}">Paid</button><button type="button" data-pay="unpaid" class="${o.paymentStatus === 'unpaid' ? 'cur' : ''}">Unpaid</button><button type="button" data-pay="refunded" class="${o.paymentStatus === 'refunded' ? 'cur' : ''}">Refunded</button></div>
      <h3>Refund</h3>
      ${o.refundable > 0 ? `<div class="refund">
        <div class="acts"><input id="rAmt" type="number" min="0.01" step="0.01" max="${(o.refundable / 100).toFixed(2)}" value="${(o.refundable / 100).toFixed(2)}" aria-label="Amount in dollars" />
        <select id="rHow" aria-label="How">${o.payment === 'card' && o.paidByCard ? '<option value="card">Back to their card (Square)</option>' : ''}<option value="e-transfer">e-Transfer (you send it)</option><option value="cash">Cash (you hand it back)</option><option value="store-credit">Store credit (a one-time code)</option></select></div>
        <input id="rWhy" placeholder="Reason, e.g. box arrived crushed" />
        <label class="notify"><input type="checkbox" id="rNotify" checked /> Email the customer</label>
        <div class="acts"><button type="button" id="rGo" class="danger">Refund</button></div>
        <p class="ev">Up to ${money(o.refundable)} can still be refunded. Full refund = the whole amount; partial = any smaller amount.</p></div>` : '<p class="ev">Nothing left to refund.</p>'}
      ${d.refunds.length ? `<ul>${d.refunds.map((x: any) => `<li class="ev">${new Date(x.created_at).toLocaleString('en-CA', { dateStyle: 'medium', timeStyle: 'short' })} · <b>${money(x.amount_cents)}</b> by ${esc(x.method)}${x.credit_code ? ` · code <b>${esc(x.credit_code)}</b>` : ''}${x.status !== 'done' ? ` · ${esc(x.status)}` : ''} ${x.reason ? '· ' + esc(x.reason) : ''} <small>${esc(x.actor)}</small></li>`).join('')}</ul>` : ''}
      <h3>Team note</h3><textarea id="pNote" rows="2" placeholder="Only the team sees this"></textarea><div class="acts"><button type="button" id="pAddNote">Add note</button></div>
      <label class="notify"><input type="checkbox" id="pSample" ${o.sample ? 'checked' : ''} /> This is a sample / test order (no emails, not counted, not in the CSV)</label>
      <h3>History</h3><ul>${d.events.map((e: any) => `<li class="ev">${new Date(e.created_at).toLocaleString('en-CA', { dateStyle: 'medium', timeStyle: 'short' })} · <b>${esc(e.kind)}</b> ${esc(e.detail ?? '')} <small>${esc(e.actor ?? '')}</small></li>`).join('')}</ul>
      <h3>Emails</h3><ul>${d.emails.map((m: any) => `<li class="ev">${esc(m.subject)} → ${esc(m.to_email)} · <b>${esc(m.status)}</b></li>`).join('') || '<li class="ev">None yet.</li>'}</ul>`;
    scrim.hidden = false; panel.removeAttribute('inert'); panel.setAttribute('aria-hidden', 'false');
    requestAnimationFrame(() => { scrim.classList.add('on'); panel.classList.add('on'); });
    const refresh = async () => { await openOrder(ref); if (!$('v-orders').hidden) loadOrders(); if (!$('v-day').hidden) loadDay(); };
    $('pBody').querySelectorAll<HTMLButtonElement>('[data-status]').forEach(b => b.addEventListener('click', async () => {
      if (b.dataset.status === 'cancelled' && !confirm(`Cancel ${ref}?`)) return;
      await api(`/api/admin/orders/${encodeURIComponent(ref)}`, { status: b.dataset.status, notify: ($('pNotify') as HTMLInputElement).checked }); refresh();
    }));
    $('pBody').querySelectorAll<HTMLButtonElement>('[data-pay]').forEach(b => b.addEventListener('click', async () => { await api(`/api/admin/orders/${encodeURIComponent(ref)}`, { paymentStatus: b.dataset.pay }); refresh(); }));
    $('pSample').addEventListener('change', async e => { await api(`/api/admin/orders/${encodeURIComponent(ref)}`, { sample: (e.target as HTMLInputElement).checked }); refresh(); });
    $('rGo')?.addEventListener('click', async () => {
      const amt = Math.round(Number(($('rAmt') as HTMLInputElement).value) * 100), how = ($('rHow') as HTMLSelectElement).value;
      if (!(amt > 0) || !confirm(`Refund ${money(amt)} by ${how}${how === 'card' ? ' (sent back through Square now)' : ''}?`)) return;
      const r = await api(`/api/admin/orders/${encodeURIComponent(ref)}/refund`, { amount_cents: amt, method: how, reason: ($('rWhy') as HTMLInputElement).value, notify: ($('rNotify') as HTMLInputElement).checked });
      if (r.creditCode) alert(`Store credit code: ${r.creditCode} (emailed to the customer if ticked)`);
      refresh();
    });
    $('pAddNote').addEventListener('click', async () => { const v = ($('pNote') as HTMLTextAreaElement).value.trim(); if (v) { await api(`/api/admin/orders/${encodeURIComponent(ref)}`, { note: v }); refresh(); } });
  }

  const showPanel = (title: string, html: string) => {
    $('pRef').textContent = title; $('pBody').innerHTML = html;
    scrim.hidden = false; panel.removeAttribute('inert'); panel.setAttribute('aria-hidden', 'false');
    requestAnimationFrame(() => { scrim.classList.add('on'); panel.classList.add('on'); });
  };
  const when = (iso: string) => new Date(iso).toLocaleString('en-CA', { dateStyle: 'medium', timeStyle: 'short' });
  const KIND: Record<string, string> = { damaged: 'Damaged', 'wrong-item': 'Wrong item', missing: 'Missing item', late: 'Late delivery', 'change-order': 'Change order', 'large-order': 'Large order', question: 'Question', other: 'Other' };
  const URGENT = ['damaged', 'wrong-item', 'missing', 'late'];
  const transcript = (lines: any[]) => `<ol class="tx">${lines.map(l => `<li class="${l.who}">${l.who === 'tool' ? `<code>${esc(l.text)}</code>` : esc(l.text).replace(/\n/g, '<br>')}</li>`).join('')}</ol>`;

  // ---------- inbox ----------
  let inboxStatus = 'open';
  $('inboxFilter').addEventListener('click', e => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-st]'); if (!b) return;
    inboxStatus = b.dataset.st!; $('inboxFilter').querySelectorAll('button').forEach(x => x.classList.toggle('cur', x === b)); loadTickets();
  });
  async function loadInboxCount() {
    const d = await api('/api/admin/tickets?status=open');
    const n = d.counts?.open ?? 0; $('inboxN').textContent = String(n); $('inboxN').hidden = !n;
  }
  async function loadTickets() {
    const d = await api(`/api/admin/tickets?status=${inboxStatus}`);
    const n = d.counts?.open ?? 0; $('inboxN').textContent = String(n); $('inboxN').hidden = !n;
    $('noTickets').hidden = d.tickets.length > 0;
    document.querySelector('#tickets tbody')!.innerHTML = d.tickets.map((t: any) => `<tr class="row" data-ticket="${esc(t.ref)}">
      <td class="ref">${esc(t.ref)}${t.photos ? `<br><small>${t.photos} photo${t.photos > 1 ? 's' : ''}</small>` : ''}</td><td>${when(t.created_at)}<br><small>${t.source === 'ask' ? 'Ask Hikaya' : 'Help form'} · ${t.lang === 'ar' ? 'Arabic' : 'English'}</small></td>
      <td>${esc(t.name ?? '')}<br><small>${esc(t.email)}</small></td>
      <td><span class="pill ${URGENT.includes(t.kind) ? 'unpaid' : ''}">${KIND[t.kind] ?? esc(t.kind)}</span></td>
      <td class="its">${esc(t.summary)}</td><td>${esc(t.order_ref ?? '')}</td><td><span class="pill ${t.status === 'resolved' ? 'completed' : t.status === 'open' ? 'received' : 'confirmed'}">${esc(t.status)}</span></td></tr>`).join('');
  }
  async function openTicket(ref: string) {
    const d = await api(`/api/admin/tickets/${encodeURIComponent(ref)}`);
    const t = d.ticket, o = d.order;
    showPanel(`${t.ref} · ${KIND[t.kind] ?? t.kind}`, `
      <p><span class="pill ${t.status === 'resolved' ? 'completed' : 'received'}">${esc(t.status)}</span>${t.resolution ? ` <span class="pill">${esc(t.resolution)}</span>` : ''} · ${t.source === 'ask' ? 'from Ask Hikaya' : 'from the help form'} · ${when(t.created_at)}</p>
      <p>${esc(t.name ?? '')} · <a href="mailto:${esc(t.email)}">${esc(t.email)}</a>${t.phone ? ` · <a href="tel:${esc(t.phone)}">${esc(t.phone)}</a>` : ''} · writes in ${t.lang === 'ar' ? 'Arabic' : 'English'}</p>
      <p class="sum">${esc(t.summary)}</p>
      ${t.details ? `<p>${esc(t.details).replace(/\n/g, '<br>')}</p>` : ''}
      ${t.order_ref ? `<h3>Order</h3>${o ? `<div class="mini to-order" data-ref="${esc(o.ref)}"><span><b>${esc(o.ref)}</b> · ${esc(o.method)} · ${fmtDay(o.day)} ${esc(o.slot_window)} · ${money(o.total_cents)} · <span class="pill ${o.status}">${STATUS_LABEL[o.status]}</span></span>${o.emailMatches ? '' : '<span class="warn">The email on this request is not the order’s email. Check before acting.</span>'}</div>` : `<p class="warn">No order ${esc(t.order_ref)} found.</p>`}` : ''}
      ${d.photos.length ? `<h3>Photos</h3><div class="ph">${d.photos.map((id: number) => `<a href="/api/admin/photos/${id}" target="_blank" rel="noopener"><img src="/api/admin/photos/${id}" alt="Customer photo ${id}" loading="lazy" /></a>`).join('')}</div>` : ''}
      <h3>Reply to the customer by email</h3>
      <textarea id="tReply" rows="5" placeholder="${t.lang === 'ar' ? 'The customer wrote in Arabic: reply in Arabic if you can.' : 'Write your reply. It is sent from the Hikaya address with the request number.'}" dir="auto"></textarea>
      <div class="acts"><button type="button" id="tSend">Send reply</button></div>
      <h3>Close it</h3>
      <div class="acts"><select id="tRes"><option value="">Outcome…</option><option value="replacement">Replacement</option><option value="refund">Refund</option><option value="credit">Store credit</option><option value="answered">Answered</option><option value="none">No action</option></select>
        <button type="button" data-tst="resolved">Mark resolved</button><button type="button" data-tst="waiting">Waiting on customer</button><button type="button" data-tst="open">Reopen</button></div>
      <h3>Team note</h3><textarea id="tNote" rows="2" placeholder="Only the team sees this"></textarea><div class="acts"><button type="button" id="tAddNote">Add note</button></div>
      <h3>History</h3><ul>${d.notes.map((n: any) => `<li class="ev">${when(n.created_at)} · <b>${esc(n.kind)}</b> ${esc(n.body)} <small>${esc(n.actor)}</small></li>`).join('') || '<li class="ev">Nothing yet.</li>'}</ul>
      ${d.transcript ? `<h3>Conversation with Ask Hikaya</h3>${transcript(d.transcript)}` : ''}`);
    const refresh = async () => { await openTicket(ref); loadTickets(); };
    $('tSend').addEventListener('click', async () => { const v = ($('tReply') as HTMLTextAreaElement).value.trim(); if (v && confirm(`Email this reply to ${t.email}?`)) { await api(`/api/admin/tickets/${encodeURIComponent(ref)}`, { reply: v }); refresh(); } });
    $('tAddNote').addEventListener('click', async () => { const v = ($('tNote') as HTMLTextAreaElement).value.trim(); if (v) { await api(`/api/admin/tickets/${encodeURIComponent(ref)}`, { note: v }); refresh(); } });
    $('pBody').querySelectorAll<HTMLButtonElement>('[data-tst]').forEach(b => b.addEventListener('click', async () => {
      await api(`/api/admin/tickets/${encodeURIComponent(ref)}`, { status: b.dataset.tst, resolution: ($('tRes') as HTMLSelectElement).value || undefined }); refresh();
    }));
  }

  // ---------- conversations ----------
  async function loadChats() {
    const d = await api('/api/admin/chats');
    $('noChats').hidden = d.chats.length > 0;
    document.querySelector('#chats tbody')!.innerHTML = d.chats.map((c: any) => `<tr class="row" data-chat="${c.id}">
      <td>${when(c.updated_at)}</td><td>${c.lang === 'ar' ? 'AR' : 'EN'}</td><td class="its" dir="auto">${esc(c.first ?? '')}</td><td>${c.turns}</td>
      <td>${c.handed_off ? 'Yes' : ''}</td><td>${c.rating === 'up' ? 'Yes' : c.rating === 'down' ? '<b class="warn">No</b>' : ''}</td></tr>`).join('');
  }
  async function openChat(id: number) {
    const d = await api(`/api/admin/chats/${id}`);
    showPanel(`Conversation · ${when(d.chat.created_at)}`, `
      <p>${d.chat.email ? esc(d.chat.email) + ' · ' : ''}${d.chat.lang === 'ar' ? 'Arabic' : 'English'} site · ${d.chat.turns} messages${d.chat.rating ? ` · helpful: ${d.chat.rating === 'up' ? 'yes' : 'no'}` : ''}</p>
      ${d.tickets.length ? `<p>Sent to the team: ${d.tickets.map((t: any) => `<a href="?ticket=${esc(t.ref)}">${esc(t.ref)}</a> (${esc(t.kind)})`).join(', ')}</p>` : ''}
      <div class="acts"><button type="button" id="teach">Teach an answer from this chat</button></div>
      ${transcript(d.transcript)}`);
    $('teach').addEventListener('click', () => {
      const firstQ = d.transcript.find((l: any) => l.who === 'customer')?.text ?? '';
      closePanel(); tab('assistant');
      const f = $('noteForm') as HTMLFormElement;
      (f.elements.namedItem('question') as HTMLInputElement).value = firstQ.slice(0, 500);
      (f.elements.namedItem('fromChat') as HTMLInputElement).value = String(id);
      (f.elements.namedItem('answer') as HTMLTextAreaElement).focus();
    });
  }

  // ---------- sample orders ----------
  $('mkSamples').addEventListener('click', async () => {
    const r = await api('/api/admin/samples', { action: 'create' });
    alert(`Added ${r.made} sample orders from ${fmtDay(r.from)} to ${fmtDay(r.to)}. They are marked SAMPLE; “Remove all sample orders” deletes them.`);
    loadOrders();
  });
  $('rmSamples').addEventListener('click', async () => {
    if (!confirm('Delete every sample order? Real orders are not touched.')) return;
    const r = await api('/api/admin/samples', { action: 'remove' });
    alert(`Removed ${r.removed} sample orders.`); loadOrders();
  });

  // ---------- products and seasons ----------
  async function loadProducts() {
    const d = await api('/api/admin/products');
    $('seasons').innerHTML = (['ramadan', 'eid'] as const).map(k => `<label class="season ${d.seasons[k] ? 'on' : ''}"><input type="checkbox" data-season-sw="${k}" ${d.seasons[k] ? 'checked' : ''} />
      <span><b>${k === 'ramadan' ? 'Ramadan' : 'Eid'} season</b><small>${d.seasons[k] ? 'On: the page, menu link, banner and boxes are on the site' : 'Off: the page says “back next season” and its boxes are hidden'}</small></span></label>`).join('');
    $('seasons').querySelectorAll<HTMLInputElement>('[data-season-sw]').forEach(i => i.addEventListener('change', async () => { await api('/api/admin/seasons', { [i.dataset.seasonSw!]: i.checked }); loadProducts(); }));
    document.querySelector('#products tbody')!.innerHTML = d.products.map((p: any) => `<tr data-pid="${esc(p.id)}" class="${p.shown ? '' : 'off'}">
      <td><b>${esc(p.name.en)}</b> <span lang="ar">${esc(p.name.ar)}</span>${p.season && !p.shown && p.visible ? `<br><small>Hidden: ${p.season} season is off</small>` : ''}</td>
      <td>${esc(p.family)}</td>
      <td><input class="price-in" type="number" min="0" step="0.5" value="${(p.price_cents / 100).toFixed(2)}" aria-label="Price" />${p.price_cents !== p.defaultPrice ? `<br><small>File price ${money(p.defaultPrice)}</small>` : ''}</td>
      <td><input type="checkbox" class="vis" ${p.visible ? 'checked' : ''} aria-label="Shown on the site" /></td>
      <td><input type="checkbox" class="sold" ${p.available ? '' : (p.visible && (!p.season || d.seasons[p.season]) ? 'checked' : '')} aria-label="Sold out" /></td>
      <td><input class="stock-in" type="number" min="0" step="1" value="${p.stock ?? ''}" placeholder="No limit" aria-label="Stock left" /></td>
      <td><button type="button" class="save">Save</button></td></tr>`).join('');
    document.querySelectorAll<HTMLTableRowElement>('#products tbody tr').forEach(tr => {
      const save = async (body: object) => { await api(`/api/admin/products/${encodeURIComponent(tr.dataset.pid!)}`, body); loadProducts(); };
      tr.querySelector('.vis')!.addEventListener('change', e => save({ visible: (e.target as HTMLInputElement).checked }));
      tr.querySelector('.sold')!.addEventListener('change', e => save({ available: !(e.target as HTMLInputElement).checked }));
      tr.querySelector('.save')!.addEventListener('click', () => save({
        price_cents: Math.round(Number((tr.querySelector('.price-in') as HTMLInputElement).value) * 100),
        stock: (tr.querySelector('.stock-in') as HTMLInputElement).value === '' ? null : Number((tr.querySelector('.stock-in') as HTMLInputElement).value),
      }));
    });
  }

  // ---------- promotions ----------
  async function loadPromos() {
    const d = await api('/api/admin/promos');
    const gives = (p: any) => p.kind === 'percent' ? `${p.value}% off` : p.kind === 'amount' ? `${money(p.value)} off` : 'Free delivery';
    const when = (p: any) => [p.starts_on ? `from ${fmtDay(String(p.starts_on).slice(0, 10))}` : '', p.ends_on ? `until ${fmtDay(String(p.ends_on).slice(0, 10))}` : ''].filter(Boolean).join(' ') || 'Any time';
    document.querySelector('#promos tbody')!.innerHTML = d.promos.map((p: any) => `<tr class="${p.active ? '' : 'off'}">
      <td class="ref">${esc(p.code)}</td><td>${gives(p)}${p.min_subtotal_cents ? `<br><small>on ${money(p.min_subtotal_cents)}+</small>` : ''}${p.once_per_email ? '<br><small>once per customer</small>' : ''}</td>
      <td>${when(p)}</td><td>${p.uses}${p.max_uses ? ` / ${p.max_uses}` : ''}</td><td>${money(p.given_cents)}</td><td>${esc(p.note ?? '')}</td>
      <td><button type="button" data-code="${esc(p.code)}" data-on="${p.active ? '0' : '1'}">${p.active ? 'Turn off' : 'Turn on'}</button></td></tr>`).join('') || '<tr><td colspan="7" class="muted">No codes yet.</td></tr>';
    document.querySelectorAll<HTMLButtonElement>('#promos [data-code]').forEach(b => b.addEventListener('click', async () => { await api(`/api/admin/promos/${encodeURIComponent(b.dataset.code!)}`, { active: b.dataset.on === '1' }); loadPromos(); }));
  }
  $('promoForm').addEventListener('submit', async e => {
    e.preventDefault();
    const f = new FormData(e.target as HTMLFormElement), kind = String(f.get('kind'));
    const v = Number(f.get('value') || 0);
    await api('/api/admin/promos', {
      code: f.get('code'), kind, value: kind === 'amount' ? Math.round(v * 100) : v,
      min_subtotal_cents: Math.round(Number(f.get('min') || 0) * 100), starts_on: f.get('starts_on'), ends_on: f.get('ends_on'),
      max_uses: f.get('max_uses') || null, once_per_email: f.get('once') === 'on', note: f.get('note'),
    });
    (e.target as HTMLFormElement).reset(); loadPromos();
  });

  // ---------- assistant ----------
  const WHY: Record<string, string> = { credits: 'The Anthropic account is out of credit. Add credit at console.anthropic.com → Plans & Billing.', key: 'The API key in Netlify is missing or wrong.', 'rate-limit': 'Too many messages at once; it clears by itself.', outage: 'Anthropic did not answer; it usually clears by itself.' };
  async function loadAskWarn() { try { const d = await api('/api/admin/ask'); $('askWarn').hidden = d.status.ok !== false; } catch { /* not critical */ } }
  async function loadAssistant() {
    const d = await api('/api/admin/ask');
    $('askWarn').hidden = d.status.ok !== false;
    $('askState').innerHTML = !d.enabled ? '<p class="state bad">Ask Hikaya is off: there is no ANTHROPIC_API_KEY in Netlify. Visitors are sent to the help form.</p>'
      : d.status.ok === false ? `<p class="state bad">Ask Hikaya is on backup answers since ${new Date(d.status.since).toLocaleString('en-CA', { dateStyle: 'medium', timeStyle: 'short' })}. ${esc(WHY[d.status.reason] ?? '')} It recovers by itself once fixed.</p>`
      : '<p class="state ok">Ask Hikaya is working.</p>';
    $('askStats').innerHTML = [['Chats this week', d.stats.week], ['Marked helpful', d.stats.helpful], ['Marked not helpful', d.stats.unhelpful], ['Sent to the team', d.stats.handed]].map(([k, v]) => `<div class="st"><b>${v}</b><span>${k}</span></div>`).join('');
    $('notes').innerHTML = d.notes.map((n: any) => `<li class="${n.active ? '' : 'off'}" data-nid="${n.id}"><p><b>${esc(n.question)}</b></p><p dir="auto">${esc(n.answer)}</p>
      <p class="ev">${esc(n.created_by)} · ${new Date(n.updated_at).toLocaleDateString('en-CA')} · <button type="button" class="edit">Edit</button> <button type="button" class="tog">${n.active ? 'Turn off' : 'Turn on'}</button> <button type="button" class="del">Delete</button></p></li>`).join('') || '<li class="muted">None yet. Answers you teach appear here.</li>';
    document.querySelectorAll<HTMLLIElement>('#notes [data-nid]').forEach(li => {
      const id = li.dataset.nid!, n = d.notes.find((x: any) => String(x.id) === id);
      li.querySelector('.tog')!.addEventListener('click', async () => { await api(`/api/admin/ask/notes/${id}`, { active: !n.active }); loadAssistant(); });
      li.querySelector('.del')!.addEventListener('click', async () => { if (confirm('Delete this answer?')) { await api(`/api/admin/ask/notes/${id}`, { delete: true }); loadAssistant(); } });
      li.querySelector('.edit')!.addEventListener('click', () => { const f = $('noteForm') as HTMLFormElement; (f.elements.namedItem('id') as HTMLInputElement).value = id; (f.elements.namedItem('question') as HTMLInputElement).value = n.question; (f.elements.namedItem('answer') as HTMLTextAreaElement).value = n.answer; f.scrollIntoView({ behavior: 'smooth' }); });
    });
  }
  $('noteForm').addEventListener('submit', async e => {
    e.preventDefault();
    const f = e.target as HTMLFormElement, fd = new FormData(f);
    await api(`/api/admin/ask/notes/${fd.get('id') || ''}`, { question: fd.get('question'), answer: fd.get('answer'), fromChat: fd.get('fromChat') || null });
    f.reset(); (f.elements.namedItem('id') as HTMLInputElement).value = ''; loadAssistant();
  });
  $('noteForm').addEventListener('reset', () => { const f = $('noteForm') as HTMLFormElement; setTimeout(() => { (f.elements.namedItem('id') as HTMLInputElement).value = ''; (f.elements.namedItem('fromChat') as HTMLInputElement).value = ''; }); });

  // ---------- day sheet ----------
  const dayPick = $('dayPick') as HTMLInputElement;
  dayPick.addEventListener('change', loadDay);
  async function loadDay() {
    const d = await api(`/api/admin/day${dayPick.value ? `?date=${dayPick.value}` : ''}`);
    dayPick.value = d.date;
    $('pack').innerHTML = d.pack.map((p: any) => `<li><span>${esc(p.name_en)}${p.option ? ` <small>(${esc(p.option)})</small>` : ''}</span><b>${p.qty}</b></li>`).join('') || '<li class="muted">Nothing to pack.</li>';
    $('pickups').innerHTML = d.pickups.map((w: any) => `<h3>${esc(w.window)} · ${w.orders.length}</h3>${w.orders.map((o: any) => `<div class="mini" data-ref="${esc(o.ref)}"><span><b>${esc(o.ref)}</b> · ${esc(o.name)} · ${esc(o.phone)}</span><span>${o.items.map((i: any) => `${i.qty}× ${esc(i.name_en)}`).join(', ')} · ${money(o.total)} · <span class="pill ${o.paymentStatus}">${o.paymentStatus}</span></span></div>`).join('')}`).join('');
    $('deliveries').innerHTML = d.deliveries.map((o: any) => `<li><div class="mini" data-ref="${esc(o.ref)}"><span><b>${esc(o.postal)}</b> · ${esc(o.street)} · ${esc(o.window)}</span><span>${esc(o.name)} · <a href="tel:${esc(o.phone)}">${esc(o.phone)}</a> · ${money(o.total)} · <span class="pill ${o.paymentStatus}">${o.paymentStatus}</span></span></div></li>`).join('') || '<li class="muted">No deliveries.</li>';
  }

  // ---------- settings ----------
  async function loadSettings() {
    const s = await api('/api/admin/settings');
    const f = $('setForm') as HTMLFormElement;
    (f.elements.namedItem('open') as HTMLInputElement).checked = s.ordering.open;
    (f.elements.namedItem('pickup') as HTMLInputElement).value = s.capacity.pickup;
    (f.elements.namedItem('delivery') as HTMLInputElement).value = s.capacity.delivery;
    f.querySelectorAll<HTMLInputElement>('[name=cutoffMode]').forEach(i => { i.checked = i.value === s.ordering.cutoffMode; });
    (f.elements.namedItem('cutoffWeekday') as HTMLSelectElement).value = String(s.ordering.cutoffWeekday);
    (f.elements.namedItem('cutoffHour') as HTMLSelectElement).value = String(s.ordering.cutoffHour);
    (f.elements.namedItem('firstDay') as HTMLInputElement).value = s.ordering.firstDay;
    (f.elements.namedItem('closedDates') as HTMLTextAreaElement).value = (s.ordering.closedDates ?? []).join('\n');
    previewCut();
  }
  const DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
  function previewCut() {
    const f = $('setForm') as HTMLFormElement;
    const mode = (f.querySelector('[name=cutoffMode]:checked') as HTMLInputElement | null)?.value ?? 'day-before';
    const h = Number((f.elements.namedItem('cutoffHour') as HTMLSelectElement).value), hh = `${h % 12 || 12} ${h >= 12 ? 'pm' : 'am'}`;
    $('cutDayField').hidden = mode !== 'weekly';
    $('cutPreview').textContent = mode === 'weekly'
      ? `Customers see: “Order by ${DAYS[Number((f.elements.namedItem('cutoffWeekday') as HTMLSelectElement).value)]}, ${hh} to get it Thursday to Sunday.”`
      : `Customers see: “Order by ${hh} the evening before.”`;
  }
  $('setForm').addEventListener('change', previewCut);
  $('setForm').addEventListener('submit', async e => {
    e.preventDefault();
    const f = e.target as HTMLFormElement;
    await api('/api/admin/settings', {
      open: (f.elements.namedItem('open') as HTMLInputElement).checked,
      capacity: { pickup: Number((f.elements.namedItem('pickup') as HTMLInputElement).value), delivery: Number((f.elements.namedItem('delivery') as HTMLInputElement).value) },
      cutoffMode: (f.querySelector('[name=cutoffMode]:checked') as HTMLInputElement | null)?.value,
      cutoffWeekday: Number((f.elements.namedItem('cutoffWeekday') as HTMLSelectElement).value),
      cutoffHour: Number((f.elements.namedItem('cutoffHour') as HTMLSelectElement).value),
      firstDay: (f.elements.namedItem('firstDay') as HTMLInputElement).value,
      closedDates: (f.elements.namedItem('closedDates') as HTMLTextAreaElement).value.split(/\s+/).filter(Boolean),
    });
    $('saved').hidden = false; setTimeout(() => { $('saved').hidden = true; }, 2000);
  });

  (async () => {
    const me = await fetch('/api/me').then(r => r.json()).catch(() => ({ user: null }));
    if (me.user?.role === 'admin') start(me.user.email); else showLogin();
  })();
</script>
