</style>

<script>
  import { mountLogin, logout } from '../../scripts/login';
  import { askWho, whoLabel } from '../../scripts/whois';
  import { PRODUCTS, DATES, GRINDS } from '../../data/products';
  const PRODUCT_LIST = PRODUCTS.map(p => ({ id: p.id, kind: p.kind, name: p.name.en }));
  const DATE_LIST = Object.entries(DATES).map(([id, d]) => ({ id, name: d.name.en }));
  const $ = (id: string) => document.getElementById(id)!;
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  const money = (c: number) => `$${(c / 100).toFixed(c % 100 ? 2 : 0)}`;
  const fmtDay = (iso: string) => new Date(iso + 'T12:00:00Z').toLocaleDateString('en-CA', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' });
  const api = async (url: string, data?: object) => {
    const r = await fetch(url, data ? { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(data) } : undefined);
    const body = await r.json().catch(() => ({}));
    if (r.status === 401 && body.error === 'preview') { location.replace(`/admin/?code=${Date.now()}`); throw new Error('preview'); }
    if (r.status === 401) { showLogin(); throw new Error('login'); }
    if (!r.ok) { alert(body.message ?? 'Something went wrong.'); throw new Error(body.error); }
    return body;
  };
  const STATUS_LABEL: Record<string, string> = { received: 'Received', confirmed: 'Confirmed', ready: 'Ready for pickup', 'out-for-delivery': 'Out for delivery', completed: 'Completed', cancelled: 'Cancelled' };
  const PAY: Record<string, string> = { 'at-pickup': 'Pay at pickup', 'e-transfer': 'e-Transfer', card: 'Card online' };
  /** One plain label for the money: what happened, or what to do next. */
  const payPill = (o: any) => {
    const st = o.paymentStatus, how = o.payment;
    if (st === 'refunded') return '<span class="pill refunded">Refunded</span>';
    if (st === 'partly-refunded') return '<span class="pill refunded">Paid · part refunded</span>';
    if (st === 'paid') return `<span class="pill paid">Paid · ${how === 'at-pickup' ? 'at pickup' : how === 'card' ? 'card' : 'e-Transfer'}</span>`;
    if (o.status === 'cancelled') return '<span class="pill">No payment</span>';
    if (how === 'at-pickup') return `<span class="pill due">Pays ${o.method === 'delivery' ? 'on delivery' : 'at pickup'}</span>`;
    if (how === 'e-transfer') return '<span class="pill unpaid">Waiting for e-Transfer</span>';
    return '<span class="pill unpaid">Card not paid yet</span>';
  };

  // ---------- auth ----------
  function showLogin() {
    for (const id of ['v-today', 'v-orders', 'v-inbox', 'v-day', 'v-week', 'v-numbers', 'v-words', 'v-plan', 'v-drivers', 'v-customers', 'v-production', 'v-products', 'v-promos', 'v-assistant', 'v-chats', 'v-settings', 'tabs', 'subtabs', 'qsBox', 'who']) $(id).hidden = true;
    $('login').hidden = false;
    mountLogin($('loginBox'), 'en', user => {
      if (user.role === 'driver' || user.role === 'packer') { location.href = '/admin/driver/'; return; }
      if (user.role !== 'admin' && user.role !== 'staff') { $('notAdmin').hidden = false; return; }
      start(user.email, user.role);
      fetch('/api/me').then(r => r.json()).then(me => { askWho(me); $('whoEmail').textContent = whoLabel(me); $('switchWho').hidden = !me.people?.length; $('switchWho').onclick = () => askWho(me, true); });
    });
  }
  let ROLE = 'admin';
  function start(email: string, role = 'admin') {
    ROLE = role; document.body.classList.toggle('role-staff', role !== 'admin');
    $('login').hidden = true; $('tabs').hidden = false; $('qsBox').hidden = false; $('who').hidden = false; $('whoEmail').textContent = email;
    const sel = document.querySelector<HTMLSelectElement>('#filters [name=status]')!;
    if (sel.options.length === 1) Object.entries(STATUS_LABEL).forEach(([k, v]) => sel.add(new Option(v, k)));
    tab('today');
    const qs = new URLSearchParams(location.search);
    if (qs.get('order')) openOrder(qs.get('order')!);
    if (qs.get('ticket')) { tab('inbox'); openTicket(qs.get('ticket')!); }
    loadInboxCount(); loadAskWarn();
  }
  $('logout').addEventListener('click', async () => { await logout(); location.reload(); });

  // ---------- tabs ----------
  // Main tabs (top row) hold smaller tabs (second row); the second row is hidden when a main tab
  // has only one. Each main tab remembers the smaller tab last opened in it.
  const lastIn: Record<string, string> = {};
  function tab(name: string) {
    const btn = document.querySelector<HTMLElement>(`#subtabs [data-tab="${name}"]`);
    const group = btn?.dataset.group ?? 'orders'; lastIn[group] = name;
    document.querySelectorAll<HTMLButtonElement>('#tabs [data-main]').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.main === group)));
    let shown = 0;
    document.querySelectorAll<HTMLElement>('#subtabs [data-group]').forEach(b => {
      const on = b.dataset.group === group; b.hidden = !on;
      if (b.dataset.tab) b.setAttribute('aria-pressed', String(b.dataset.tab === name));
      if (on && !(ROLE !== 'admin' && b.classList.contains('owner-only'))) shown++;
    });
    $('subtabs').hidden = shown < 2;
    for (const v of ['today', 'orders', 'inbox', 'day', 'week', 'numbers', 'words', 'plan', 'drivers', 'customers', 'production', 'products', 'promos', 'assistant', 'chats', 'settings']) $(`v-${v}`).hidden = v !== name;
    if (name === 'products') loadProducts();
    if (name === 'week') loadWeek();
    if (name === 'numbers') { loadNumbers(); if (ROLE === 'admin') { loadMargins(); loadCosts(); } }
    if (name === 'words') loadWords();
    if (name === 'drivers') loadDrivers();
    if (name === 'production') loadProduction();
    if (name === 'customers') loadCustomers();
    if (name === 'promos') loadPromos();
    if (name === 'assistant') loadAssistant();
    if (name === 'orders') loadOrders();
    if (name === 'today') loadToday();
    if (name === 'inbox') loadTickets();
    if (name === 'chats') loadChats();
    if (name === 'day') loadDay();
    if (name === 'settings') loadSettings();
  }
  $('tabs').addEventListener('click', e => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-main]'); if (!b) return;
    const g = b.dataset.main!;
    const first = [...document.querySelectorAll<HTMLElement>(`#subtabs [data-group="${g}"][data-tab]`)].find(x => !(ROLE !== 'admin' && x.classList.contains('owner-only')));
    tab(lastIn[g] ?? first?.dataset.tab ?? 'orders');
  });
  $('subtabs').addEventListener('click', e => { const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-tab]'); if (b) tab(b.dataset.tab!); });

  // ---------- quick search ----------
  let qsTimer: number | undefined, qsSeq = 0;
  const qsIn = $('qs') as HTMLInputElement, qsList = $('qsList');
  async function runSearch() {
    const v = qsIn.value.trim(); const seq = ++qsSeq;
    if (v.length < 2) { qsList.hidden = true; return; }
    const d = await api(`/api/admin/search?q=${encodeURIComponent(v)}`); if (seq !== qsSeq) return;
    const rows = [
      ...d.orders.map((o: any) => `<button type="button" role="option" data-order="${esc(o.ref)}"><span><b>${esc(o.ref)}</b> ${esc(o.name)}</span><small>${fmtDay(o.day)} · ${esc(o.method)} · ${esc(STATUS_LABEL[o.status] ?? o.status)} · ${money(o.total_cents)}</small></button>`),
      ...d.customers.map((c: any) => `<button type="button" role="option" data-cust="${c.id}"><span><b>${esc(c.name || c.email)}</b> · customer</span><small>${esc(c.email)}${c.phone ? ` · ${esc(c.phone)}` : ''}</small></button>`),
      ...d.tickets.map((t: any) => `<button type="button" role="option" data-ticket="${esc(t.ref)}"><span><b>${esc(t.ref)}</b> message from ${esc(t.name || t.email)}</span><small>${esc(t.kind)} · ${esc(t.status)}</small></button>`),
    ];
    qsList.innerHTML = rows.join('') || '<p class="muted">Nothing found.</p>'; qsList.hidden = false;
  }
  qsIn.addEventListener('input', () => { clearTimeout(qsTimer); qsTimer = window.setTimeout(() => runSearch().catch(() => {}), 200); });
  qsIn.addEventListener('keydown', e => {
    if (e.key === 'Escape') { qsIn.value = ''; qsList.hidden = true; qsIn.blur(); }
    if (e.key === 'Enter') { e.preventDefault(); qsList.querySelector<HTMLButtonElement>('button')?.click(); }
    if (e.key === 'ArrowDown') { e.preventDefault(); qsList.querySelector<HTMLButtonElement>('button')?.focus(); }
  });
  qsList.addEventListener('keydown', e => {
    const cur = document.activeElement as HTMLElement;
    if (e.key === 'ArrowDown') { e.preventDefault(); (cur.nextElementSibling as HTMLElement | null)?.focus(); }
    if (e.key === 'ArrowUp') { e.preventDefault(); ((cur.previousElementSibling as HTMLElement | null) ?? qsIn).focus(); }
    if (e.key === 'Escape') { qsList.hidden = true; qsIn.focus(); }
  });
  qsList.addEventListener('click', e => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button'); if (!b) return;
    qsList.hidden = true;
    if (b.dataset.order) openOrder(b.dataset.order);
    if (b.dataset.cust) { tab('customers'); openCustomer(Number(b.dataset.cust)); }
    if (b.dataset.ticket) { tab('inbox'); openTicket(b.dataset.ticket); }
  });
  document.addEventListener('click', e => { if (!(e.target as HTMLElement).closest('#qsBox')) qsList.hidden = true; });
  document.addEventListener('keydown', e => {
    const t = e.target as HTMLElement;
    if (e.key === '/' && !$('qsBox').hidden && !t.closest('input, textarea, select, [contenteditable]')) { e.preventDefault(); qsIn.focus(); qsIn.select(); }
  });

  // ---------- today ----------
  const LEVEL: Record<string, string> = { now: 'Now', soon: 'Soon', fyi: 'Note' };
  const TAB_NAME: Record<string, string> = { orders: 'All orders', day: 'Day sheet', inbox: 'Inbox', drivers: 'Team', products: 'Products', promos: 'Promotions', production: 'Production' };
  async function loadToday() {
    const d = await api('/api/admin/today'); const c = d.counts;
    $('tdTitle').textContent = `Today, ${fmtDay(d.date)}`;
    $('tdStats').innerHTML = [[c.orders, 'orders today'], [c.pickups, 'pickups'], [c.deliveries, 'deliveries'], [c.toPack, 'still to pack'], [c.out, 'out for delivery'], [c.done, 'done']]
      .map(([v, k]) => `<div class="st"><b>${v}</b><span>${k}</span></div>`).join('')
      + (d.money ? `<div class="st"><b>${money(d.money.today)}</b><span>ordered today (${d.money.orders})</span></div><div class="st"><b>${money(d.money.week)}</b><span>last 7 days</span></div>` : '');
    $('tdList').innerHTML = d.todo.map((t: any) => `<li class="td-${t.level}"><span class="td-lv">${LEVEL[t.level]}</span><span>${esc(t.text)}</span>${!(ROLE !== 'admin' && ['products', 'promos'].includes(t.tab)) ? `<button type="button" class="btn line sm" data-go="${t.tab}">${TAB_NAME[t.tab] ?? 'Open'}</button>` : ''}</li>`).join('')
      || '<li class="td-clear">Nothing waiting. All caught up.</li>';
  }
  $('tdList').addEventListener('click', e => { const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-go]'); if (b) tab(b.dataset.go!); });
  $('tdReload').addEventListener('click', loadToday);
  setInterval(() => { if (!$('v-today').hidden && document.visibilityState === 'visible') loadToday().catch(() => {}); }, 120000);

  // ---------- orders ----------
  let timer: number | undefined;
  $('filters').addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(loadOrders, 250); });
  async function loadOrders() {
    const f = new FormData($('filters') as HTMLFormElement);
    const qs = new URLSearchParams([...f.entries()].filter(([, v]) => v) as [string, string][]).toString();
    ($('csv') as HTMLAnchorElement).href = `/api/admin/export.csv?${qs}`;
    const d = await api(`/api/admin/orders?${qs}`);
    const c = d.counts ?? {};
    $('stats').innerHTML = [
      ['New', c.received ?? 0], ['Confirmed', c.confirmed ?? 0], ['Ready / on the way', (c.ready ?? 0) + (c['out-for-delivery'] ?? 0)], ['Completed', c.completed ?? 0],
      ['Waiting for e-Transfer or card · follow up', `${d.waiting?.n ?? 0} · ${money(d.waiting?.cents ?? 0)}`, d.waiting?.n ? 'warn' : ''],
      ['To collect at pickup or delivery', `${d.atPickup?.n ?? 0} · ${money(d.atPickup?.cents ?? 0)}`],
    ].map(([k, v, cls]) => `<div class="st ${cls ?? ''}"><b>${v}</b><span>${k}</span></div>`).join('');
    $('none').hidden = d.orders.length > 0;
    document.querySelector('#list tbody')!.innerHTML = d.orders.map((o: any) => `<tr class="row" data-ref="${esc(o.ref)}">
      <td class="ref">${esc(o.ref)}${o.sample ? '<br><span class="pill sample">SAMPLE</span>' : ''}</td><td>${fmtDay(o.day)}<br><small>${esc(o.window)}</small></td>
      <td>${esc(o.name)}<br><small>${esc(o.phone)}</small>${o.gift ? `<br><span class="pill gift">Gift → ${esc(o.gift.to)}</span>` : ''}</td>
      <td>${o.method === 'delivery' ? `Delivery<br><small>${esc(o.postal)}</small>` : 'Pickup'}</td>
      <td class="its">${(o.items ?? []).map((i: any) => `${i.qty}× ${esc(i.name)}${i.option ? ` (${esc(i.option)})` : ''}`).join(', ')}</td>
      <td>${money(o.total)}${o.discount ? `<br><small>−${money(o.discount)} ${esc(o.promo ?? '')}</small>` : ''}</td><td>${payPill(o)}</td>
      <td><span class="pill ${o.status}">${STATUS_LABEL[o.status]}</span></td></tr>`).join('');
  }
  document.addEventListener('click', e => {
    const t = e.target as HTMLElement;
    const r = t.closest<HTMLElement>('[data-ref]'), tk = t.closest<HTMLElement>('[data-ticket]'), ch = t.closest<HTMLElement>('[data-chat]');
    if (t.closest('a')) return;
    if (r && (!t.closest('#panel') || r.classList.contains('to-order'))) openOrder(r.dataset.ref!);
    else if (tk && !t.closest('#panel')) openTicket(tk.dataset.ticket!);
    else if (ch && !t.closest('#panel')) openChat(Number(ch.dataset.chat));
  });

  // ---------- order panel ----------
  const panel = $('panel'), scrim = $('pScrim');
  const closePanel = () => { panel.classList.remove('on'); scrim.classList.remove('on'); panel.setAttribute('inert', ''); panel.setAttribute('aria-hidden', 'true'); setTimeout(() => { scrim.hidden = true; }, 300); };
  $('pClose').addEventListener('click', closePanel); scrim.addEventListener('click', closePanel);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closePanel(); });

  async function openOrder(ref: string) {
    const d = await api(`/api/admin/orders/${encodeURIComponent(ref)}`);
    const o = d.order;
    $('pRef').textContent = o.ref;
    const flow = o.method === 'pickup' ? ['received', 'confirmed', 'ready', 'completed'] : ['received', 'confirmed', 'out-for-delivery', 'completed'];
    $('pBody').innerHTML = `
      <p><span class="pill ${o.status}">${STATUS_LABEL[o.status]}</span> ${payPill(o)} <small class="muted">Chose: ${PAY[o.payment]}</small></p>
      <p><b>${fmtDay(o.day)} · ${esc(o.window)}</b><br>${o.method === 'delivery' ? `Delivery: ${esc(o.street)}, ${esc(o.postal)} · <a href="https://maps.google.com/?q=${encodeURIComponent(`${o.street}, ${o.postal}, Calgary`)}" target="_blank" rel="noopener">Map</a>` : 'Pickup'}</p>
      <p>${esc(o.name)} · <a href="tel:${esc(o.phone)}">${esc(o.phone)}</a> · <a href="mailto:${esc(o.email)}">${esc(o.email)}</a> · ${o.lang === 'ar' ? 'Arabic' : 'English'}</p>
      ${o.notes ? `<p><b>Customer note:</b> ${esc(o.notes)}</p>` : ''}
      ${d.customer?.note ? `<p class="gift-note"><b>About this customer:</b> ${esc(d.customer.note)}</p>` : ''}
      ${d.customer ? `<p><button type="button" class="linkish" data-cust="${d.customer.id}">Customer page (all orders, team note)</button></p>` : ''}
      ${o.giftCard ? `<p>Gift card used: ${money(o.giftCard)}${o.giftCardCode ? ` (${esc(o.giftCardCode)})` : ''}</p>` : ''}${o.regular ? '<p><span class="pill">Regular order</span></p>' : ''}
      ${o.collected ? `<p>Collected at the door: <b>${money(o.collected.cents)}</b> by ${esc(o.collected.method)} (${esc(o.collected.by)})</p>` : ''}
      ${o.gift ? `<p class="gift-note">Gift for <b>${esc(o.gift.to)}</b>${o.gift.phone ? ` · <a href="tel:${esc(o.gift.phone)}">${esc(o.gift.phone)}</a>` : ''}${o.gift.message ? `<br>Card: <i>“${esc(o.gift.message)}”</i>` : ''}</p>` : ''}
      <h3>Items</h3><ul class="its">${o.items.map((i: any) => `<li><span>${i.qty} × ${esc(i.name_en)}${i.option_en ? ` <small>(${esc(i.option_en)})</small>` : ''}</span><span>${money(i.unit_cents * i.qty)}</span></li>`).join('')}
        ${o.delivery ? `<li><span>Delivery</span><span>${money(o.delivery)}</span></li>` : ''}${o.discount ? `<li><span>Discount ${esc(o.promo ?? '')}</span><span>−${money(o.discount)}</span></li>` : ''}<li><b>Total</b><b>${money(o.total)}</b></li>${o.refunded ? `<li><span>Refunded</span><span>−${money(o.refunded)}</span></li>` : ''}</ul>
      ${['received', 'confirmed'].includes(o.status) ? `<details class="edit-items"><summary>Change items</summary>
        <div id="eiList">${o.items.map((i: any) => itemRow(i.product_id, i.option, i.qty)).join('')}</div>
        <div class="acts"><select id="eiAdd"><option value="">Add a product…</option>${PRODUCTS.map(p => `<option value="${p.id}">${esc(p.name.en)}</option>`).join('')}</select></div>
        <label class="notify"><input type="checkbox" id="eiNotify" checked /> Email the customer the new order</label>
        <div class="acts"><button type="button" id="eiSave">Save changes</button></div>
        <p class="ev">Prices are today's. Quantity 0 removes a line. If it was paid and the total goes up, it shows what is still to pay; if it goes down, use Refund.</p></details>` : ''}
      <h3>Move the order</h3>
      <div class="acts">${flow.map(s => `<button type="button" data-status="${s}" class="${s === o.status ? 'cur' : ''}">${STATUS_LABEL[s]}</button>`).join('')}<button type="button" class="danger" data-status="cancelled">Cancel order</button></div>
      <label class="notify"><input type="checkbox" id="pNotify" checked /> Email the customer about the change</label>
      ${o.method === 'delivery' ? `<h3>Driver</h3><div class="acts"><select id="pDriver"><option value="">Not assigned</option></select></div>` : ''}
      <h3>Change day or time</h3>
      <div class="acts"><input type="date" id="mvDay" value="${o.day}" /><select id="mvWin">${['11:00–14:00', '14:00–17:00', '17:00–20:00'].map(w => `<option ${w === o.window ? 'selected' : ''}>${w}</option>`).join('')}</select><button type="button" id="mvGo">Move</button></div>
      <label class="notify"><input type="checkbox" id="mvForce" /> Allow even if that time is full or past the deadline</label>
      <h3>Payment</h3>
      <div class="acts"><button type="button" data-pay="paid" class="${o.paymentStatus === 'paid' ? 'cur' : ''}">Money received</button><button type="button" data-pay="unpaid" class="${o.paymentStatus === 'unpaid' ? 'cur' : ''}">Not received yet</button></div>
      ${ROLE !== 'admin' ? '' : `<h3>Refund</h3>`}
      ${ROLE !== 'admin' ? '' : o.refundable > 0 ? `<div class="refund">
        <div class="acts"><input id="rAmt" type="number" min="0.01" step="0.01" max="${(o.refundable / 100).toFixed(2)}" value="${(o.refundable / 100).toFixed(2)}" aria-label="Amount in dollars" />
        <select id="rHow" aria-label="How">${o.payment === 'card' && o.paidByCard ? '<option value="card">Back to their card (Square)</option>' : ''}<option value="e-transfer">e-Transfer (you send it)</option><option value="cash">Cash (you hand it back)</option><option value="store-credit">Store credit (a one-time code)</option></select></div>
        <input id="rWhy" placeholder="Reason, e.g. box arrived crushed" />
        <label class="notify"><input type="checkbox" id="rNotify" checked /> Email the customer</label>
        <div class="acts"><button type="button" id="rGo" class="danger">Refund</button></div>
        <p class="ev">Up to ${money(o.refundable)} can still be refunded. Full refund = the whole amount; partial = any smaller amount.</p></div>` : '<p class="ev">Nothing left to refund.</p>'}
      ${d.refunds.length ? `<ul>${d.refunds.map((x: any) => `<li class="ev">${new Date(x.created_at).toLocaleString('en-CA', { dateStyle: 'medium', timeStyle: 'short' })} · <b>${money(x.amount_cents)}</b> by ${esc(x.method)}${x.credit_code ? ` · code <b>${esc(x.credit_code)}</b>` : ''}${x.status !== 'done' ? ` · ${esc(x.status)}` : ''} ${x.reason ? '· ' + esc(x.reason) : ''} <small>${esc(x.actor)}</small></li>`).join('')}</ul>` : ''}
      <h3>Team note</h3><textarea id="pNote" rows="2" placeholder="Only the team sees this"></textarea><div class="acts"><button type="button" id="pAddNote">Add note</button></div>
      <label class="notify owner-only"><input type="checkbox" id="pSample" ${o.sample ? 'checked' : ''} /> This is a sample / test order (no emails, not counted, not in the CSV)</label>
      <h3>History</h3><ul>${d.events.map((e: any) => `<li class="ev">${new Date(e.created_at).toLocaleString('en-CA', { dateStyle: 'medium', timeStyle: 'short' })} · <b>${esc(e.kind)}</b> ${esc(e.detail ?? '')} <small>${esc(e.actor ?? '')}</small></li>`).join('')}</ul>
      <h3>Emails</h3><ul>${d.emails.map((m: any) => `<li class="ev">${esc(m.subject)} → ${esc(m.to_email)} · <b>${esc(m.status)}</b></li>`).join('') || '<li class="ev">None yet.</li>'}</ul>`;
    scrim.hidden = false; panel.removeAttribute('inert'); panel.setAttribute('aria-hidden', 'false');
    requestAnimationFrame(() => { scrim.classList.add('on'); panel.classList.add('on'); });
    const refresh = async () => { await openOrder(ref); if (!$('v-orders').hidden) loadOrders(); if (!$('v-day').hidden) loadDay(); };
    $('pBody').querySelectorAll<HTMLButtonElement>('[data-status]').forEach(b => b.addEventListener('click', async () => {
      if (b.dataset.status === 'cancelled' && !confirm(`Cancel ${ref}?`)) return;
      await api(`/api/admin/orders/${encodeURIComponent(ref)}`, { status: b.dataset.status, notify: ($('pNotify') as HTMLInputElement).checked }); refresh();
    }));
    $('pBody').querySelectorAll<HTMLButtonElement>('[data-pay]').forEach(b => b.addEventListener('click', async () => { await api(`/api/admin/orders/${encodeURIComponent(ref)}`, { paymentStatus: b.dataset.pay }); refresh(); }));
    $('pSample').addEventListener('change', async e => { await api(`/api/admin/orders/${encodeURIComponent(ref)}`, { sample: (e.target as HTMLInputElement).checked }); refresh(); });
    $('rGo')?.addEventListener('click', async () => {
      const amt = Math.round(Number(($('rAmt') as HTMLInputElement).value) * 100), how = ($('rHow') as HTMLSelectElement).value;
      if (!(amt > 0) || !confirm(`Refund ${money(amt)} by ${how}${how === 'card' ? ' (sent back through Square now)' : ''}?`)) return;
      const r = await api(`/api/admin/orders/${encodeURIComponent(ref)}/refund`, { amount_cents: amt, method: how, reason: ($('rWhy') as HTMLInputElement).value, notify: ($('rNotify') as HTMLInputElement).checked });
      if (r.creditCode) alert(`Store credit code: ${r.creditCode} (emailed to the customer if ticked)`);
      refresh();
    });
    $('eiAdd')?.addEventListener('change', e => { const sel = e.target as HTMLSelectElement; if (!sel.value) return; $('eiList').insertAdjacentHTML('beforeend', itemRow(sel.value, null, 1)); sel.value = ''; });
    $('eiSave')?.addEventListener('click', async () => {
      const lines = [...document.querySelectorAll<HTMLElement>('#eiList .ei')].map(r => ({ id: r.dataset.pid!, opt: (r.querySelector('select') as HTMLSelectElement | null)?.value ?? '', qty: Number((r.querySelector('input') as HTMLInputElement).value) })).filter(l => l.qty > 0);
      if (!lines.length) { alert('An order needs at least one item. To cancel it, use Cancel order.'); return; }
      const r = await api(`/api/admin/orders/${encodeURIComponent(ref)}/items`, { lines, notify: ($('eiNotify') as HTMLInputElement).checked });
      alert(`Saved. New total ${money(r.total)}.${r.balance > 0 ? ` ${money(r.balance)} still to pay.` : r.balance < 0 ? ` ${money(-r.balance)} to refund.` : ''}`); refresh();
    });
    $('mvGo').addEventListener('click', async () => {
      const r = await api(`/api/admin/orders/${encodeURIComponent(ref)}/move`, { day: ($('mvDay') as HTMLInputElement).value, window: ($('mvWin') as HTMLSelectElement).value, force: ($('mvForce') as HTMLInputElement).checked });
      alert(`Moved to ${fmtDay(r.day)} ${r.window}. The customer was emailed.`); refresh();
    });
    if (document.getElementById('pDriver')) {
      api('/api/admin/team').then(t => {
        const sel = $('pDriver') as HTMLSelectElement;
        for (const x of t.drivers) sel.add(new Option(x.name, x.email, false, x.email === o.driver));
        sel.addEventListener('change', async () => { await api('/api/admin/assign', { refs: [ref], driver: sel.value }); refresh(); });
      });
    }
    $('pBody').querySelector<HTMLButtonElement>('[data-cust]')?.addEventListener('click', e => openCustomer(Number((e.target as HTMLElement).dataset.cust)));
    $('pAddNote').addEventListener('click', async () => { const v = ($('pNote') as HTMLTextAreaElement).value.trim(); if (v) { await api(`/api/admin/orders/${encodeURIComponent(ref)}`, { note: v }); refresh(); } });
  }

  // One line in the "Change items" editor: product, its option (grind or date), quantity.
  function itemRow(pid: string, opt: string | null, qty: number) {
    const p = PRODUCTS.find(x => x.id === pid); if (!p) return '';
    const opts = p.kind === 'coffee' ? p.grinds.map(g => [g, GRINDS[g].en]) : p.kind === 'box' && p.chooseDate ? Object.entries(DATES).map(([id, d]) => [id, d.name.en]) : [];
    return `<div class="ei acts" data-pid="${p.id}"><span>${esc(p.name.en)}</span>${opts.length ? `<select>${opts.map(([v, l]) => `<option value="${v}" ${v === opt ? 'selected' : ''}>${esc(l)}</option>`).join('')}</select>` : ''}<input type="number" min="0" max="20" value="${qty}" style="width:70px" aria-label="Quantity" /></div>`;
  }
  const showPanel = (title: string, html: string) => {
    $('pRef').textContent = title; $('pBody').innerHTML = html;
    scrim.hidden = false; panel.removeAttribute('inert'); panel.setAttribute('aria-hidden', 'false');
    requestAnimationFrame(() => { scrim.classList.add('on'); panel.classList.add('on'); });
  };
  const when = (iso: string) => new Date(iso).toLocaleString('en-CA', { dateStyle: 'medium', timeStyle: 'short' });
  const KIND: Record<string, string> = { damaged: 'Damaged', 'wrong-item': 'Wrong item', missing: 'Missing item', late: 'Late delivery', 'change-order': 'Change order', 'large-order': 'Large order', question: 'Question', other: 'Other' };
  const URGENT = ['damaged', 'wrong-item', 'missing', 'late'];
  const transcript = (lines: any[]) => `<ol class="tx">${lines.map(l => `<li class="${l.who}">${l.who === 'tool' ? `<code>${esc(l.text)}</code>` : esc(l.text).replace(/\n/g, '<br>')}</li>`).join('')}</ol>`;

  // ---------- inbox ----------
  let inboxStatus = 'open';
  $('inboxFilter').addEventListener('click', e => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-st]'); if (!b) return;
    inboxStatus = b.dataset.st!; $('inboxFilter').querySelectorAll('button').forEach(x => x.classList.toggle('cur', x === b)); loadTickets();
  });
  async function loadInboxCount() {
    const d = await api('/api/admin/tickets?status=open');
    const n = d.counts?.open ?? 0; $('inboxN').textContent = String(n); $('inboxN').hidden = !n; $('inboxMain').textContent = String(n); $('inboxMain').hidden = !n;
  }
  async function loadTickets() {
    const d = await api(`/api/admin/tickets?status=${inboxStatus}`);
    const n = d.counts?.open ?? 0; $('inboxN').textContent = String(n); $('inboxN').hidden = !n; $('inboxMain').textContent = String(n); $('inboxMain').hidden = !n;
    $('noTickets').hidden = d.tickets.length > 0;
    document.querySelector('#tickets tbody')!.innerHTML = d.tickets.map((t: any) => `<tr class="row" data-ticket="${esc(t.ref)}">
      <td class="ref">${esc(t.ref)}${t.photos ? `<br><small>${t.photos} photo${t.photos > 1 ? 's' : ''}</small>` : ''}</td><td>${when(t.created_at)}<br><small>${t.source === 'ask' ? 'Ask Hikaya' : 'Help form'} · ${t.lang === 'ar' ? 'Arabic' : 'English'}</small></td>
      <td>${esc(t.name ?? '')}<br><small>${esc(t.email)}</small></td>
      <td><span class="pill ${URGENT.includes(t.kind) ? 'unpaid' : ''}">${KIND[t.kind] ?? esc(t.kind)}</span></td>
      <td class="its">${esc(t.summary)}</td><td>${esc(t.order_ref ?? '')}</td><td><span class="pill ${t.status === 'resolved' ? 'completed' : t.status === 'open' ? 'received' : 'confirmed'}">${esc(t.status)}</span></td></tr>`).join('');
  }
  async function openTicket(ref: string) {
    const d = await api(`/api/admin/tickets/${encodeURIComponent(ref)}`);
    const t = d.ticket, o = d.order;
    showPanel(`${t.ref} · ${KIND[t.kind] ?? t.kind}`, `
      <p><span class="pill ${t.status === 'resolved' ? 'completed' : 'received'}">${esc(t.status)}</span>${t.resolution ? ` <span class="pill">${esc(t.resolution)}</span>` : ''} · ${t.source === 'ask' ? 'from Ask Hikaya' : 'from the help form'} · ${when(t.created_at)}</p>
      <p>${esc(t.name ?? '')} · <a href="mailto:${esc(t.email)}">${esc(t.email)}</a>${t.phone ? ` · <a href="tel:${esc(t.phone)}">${esc(t.phone)}</a>` : ''} · writes in ${t.lang === 'ar' ? 'Arabic' : 'English'}</p>
      <p class="sum">${esc(t.summary)}</p>
      ${t.details ? `<p>${esc(t.details).replace(/\n/g, '<br>')}</p>` : ''}
      ${t.order_ref ? `<h3>Order</h3>${o ? `<div class="mini to-order" data-ref="${esc(o.ref)}"><span><b>${esc(o.ref)}</b> · ${esc(o.method)} · ${fmtDay(o.day)} ${esc(o.slot_window)} · ${money(o.total_cents)} · <span class="pill ${o.status}">${STATUS_LABEL[o.status]}</span></span>${o.emailMatches ? '' : '<span class="warn">The email on this request is not the order’s email. Check before acting.</span>'}</div>` : `<p class="warn">No order ${esc(t.order_ref)} found.</p>`}` : ''}
      ${d.photos.length ? `<h3>Photos</h3><div class="ph">${d.photos.map((id: number) => `<a href="/api/admin/photos/${id}" target="_blank" rel="noopener"><img src="/api/admin/photos/${id}" alt="Customer photo ${id}" loading="lazy" /></a>`).join('')}</div>` : ''}
      <h3>Reply to the customer by email</h3>
      <textarea id="tReply" rows="5" placeholder="${t.lang === 'ar' ? 'The customer wrote in Arabic: reply in Arabic if you can.' : 'Write your reply. It is sent from the Hikaya address with the request number.'}" dir="auto"></textarea>
