  .mg-pick { display: flex; flex-wrap: wrap; gap: 10px; align-items: end; margin-bottom: 10px; } .mg-pick input { border: 1.5px solid var(--line); border-radius: 10px; padding: 6px 8px; font: inherit; margin-inline-start: 6px; }
