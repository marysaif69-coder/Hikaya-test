  // ---------- numbers ----------
  async function loadNumbers() {
    const d = await api('/api/admin/numbers');
    const rows = (list: any[], cols: (x: any) => string[], head: string[], empty: string) => `<tr>${head.map(h => `<th>${h}</th>`).join('')}</tr>` + (list.map(x => `<tr>${cols(x).map(c => `<td>${c}</td>`).join('')}</tr>`).join('') || `<tr><td colspan="${head.length}" class="muted">${empty}</td></tr>`);
    $('nDays').innerHTML = rows(d.byDay.slice().reverse(), x => [fmtDay(x.day), String(x.views)], ['Day', 'Views'], 'No visits yet.');
    $('nPages').innerHTML = rows(d.pages, x => [esc(x.path), String(x.views)], ['Page', 'Views'], 'No visits yet.');
    $('nRefs').innerHTML = rows(d.refs, x => [esc(x.ref), String(x.views)], ['Site', 'Visits'], 'None yet: most people type the address or use Instagram’s app.');
    $('nWeeks').innerHTML = rows(d.weeks.slice().reverse(), x => [`Week of ${fmtDay(x.week)}`, String(x.orders), money(x.cents)], ['Week', 'Orders', 'Sales'], 'No real orders yet.');
    $('nTop').innerHTML = rows(d.top, x => [esc(x.name), String(x.qty)], ['Product', 'Sold'], 'No real orders yet.');
