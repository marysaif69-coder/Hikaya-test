    const g = await api('/api/admin/giftcards/sell', { amount_cents: Math.round(dollarsIn * 100), payment: v('payment'), to_name: v('to_name'), to_email: v('to_email'), buyer_name: v('buyer_name'), buyer_email: v('buyer_email'), message: v('message'), lang: v('lang') });
    $('gcSold').innerHTML = `<p class="gc-code">Code <b>${esc(g.code)}</b> · ${money(g.amount_cents)}${g.sentTo ? ` · emailed to ${esc(g.sentTo)}` : ' · not emailed: write it on a card or print it'}</p><p><button type="button" class="btn line sm" id="gcPrint">Print a gift card</button></p>`;
